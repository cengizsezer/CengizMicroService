{
  "Routes": [
    {
      "UseServiceDiscovery": true,
      "ServiceName": "CatalogService",
      "DownstreamPathTemplate": "/api/catalog/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/catalog/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put", "Options" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "IdentityService",
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "OCRService",
      "DownstreamPathTemplate": "/api/ocr/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/OCR/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "FileApiService",
      "DownstreamPathTemplate": "/api/file/v1/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/file/v1/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ],
      "UpstreamScheme": "http"
    }
    
  ],
  "GlobalConfiguration": {
    //"BaseUrl": "http://webapigateway.api:5000",
    "BaseUrl": "http://localhost:5000",
    "ServiceDiscoveryProvider": {
      //"Host": "c_consul",
      "Host": "localhost",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}
