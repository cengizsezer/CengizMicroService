{
  "Routes": [
    {
      // Açık (girişsiz) bordro hesaplayıcısı — KARARLAR §155. Bilinçli olarak
      // AuthenticationOptions YOK. Aşağıdaki Bearer'lı /catalog/{everything} rotası da
      // bu yolu eşleştirdiği için Priority açıkça yüksek verildi (varsayılan 1); sıraya
      // güvenilmiyor. Controller yalnız law-types + calculate açıyor ve IP başına hız
      // sınırının arkasında (CatalogService: PayrollAcikController).
      "UseServiceDiscovery": true,
      "ServiceName": "CatalogService",
      "DownstreamPathTemplate": "/api/catalog/payroll/acik/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/catalog/payroll/acik/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "OPTIONS" ],
      "UpstreamScheme": "http",
      "Priority": 2
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "CatalogService",
      "DownstreamPathTemplate": "/api/catalog/jobs/assignments/{assignmentId}/status",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/catalog/jobs/assignments/{assignmentId}/status",
      "UpstreamHttpMethod": [ "PATCH" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "CatalogService",
      "DownstreamPathTemplate": "/api/catalog/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/catalog/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "UpstreamScheme": "http",

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "IdentityService",
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "OCRService",
      "DownstreamPathTemplate": "/api/ocr/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/OCR/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "FileApiService",
      "DownstreamPathTemplate": "/api/file/v1/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/file/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "UpstreamScheme": "http"
    }

  ],
  "GlobalConfiguration": {
    //"BaseUrl": "http://webapigateway.api:5000",
    "BaseUrl": "http://localhost:5000",
    "ServiceDiscoveryProvider": {
      //"Host": "c_consul",
      "Host": "localhost",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}
