{
  "Routes": [
    {
      "UseServiceDiscovery": true,
      "ServiceName": "CatalogService",
      "DownstreamPathTemplate": "/api/catalog/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/catalog/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "IdentityService",
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put", "Options" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "OCRService",
      "DownstreamPathTemplate": "/api/ocr/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/ocr/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put", "Options" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "FileApiService",
      "DownstreamPathTemplate": "/api/file/v1/{everything}",
      "DownstreamScheme": "http",

      "UpstreamPathTemplate": "/file/v1/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ],
      "UpstreamScheme": "http"
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "IdentityService",
      "DownstreamPathTemplate": "/api/auth/admin/{everything}",
      "UpstreamPathTemplate": "/auth/admin/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "role": "Admin"
      }
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "SovosService",
      "DownstreamPathTemplate": "/api/faturakontrol/companies/run-batch",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/faturakontrol/companies/run-batch",
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamScheme": "http",
      "QoSOptions": {
        "TimeoutValue": 1500000
      }
    },
    {
      "UseServiceDiscovery": true,
      "ServiceName": "SovosService",
      "DownstreamPathTemplate": "/api/faturakontrol/{everything}",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/faturakontrol/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http"
    }

  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "ServiceDiscoveryProvider": {
      "Host": "localhost",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}
