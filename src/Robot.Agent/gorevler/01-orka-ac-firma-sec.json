{
  "Ad": "ORKA Ac ve Firma Sec",
  "Aciklama": "En temel zincir. Firma secimi IKI Enter ister. Sifre popup'inda ALT+T (Tamam) kullanilir.",

  "// KULLANIM": [
    "PkfRobot.exe --gorev gorevler\\01-orka-ac-firma-sec.json --sifre Pkf123+ --degisken firmaSifre=pkf03"
  ],

  "// OLCUM NOTLARI": [
    "F7 > kod yaz > ENTER (arama onayi) > ENTER (firmaya gir)",
    "Sonra 'Firma Sifresini Giriniz.' popup'i acilir, icinde Sifre alani ve Tamam butonu var.",
