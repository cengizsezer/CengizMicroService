    "'Firma' diye ARAMA - cmd penceresinin basliginda da 'firma' geciyor (dosya adi).",
    "'Giriniz' benzersiz ve Turkce karakter icermiyor."
  ],

  "Adimlar": [
    { "Tip": "Log", "Not": "--- ORKA baslatiliyor ---" },
    { "Tip": "OrkaBaslat" },

    { "Tip": "BeklePencere", "Deger": "Orka SQL", "Not": "Giris ekrani bekleniyor" },
    { "Tip": "EkranGoruntusu", "Deger": "giris-ekrani" },

    { "Tip": "Log", "Not": "--- 1. SIFRE: ORKA girisi ---" },
    { "Tip": "Bekle", "Sayi": 1500 },

    { "Tip": "Yaz", "Deger": "{sifre}", "Not": "orka sifresi giriliyor" },
    { "Tip": "Bekle", "Sayi": 400 },
    { "Tip": "EkranGoruntusu", "Deger": "sifre-yazildi" },
    { "Tip": "Tus", "Deger": "ENTER", "Adet": 1 },
    { "Tip": "Bekle", "Sayi": 2500 },
    { "Tip": "EkranGoruntusu", "Deger": "giris-sonrasi" },

    { "Tip": "Log", "Not": "--- Firma araniyor (F7) ---" },
    { "Tip": "Tus", "Deger": "F7", "Adet": 1 },
    { "Tip": "Bekle", "Sayi": 800 },
    { "Tip": "TemizleYaz", "Deger": "{firmaKodu}", "Not": "firma kodu yaziliyor" },
    { "Tip": "Bekle", "Sayi": 1000 },
    { "Tip": "EkranGoruntusu", "Deger": "firma-arandi" },

    { "Tip": "Log", "Not": "--- 1. ENTER: arama onayi, firma listede belirir ---" },
