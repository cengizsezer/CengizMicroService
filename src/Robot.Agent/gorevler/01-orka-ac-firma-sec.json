    { "Tip": "EkranGoruntusu", "Deger": "firma-listede" },

    { "Tip": "Log", "Not": "--- 2. ENTER: firmaya giris ---" },
    { "Tip": "Tus", "Deger": "ENTER", "Adet": 1 },

    { "Tip": "Log", "Not": "--- 2. SIFRE: popup bekleniyor ve odaklaniyor ---" },
    { "Tip": "Bekle", "Sayi": 3000, "Not": "Firma Sifresini Giriniz popup" },
    { "Tip": "EkranGoruntusu", "Deger": "firma-sifre-ekrani" },

    { "Tip": "Yaz", "Deger": "{firmaSifre}", "Not": "firma sifresi giriliyor" },
    { "Tip": "Bekle", "Sayi": 500 },
    { "Tip": "EkranGoruntusu", "Deger": "firma-sifre-yazildi" },

    { "Tip": "Log", "Not": "--- ALT+T = Tamam butonu (T alti cizili) ---" },
    { "Tip": "Kisayol", "Deger": "ALT+T", "Not": "Tamam butonu" },
    { "Tip": "Bekle", "Sayi": 3000 },
    { "Tip": "EkranGoruntusu", "Deger": "firma-sifre-sonrasi" },

    { "Tip": "Log", "Not": "--- Sube secimi (tek sube ise Enter yeter) ---" },
    { "Tip": "EkranGoruntusu", "Deger": "sube-ekrani" },
    { "Tip": "Tus", "Deger": "ENTER", "Adet": 1 },
    { "Tip": "Bekle", "Sayi": 3000 },

    { "Tip": "Log", "Not": "--- Modul ekranina gelindi mi kontrol ---" },
    { "Tip": "Dogrula", "Deger": "ORKA_0001_2026", "Not": "Baslikta firma kodu var mi" },
    { "Tip": "EkranGoruntusu", "Deger": "modul-ekrani" },

    { "Tip": "Log", "Not": "BASARILI: Firma acildi, modul ekranindayiz." }
