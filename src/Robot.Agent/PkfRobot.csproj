<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PkfRobot</AssemblyName>
    <RootNamespace>PkfRobot</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Argumansiz calistirilinca WinForms arayuzu aciliyor. OutputType yine Exe
         (konsol alt sistemi): WinExe yapilsaydi ajan, probe ve kalibre
         modlarinin ciktisi hicbir yere yazilmazdi. Arayuz acilirken konsol
         penceresi gizleniyor. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Sunucu asgari surum kontrolu yapiyor; AjanSurumu bu degerden okunuyor.
         Sozlesme degistiren her yayin oncesi artir. -->
    <Version>1.0.0</Version>

    <!-- Tek dosya publish icin OKUBENI.md'deki dotnet publish komutunu kullan.
         (XML yorumu icinde cift tire kullanilamadigi icin komut buraya yazilmadi.) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Native DLL'ler de exe'ye gomulsun. Bu olmadan WPF/UIA native kutuphaneleri
         exe'nin YANINDA ayri dosya olarak kalir ve kopyalanmazsa ofiste hata verir. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!-- Ajan modu: hub baglantisi ve anahtarin DPAPI ile diskte sifreli durmasi. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />

    <!-- Duzeltilmis ekstrenin satir sayisini dogrulamak icin. Dosyayi sunucu da
         ClosedXML ile yaziyor; ayni kutuphaneyle okumak "kac satir var"
         sorusuna iki tarafta ayni yaniti veriyor. -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="gorevler\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
