<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PkfRobot</AssemblyName>
    <RootNamespace>PkfRobot</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Tek dosya publish icin OKUBENI.md'deki dotnet publish komutunu kullan.
         (XML yorumu icinde cift tire kullanilamadigi icin komut buraya yazilmadi.) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Native DLL'ler de exe'ye gomulsun. Bu olmadan WPF/UIA native kutuphaneleri
         exe'nin YANINDA ayri dosya olarak kalir ve kopyalanmazsa ofiste hata verir. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="gorevler\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
