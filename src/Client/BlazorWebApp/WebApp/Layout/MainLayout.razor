@code {
    bool isCollapsed = false; // başlangıçta açık
    string CurrentFirmName { get; set; } = string.Empty;

    [Inject] IAppSessionManager SessionManager { get; set; } = default!;
    [Inject] AppStateManager AppState { get; set; } = default!;
    [Inject] DialogService DialogService { get; set; } = default!;
    [Inject] ILocalStorageService LocalStorage { get; set; } = default!;
    [Inject] IIdentityService IdentityService { get; set; } = default!;
    [Inject] NavigationManager Navigation { get; set; } = default!;

    void ToggleSidebar() => isCollapsed = !isCollapsed;
    private bool canViewBeyannameTakip;
    private bool canViewVergiOdeme;

    private bool canViewVehicleList;
    private bool canViewExpenses;
    private bool canViewEducation;
    private bool canViewSettings;
    private bool canViewCalendar;
    private bool canViewFaturaKontrol;


    protected override async Task OnInitializedAsync()
    {
        await SessionManager.RestoreAsync();
        CurrentFirmName = AppState.SelectedFirmName;

        AppState.StateChanged += OnAppStateChanged;
        SessionManager.FirmChanged += OnFirmChanged;
        SessionManager.AuthChanged += OnAuthChanged;

        await LoadPermissionsAsync();
    }


    private async Task LoadPermissionsAsync()
    {
        canViewBeyannameTakip = await PermissionService.HasPermissionAsync("BeyannameTakip.View");
        canViewVergiOdeme = await PermissionService.HasPermissionAsync("TaxPayment.View");
        canViewVehicleList = await PermissionService.HasPermissionAsync("Vehicle.View"); // veya VehicleList.View
        canViewExpenses = await PermissionService.HasPermissionAsync("Expense.View");
        canViewEducation = await PermissionService.HasPermissionAsync("Education.View");
        canViewSettings = await PermissionService.HasPermissionAsync("Settings.View");
        canViewCalendar = await PermissionService.HasPermissionAsync("Calendarpage.View");
        canViewFaturaKontrol = await PermissionService.HasPermissionAsync("FaturaKontrol.View");
    }

    private async void OnAppStateChanged(AppStateEvent ev)
    {
        if (ev == AppStateEvent.FirmChanged)
        {
            CurrentFirmName = AppState.SelectedFirmName;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnFirmChanged(FirmaDto firm)
    {
        CurrentFirmName = firm?.Ad ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthChanged()
    {
        await LoadPermissionsAsync();
        await InvokeAsync(StateHasChanged);
    }
  

    private async Task OnChangeFirmClick()
    {
        var firms = SessionManager.Firms?.ToList();
        if (firms is null || firms.Count == 0) return;

        var result = await DialogService.OpenAsync<FirmSelectDialog>(
            "Firma Seç",
            new() { ["Firms"] = firms },
            new DialogOptions { Width = "60vw", Height = "70vh", CloseDialogOnOverlayClick = true, Resizable = true, Draggable = true });

        if (result is FirmaDto chosen)
            await SessionManager.SelectFirmAsync(chosen);
    }

    private async Task OnLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        await SessionManager.ClearAsync();
        IdentityService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AppState.StateChanged -= OnAppStateChanged;
        SessionManager.FirmChanged -= OnFirmChanged;
        SessionManager.AuthChanged -= OnAuthChanged;
    }

    void OnProfileMenuClick(RadzenProfileMenuItem item)
    {
        if (item?.Value?.ToString() == "logout")
            _ = OnLogout();
    }
    string UserInitials => GetInitials(UserFullName);

    // Burayı kendi user modeline göre ayarlarsın.
    // Şimdilik örnek olarak:
    string UserFullName
        => "Cengiz Sezer" // eğer böyle bir property'n varsa
           ?? "Cengiz Sezer";                      // yoksa şimdilik sabit dursun


    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts = fullName
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        // Tek kelimelik isimse: ilk 2 harf (CE gibi)
        if (parts.Length == 1)
        {
            var name = parts[0];
            var len = Math.Min(2, name.Length);
            return name[..len].ToUpper(new CultureInfo("tr-TR"));
        }

        // Birden fazla kelimeyse: ilk + son kelimenin ilk harfi (Cengiz Sezer -> CS)
        char first = parts[0][0];
        char last = parts[^1][0];

        return $"{char.ToUpper(first, new CultureInfo("tr-TR"))}{char.ToUpper(last, new CultureInfo("tr-TR"))}";
    }
}
