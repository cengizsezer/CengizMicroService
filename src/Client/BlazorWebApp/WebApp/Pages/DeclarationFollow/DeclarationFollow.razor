@*
    Beyannameler > Takip sekmesi.

    Kendi @page rotası YOK: rotayı üst sayfa (BeyannamelerPage) yönetiyor ve bu bileşeni
    DynamicComponent ile basıyor — Hesaplamalar sayfasındaki kalıbın aynısı (KARARLAR §79).
    Eski adres /beyanname-takip yönlendirme olarak duruyor (EskiRotaYonlendirme.razor).

    Ekranın içeriği değişmedi.
*@
@using System.Globalization
@using CatalogService.Api.Features.Declarations.Dtos
@using CatalogService.Api.Features.Declarations.Entities
@using WebApp.Pages.Beyannameler.Components
@using Microsoft.AspNetCore.Authorization
@using WebApp.Application.Services.Interfaces
@using WebApp.Manager
@inject DialogService DialogService
@inject IDeclarationApiService DeclarationApiService
@inject ICustomerCompanyApiService CustomerCompanyApiService
@inject IPermissionService PermissionService
@inject IBeyannameTuruApiService BeyannameTuruApi
@inject NavigationManager Navigation

<PageTitle>Beyanname Takip</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText Text="Beyanname Takip" TextStyle="TextStyle.H4" class="rz-mb-3" />

        <RadzenButton Text="Yeni Beyanname Ekle"
                      Icon="add_circle"
                      Click="@OpenCreateDialog" />
    </RadzenStack>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenRow Gap="1rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Yıl" Style="width:100%">
                    <RadzenDropDown @bind-Value="selectedYear"
                                    Data="@years"
                                    Style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Ay" Style="width:100%">
                    <RadzenDropDown @bind-Value="selectedMonth"
                                    Data="@months"
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    Style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Firma" Style="width:100%">
                    <RadzenDropDown Data="@customerCompanies"
                                    TextProperty="CompanyName"
                                    ValueProperty="Id"
                                    @bind-Value="selectedCompanyId"
                                    AllowClear="true"
                                    Change="@OnCompanyFilterChanged"
                                    Style="width:100%"
                                    Placeholder="Firma seçiniz" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="Beyanname Türü" Style="width:100%">
                    <RadzenDropDown @bind-Value="selectedDeclarationType"
                                    Data="@turSecenekleri"
                                    TextProperty="Etiket"
                                    ValueProperty="Deger"
                                    AllowClear="true"
                                    Placeholder="Tümü"
                                    Style="width:100%" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="1">
                <RadzenButton Text="Getir"
                              Icon="search"
                              Click="@LoadData"
                              Style="width:100%" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard class="rz-p-3">
                <RadzenText Text="Bu Ay Toplam Vergi" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@monthlyTotal.ToString("C", trCulture)" TextStyle="TextStyle.H5" />
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard class="rz-p-3">
                <RadzenText Text="Bu Ay Ödenen" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@monthlyPaid.ToString("C", trCulture)" TextStyle="TextStyle.H5" />
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard class="rz-p-3">
                <RadzenText Text="Bu Ay Bekleyen" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@monthlyPending.ToString("C", trCulture)" TextStyle="TextStyle.H5" />
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard class="rz-p-3">
                <RadzenText Text="Bu Yıl Toplam Vergi" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@(yearlySummary?.TotalAmount.ToString("C", trCulture) ?? "₺0,00")"
                            TextStyle="TextStyle.H5" />
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid @ref="grid"
                    Data="@(monthlyData ?? new List<CompanyMonthlySummaryDto>())"
                    TItem="CompanyMonthlySummaryDto"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    ExpandMode="DataGridExpandMode.Single"
                    RowRender="@RowRender">

        <Template Context="company">
            <div class="rz-p-3" style="background:#fafafa; border-radius:8px;">
                <RadzenDataGrid Data="@(company.Declarations ?? new List<DeclarationDto>())"
                                TItem="DeclarationDto"
                                AllowPaging="false"
                                AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn Property="DeclarationType" Title="Beyanname Türü" />

                        <RadzenDataGridColumn Property="Amount" Title="Tutar">
                            <Template Context="item">
                                @item.Amount.ToString("C", trCulture)
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DueDate" Title="Son Tarih">
                            <Template Context="item">
                                @item.DueDate.ToString("dd.MM.yyyy")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Beyanname Durumu">
                            <Template Context="item">
                                <RadzenBadge Text="@GetDeclarationStatusText(item.DeclarationStatus)"
                                             BadgeStyle="@GetDeclarationBadgeStyle(item.DeclarationStatus)" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Ödeme Durumu">
                            <Template Context="item">
                                <RadzenBadge Text="@GetPaymentStatusText(item.PaymentStatus)"
                                             BadgeStyle="@GetPaymentBadgeStyle(item.PaymentStatus)" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Note" Title="Not" />

                        @* Tahakkuk / beyanname / dekont: belge varsa ikon dolu, yoksa soluk.
                           Matristeki ikonlarla aynı bileşen. *@
                        <RadzenDataGridColumn Title="Belgeler" Width="110px" Sortable="false" Filterable="false">
                            <Template Context="item">
                                <BeyannameBelgeHucresi DeclarationId="@item.Id"
                                                       Odendi="@(item.PaymentStatus == PaymentStatus.Paid)" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="İşlem" Width="150px">
                            <Template Context="item">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Icon="edit"
                                                  Size="ButtonSize.Small"
                                                  Click="@(args => OpenEditDialog(item))" />

                                    <RadzenButton Icon="delete"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Click="@(args => DeleteDeclaration(item))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </Template>

        <Columns>
            <RadzenDataGridColumn Property="CompanyName" Title="Firma" />

            <RadzenDataGridColumn Property="TotalAmount" Title="Aylık Toplam Vergi">
                <Template Context="item">
                    @item.TotalAmount.ToString("C", trCulture)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="DeclarationCount" Title="Beyanname Sayısı" />
            <RadzenDataGridColumn Property="ApprovedCount" Title="Onaylanan" />
            <RadzenDataGridColumn Property="PaidCount" Title="Ödenen" />

            <RadzenDataGridColumn Property="PendingAmount" Title="Bekleyen">
                <Template Context="item">
                    @item.PendingAmount.ToString("C", trCulture)
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</RadzenStack>

@code {
    private readonly CultureInfo trCulture = new("tr-TR");
    [Parameter] public List<CustomerCompanyDto> Companies { get; set; } = new();
    private RadzenDataGrid<CompanyMonthlySummaryDto>? grid;
   
    private List<CompanyMonthlySummaryDto> monthlyData = new();
    private YearlyTaxSummaryDto? yearlySummary;
    [Inject] IAppSessionManager SessionManager { get; set; } = default!;
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;
   
    private string? selectedDeclarationType;
    private List<CustomerCompanyDto> customerCompanies = new();
    private List<int> years = new();
    private List<MonthOption> months = new();
    private List<DropdownOption> companyOptions = new();
    private int? selectedCompanyId;
    // Beyanname türleri artık burada sabit DEĞİL: catalog.BeyannameTurleri tablosundan
    // geliyor — Özet sekmesiyle aynı kaynak. İki liste ayrı durduğu sürece biri
    // doluyken diğeri boş kalabiliyordu. Tanımlar sekmesinden yönetilir.
    private List<BeyannameTuruDto> beyannameTurleri = new();

    /// <summary>Açılır listenin gösterdiği etiket; filtreye giden değer <c>Deger</c>.</summary>
    private sealed record TurSecenegi(string Deger, string Etiket);

    private List<TurSecenegi> turSecenekleri = new();

    private static TurSecenegi Secenek(BeyannameTuruDto tur)
        => new(tur.Deger, string.IsNullOrWhiteSpace(tur.Kod) ? tur.Ad : $"{tur.Kod} {tur.Ad}");

    private decimal monthlyTotal => monthlyData?.Sum(x => x.TotalAmount) ?? 0;
    private decimal monthlyPaid => monthlyData?.Sum(x => x.PaidAmount) ?? 0;
    private decimal monthlyPending => monthlyData?.Sum(x => x.PendingAmount) ?? 0;

    private void OnCompanyFilterChanged(object? value)
    {
        if (value == null)
        {
            selectedCompanyId = null;
            return;
        }

        selectedCompanyId = Convert.ToInt32(value);
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 🔥 1. Session restore
            await SessionManager.RestoreAsync();

            // 🔥 2. Permission check (artık token hazır)
            var canView = await PermissionService.HasPermissionAsync("BeyannameTakip.View");

            if (!canView)
            {
                Navigation.NavigateTo("/unauthorized");
                return;
            }

            // 🔥 3. UI init
            years = Enumerable.Range(DateTime.Now.Year - 3, 6).ToList();

            months = new()
        {
            new MonthOption(1, "Ocak"),
            new MonthOption(2, "Şubat"),
            new MonthOption(3, "Mart"),
            new MonthOption(4, "Nisan"),
            new MonthOption(5, "Mayıs"),
            new MonthOption(6, "Haziran"),
            new MonthOption(7, "Temmuz"),
            new MonthOption(8, "Ağustos"),
            new MonthOption(9, "Eylül"),
            new MonthOption(10, "Ekim"),
            new MonthOption(11, "Kasım"),
            new MonthOption(12, "Aralık")
        };

            // 🔥 4. API çağrıları
            customerCompanies = await CustomerCompanyApiService.GetAllAsync();

            beyannameTurleri = await BeyannameTuruApi.GetHepsiAsync();
            turSecenekleri = beyannameTurleri.Select(Secenek).ToList();

            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BeyannameTakip INIT ERROR]: {ex.Message}");
        }
    }
    private async Task DeleteDeclaration(DeclarationDto item)
    {
        var confirmed = await DialogService.Confirm(
            $"{item.DeclarationType} kaydını silmek istiyor musunuz?",
            "Kayıt Sil",
            new ConfirmOptions
            {
                OkButtonText = "Sil",
                CancelButtonText = "Vazgeç"
            });

        if (confirmed == true)
        {
            var ok = await DeclarationApiService.DeleteAsync(item.Id);

            if (ok)
            {
                await LoadData();
            }
        }
    }

   
   
    private async Task LoadData()
    {
        try
        {
            monthlyData = await DeclarationApiService.GetMonthlySummaryAsync(
                selectedYear,
                selectedMonth,
                selectedCompanyId,
                selectedDeclarationType) ?? new();

            yearlySummary = await DeclarationApiService.GetYearlySummaryAsync(
                selectedYear,
                selectedCompanyId);

           
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BeyannameTakip LoadData ERROR] {ex.Message}");

            monthlyData = new();
            yearlySummary = null;
           
        }
    }

    private async Task OpenCreateDialog()
    {
        var model = new CreateDeclarationRequest
        {
            Year = selectedYear,
            Month = selectedMonth,
            DueDate = DateTime.Today,
            DeclarationStatus = DeclarationStatus.Draft,
            PaymentStatus = PaymentStatus.Pending
        };

        var result = await DialogService.OpenAsync<DeclarationFormDialog>(
    "Yeni Beyanname Ekle",
    new Dictionary<string, object>
    {
        { "Model", model },
        { "Companies", customerCompanies },
        { "Turler", beyannameTurleri }
    },
    new DialogOptions
    {
        Width = "700px",
        Height = "800px",
        Resizable = true,
        Draggable = true
    });

        if (result is CreateDeclarationRequest request)
        {
            var createdId = await DeclarationApiService.CreateAsync(request);

            if (createdId.HasValue)
            {
                await LoadData();
            }
        }
    }

    private async Task OpenEditDialog(DeclarationDto item)
    {
        var model = new CreateDeclarationRequest
        {
            CustomerCompanyId = item.CustomerCompanyId,
            CompanyName = item.CompanyName,
            DeclarationType = item.DeclarationType,
            Year = item.Year,
            Month = item.Month,
            Amount = item.Amount,
            DueDate = item.DueDate,
            DeclarationStatus = item.DeclarationStatus,
            PaymentStatus = item.PaymentStatus,
            PaymentDate = item.PaymentDate,
            Note = item.Note
        };

        var result = await DialogService.OpenAsync<DeclarationFormDialog>(
    "Beyanname Düzenle",
    new Dictionary<string, object>
    {
        { "Model", model },
        { "Companies", customerCompanies },
        { "Turler", beyannameTurleri }
    },
    new DialogOptions
    {
        Width = "700px",
        Height = "800px",
        Resizable = true,
        Draggable = true
    });

        if (result is CreateDeclarationRequest form)
        {
            var updateRequest = new UpdateDeclarationRequest
            {
                CustomerCompanyId = form.CustomerCompanyId,
                CompanyName = form.CompanyName,
                DeclarationType = form.DeclarationType,
                Year = form.Year,
                Month = form.Month,
                Amount = form.Amount,
                DueDate = form.DueDate,
                DeclarationStatus = form.DeclarationStatus,
                PaymentStatus = form.PaymentStatus,
                PaymentDate = form.PaymentDate,
                Note = form.Note
            };
            var ok = await DeclarationApiService.UpdateAsync(item.Id, updateRequest);

            if (ok)
            {
                await LoadData();
            }
        }
    }

    private void RowRender(RowRenderEventArgs<CompanyMonthlySummaryDto> args)
    {
        args.Expandable = args.Data?.Declarations != null && args.Data.Declarations.Any();
    }

    private static string GetDeclarationStatusText(DeclarationStatus status) => status switch
    {
        DeclarationStatus.Preparing => "Hazırlanıyor",
        DeclarationStatus.Draft => "Taslak",
        DeclarationStatus.Ready => "Hazır",
        DeclarationStatus.Approved => "Onaylandı",
        DeclarationStatus.Submitted => "Gönderildi",
        _ => status.ToString()
    };

    private static string GetPaymentStatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => "Bekliyor",
        PaymentStatus.Planned => "Planlandı",
        PaymentStatus.Paid => "Ödendi",
        _ => status.ToString()
    };

    private static BadgeStyle GetDeclarationBadgeStyle(DeclarationStatus status) => status switch
    {
        DeclarationStatus.Preparing => BadgeStyle.Warning,
        DeclarationStatus.Draft => BadgeStyle.Secondary,
        DeclarationStatus.Ready => BadgeStyle.Info,
        DeclarationStatus.Approved => BadgeStyle.Success,
        DeclarationStatus.Submitted => BadgeStyle.Primary,
        _ => BadgeStyle.Light
    };

    private static BadgeStyle GetPaymentBadgeStyle(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => BadgeStyle.Warning,
        PaymentStatus.Planned => BadgeStyle.Info,
        PaymentStatus.Paid => BadgeStyle.Success,
        _ => BadgeStyle.Light
    };

    public record MonthOption(int Value, string Text);
    public record DropdownOption(string Value, string Text);
}