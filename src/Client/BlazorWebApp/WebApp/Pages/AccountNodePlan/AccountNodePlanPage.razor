@page "/hesap-plani"
@using Radzen
@using Radzen.Blazor
@using WebApp.Shared.Dto.AccountNodePlan
@using WebApp.Application.Services.Interfaces
@using Microsoft.AspNetCore.Components.Web
@inject IAccountPlanClient AccountPlanClient
@inject DialogService Dialog
@inject NotificationService Notif

<style>
    .left-pane {
        height: calc(100vh - 140px); /* sol taraf yüksekliği */
        display: flex;
        flex-direction: column;
    }

    .tree-wrapper {
        flex: 0 0 auto;
    }

    .note-preview {
        flex: 1 1 auto;
        margin-top: 8px;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #eee;
        background: #fff;
        overflow-y: auto;
        font-size: 13px;
        line-height: 1.5;
    }

    .note-preview-empty {
        flex: 1 1 auto;
        margin-top: 8px;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px dashed #ddd;
        color: #999;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .viewer-card {
        height: 70vh;
        min-height: 360px;
        overflow-y: auto;
        padding: 12px 16px;
        border-radius: 6px;
        border: 1px solid #eee;
        background: #fff;
    }
</style>

<div class="row">
    <div class="col-4">
        <div class="left-pane">
            <RadzenTextBox placeholder="Ara (kod/ad)" type="search"
                           @oninput="Filter" style="width:100%; margin-bottom:8px" />

            <div class="tree-wrapper">
                <RadzenTree Style="width:100%" Change="@OnSelect">
                    @foreach (var root in _viewRoots)
                    {
                        @RenderNode(root)
                    }
                </RadzenTree>
            </div>

           
        </div>
    </div>

    <div class="col-8">
        @if (_selected is not null)
        {
            <h4>@_selected.Code - @_selected.Name</h4>

            @if (!string.IsNullOrWhiteSpace(_selected.Description))
            {
                <p class="text-muted">@_selected.Description</p>
            }

            @if (!_editMode)
            {
                <!-- OKUMA MODU -->
                <div class="viewer-card">
                    @if (!string.IsNullOrWhiteSpace(_notes))
                    {
                        <RadzenHtml>
                            @((MarkupString)_notes)
                        </RadzenHtml>
                    }
                    else
                    {
                        <span class="text-muted">Bu hesap için henüz not girilmemiş.</span>
                    }
                </div>

                <div class="rz-mt-2">
                    <RadzenButton Text="Düzenle"
                                  Icon="edit"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@StartEdit"
                                  class="rz-mr-2" />

                    <RadzenButton Text="Notu Sil"
                                  Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Disabled="@string.IsNullOrWhiteSpace(_notes)"
                                  Click="@ClearNoteAsync" />
                </div>
            }
            else
            {
                <!-- DÜZENLEME MODU -->
                <RadzenHtmlEditor @bind-Value="_notes" Style="height:70vh;min-height:360px" />

                <div class="rz-mt-2">
                    <RadzenButton Text="Kaydet"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@SaveNotes"
                                  class="rz-mr-2" />

                    <RadzenButton Text="Vazgeç"
                                  Icon="close"
                                  Click="@CancelEdit" />
                </div>
            }
        }
        else
        {
            <div class="text-muted">Soldan bir hesap seçin.</div>
        }
    </div>
</div>

@code {
    // Orijinal ağaç (API'den gelen)
    List<AccountNodeDto> _tree = new();
    // Filtrelenmiş / gösterilecek kökler
    List<AccountNodeDto> _viewRoots = new();
    // Seçim ve notlar
    AccountNodeDto? _selected;
    string? _notes;
    string _term = string.Empty;
    bool _editMode = false;

    protected override async Task OnInitializedAsync()
    {
        _tree = await AccountPlanClient.GetTreeAsync() ?? new();
        _viewRoots = _tree; // başlangıçta tüm ağaç
    }

    // --------- RadzenTreeItem'ları recursive üret ----------
    RenderFragment RenderNode(AccountNodeDto n) => __builder =>
    {
        __builder.OpenComponent<RadzenTreeItem>(0);
        __builder.AddAttribute(1, "Text", $"{n.Code} - {n.Name}");
        __builder.AddAttribute(2, "Value", n);
        __builder.AddAttribute(3, "Expanded", !string.IsNullOrWhiteSpace(_term));
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)((b) =>
        {
            if (n.Children != null)
            {
                foreach (var c in n.Children)
                    b.AddContent(5, RenderNode(c));
            }
        }));
        __builder.CloseComponent();
    };

    // --------- Seçim ----------
    async Task OnSelect(TreeEventArgs args)
    {
        _selected = args.Value as AccountNodeDto;
        if (_selected is null) return;

        _editMode = false;

        var fresh = await AccountPlanClient.GetAsync(_selected.Id);
        if (fresh is not null)
        {
            _selected = fresh;
            _notes = fresh.Notes;
        }
    }

    // --------- Edit modunu aç ----------
    void StartEdit()
    {
        if (_selected is null) return;
        _editMode = true;
    }

    // --------- Vazgeç ----------
    async Task CancelEdit()
    {
        if (_selected is null) { _editMode = false; return; }

        // Sunucudaki güncel haline geri dön
        var fresh = await AccountPlanClient.GetAsync(_selected.Id);
        if (fresh is not null)
        {
            _selected = fresh;
            _notes = fresh.Notes;
        }
        _editMode = false;
    }

    // --------- Not kaydet ----------
    async Task SaveNotes()
    {
        if (_selected is null) return;

        await AccountPlanClient.UpdateNotesAsync(_selected.Id, _notes);
        UpdateNoteInTrees(_selected.Id, _notes);

        _selected.Notes = _notes;
        _editMode = false;

        Notif.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Kaydedildi",
            Detail = $"{_selected.Code} - {_selected.Name} notu güncellendi."
        });
    }

    // --------- Notu tamamen sil ----------
    async Task ClearNoteAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_notes)) return;

        var ok = await Dialog.Confirm(
            $"{_selected.Code} - {_selected.Name} için kaydedilmiş not silinsin mi?",
            "Silme Onayı",
            new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç", ShowClose = true });

        if (ok == true)
        {
            _notes = null;
            await AccountPlanClient.UpdateNotesAsync(_selected.Id, null);
            UpdateNoteInTrees(_selected.Id, null);
            _selected.Notes = null;
            _editMode = false;

            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Silindi",
                Detail = "Not temizlendi."
            });
        }
    }

    // --------- Arama / Filtre ----------
    void Filter(ChangeEventArgs e)
    {
        _term = (e.Value?.ToString() ?? string.Empty).Trim();
        _viewRoots = string.IsNullOrWhiteSpace(_term) ? _tree : FilterTree(_tree, _term);
        StateHasChanged();
    }

    static List<AccountNodeDto> FilterTree(List<AccountNodeDto> roots, string term)
    {
        var list = new List<AccountNodeDto>();
        foreach (var r in roots)
        {
            var match = NodeMatches(r, term);
            var filteredChildren = r.Children is null ? new List<AccountNodeDto>() : FilterTree(r.Children, term);

            if (match || filteredChildren.Count > 0)
            {
                list.Add(new AccountNodeDto
                {
                    Id = r.Id,
                    Code = r.Code,
                    Name = r.Name,
                    Description = r.Description,
                    Notes = r.Notes,
                    Level = r.Level,
                    ParentId = r.ParentId,
                    Order = r.Order,
                    Children = filteredChildren
                });
            }
        }
        return list;
    }

    static bool NodeMatches(AccountNodeDto n, string term) =>
        (n.Code?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (n.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    // ağacın içinde ilgili düğümün Notes'unu güncelle
    void UpdateNoteInTrees(int id, string? notes)
    {
        void Apply(List<AccountNodeDto> roots)
        {
            foreach (var n in roots)
            {
                if (n.Id == id) { n.Notes = notes; return; }
                if (n.Children?.Count > 0) Apply(n.Children);
            }
        }
        Apply(_tree);
        Apply(_viewRoots);
    }


    @*  @if (_selected is not null && !string.IsNullOrWhiteSpace(_selected.Notes))
            {
                <div class="note-preview">
                    <RadzenHtml>
                        @((MarkupString)_selected.Notes)
                    </RadzenHtml>
                </div>
            }
            else
            {
                <div class="note-preview-empty">
                    Bu hesap için kayıtlı bir not yok.
                </div>
            } *@
}
