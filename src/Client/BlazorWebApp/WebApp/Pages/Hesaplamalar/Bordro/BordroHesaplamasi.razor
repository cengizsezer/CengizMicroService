    protected override async Task OnInitializedAsync()
    {
        monthInputs = BuildDefaultMonths();

        lawTypes = await HesapApi.GetLawTypesAsync(model.Year);

        if (!lawTypes.Any(x => x.Code == model.LawCode))
        {
            model.LawCode = lawTypes.FirstOrDefault()?.Code ?? "00000";
        }
    }

    private async Task OnYearChangedAsync(object? value)
    {
        if (value is int year)
        {
            model.Year = year;
        }
        else
        {
            model.Year = Convert.ToInt32(value);
        }

        lawTypes = await HesapApi.GetLawTypesAsync(model.Year);

        if (!lawTypes.Any(x => x.Code == model.LawCode))
        {
            model.LawCode = lawTypes.FirstOrDefault()?.Code ?? "00000";
        }

        await TriggerRecalculateAsync();
    }

