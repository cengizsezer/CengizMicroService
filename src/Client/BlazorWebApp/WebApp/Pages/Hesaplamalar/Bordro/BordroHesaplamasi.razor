    private async Task OnLawChangedAsync()
    {
        // Alt seçim (bölge / dönem) teşvike özgü; teşvik değişince yeniden seçilsin.
        model.TesvikAltSecimi = null;
        await TriggerRecalculateAsync();
    }

    private async Task OnEmployeeTypeChangedAsync()
    {
        // Huzur hakkında teşvik kutusu kilitli ve teşviksiz.
        if (IsHonorarium)
        {
            model.LawCode = "00000";
            model.TesvikAltSecimi = null;
            // Yol / Yemek de kapanır; başka tipe dönülünce kapalı başlar.
            model.YolYemekAcik = false;
        }
        await TriggerRecalculateAsync();
    }

    /// <summary>
    /// Sunucudaki PayrollTesvikDogrulama'nın ekrandaki karşılığı: eksik girdiyle sunucuya
    /// gitmeden okunur mesaj gösterilir. Sunucu yine son kapı.
    /// </summary>
    private string? EksikTesvikGirdisi()
    {
        if (IsHonorarium || SelectedLaw is not { } law) return null;

        if (law.AltSecimler.Count > 0 && law.AltSecimler.All(x => x.Deger != model.TesvikAltSecimi))
            return $"{law.Name} için {law.AltSecimBasligi?.ToLowerInvariant()} seçin.";
        if (law.EngelZorunlu && model.DisabilityType == 0)
            return $"{law.Name} için Engel Durumu en az 1. derece olmalı.";
        if (law.OnayMetni is not null && !model.TurizmKonaklamaOnayi)
            return $"{law.Name} için \"{law.OnayMetni}\" onayını işaretleyin.";
        if (law.OnayMetni is not null && model.TurizmPrimGunu is < 1 or > 30)
            return "Prim günü 1 ile 30 arasında olmalı.";
        if (law.AylikTutarSorulur && model.IsgDestegiTutari <= 0)
            return $"{law.Name} için aylık tutar girin.";
        if (law.ManuelSorulur && model.ManuelTesvikTuru is null)
            return "Manuel teşvik için tür seçin.";
        if (law.ManuelSorulur && model.ManuelTesvikDegeri <= 0)
            return "Manuel teşvik için değer girin.";
        if (law.ManuelSorulur && model.ManuelTesvikTuru == 1 && model.ManuelTesvikDegeri > 100)
            return "Manuel teşvik oranı %100'ü aşamaz.";
        return null;
    }

    /// <summary>Sunucudaki yol / yemek kontrolünün ekrandaki karşılığı.</summary>
    private string? EksikYolYemekGirdisi()
    {
        if (!YolYemekUygulanir) return null;
        if (model.YolYemekGunSayisi is < 1 or > 31)
            return "Yol / yemek için aylık gün sayısı 1 ile 31 arasında olmalı.";
        if (model.YemekGunlukTutar < 0 || model.YolGunlukTutar < 0)
            return "Yol / yemek günlük tutarı negatif olamaz.";
        return null;
    }

    private async Task OnAmountChangedAsync(PayrollMonthInputModel item, object? value)
    {
        var amount = value is decimal dec ? dec : 0m;

        item.Amount = amount;
        item.IsEdited = true;

        foreach (var next in monthInputs.Where(x => x.Month > item.Month).OrderBy(x => x.Month))
        {
            next.Amount = amount;
        }

        await TriggerRecalculateAsync();
    }

    private async Task OnJanitorChanged(bool value)
    {
        model.IsJanitor = value;
        await TriggerRecalculateAsync();
    }

    private async Task TriggerRecalculateAsync()
    {
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        try
        {
            await Task.Delay(250, token);
            await CalculateAsync(token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private CalculatePayrollRequest BuildRequest() => new()
    {
        Year = model.Year,
        LawCode = IsHonorarium ? "00000" : model.LawCode,
        CalculationType = model.CalculationType,
        EmployeeType = model.EmployeeType,
        HasMandatoryBes = model.HasMandatoryBes,
        DisabilityType = model.DisabilityType,
        IncludeMinimumWageExemption = model.IncludeMinimumWageExemption,
        IncludeStampTax = model.IncludeStampTax,
        IncludeEmployerCost = model.IncludeEmployerCost,
        IsManufacturingSector = model.ShowManufacturingOption,
        // Sorulmayan girdi varsayılanda gider (2026 öncesi yıllarda eğitim hep %80 — dondurulmuş).
        ArGeEgitimDurumu = SelectedLaw?.EgitimDurumuSorulur == true ? model.ArGeEgitimDurumu : 0,
        TesvikAltSecimi = SelectedLaw?.AltSecimler.Count > 0 ? model.TesvikAltSecimi : null,
        TurizmKonaklamaOnayi = model.TurizmKonaklamaOnayi,
        TurizmPrimGunu = model.TurizmPrimGunu,
        IsgDestegiTutari = model.IsgDestegiTutari,
        ManuelTesvikTuru = model.ManuelTesvikTuru,
        ManuelTesvikDegeri = model.ManuelTesvikDegeri,
        YolYemek = YolYemekUygulanir
            ? new PayrollYolYemekRequest
            {
                GunSayisi = model.YolYemekGunSayisi,
                YemekGunlukTutar = model.YemekGunlukTutar,
                YemekOdemeSekli = model.YemekOdemeSekli,
                YolGunlukTutar = model.YolGunlukTutar,
                YolOdemeSekli = model.YolOdemeSekli
            }
            : null,
        StartMonth = 1,
        PreviousCumulativeTaxBase = model.PreviousCumulativeTaxBase,
        Months = monthInputs
            .OrderBy(x => x.Month)
            .Select(x => new PayrollMonthInputRequest { Month = x.Month, Amount = x.Amount })
            .ToList()
    };

    private async Task CalculateAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            if (!monthInputs.Any(x => x.IsEdited))
            {
                result = null;
                return;
            }

            if ((EksikTesvikGirdisi() ?? EksikYolYemekGirdisi()) is { } eksik)
            {
                result = null;
                errorMessage = eksik;
                return;
            }

            var request = BuildRequest();

            result = await HesapApi.CalculateAsync(request, cancellationToken);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ExportExcelAsync()
    {
        await DownloadAsync("Excel", BuildFileName("xlsx"),
            ct => HesapApi.ExportExcelAsync(BuildRequest(), ct));
    }

    private async Task ExportPdfAsync()
    {
        await DownloadAsync("PDF", BuildFileName("pdf"),
            ct => HesapApi.ExportPdfAsync(BuildRequest(), ct));
    }

    private string BuildFileName(string ext)
    {
        var prefix = IsHonorarium ? "huzur_hakki" : "bordro";
        return $"{prefix}_{model.Year}.{ext}";
    }

    private async Task DownloadAsync(string label, string fileName, Func<CancellationToken, Task<byte[]>> fetch)
    {
        if (!monthInputs.Any(x => x.IsEdited))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Eksik veri",
                Detail = "Önce en az bir ay için tutar girin.",
                Duration = 4000
            });
            return;
        }

        isExporting = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var bytes = await fetch(CancellationToken.None);
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, bytes);
        }
        catch (Exception ex)
        {
            errorMessage = $"{label} oluşturulamadı: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

