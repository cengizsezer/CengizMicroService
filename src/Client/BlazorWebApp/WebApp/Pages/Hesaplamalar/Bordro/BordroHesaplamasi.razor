@using Radzen
@using WebApp.Pages.Hesaplamalar.Bordro
@using WebApp.Pages.Hesaplamalar.Bordro.Component
@using WebApp.Pages.Hesaplamalar.Bordro.Model
@using WebApp.Pages.Hesaplamalar.Bordro.Services
@inject IPayrollApiService PayrollApiService
@inject PayrollAcikApiService PayrollAcikApiService
@inject DialogService DialogService
@inject NotificationService NotificationService

@inject IJSRuntime JS

@*
    Bordro hesaplayıcısının TEK kopyası. İki yerden açılır (KARARLAR §155):
      - Hesaplamalar > Bordro Hesaplaması (girişli, MainLayout) — sekmeyi
        HesaplamalarPage basıyor (bkz. HesaplamaSekmesi kayıt listesi).
      - /payroll-calculator açık sayfası (girişsiz) — AcikErisim="true" ile.

    Kendi @page rotası YOK. Oturum, firma ya da menü BİLMEZ; tek ayar AcikErisim.
    İki modda da işlevler aynı (hesap, Excel/PDF, kâr dağıtımı karşılaştırması); fark
    yalnız hangi kapıdan gidildiği — açık modda token'sız /catalog/payroll/acik uçları.
    Karşılaştırma penceresi de aynı kapıyı parametre olarak alır.
*@

<div class="payroll-page">
    <div class="payroll-container">

      @*   <div class="payroll-header">
            <img src="/img/bordro-logo.svg" alt="Bordro Hesaplama" class="payroll-logo" />
            <h1 class="page-title">@(IsHonorarium ? "Huzur Hakkı Hesaplama" : "Ücret Bordrosu")</h1>
        </div> *@

        <div class="payroll-filters">
            <div class="filter-item year-box">
                <label>Yıl</label>
                <RadzenDropDown TValue="int"
                                Data="@yearOptions"
                                @bind-Value="model.Year"
                                Style="width:110px;"
                                Change="@OnYearChangedAsync" />
            </div>

            <div class="filter-item">
                <label>Kanun</label>
                <RadzenDropDown TValue="string"
                                @bind-Value="model.LawCode"
                                Data="@lawTypes"
                                TextProperty="Label"
                                ValueProperty="Code"
                                AllowClear="false"
                                Disabled="@IsHonorarium"
                                Style="width:300px;"
                                PopupStyle="max-height: 400px;"
                                Change="@(_ => OnLawChangedAsync())" />
            </div>

            @* Seçilen teşvikin istediği ek girdiler — hangisinin sorulacağı sunucudaki kural tablosundan gelir. *@
            @if (!IsHonorarium && SelectedLaw is { } law)
            {
                @if (law.AltSecimler.Count > 0)
                {
                    <div class="filter-item">
                        <label>@law.AltSecimBasligi</label>
                        <RadzenDropDown TValue="int?"
                                        Data="@law.AltSecimler"
                                        TextProperty="Ad"
                                        ValueProperty="Deger"
                                        @bind-Value="model.TesvikAltSecimi"
                                        Placeholder="Seçiniz"
                                        Style="width:170px;"
                                        Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                }

                @if (law.EgitimDurumuSorulur)
                {
                    <div class="filter-item">
                        <label>Eğitim Durumu</label>
                        <RadzenDropDown TValue="int"
                                        Data="@egitimDurumlari"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="model.ArGeEgitimDurumu"
                                        Style="width:170px;"
                                        Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                }

                @if (law.OnayMetni is not null)
                {
                    <div class="filter-item switch-item">
                        <label>&nbsp;</label>
                        <div class="switch-wrap">
                            <RadzenSwitch class="payroll-switch" @bind-Value="model.TurizmKonaklamaOnayi"
                                          Change="@(_ => TriggerRecalculateAsync())" />
                            <span>@law.OnayMetni</span>
                        </div>
                    </div>
                    <div class="filter-item">
                        <label>Prim Günü</label>
                        <RadzenNumeric TValue="int" @bind-Value="model.TurizmPrimGunu" Min="1" Max="30"
                                       Style="width:80px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                }

                @if (law.AylikTutarSorulur)
                {
                    <div class="filter-item">
                        <label>Aylık Tutar (TL)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="model.IsgDestegiTutari" Min="0" Format="N2"
                                       Style="width:130px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                }

                @if (law.ManuelSorulur)
                {
                    <div class="filter-item">
                        <label>Teşvik Türü</label>
                        <RadzenDropDown TValue="int?"
                                        Data="@manuelTurleri"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="model.ManuelTesvikTuru"
                                        Placeholder="Seçiniz"
                                        Style="width:150px;"
                                        Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                    <div class="filter-item">
                        <label>@(model.ManuelTesvikTuru == 2 ? "Aylık Tutar (TL)" : "Oran (%)")</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="model.ManuelTesvikDegeri" Min="0" Format="N2"
                                       Style="width:120px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                }
            }

            <div class="filter-item">
                <label>Hesaplama Tipi</label>
                <RadzenDropDown TValue="int"
                                Data="@calculationTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.CalculationType"
                                Style="width:170px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            <div class="filter-item">
                <label>Çalışan Tipi</label>
                <RadzenDropDown TValue="int"
                                Data="@employeeTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.EmployeeType"
                                Style="width:170px;"
                                Change="@(_ => OnEmployeeTypeChangedAsync())" />
            </div>

            <div class="filter-item">
                <label>Engel Durumu</label>
                <RadzenDropDown TValue="int"
                                Data="@disabilityTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.DisabilityType"
                                Style="width:225px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            @if (!IsHonorarium)
            {
                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.IncludeMinimumWageExemption"
                                      Change="@((bool value) => TriggerRecalculateAsync())" />
                        <span>AÜVİ Uygula</span>
                    </div>
                </div>

                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.ShowManufacturingOption"
                                      Change="@(_ => TriggerRecalculateAsync())" />
                        <span>İmalat Sektörü</span>
                    </div>
                </div>

                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.HasMandatoryBes"
                                      Change="@((bool value) => TriggerRecalculateAsync())" />
                        <span>Zorunlu BES</span>
                    </div>
                </div>
@* 
                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.IncludeStampTax"
                                      Change="@(_ => TriggerRecalculateAsync())" />
                        <span>Damga Vergisi</span>
                    </div>
                </div> *@

                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.IncludeEmployerCost"
                                      Change="@(_ => TriggerRecalculateAsync())"
                                      />
                        
                        <span>İşveren Maliyetleri</span>
                    </div>
                </div>

            }

            @* Yol / Yemek (2026+). Huzur hakkında diğer düğmeler gibi gizli; 2026 öncesinde kilitli.
               İkisinde de istekte gönderilmez. *@
            @if (!IsHonorarium)
            {
                <div class="filter-item switch-item">
                    <label>&nbsp;</label>
                    <div class="switch-wrap">
                        <RadzenSwitch class="payroll-switch" @bind-Value="model.YolYemekAcik"
                                      Disabled="@(!YolYemekKullanilabilir)"
                                      Change="@(_ => TriggerRecalculateAsync())" />
                        <span>Yol / Yemek</span>
                    </div>
                </div>
            }

            @if (YolYemekUygulanir)
            {
                @* Beş girdi tek grup: sığmazsa grubun tamamı alt satıra geçer (içi bölünmez). *@
                <div class="yol-yemek-grup">
                    <div class="filter-item">
                        <label>Aylık Gün</label>
                        <RadzenNumeric TValue="int" @bind-Value="model.YolYemekGunSayisi" Min="1" Max="31"
                                       Style="width:70px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                    <div class="filter-item">
                        <label>Yemek Günlük (TL)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="model.YemekGunlukTutar" Min="0" Format="N2"
                                       Style="width:110px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                    <div class="filter-item">
                        <label>Yemek Ödeme</label>
                        <RadzenDropDown TValue="int"
                                        Data="@yemekOdemeSekilleri"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="model.YemekOdemeSekli"
                                        Style="width:170px;"
                                        Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                    <div class="filter-item">
                        <label>Yol Günlük (TL)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="model.YolGunlukTutar" Min="0" Format="N2"
                                       Style="width:110px;"
                                       Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                    <div class="filter-item">
                        <label>Yol Ödeme</label>
                        <RadzenDropDown TValue="int"
                                        Data="@yolOdemeSekilleri"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="model.YolOdemeSekli"
                                        Style="width:170px;"
                                        Change="@(_ => TriggerRecalculateAsync())" />
                    </div>
                </div>
            }

            @if (IsHonorarium)
            {
                <div class="filter-item action-link">
                    <label>&nbsp;</label>
                    @* PDF İndir ile aynı stil (Outlined + Primary); yükseklik/odak: .karsilastirma-btn *@
                    <RadzenButton Text="Kar Dağıtımı Karşılaştırma"
                                  Icon="compare_arrows"
                                  Click="@OpenComparisonPopup"
                                  Variant="Variant.Outlined"
                                  ButtonStyle="ButtonStyle.Primary"
                                  class="karsilastirma-btn" />
                </div>
            }

           
        </div>

        <div class="table-wrapper">
            @if (!IsHonorarium)
            {
                <table class="payroll-table">
                    <thead>
                        <tr>
                            <th>Aylar</th>
                            <th>Tutar</th>
                            <th>Brüt<br />Ücret</th>
                            @if (HasYolYemek)
                            {
                                <th>Yemek<br />Tutarı</th>
                                <th>Yol<br />Tutarı</th>
                                <th>SGK'ya Tabi<br />Yan Hak</th>
                                <th>GV'ye Tabi<br />Yan Hak</th>
                            }
                            <th>SGK<br />İşçi</th>
                            <th>İSP<br />İşçi</th>
                            @if (HasEmployeeSgkIncentive)
                            {
                                <th>SGK İşçi<br />Teşvik</th>
                            }
                            @if (model.DisabilityType > 0)
                            {
                                <th>Engel<br />İndirimi</th>
                            }
                            <th>Gelir V.<br />Matrahı</th>
                            <th>Kümülatif<br />Matrah</th>
                            <th>Gelir<br />Vergisi</th>
                            <th>İstisna<br />Gelir V.</th>
                            <th>Ödenecek<br />Gelir Ver.</th>
                            <th>Damga<br />Vergisi</th>
                            <th>İstisna<br />D.V.</th>
                            <th>Ödenecek<br />Damga V.</th>
                            @if (model.HasMandatoryBes)
                            {
                                <th>BES<br />Kesintisi</th>
                            }
                            <th>Kesintiler<br />Toplamı</th>
                            <th>Net<br />Ücret</th>
                            @if (HasYolYemek)
                            {
                                <th>Kartla<br />Ödenen</th>
                            }
                            @if (model.IncludeEmployerCost)
                            {
                                <th>SGK İşveren<br />Brüt</th>
                                @if (HasIncentive)
                                {
                                    <th>@IncentiveLabel</th>
                                }
                                <th>SGK İşveren<br />Net</th>
                                <th>İSP<br />İşveren</th>
                                @if (HasSupport)
                                {
                                    <th>@SupportLabel</th>
                                }
                                <th>Toplam İşveren<br />Maliyet</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < monthInputs.Count; i++)
                        {
                            var input = monthInputs[i];
                            var monthResult = GetMonthResult(input.Month);

                            <tr>
                                <td>@input.MonthName</td>

                                <td class="input-cell">
                                    <div class="input-wrap">
                                        <RadzenNumeric TValue="decimal"
                                                       Value="input.Amount"
                                                       Style="width:100%;"
                                                       Format="N2"
                                                       Change="@(args => OnAmountChangedAsync(input, args))" />
                                    </div>
                                </td>

                                <td>@FormatMoney(monthResult?.GrossSalary)</td>
                                @if (HasYolYemek)
                                {
                                    <td>@FormatMoney(monthResult?.MealAmount)</td>
                                    <td>@FormatMoney(monthResult?.TransportAmount)</td>
                                    <td>@FormatMoney(monthResult?.SgkTaxableBenefits)</td>
                                    <td>@FormatMoney(monthResult?.IncomeTaxableBenefits)</td>
                                }
                                <td>@FormatMoney(monthResult?.SgkEmployeeAmount)</td>
                                <td>@FormatMoney(monthResult?.UnemploymentEmployeeAmount)</td>
                                @if (HasEmployeeSgkIncentive)
                                {
                                    <td>@FormatMoney(monthResult?.EmployeeSgkIncentive)</td>
                                }
                                @if (model.DisabilityType > 0)
                                {
                                    <td>@FormatMoney(monthResult?.DisabilityExemptionAmount)</td>
                                }
                                <td>@FormatMoney(monthResult?.IncomeTaxBase)</td>
                                <td>@FormatMoney(monthResult?.CumulativeIncomeTaxBase)</td>
                                <td>@FormatMoney(monthResult?.CalculatedIncomeTax)</td>
                                <td>@FormatMoney(monthResult?.IncomeTaxExemption)</td>
                                <td>@FormatMoney(monthResult?.PayableIncomeTax)</td>
                                <td>@FormatMoney(monthResult?.CalculatedStampTax)</td>
                                <td>@FormatMoney(monthResult?.StampTaxExemption)</td>
                                <td>@FormatMoney(monthResult?.PayableStampTax)</td>
                                @if (model.HasMandatoryBes)
                                {
                                    <td>@FormatMoney(monthResult?.BesAmount)</td>
                                }
                                <td>@FormatMoney(monthResult?.TotalDeductions)</td>
                                <td>@FormatMoney(monthResult?.NetSalary)</td>
                                @if (HasYolYemek)
                                {
                                    <td>@FormatMoney(monthResult?.CardPaidBenefits)</td>
                                }
                                @if (model.IncludeEmployerCost)
                                {
                                    <td>@FormatMoney(monthResult?.SgkEmployerGross)</td>
                                    @if (HasIncentive)
                                    {
                                        <td>@FormatMoney(monthResult?.SgkEmployerIncentive)</td>
                                    }
                                    <td>@FormatMoney(monthResult?.SgkEmployerNet)</td>
                                    <td>@FormatMoney(monthResult?.UnemploymentEmployerAmount)</td>
                                    @if (HasSupport)
                                    {
                                        <td>@FormatMoney(monthResult?.EmployerSupportAmount)</td>
                                    }
                                    <td>@FormatMoney(monthResult?.TotalEmployerCost)</td>
                                }
                            </tr>
                        }

                        <tr class="total-row">
                            <td colspan="2">Toplam</td>
                            <td>@FormatMoney(result?.Totals?.TotalGrossSalary)</td>
                            @if (HasYolYemek)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalMealAmount)</td>
                                <td>@FormatMoney(result?.Totals?.TotalTransportAmount)</td>
                                <td>@FormatMoney(result?.Totals?.TotalSgkTaxableBenefits)</td>
                                <td>@FormatMoney(result?.Totals?.TotalIncomeTaxableBenefits)</td>
                            }
                            <td>@FormatMoney(result?.Totals?.TotalSgkEmployeeAmount)</td>
                            <td>@FormatMoney(result?.Totals?.TotalUnemploymentEmployeeAmount)</td>
                            @if (HasEmployeeSgkIncentive)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalEmployeeSgkIncentive)</td>
                            }
                            @if (model.DisabilityType > 0)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalDisabilityExemptionAmount)</td>
                            }
                            <td>@FormatMoney(result?.Totals?.TotalIncomeTaxBase)</td>
                            <td>@FormatMoney(result?.Totals?.TotalIncomeTaxBase)</td>
                            <td>@FormatMoney(result?.Totals?.TotalCalculatedIncomeTax)</td>
                            <td>@FormatMoney(result?.Totals?.TotalIncomeTaxExemption)</td>
                            <td>@FormatMoney(result?.Totals?.TotalPayableIncomeTax)</td>
                            <td>@FormatMoney(result?.Totals?.TotalCalculatedStampTax)</td>
                            <td>@FormatMoney(result?.Totals?.TotalStampTaxExemption)</td>
                            <td>@FormatMoney(result?.Totals?.TotalPayableStampTax)</td>
                            @if (model.HasMandatoryBes)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalBesAmount)</td>
                            }
                            <td>@FormatMoney(result?.Totals?.TotalDeductions)</td>
                            <td>@FormatMoney(result?.Totals?.TotalNetSalary)</td>
                            @if (HasYolYemek)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalCardPaidBenefits)</td>
                            }
                            @if (model.IncludeEmployerCost)
                            {
                                <td>@FormatMoney(result?.Totals?.TotalSgkEmployerGross)</td>
                                @if (HasIncentive)
                                {
                                    <td>@FormatMoney(result?.Totals?.TotalSgkEmployerIncentive)</td>
                                }
                                <td>@FormatMoney(result?.Totals?.TotalSgkEmployerNet)</td>
                                <td>@FormatMoney(result?.Totals?.TotalUnemploymentEmployerAmount)</td>
                                @if (HasSupport)
                                {
                                    <td>@FormatMoney(result?.Totals?.TotalEmployerSupportAmount)</td>
                                }
                                <td>@FormatMoney(result?.Totals?.TotalEmployerCost)</td>
                            }
                        </tr>
                    </tbody>
                </table>
            }
            else
            {
                <table class="payroll-table">
                    <thead>
                        <tr>
                            <th>Aylar</th>
                            <th>Tutar</th>
                            <th>Brüt<br />Huzur Hakkı</th>
                            <th>Gelir V.<br />Matrahı</th>
                            <th>Kümülatif<br />Matrah</th>
                            <th>Gelir<br />Vergisi</th>
                            <th>İstisna<br />Gelir V.</th>
                            <th>Ödenecek<br />Gelir Ver.</th>
                            <th>Damga<br />Vergisi</th>
                            <th>İstisna<br />D.V.</th>
                            <th>Ödenecek<br />Damga V.</th>
                            <th>Kesintiler<br />Toplamı</th>
                            <th>Vergi<br />Yükü</th>
                            <th>Net<br />Huzur Hakkı</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < monthInputs.Count; i++)
                        {
                            var input = monthInputs[i];
                            var monthResult = GetHonorariumMonthResult(input.Month);

                            <tr>
                                <td>@input.MonthName</td>

                                <td class="input-cell">
                                    <div class="input-wrap">
                                        <RadzenNumeric TValue="decimal"
                                                       Value="input.Amount"
                                                       Style="width:100%;"
                                                       Format="N2"
                                                       Change="@(args => OnAmountChangedAsync(input, args))" />
                                    </div>
                                </td>

                                <td>@FormatMoney(monthResult?.GrossHonorarium)</td>
                                <td>@FormatMoney(monthResult?.IncomeTaxBase)</td>
                                <td>@FormatMoney(monthResult?.CumulativeIncomeTaxBase)</td>
                                <td>@FormatMoney(monthResult?.CalculatedIncomeTax)</td>
                                <td>@FormatMoney(monthResult?.IncomeTaxExemption)</td>
                                <td>@FormatMoney(monthResult?.PayableIncomeTax)</td>
                                <td>@FormatMoney(monthResult?.CalculatedStampTax)</td>
                                <td>@FormatMoney(monthResult?.StampTaxExemption)</td>
                                <td>@FormatMoney(monthResult?.PayableStampTax)</td>
                                <td>@FormatMoney(monthResult?.TotalDeductions)</td>
                                <td>@FormatPercent(monthResult?.TaxBurdenRate)</td>
                                <td>@FormatMoney(monthResult?.NetHonorarium)</td>
                            </tr>
                        }

                        <tr class="total-row">
                            <td colspan="2">Toplam</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalGrossHonorarium)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalIncomeTaxBase)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalIncomeTaxBase)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalCalculatedIncomeTax)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalIncomeTaxExemption)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalPayableIncomeTax)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalCalculatedStampTax)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalStampTaxExemption)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalPayableStampTax)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalDeductions)</td>
                            <td>@FormatPercent(result?.HonorariumTotals?.AverageTaxBurdenRate)</td>
                            <td>@FormatMoney(result?.HonorariumTotals?.TotalNetHonorarium)</td>
                        </tr>
                    </tbody>

                </table>
            }
        </div>

        <div class="payroll-actions">
            <div class="payroll-disclaimer">
                <p>@PayrollDisclaimerTexts.FreeServiceNote</p>
                <p>@PayrollDisclaimerTexts.Disclaimer</p>
            </div>

            <div class="payroll-buttons">
                <RadzenButton Text="Excel İndir"
                              Icon="download"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Success"
                              Disabled="@isExporting"
                              Click="@ExportExcelAsync" />
                <RadzenButton Text="PDF İndir"
                              Icon="picture_as_pdf"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@isExporting"
                              Click="@ExportPdfAsync" />

                <RadzenButton Text="Hesapla"
                              Icon="calculate"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@TriggerRecalculateAsync" />
            </div>
        </div>


        @if (isLoading)
        {
            <div class="status-text">Hesaplanıyor...</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="error-box">@errorMessage</div>
        }

        @if (result?.Warnings is { Count: > 0 } uyarilar)
        {
            <div class="warning-box">
                @foreach (var uyari in uyarilar)
                {
                    <div>@uyari</div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// true: girişsiz açık sayfa — bütün çağrılar açık uçlardan (token'sız) gider.
    /// Varsayılan false — uygulama içi. Görünen işlevler iki modda aynı.
    /// </summary>
    [Parameter] public bool AcikErisim { get; set; }

    /// <summary>
    /// Bütün sunucu çağrılarının gittiği kapı (hesap, dosya, karşılaştırma).
    /// Karşılaştırma penceresine de bu geçirilir.
    /// </summary>
    private IPayrollHesapApi HesapApi => AcikErisim ? PayrollAcikApiService : PayrollApiService;

    private readonly PayrollPageModel model = new();
    private List<PayrollMonthInputModel> monthInputs = new();
    private CalculatePayrollResponse? result;
    private bool isLoading;
    private bool isExporting;
    private string? errorMessage;
    private CancellationTokenSource? debounceCts;
    private List<PayrollLawTypeDto> lawTypes = new();
    private bool IsHonorarium => model.EmployeeType == 3;
    private PayrollLawTypeDto? SelectedLaw => lawTypes.FirstOrDefault(x => x.Code == model.LawCode);
    // Ayrı satır destekte (Turizm, İSG) SGK teşvik kolonu yerine destek kolonu görünür.
    private bool HasSupport => SelectedLaw?.AyriSatirDestek == true;
    private bool HasIncentive => model.LawCode != "00000" && !HasSupport;
    private bool HasEmployeeSgkIncentive => result?.Months?.Any(x => x.EmployeeSgkIncentive != 0) == true;
    // Yol / yemek yalnız 2026+ ücret bordrosunda; sütunlar hesaplanan sonuca göre.
    private const int YolYemekIlkYil = 2026;
    private bool YolYemekKullanilabilir => !IsHonorarium && model.Year >= YolYemekIlkYil;
    private bool YolYemekUygulanir => YolYemekKullanilabilir && model.YolYemekAcik;
    private bool HasYolYemek => result?.YolYemekDahil == true;
    private string SupportLabel =>
        result?.Months?.FirstOrDefault(x => x.EmployerSupportSource != null)?.EmployerSupportSource ?? "Destek";
    private string IncentiveLabel =>
        result?.Months?.FirstOrDefault(x => x.IncentiveSource != null)?.IncentiveSource is string src
            ? $"SGK Teşvik ({src})"
            : "SGK Teşvik";
