@using Radzen
@using WebApp.Application.Services.Interfaces
@using WebApp.Cards
@using WebApp.Infrastructure
@using Blazored.LocalStorage
@using WebApp.Domain.Models.User

@inject DialogService DialogService
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject AppStateManager AppState
@inject IIdentityService IdentityService

<RadzenDialogStyle Width="1120px" />

<div class="firm-dialog">
  <div class="pill-wrap">
    <div class="pill-bg">

      <!-- Orta beyaz kart -->
      <div class="firm-card">
                <RadzenCard class="rz-p-4 rz-background-color-primary-lighter"
                            Variant="Variant.Outlined">
                    <RadzenCarousel @ref="carousel"
                                    PagerOverlay="false"
                                    Interval="@interval"
                                    ButtonShade="Shade.Default"
                                    Style="height:500px"
                                    Auto="@auto">

                        <Items>
                            @foreach (var f in Firms ?? Enumerable.Empty<FirmaDto>())
                            {

                                <RadzenCarouselItem>
                                    <RadzenCard class="shadow rz-w-75">
                                        <FirmCardPage Firm="@f"
                                                      ShowClose="false"
                                                      ShowContinue="true"
                                                      OnContinue="Continue" />
                                    </RadzenCard>
                                </RadzenCarouselItem>
                            }
                        </Items>
                    </RadzenCarousel>
                </RadzenCard>
      </div>
    </div>
  </div>
</div>

@code {
    RadzenCarousel? carousel;
    bool auto = false;
    double interval = 4000;
    int selectedIndex;

    [Parameter] public List<FirmaDto>? Firms { get; set; }

    private async Task Continue(FirmaDto firm)
    {
        if (firm is null) return;

        var selectRes = await IdentityService.SelectTenant(firm.FirmaNo);
        await IdentityService.StoreTokens(selectRes.Token, selectRes.RefreshToken);
        AppState.SetSelectedFirm(firm.FirmaNo, firm.Ad);
        // AppState.SelectedFirmId = firm.FirmaNo;
        // AppState.SelectedFirmName = firm.Ad;
        // AppState.FirmChanged(this);

        await LocalStorage.SetItemAsync("SelectedFirmId", firm.FirmaNo);
        await LocalStorage.SetItemAsync("SelectedFirmName", firm.Ad);

        DialogService.Close(true);
        Nav.NavigateTo("/calendarpage");
    }
    }