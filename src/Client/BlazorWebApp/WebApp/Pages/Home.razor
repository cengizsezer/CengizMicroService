@page "/home"
@using Microsoft.AspNetCore.Authorization
@using WebApp.Domain.Models
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6" SizeLG="6">
            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                <RadzenStack Style="height: 100%;" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.H6">Toplam Masraf</RadzenText>
                        <RadzenText TextStyle="TextStyle.H2" class="rz-m-0">@expenses.Count()</RadzenText>
                    </RadzenStack>
                    <RadzenChart Style="width: 100%; height: 300px;">
                        <RadzenAreaSeries Data="@expensesByDate.Where(e => !e.IsRead)" ValueProperty="Count" CategoryProperty="Date" Title="Okunmamış" Stroke="var(--rz-danger)" Fill="var(--rz-danger-lighter)">
                            <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                        </RadzenAreaSeries>
                        <RadzenAreaSeries Data="@expensesByDate.Where(e => e.IsRead)" ValueProperty="Count" CategoryProperty="Date" Title="Okunmuş" Stroke="var(--rz-success)" Fill="var(--rz-success-lighter)">
                            <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                        </RadzenAreaSeries>
                        <RadzenValueAxis>
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenCategoryAxis Padding="20" Formatter="@(d => ((DateTime)d).ToString("MMM dd"))" />
                    </RadzenChart>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3" SizeXL="2">
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText TextStyle="TextStyle.H6">Okunmamış Masraflar</RadzenText>
                                <RadzenText TextStyle="TextStyle.H2" class="rz-color-danger rz-m-0">@unreadExpenses.Count()</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText TextStyle="TextStyle.H6">Okunmuş Masraflar</RadzenText>
                                <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">@readExpenses.Count()</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3" SizeXL="2">
            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Kategori Bazlı Masraf Dağılımı</RadzenText>
                <RadzenChart Style="height: 200px; width: 100%;">
                    <RadzenDonutSeries Data="@categoryGroups" CategoryProperty="Category" ValueProperty="Total" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12">
            <RadzenDateRangePicker 
                Value="@dateRange"
                ValueChanged="@((DateRange range) => dateRange = range)"
                ValueExpression="@(() => dateRange)"
                StartText="Başlangıç" 
                EndText="Bitiş" 
                Change="OnDateRangeChanged" 
                Style="margin-bottom: 1rem;" />

            <RadzenDataGrid Data="@filteredExpenses" TItem="Expense" Style="height: 500px" AllowFiltering="true" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn Property="Title" Title="Başlık" />
                    <RadzenDataGridColumn Property="Amount" Title="Tutar (₺)" />
                    <RadzenDataGridColumn Property="Category" Title="Kategori" />
                    <RadzenDataGridColumn Property="CreatedAt" Title="Tarih" FormatString="{0:dd.MM.yyyy}" />
                    <RadzenDataGridColumn Title="Durum">
                        <Template Context="expense">
                            @if (!expense.IsRead)
                            {
                                <RadzenBadge Text="Okunmadı" BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge Text="Okundu" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="İşlem">
                        <Template Context="expense">
                            <RadzenButton Icon="info" Size="ButtonSize.Small" Text="Detay" Click="() => ShowDetails(expense)" Style="margin-right: 6px;" />
                            @if (!expense.IsRead)
                            {
                                <RadzenButton Icon="check" Size="ButtonSize.Small" Text="Okundu" Click="() => MarkAsRead(expense)" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

<RadzenDialog />

@code {
    public class Expense
    {
        public string Title { get; set; }
        public decimal Amount { get; set; }
        public string Category { get; set; }
        public DateTime CreatedAt { get; set; }
        public bool IsRead { get; set; }
    }

    public class ExpenseSummary
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
        public bool IsRead { get; set; }
    }

    public class CategoryGroup
    {
        public string Category { get; set; }
        public decimal Total { get; set; }
    }

    public class DateRange
    {
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
    }

    List<Expense> expenses = new();
    List<Expense> readExpenses => expenses.Where(e => e.IsRead).ToList();
    List<Expense> unreadExpenses => expenses.Where(e => !e.IsRead).ToList();

    DateRange dateRange = new();
    DateTime? startDate => dateRange?.Start;
    DateTime? endDate => dateRange?.End;

    List<Expense> filteredExpenses => expenses
        .Where(e => (!startDate.HasValue || e.CreatedAt.Date >= startDate.Value.Date) && (!endDate.HasValue || e.CreatedAt.Date <= endDate.Value.Date))
        .ToList();

    IEnumerable<ExpenseSummary> expensesByDate;
    IEnumerable<CategoryGroup> categoryGroups;

    void MarkAsRead(Expense expense)
    {
        expense.IsRead = true;
    }

    async Task ShowDetails(Expense expense)
    {
        await DialogService.OpenAsync("Masraf Detayı", ds => @<div class="rz-p-4">
            <p><b>Başlık:</b> @expense.Title</p>
            <p><b>Kategori:</b> @expense.Category</p>
            <p><b>Tutar:</b> ₺@expense.Amount</p>
            <p><b>Tarih:</b> @expense.CreatedAt.ToString("dd.MM.yyyy")</p>
            <p><b>Durum:</b> @(expense.IsRead ? "Okundu" : "Okunmadı")</p>
        </div>, new DialogOptions { Width = "400px", Height = "350px" });
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);

        var now = DateTime.Now;
        expenses = new List<Expense>
        {
            new Expense { Title = "Yemek Fişi", Amount = 124.50m, Category = "Yemek", CreatedAt = now.AddDays(-1), IsRead = false },
            new Expense { Title = "Taksi Ücreti", Amount = 75m, Category = "Ulaşım", CreatedAt = now.AddDays(-2), IsRead = true },
            new Expense { Title = "Ofis Kırtasiye", Amount = 340m, Category = "Ofis", CreatedAt = now.AddDays(-3), IsRead = false },
            new Expense { Title = "Fatura Gideri", Amount = 980m, Category = "Fatura", CreatedAt = now.AddDays(-4), IsRead = true },
            new Expense { Title = "Yemek", Amount = 60m, Category = "Yemek", CreatedAt = now.AddDays(-5), IsRead = false },
            new Expense { Title = "Metro Kartı", Amount = 200m, Category = "Ulaşım", CreatedAt = now.AddDays(-6), IsRead = true },
            new Expense { Title = "Temizlik Malzemesi", Amount = 185m, Category = "Ofis", CreatedAt = now.AddDays(-7), IsRead = false },
            new Expense { Title = "Elektrik Faturası", Amount = 800m, Category = "Fatura", CreatedAt = now.AddDays(-8), IsRead = true },
            new Expense { Title = "Kırtasiye", Amount = 155m, Category = "Ofis", CreatedAt = now.AddDays(-9), IsRead = true },
            new Expense { Title = "Yemek Kartı", Amount = 250m, Category = "Yemek", CreatedAt = now.AddDays(-10), IsRead = false }
        };

        expensesByDate = expenses
            .GroupBy(e => new { Date = e.CreatedAt.Date, e.IsRead })
            .Select(g => new ExpenseSummary { Date = g.Key.Date, IsRead = g.Key.IsRead, Count = g.Count() })
            .OrderBy(e => e.Date);

        categoryGroups = expenses
            .GroupBy(e => e.Category)
            .Select(g => new CategoryGroup { Category = g.Key, Total = g.Sum(e => e.Amount) })
            .OrderByDescending(g => g.Total);
    }

    void OnDateRangeChanged(object value)
    {
        StateHasChanged();
    }

    [Inject] DialogService DialogService { get; set; }
}
