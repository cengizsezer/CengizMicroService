@* Iskelet aşamasında her tabın içeriği bu placeholder ile gösterilir.
   Adım 7-10'da yerini gerçek tab içerikleri alacak. *@

<RadzenCard class="rz-mb-3 rz-p-4">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.6rem">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@Title</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@Description</RadzenText>
    </RadzenStack>
</RadzenCard>

<RadzenCard class="rz-p-4" Style="border: 1px dashed var(--rz-border-light); background: var(--rz-base-50);">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="info" />
        <span>@InfoMesaj</span>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string InfoMesaj { get; set; } = "İçerik buraya gelecek.";
}
