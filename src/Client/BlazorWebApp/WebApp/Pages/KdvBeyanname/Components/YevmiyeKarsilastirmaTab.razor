@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.KdvBeyanname
@using WebApp.Domain.Models.KdvBeyanname
@inject IKdvBeyannameApiService KdvApi
@inject NotificationService Notif
@inject DialogService DialogService

<RadzenCard class="rz-mb-3 rz-p-4">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">

            <RadzenIcon Icon="rule" Style="font-size:1.5rem;" />
            <div>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Yevmiye Karşılaştırma</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    Dönem: <strong>@Donem</strong>
                </RadzenText>
            </div>

            <div style="flex:1;"></div>

            <label class="rz-button rz-button-md rz-variant-flat rz-shade-default" style="cursor: pointer;">
                <RadzenIcon Icon="upload_file" class="rz-mr-1" />
                @(uploading ? "Yükleniyor..." : "Excel Yükle")
                <InputFile OnChange="OnFileSelected"
                           accept=".xlsx,.xls"
                           disabled="@uploading"
                           style="display:none;" />
            </label>

            <RadzenButton Icon="refresh"
                          Text="Yenile"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Disabled="@(loading || uploading)"
                          Click="@LoadAsync" />
        </RadzenStack>

        @if (uploading)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <span>Yevmiye dosyası parse ediliyor...</span>
            </RadzenStack>
        }

        @if (sonHataMesaji is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger"
                         Shade="Shade.Light"
                         AllowClose="true"
                         Close="@(() => sonHataMesaji = null)"
                         Icon="error">
                @sonHataMesaji
            </RadzenAlert>
        }

        @if (sonUploadOzeti is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success"
                         Shade="Shade.Light"
                         AllowClose="true"
                         Close="@(() => sonUploadOzeti = null)"
                         Icon="check_circle">
                <strong>@sonUploadOzeti.KaydedilenSatir</strong> yevmiye satırı kaydedildi
                (okunan: @sonUploadOzeti.OkunanSatir, atlanan: @sonUploadOzeti.AtlananSatir).
            </RadzenAlert>
        }

        @* ── Yükleme sonrası başlık eşleşmedi: BULUNAN vs BEKLENEN ───────── *@
        @if (baslikHatasi is not null)
        {
            <RadzenCard class="rz-p-3" Style="border:1px solid var(--rz-danger); background: var(--rz-danger-lighter);">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="color: var(--rz-danger);">
                        <RadzenIcon Icon="error" class="rz-mr-1" />Sütun başlıkları eşleşmedi
                    </RadzenText>

                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                            Excel'de bulunan başlıklar:
                        </RadzenText>
                        @if (baslikHatasi.BulunanBasliklar.Count == 0)
                        {
                            <em>(başlık satırı boş görünüyor)</em>
                        }
                        else
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                @foreach (var b in baslikHatasi.BulunanBasliklar)
                                {
                                    <RadzenBadge Text="@b" BadgeStyle="BadgeStyle.Light" />
                                }
                            </RadzenStack>
                        }
                    </div>

                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                            Beklenen kolonlar (<span style="color: var(--rz-danger);">kırmızı</span> = eksik/eşleşmedi):
                        </RadzenText>
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                            @foreach (var k in baslikHatasi.BeklenenKolonlar)
                            {
                                var eksik = k.Zorunlu && !k.Bulundu;
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                    <RadzenIcon Icon="@(k.Bulundu ? "check_circle" : (k.Zorunlu ? "cancel" : "remove"))"
                                                Style="@($"font-size:1rem; color: {(k.Bulundu ? "var(--rz-success)" : (k.Zorunlu ? "var(--rz-danger)" : "var(--rz-text-secondary)"))};")" />
                                    <span style="@(eksik ? "color: var(--rz-danger); font-weight:600;" : "")">
                                        @k.Ad
                                    </span>
                                    <RadzenBadge Text="@(k.Zorunlu ? "Zorunlu" : "Opsiyonel")"
                                                 BadgeStyle="@(k.Zorunlu ? BadgeStyle.Danger : BadgeStyle.Light)" />
                                    @if (k.Alternatifler.Count > 1)
                                    {
                                        <span class="rz-color-secondary" style="font-size:0.8rem;">
                                            kabul edilen: @string.Join(" / ", k.Alternatifler)
                                        </span>
                                    }
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </div>
                </RadzenStack>
            </RadzenCard>
        }

        @* ── Beklenen sütun başlıkları paneli (her zaman, tek kaynaktan) ──── *@
        @if (beklenenBasliklar.Count > 0)
        {
            <RadzenFieldset AllowCollapse="true" Collapsed="@beklenenPanelCollapsed"
                            Style="border-color: var(--rz-border-light);">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="view_column" />
                        <strong>Beklenen Sütun Başlıkları</strong>
                        <span class="rz-color-secondary" style="font-size:0.85rem;">
                            — Excel'in başlık satırında bu kolonlar aranır.
                        </span>
                    </RadzenStack>
                </HeaderTemplate>
                <ChildContent>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                        <div>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                                Zorunlu (yoksa dosya yüklenmez):
                            </RadzenText>
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                @foreach (var k in beklenenBasliklar.Where(k => k.Zorunlu))
                                {
                                    <div>
                                        <RadzenBadge Text="@k.Ad" BadgeStyle="BadgeStyle.Danger" />
                                        @if (k.Alternatifler.Count > 1)
                                        {
                                            <span class="rz-color-secondary" style="font-size:0.8rem;">
                                                &nbsp;kabul edilen yazımlar: @string.Join(" / ", k.Alternatifler)
                                            </span>
                                        }
                                    </div>
                                }
                            </RadzenStack>
                        </div>

                        <div>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-1">
                                Opsiyonel (yoksa ilgili alan boş kalır):
                            </RadzenText>
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                @foreach (var k in beklenenBasliklar.Where(k => !k.Zorunlu))
                                {
                                    <div>
                                        <RadzenBadge Text="@k.Ad" BadgeStyle="BadgeStyle.Light" />
                                        @if (k.Alternatifler.Count > 1)
                                        {
                                            <span class="rz-color-secondary" style="font-size:0.8rem;">
                                                &nbsp;kabul edilen yazımlar: @string.Join(" / ", k.Alternatifler)
                                            </span>
                                        }
                                    </div>
                                }
                            </RadzenStack>
                        </div>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Light"
                                     AllowClose="false" Icon="info" class="rz-m-0">
                            Başlıklar büyük/küçük harf duyarsız; baştaki/sondaki boşluk önemsiz.
                            Ancak içerideki fazla boşluk, sondaki nokta veya
                            <strong>"Borç Tutarı"</strong> gibi ek harf eşleşmeyi bozabilir.
                        </RadzenAlert>
                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>
        }
    </RadzenStack>
</RadzenCard>

@if (loading)
{
    <RadzenCard class="rz-p-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>Karşılaştırma yükleniyor...</span>
        </RadzenStack>
    </RadzenCard>
}
else if (sonuc is null || sonuc.YevmiyeFaturaNoSayisi == 0)
{
    <RadzenCard class="rz-p-4" Style="border: 1px dashed var(--rz-border-light); background: var(--rz-base-50);">
        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="upload_file" Style="font-size:3rem; color: var(--rz-text-secondary);" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Yevmiye Excel'i yükleyin</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Karşılaştırma için <strong>@Donem</strong> dönemine ait yevmiye dosyasını yükleyin.
                <br />Aynı dönem için tekrar yüklerseniz mevcut kayıtlar silinip yenisiyle değişir.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" class="rz-mb-3" Wrap="FlexWrap.Wrap">
        <RadzenCard class="rz-p-3" Style="min-width: 180px;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="inventory_2" Style="color: var(--rz-info);" />
                <div>
                    <div class="rz-color-secondary" style="font-size: 0.85rem;">Sistemdeki Fatura</div>
                    <div style="font-size: 1.4rem; font-weight: 600;">@sonuc.GelenFaturaSayisi</div>
                </div>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="rz-p-3" Style="min-width: 180px;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="receipt_long" Style="color: var(--rz-info);" />
                <div>
                    <div class="rz-color-secondary" style="font-size: 0.85rem;">Yevmiyedeki Fatura</div>
                    <div style="font-size: 1.4rem; font-weight: 600;">@sonuc.YevmiyeFaturaNoSayisi</div>
                </div>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="rz-p-3" Style="min-width: 180px; background: var(--rz-danger-lighter);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="report_problem" Style="color: var(--rz-danger);" />
                <div>
                    <div class="rz-color-secondary" style="font-size: 0.85rem;">İşlenmemiş</div>
                    <div style="font-size: 1.4rem; font-weight: 600; color: var(--rz-danger);">@sonuc.Islenmemis.Count</div>
                </div>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="rz-p-3" Style="min-width: 180px;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                <div>
                    <div class="rz-color-secondary" style="font-size: 0.85rem;">Eşleşen</div>
                    <div style="font-size: 1.4rem; font-weight: 600; color: var(--rz-success);">@sonuc.Eslesen.Count</div>
                </div>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="rz-p-3" Style="min-width: 180px;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="help_outline" Style="color: var(--rz-warning);" />
                <div>
                    <div class="rz-color-secondary" style="font-size: 0.85rem;">Fazla (sadece yevmiyede)</div>
                    <div style="font-size: 1.4rem; font-weight: 600; color: var(--rz-warning);">@sonuc.Fazla.Count</div>
                </div>
            </RadzenStack>
        </RadzenCard>
        @if (sonuc.ReddedilenSayisi > 0)
        {
            <RadzenCard class="rz-p-3" Style="min-width: 180px; background: var(--rz-info-lighter);" title="DP'de 'FATURA RED' statüsündeki faturalar karşılaştırmadan elenir.">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="filter_alt_off" Style="color: var(--rz-info);" />
                    <div>
                        <div class="rz-color-secondary" style="font-size: 0.85rem;">Filtrelenmiş (Reddedildi)</div>
                        <div style="font-size: 1.4rem; font-weight: 600; color: var(--rz-info);">@sonuc.ReddedilenSayisi adet</div>
                    </div>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>

    @* ── ISLENMEMIS: kritik liste, en üstte, kırmızı tema ─── *@
    <RadzenFieldset class="rz-mb-3" Style="border-color: var(--rz-danger);">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="report_problem" Style="color: var(--rz-danger);" />
                <strong>İşlenmemiş Faturalar</strong>
                <RadzenBadge Text="@sonuc.Islenmemis.Count.ToString()"
                             BadgeStyle="BadgeStyle.Danger" />
                <span class="rz-color-secondary" style="font-size: 0.85rem;">
                    — Sistemde var, yevmiyede yok. Bu faturalar muhasebeye işlenmemiş demektir.
                </span>
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            @if (sonuc.Islenmemis.Count == 0)
            {
                <em>Tüm sistem faturaları yevmiyede karşılığını bulmuş — tebrikler.</em>
            }
            else
            {
                <RadzenDataGrid Data="@sonuc.Islenmemis"
                                TItem="KdvKarsilastirmaSatiri"
                                AllowPaging="true"
                                PageSize="15"
                                AllowSorting="true"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Simple"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn Property="FaturaNo" Title="Fatura No" Width="180px" />
                        <RadzenDataGridColumn Property="FaturaTarihi" Title="Tarih" Width="110px" FormatString="{0:dd.MM.yyyy}" />
                        <RadzenDataGridColumn Property="GondericiVkn" Title="Gönderici VKN" Width="130px" />
                        <RadzenDataGridColumn Property="GondericiUnvan" Title="Gönderici Ünvan" />
                        <RadzenDataGridColumn Property="KdvTutari" Title="KDV" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="row">@FormatPara(row.KdvTutari)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="ToplamTutar" Title="Toplam" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@FormatPara(row.ToplamTutar)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="KdvKarsilastirmaSatiri" Title="PDF" Width="80px"
                                              Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                <RadzenButton Icon="picture_as_pdf"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.Small"
                                              IsBusy="@(pdfBusyFaturaNo == row.FaturaNo)"
                                              BusyText=""
                                              Disabled="@pdfBusy"
                                              title="Faturanın PDF'ini Sovos'tan getir"
                                              Click="@(() => OnPdfClick(row))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </ChildContent>
    </RadzenFieldset>

    @* ── ESLESEN ─────────────────────────────────────────── *@
    <RadzenFieldset class="rz-mb-3" AllowCollapse="true" Collapsed="@eslesenCollapsed">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                <strong>Eşleşen Faturalar</strong>
                <RadzenBadge Text="@sonuc.Eslesen.Count.ToString()"
                             BadgeStyle="BadgeStyle.Success" />
                <span class="rz-color-secondary" style="font-size: 0.85rem;">
                    — Sistemde de var, yevmiyede de var.
                </span>
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            @if (sonuc.Eslesen.Count == 0)
            {
                <em>Eşleşen fatura yok.</em>
            }
            else
            {
                <RadzenDataGrid Data="@sonuc.Eslesen"
                                TItem="KdvKarsilastirmaSatiri"
                                AllowPaging="true"
                                PageSize="15"
                                AllowSorting="true"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Simple"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn Property="FaturaNo" Title="Fatura No" Width="180px" />
                        <RadzenDataGridColumn Property="FaturaTarihi" Title="Tarih" Width="110px" FormatString="{0:dd.MM.yyyy}" />
                        <RadzenDataGridColumn Property="GondericiUnvan" Title="Gönderici Ünvan" />
                        <RadzenDataGridColumn Property="ToplamTutar" Title="Toplam" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@FormatPara(row.ToplamTutar)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="YevmiyeHesapKodu" Title="Yev. Hesap" Width="130px" />
                        <RadzenDataGridColumn Property="YevmiyeAciklamasi" Title="Yev. Açıklama" />
                    </Columns>
                </RadzenDataGrid>
            }
        </ChildContent>
    </RadzenFieldset>

    @* ── FAZLA ───────────────────────────────────────────── *@
    <RadzenFieldset class="rz-mb-3" AllowCollapse="true" Collapsed="@fazlaCollapsed">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="help_outline" Style="color: var(--rz-warning);" />
                <strong>Fazla — Yevmiyede Var, Sistemde Yok</strong>
                <RadzenBadge Text="@sonuc.Fazla.Count.ToString()"
                             BadgeStyle="BadgeStyle.Warning" />
                <span class="rz-color-secondary" style="font-size: 0.85rem;">
                    — Manuel girilmiş veya geç gelmiş e-fatura olabilir.
                </span>
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            @if (sonuc.Fazla.Count == 0)
            {
                <em>Yevmiyede fazladan fatura yok.</em>
            }
            else
            {
                <RadzenDataGrid Data="@sonuc.Fazla"
                                TItem="KdvKarsilastirmaSatiri"
                                AllowPaging="true"
                                PageSize="15"
                                AllowSorting="true"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Simple"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn Property="FaturaNo" Title="Fatura No" Width="200px" />
                        <RadzenDataGridColumn Property="YevmiyeHesapKodu" Title="Yev. Hesap" Width="130px" />
                        <RadzenDataGridColumn Property="YevmiyeAciklamasi" Title="Yev. Açıklama" />
                    </Columns>
                </RadzenDataGrid>
            }
        </ChildContent>
    </RadzenFieldset>
}

@code {
    [Parameter, EditorRequired] public int FirmaId { get; set; }
    [Parameter, EditorRequired] public string Donem { get; set; } = string.Empty;
    [Parameter] public EventCallback<int> OnYevmiyeSayisiChanged { get; set; }

    private static readonly CultureInfo TrCulture = new("tr-TR");

    private KdvKarsilastirmaSonucu? sonuc;
    private YevmiyeUploadResult? sonUploadOzeti;

    private bool loading = true;
    private bool uploading;
    private string? sonHataMesaji;

    // Beklenen sütun başlıkları — backend tek kaynağından (KdvYevmiyeColumns).
    private List<BeklenenKolon> beklenenBasliklar = new();
    private bool beklenenPanelCollapsed = true;

    // Yükleme sonrası başlık eşleşmedi → bulunan vs beklenen karşılaştırması.
    private YevmiyeBaslikHatasi? baslikHatasi;

    private bool eslesenCollapsed = true;   // Eşleşen geniş listesi — default kapalı
    private bool fazlaCollapsed = false;

    // Tek fatura PDF çekimi — aynı anda tek çekim (aynı DP oturumu çakışmasın).
    private bool pdfBusy;
    private string? pdfBusyFaturaNo;

    private int previousFirmaId;
    private string previousDonem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            beklenenBasliklar = await KdvApi.GetYevmiyeBeklenenBasliklarAsync();
        }
        catch
        {
            // Panel bilgi amaçlı; yüklenemezse sessizce boş kalsın.
            beklenenBasliklar = new();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (previousFirmaId == FirmaId && previousDonem == Donem) return;
        previousFirmaId = FirmaId;
        previousDonem = Donem;

        sonHataMesaji = null;
        sonUploadOzeti = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(Donem)) return;

        loading = true;
        StateHasChanged();
        try
        {
            // Dönem için yüklü yevmiye var mı? Sayım üzerinden anlaşılır.
            var yevmiye = await KdvApi.GetYevmiyeAsync(FirmaId, Donem);
            var sayim = yevmiye.Count;

            if (OnYevmiyeSayisiChanged.HasDelegate)
                await OnYevmiyeSayisiChanged.InvokeAsync(sayim);

            if (sayim == 0)
            {
                // Yüklü yevmiye yok → boş state, karşılaştırma çağrısı yapma.
                sonuc = null;
                return;
            }

            // Yüklü yevmiye var → karşılaştırmayı otomatik çek.
            sonuc = await KdvApi.GetKarsilastirmaAsync(FirmaId, Donem);
        }
        catch (Exception ex)
        {
            sonuc = null;
            sonHataMesaji = $"Karşılaştırma yüklenirken hata: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        if (string.IsNullOrWhiteSpace(Donem))
        {
            sonHataMesaji = "Dönem boş. Üst panelden geçerli bir dönem (YYYY-MM) girin.";
            return;
        }

        sonHataMesaji = null;
        sonUploadOzeti = null;
        baslikHatasi = null;
        uploading = true;
        StateHasChanged();

        try
        {
            // Max 50 MB — backend de aynı sınırı uyguluyor.
            await using var stream = file.OpenReadStream(maxAllowedSize: 50_000_000);
            sonUploadOzeti = await KdvApi.UploadYevmiyeAsync(FirmaId, Donem, stream, file.Name);

            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary  = "Yevmiye yüklendi",
                Detail   = $"{sonUploadOzeti.KaydedilenSatir} satır kaydedildi.",
                Duration = 4000
            });

            // Otomatik karşılaştırma — kullanıcının ayrıca buton basmasına gerek yok.
            await LoadAsync();
        }
        catch (YevmiyeBaslikHatasiException ex)
        {
            // Zorunlu başlık eksik → bulunan vs beklenen karşılaştırmasını göster.
            baslikHatasi = ex.Detay;
            sonHataMesaji = ex.Detay.Mesaj;
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Başlık eşleşmedi",
                Detail   = "Excel'deki sütun başlıkları beklenenle uyuşmuyor. Detay panelde.",
                Duration = 6000
            });
        }
        catch (Exception ex)
        {
            sonHataMesaji = $"Yevmiye yüklenirken hata: {ex.Message}";
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "Hata",
                Detail   = sonHataMesaji,
                Duration = 6000
            });
        }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    private static string FormatPara(decimal? tutar) =>
        tutar.HasValue ? tutar.Value.ToString("N2", TrCulture) + " TL" : "—";

    // ── Tek fatura PDF: getir → presigned URL → dialog (önizleme + indir) ──
    private async Task OnPdfClick(KdvKarsilastirmaSatiri row)
    {
        if (pdfBusy || string.IsNullOrWhiteSpace(row.FaturaNo)) return;

        if (!TryParseDonem(Donem, out var yil, out var ay))
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Dönem geçersiz",
                Detail   = "PDF için geçerli bir dönem (YYYY-MM) gerekli.",
                Duration = 4000
            });
            return;
        }

        pdfBusy = true;
        pdfBusyFaturaNo = row.FaturaNo;
        Notif.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary  = "PDF getiriliyor",
            Detail   = "Sovos'tan çekiliyor... (ilk sefer 10-25 sn sürebilir)",
            Duration = 8000
        });
        StateHasChanged();

        try
        {
            var pdf = await KdvApi.GetFaturaPdfAsync(FirmaId, row.FaturaNo, yil, ay);
            var url = await KdvApi.GetFilePresignedUrlAsync(pdf.FileId);
            if (string.IsNullOrWhiteSpace(url))
            {
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary  = "Hata",
                    Detail   = "PDF önizleme adresi alınamadı.",
                    Duration = 5000
                });
                return;
            }

            await DialogService.OpenAsync<FaturaPdfDialog>(
                $"Fatura {pdf.FaturaNo}",
                new Dictionary<string, object>
                {
                    ["PresignedUrl"] = url,
                    ["FaturaNo"]     = pdf.FaturaNo,
                    ["FileName"]     = string.IsNullOrWhiteSpace(pdf.FileName)
                                         ? $"{pdf.FaturaNo}.pdf" : pdf.FileName!
                },
                new DialogOptions
                {
                    Width = "80vw",
                    Height = "85vh",
                    Resizable = true,
                    Draggable = true,
                    CloseDialogOnOverlayClick = true
                });
        }
        catch (FaturaPdfHataException ex) when (ex.StatusCode == 409)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Captcha",
                Detail   = "Sovos'ta captcha çıktı; lütfen daha sonra tekrar deneyin.",
                Duration = 6000
            });
        }
        catch (Exception) // 502/500/timeout — hepsi kullanıcıya aynı: tekrar dene
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary  = "PDF çekilemedi",
                Detail   = "Fatura PDF'i çekilemedi. Lütfen tekrar deneyin.",
                Duration = 6000
            });
        }
        finally
        {
            pdfBusy = false;
            pdfBusyFaturaNo = null;
            StateHasChanged();
        }
    }

    // "yyyy-MM" → yil, ay
    private static bool TryParseDonem(string donem, out int yil, out int ay)
    {
        yil = 0; ay = 0;
        if (string.IsNullOrWhiteSpace(donem) || donem.Length != 7 || donem[4] != '-')
            return false;
        return int.TryParse(donem.AsSpan(0, 4), out yil)
               && int.TryParse(donem.AsSpan(5, 2), out ay)
               && ay is >= 1 and <= 12;
    }
}
