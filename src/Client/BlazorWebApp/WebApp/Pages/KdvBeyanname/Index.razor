@page "/kdv-beyanname"
@using WebApp.Application.Services.KdvBeyanname
@using WebApp.Domain.Models.KdvBeyanname
@using WebApp.Pages.KdvBeyanname.Components
@inject IKdvBeyannameApiService KdvApi
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem" AlignItems="AlignItems.Stretch">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenIcon Icon="request_quote" Style="font-size:2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">KDV Beyannamesi</RadzenText>
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
        KDV beyannamesi hazırlayacağınız firmayı seçin. Beyanname için gelen
        faturalar, yevmiye ve KDV mizan birlikte değerlendirilecek.
    </RadzenText>

    @if (firmalar is null)
    {
        <RadzenCard class="rz-p-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <span>Yükleniyor...</span>
            </RadzenStack>
        </RadzenCard>
    }
    else if (firmalar.Count == 0)
    {
        <RadzenCard class="rz-p-4">
            <em>Tanımlı firma bulunamadı.</em>
        </RadzenCard>
    }
    else
    {
        <div class="fk-carousel-wrapper">
            <RadzenCarousel Auto="false"
                            PagerOverlay="false"
                            ShowNavigation="true"
                            ShowPager="true"
                            ButtonShade="Shade.Default"
                            Style="height: 560px;">
                <Items>
                    @foreach (var f in firmalar)
                    {
                        <RadzenCarouselItem>
                            <div class="fk-carousel-slide">
                                <KdvFirmaCard Firma="f" OnGiris="GoToDetay" />
                            </div>
                        </RadzenCarouselItem>
                    }
                </Items>
            </RadzenCarousel>
        </div>
    }
</RadzenStack>

@code {
    private List<KdvFirmaCardDto>? firmalar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            firmalar = await KdvApi.GetFirmalarAsync();
        }
        catch
        {
            firmalar = new();
        }
    }

    private void GoToDetay(KdvFirmaCardDto firma)
    {
        Navigation.NavigateTo($"/kdv-beyanname/{firma.Id}");
    }
}
