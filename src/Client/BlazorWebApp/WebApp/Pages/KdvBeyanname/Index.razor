@page "/kdv-beyanname"
@using WebApp.Application.Services.KdvBeyanname
@using WebApp.Domain.Models.KdvBeyanname
@using WebApp.Pages.KdvBeyanname.Components
@inject IKdvBeyannameApiService KdvApi
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem" AlignItems="AlignItems.Stretch">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenIcon Icon="request_quote" Style="font-size:2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">KDV Beyannamesi</RadzenText>
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
        KDV beyannamesi hazırlayacağınız firmayı seçin. Beyanname için gelen
        faturalar, yevmiye ve KDV mizan birlikte değerlendirilecek.
    </RadzenText>

    @if (firmalar is null)
    {
        <RadzenCard class="rz-p-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <span>Yükleniyor...</span>
            </RadzenStack>
        </RadzenCard>
    }
    else if (firmalar.Count == 0)
    {
        <RadzenCard class="rz-p-4">
            <em>Tanımlı firma bulunamadı.</em>
        </RadzenCard>
    }
    else
    {
        <RadzenDataGrid TItem="KdvFirmaCardDto"
                        Data="@firmalar"
                        AllowPaging="true" PageSize="20"
                        AllowSorting="true"
                        AllowFiltering="false"
                        RowSelect="@GoToDetay"
                        Style="cursor:pointer;">
            <Columns>
                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Property="KisaAd" Title="Kısa Ad" Width="160px" />
                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Property="Unvan" Title="Unvan" />
                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Property="VergiKimlikNo" Title="VKN" Width="150px" />

                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Title="Son Tarama" Width="170px">
                    <Template Context="f">
                        @if (f.SonTaramaAt.HasValue)
                        {
                            @f.SonTaramaAt.Value.ToString("dd.MM.yyyy HH:mm")
                        }
                        else
                        {
                            <span class="rz-text-muted">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Title="BDP" Width="160px" Sortable="false">
                    <Template Context="f">
                        @if (f.BdpAlanlariEksik)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="BDP alanları eksik" IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="BDP hazır" IsPill="true" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Title="Tarama Durumu" Width="160px" Sortable="false">
                    <Template Context="f">
                        @if (f.SonTaramaDurumu.HasValue)
                        {
                            <RadzenBadge BadgeStyle="@DurumStyle(f.SonTaramaDurumu.Value)"
                                         Text="@($"Tarama: {f.SonTaramaDurumu}")"
                                         IsPill="true" />
                        }
                        else
                        {
                            <span class="rz-text-muted">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="KdvFirmaCardDto" Title="" Width="120px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="f">
                        <span @onclick:stopPropagation @onkeydown:stopPropagation>
                            <RadzenButton Text="GİRİŞ"
                                          Icon="login"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small"
                                          Click="@(() => GoToDetay(f))" />
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private List<KdvFirmaCardDto>? firmalar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            firmalar = await KdvApi.GetFirmalarAsync();
        }
        catch
        {
            firmalar = new();
        }
    }

    private void GoToDetay(KdvFirmaCardDto firma)
    {
        Navigation.NavigateTo($"/kdv-beyanname/{firma.Id}");
    }

    private static BadgeStyle DurumStyle(KdvBeyannameTaramaDurumu d) => d switch
    {
        KdvBeyannameTaramaDurumu.Tamamlandi => BadgeStyle.Success,
        KdvBeyannameTaramaDurumu.Calisiyor  => BadgeStyle.Info,
        KdvBeyannameTaramaDurumu.Hatali     => BadgeStyle.Danger,
        _                                   => BadgeStyle.Light
    };
}
