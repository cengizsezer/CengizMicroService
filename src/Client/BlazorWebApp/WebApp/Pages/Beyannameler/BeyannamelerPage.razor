@page "/beyannameler"
@page "/beyannameler/{Slug}"

@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor

@attribute [Authorize]

@inject NavigationManager Nav

@*
    Beyannameler — alt sekmeli beyanname ekranları (Takip + Özet).

    İskelet sekmeleri BİLMEZ: şeridi de içeriği de BeyannameSekmesi.Hepsi listesinden
    üretir. Yeni sekme eklemek yeni bir Razor bileşeni + listeye bir satır demek; bu
    dosyaya dokunmak gerekmez. Kalıp Hesaplamalar sayfasından alındı (KARARLAR §79).
*@

<style>
    .by-sekmeler { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
    .by-sekme { display: inline-flex; align-items: center; gap: 6px;
                border: 1px solid #e2e8f0; border-radius: 999px; padding: 5px 16px;
                font-size: 13px; color: #4a5568; background: #fff; text-decoration: none; }
    .by-sekme:hover { background: #edf5ff; }
    .by-sekme.aktif { background: #2b6cb0; border-color: #2b6cb0; color: #fff; font-weight: 600; }
    .by-bos { padding: 26px; text-align: center; color: #a0aec0;
              border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; }
</style>

<PageTitle>@(Aktif is null ? "Beyannameler" : $"Beyannameler — {Aktif.Baslik}")</PageTitle>

<div class="by-sekmeler">
    @foreach (var sekme in BeyannameSekmesi.Hepsi)
    {
        <a class="by-sekme @(sekme == Aktif ? "aktif" : "")" href="@sekme.Yol">
            <RadzenIcon Icon="@sekme.Ikon" Style="font-size:16px" />
            @sekme.Baslik
        </a>
    }
</div>

@if (Aktif is not null)
{
    <DynamicComponent Type="@Aktif.Bilesen" />
}
else if (Slug is not null)
{
    <div class="by-bos">"@Slug" diye bir beyanname sekmesi yok. Yukarıdan bir sekme seçin.</div>
}

@code {
    /// <summary>Adresin son parçası; <c>/beyannameler</c> kökünde null.</summary>
    [Parameter] public string? Slug { get; set; }

    private BeyannameSekmesi? Aktif;

    protected override void OnParametersSet()
    {
        // Kök adres kanonik sekme adresine gider: aynı ekranın iki adresi olmasın, şerit
        // vurgusu ve yer imi tek yol üzerinden yürüsün. replace: true — geri düğmesi köke
        // dönüp sonsuz yönlendirme kurmasın.
        if (Slug is null)
        {
            Nav.NavigateTo(BeyannameSekmesi.Varsayilan.Yol, forceLoad: false, replace: true);
            return;
        }

        Aktif = BeyannameSekmesi.Bul(Slug);
    }
}
