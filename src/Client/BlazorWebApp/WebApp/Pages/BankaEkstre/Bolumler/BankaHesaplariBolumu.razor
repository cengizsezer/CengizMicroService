@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.BankaEkstre

@inject IBankaEkstreApi Api
@inject IBankaOtomasyonOturumu Oturum
@inject NotificationService Notif
@inject DialogService Dialog
@inject IJSRuntime JS

@*
    Tanımlar ekranının "Banka hesapları" bölümü — hesapların TAM CRUD'u.

    Liste aynı zamanda "banka kayıt defteri"dir: bankalar arası hareketlerde karşı taraf
    buradan bulunur, bu yüzden her banka için ORKA kodu doğru girilmeli. Aktar ekranının
    banka sekmeleri de buradaki tanımlardan türer.

    NEDEN BURADA, BANKANIN KAPSÜLÜNDE DEĞİL: banka hesabı tanımı bankaya değil FİRMAYA
    ait bir kayıttır; ayrıca yeni bir banka eklenirken o bankanın sekmesi henüz yoktur,
    kapsülün içinden erişilemez. Kapsülde yalnız ayrıştırıcı/katman ayarları kaldı ve
    oradan buraya bağlantı var.

    BANKA ADI TUTARSIZLIĞI: "aynı banka önceliği" kuralı BankaAdi üzerinden çalışır.
    Aynı banka iki yazımla girilirse ("İş Bankası" / "İŞ BANKASI") sistem onları ayrı
    bankalar sanır, sekme sayısı şişer ve bankalar arası eşleştirme bozulur. Bu yüzden
    alan otomatik tamamlamalı ve listede olmayan yazım uyarı üretiyor.

    Hesap sahibi unvanı burada DÜZENLENMEZ: firma bazlı tek bir değer, kendi bölümünde.
    Form değeri yine de taşır (kaydederken silinmesin diye).
*@

<style>
    .bh-arac { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .bh-tablo { border: 1px solid #eee; border-radius: 6px; background: #fff; overflow: hidden; }
    .bh-satir { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid #f5f5f5; font-size: 13px; }
    .bh-head { background: #fafafa; border-bottom: 1px solid #eee; font-size: 11px; color: #718096;
               text-transform: uppercase; letter-spacing: .3px; }
    .bh-satir:not(.bh-head):hover { background: #f8fbff; }
    .bh-ad { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bh-kod { flex: 0 0 130px; font-family: ui-monospace, Consolas, monospace; }
    .bh-iban { flex: 0 0 190px; font-family: ui-monospace, Consolas, monospace; color: #4a5568; }
    .bh-anahtar { flex: 0 0 170px; color: #4a5568; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bh-anahtar.yok, .bh-parser.yok { color: #cbd5e0; }
    .bh-tip { flex: 0 0 90px; color: #4a5568; }
    .bh-parser { flex: 0 0 170px; color: #718096; font-size: 12px; }
    .bh-aksiyon { flex: 0 0 80px; text-align: right; }
    .bh-pasif .bh-ad, .bh-pasif .bh-kod { color: #a0aec0; text-decoration: line-through; }
    .bh-bos { padding: 26px; text-align: center; color: #a0aec0; }

    .bh-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .bh-alan { display: flex; flex-direction: column; gap: 3px; }
    .bh-alan label { font-size: 11px; color: #718096; text-transform: uppercase; letter-spacing: .3px; }
    .bh-ipucu { font-size: 11px; color: #a0aec0; }
    .bh-uyari { font-size: 11px; color: #975a16; }

    .bh-ice-aktar { margin-top: 14px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fbfdff; }
    .bh-ice-aktar-baslik { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .bh-sorun { font-size: 12px; color: #4a5568; padding: 2px 0; }
    .bh-sorun-hata { color: #c53030; }
    .bh-sorun-no { display: inline-block; min-width: 62px; color: #718096; font-variant-numeric: tabular-nums; }
</style>

<div class="bh-arac">
    <h5 style="margin:0">Banka hesapları</h5>
    <div style="display:flex; gap:6px; align-items:center">
        <RadzenCheckBox TValue="bool" Value="@_pasifDahil" Name="pasifDahil"
                        Change="@(async (bool secili) => { _pasifDahil = secili; await YukleAsync(); })" />
        <label for="pasifDahil" style="font-size:12px; color:#718096">Pasifleri de göster</label>
        <RadzenButton Text="Yeni hesap" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="@(() => FormAc(null))" />
    </div>
</div>

@if (_yukleniyor)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
}
else
{
    <div class="bh-tablo">
        <div class="bh-satir bh-head">
            <span class="bh-ad">Banka / hesap adı</span>
            <span class="bh-tip">Tip</span>
            <span class="bh-kod">ORKA kodu</span>
            <span class="bh-iban">IBAN</span>
            <span class="bh-anahtar">Anahtarlar</span>
            <span class="bh-parser">Ayrıştırıcı</span>
            <span class="bh-aksiyon"></span>
        </div>

        @if (Gorunen.Count == 0)
        {
            <div class="bh-bos">Henüz banka hesabı tanımlanmadı.</div>
        }

        @foreach (var hesap in Gorunen)
        {
            <div class="bh-satir @(hesap.Aktif ? "" : "bh-pasif")">
                <span class="bh-ad">
                    @hesap.BankaAdi
                    @if (!string.IsNullOrWhiteSpace(hesap.HesapAdi))
                    {
                        <span style="color:#a0aec0"> · @hesap.HesapAdi</span>
                    }
                </span>
                <span class="bh-tip">@BankaEkstreEtiket.HesapTipi(hesap.HesapTipi) · @hesap.ParaBirimi</span>
                <span class="bh-kod">@hesap.OrkaHesapKodu</span>
                <span class="bh-iban">@(string.IsNullOrWhiteSpace(hesap.Iban) ? "—" : hesap.Iban)</span>
                <span class="bh-anahtar @(string.IsNullOrWhiteSpace(hesap.EslestirmeAnahtarlari) ? "yok" : "")"
                      title="@hesap.EslestirmeAnahtarlari">
                    @(string.IsNullOrWhiteSpace(hesap.EslestirmeAnahtarlari) ? "—" : hesap.EslestirmeAnahtarlari)
                </span>
                <span class="bh-parser @(string.IsNullOrWhiteSpace(hesap.ParserTipi) ? "yok" : "")">
                    @(string.IsNullOrWhiteSpace(hesap.ParserTipi) ? "yok" : ParserAdi(hesap.ParserTipi))
                </span>
                <span class="bh-aksiyon">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => FormAc(hesap))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => SilAsync(hesap))" />
                </span>
            </div>
        }
    </div>
}

@*
    Toplu içe aktarım. Hesap planı bölümüyle aynı kalıp: xlsx yüklenir, kolonlar başlık
    adıyla bulunur, sonuç raporu satır bazlı gösterilir. Tekli CRUD yerinde duruyor;
    19 hesabı tek tek girmek yerine bu kullanılır.
*@
<div class="bh-ice-aktar">
    <div class="bh-ice-aktar-baslik">
        <RadzenButton Text="Toplu İçe Aktar" Icon="upload_file" ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.Small" Disabled="@_iceAktariliyor"
                      Click="@(() => _iceAktarimAcik = !_iceAktarimAcik)" />
        <RadzenButton Text="Örnek şablon indir" Icon="download" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@SablonIndirAsync" />
        <span class="bh-ipucu">
            xlsx; kolonlar başlık adıyla bulunur, sıraları değişebilir. Anahtar ORKA hesap
            kodu: varsa güncellenir, yoksa eklenir. Dosyada olmayan hesaplara dokunulmaz.
            <b>Tüm bankaları kapsar</b> — her satır dosyadaki kendi bankasına yazılır.
        </span>
    </div>

    @if (_iceAktarimAcik)
    {
        <div class="bh-alan" style="margin-top:10px; max-width:460px">
            <label>Dosya seç (.xlsx)</label>
            <InputFile OnChange="IceAktarAsync" accept=".xlsx,.xls" disabled="@_iceAktariliyor" />
            <span class="bh-ipucu">
                Zorunlu kolonlar: <code>Orka Hesap Kodu</code>, <code>Hesap Adı</code>, <code>Banka Adı</code>,
                <code>Hesap Tipi</code>, <code>Para Birimi</code>. İsteğe bağlı: <code>Parser Tipi</code>,
                <code>IBAN</code>, <code>Eşleştirme Anahtarları</code>.
            </span>
        </div>
    }

    @if (_iceAktariliyor)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>İçe aktarılıyor...</span>
        </RadzenStack>
    }

    @if (_iceAktarimSonucu is not null)
    {
        <RadzenAlert AlertStyle="@(_iceAktarimSonucu.Hatalar.Count > 0 ? AlertStyle.Warning : AlertStyle.Success)"
                     ShowIcon="true" AllowClose="false" Style="margin-top:10px">
            @_iceAktarimSonucu.Okunan satır okundu · @_iceAktarimSonucu.Eklenen eklendi ·
            @_iceAktarimSonucu.Guncellenen güncellendi
            @if (_iceAktarimSonucu.Atlanan > 0)
            {
                <span> · @_iceAktarimSonucu.Atlanan atlandı</span>
            }
        </RadzenAlert>

        @foreach (var hata in _iceAktarimSonucu.Hatalar)
        {
            <div class="bh-sorun bh-sorun-hata">
                <span class="bh-sorun-no">Satır @hata.SatirNo</span> @hata.Message
            </div>
        }

        @foreach (var uyari in _iceAktarimSonucu.Uyarilar)
        {
            <div class="bh-sorun">
                <span class="bh-sorun-no">Satır @uyari.SatirNo</span> @uyari.Message
            </div>
        }
    }
</div>

@if (_form is not null)
{
    <div style="margin-top:16px; padding:14px; border:1px solid #e2e8f0; border-radius:6px; background:#fff">
        <h5 style="margin-top:0">@(_duzenlenenId is null ? "Yeni banka hesabı" : "Hesabı düzenle")</h5>

        <div class="bh-form">
            <div class="bh-alan">
                <label>Banka adı</label>
                @*
                    Otomatik tamamlama mevcut hesapların banka adlarından beslenir: aynı
                    bankayı ikinci bir yazımla girmenin önündeki ilk engel. Serbest yazma
                    yine mümkün (gerçekten yeni banka eklenebilmeli), ama uyarı çıkar.
                *@
                <RadzenAutoComplete @bind-Value="_form.BankaAdi" Data="@MevcutBankaAdlari"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="Vakıfbank" Style="width:100%" />
                <span class="bh-ipucu">
                    Yalnız <b>kısa banka adı</b>: Vakıfbank, Ziraat, TEB, Akbank, İş Bankası.
                    Tam hesap adını yazmayın — o metin hiçbir açıklamada geçmez, eşleşme hiç olmaz.
                </span>
                @if (BankaAdiDenetimi.Uyari(_form.BankaAdi) is string bankaUyari)
                {
                    <span class="bh-uyari">@bankaUyari</span>
                }
                @if (BankaAdiDenetimi.YeniBankaUyarisi(_form.BankaAdi, MevcutBankaAdlari) is string yeniBankaUyari)
                {
                    <span class="bh-uyari">@yeniBankaUyari</span>
                }
            </div>

            <div class="bh-alan">
                <label>Hesap adı (isteğe bağlı)</label>
                <RadzenTextBox Value="@_form.HesapAdi" Placeholder="VAKIFBANK VADESIZ TL"
                               Change="@HesapAdiDegistiAsync" />
                <span class="bh-ipucu">Hesabın ORKA'daki adı; toplu içe aktarımda zorunlu kolon.</span>
            </div>

            <div class="bh-alan" style="grid-column: 1 / -1">
                <label>Eşleştirme anahtarları (isteğe bağlı)</label>
                <div style="display:flex; gap:6px; align-items:center">
                    <RadzenTextBox @bind-Value="_form.EslestirmeAnahtarlari"
                                   Placeholder="Otomatik Süpürme, Süpürme" Style="flex:1 1 auto" />
                    <RadzenButton Text="Hesap adından öner" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Disabled="@string.IsNullOrWhiteSpace(_form.HesapAdi)" Click="@AnahtarOnerAsync" />
                </div>
                <span class="bh-ipucu">
                    Virgülle ayırın. Bankalar arası hareketlerde açıklamada önce bu ifadeler aranır,
                    tutmazsa banka adına düşülür; en uzun eşleşen kazanır. Aynı bankada birden fazla
                    hesap varsa ve hiçbir anahtar tutmazsa satır onaya düşer.
                </span>
            </div>

            <div class="bh-alan">
                <label>ORKA hesap kodu</label>
                <RadzenTextBox @bind-Value="_form.OrkaHesapKodu" Placeholder="102 1 1 01" />
                <span class="bh-ipucu">Boşluklu yazın; format değiştirilmez, ORKA tanımaz.</span>
            </div>

            <div class="bh-alan">
                <label>Hesap tipi</label>
                <RadzenDropDown TValue="HesapTipi" @bind-Value="_form.HesapTipi"
                                Data="@(new[] { HesapTipi.Vadesiz, HesapTipi.Vadeli })"
                                Style="width:100%" />
            </div>

            <div class="bh-alan">
                <label>Para birimi</label>
                <RadzenTextBox @bind-Value="_form.ParaBirimi" Placeholder="TRY" />
            </div>

            <div class="bh-alan">
                <label>IBAN (isteğe bağlı)</label>
                <RadzenTextBox @bind-Value="_form.Iban" Placeholder="TR..." />
                <span class="bh-ipucu">Girilirse bankalar arası eşleştirme IBAN'dan kesin çözülür.</span>
            </div>

            <div class="bh-alan">
                <label>Ayrıştırıcı (isteğe bağlı)</label>
                <RadzenDropDown TValue="string" @bind-Value="_form.ParserTipi" Data="@ParserSecenekleri"
                                TextProperty="Ad" ValueProperty="Tip" Style="width:100%" />
                <span class="bh-ipucu">
                    "Yok" seçilirse hesap İşleme ekranında kart göstermez (ekstre yüklenemez) ama
                    kayıt defterinde durur ve karşı hesap olarak bulunur — vadeli, süpürme ve blokaj
                    hesapları böyle tanımlanır. Ekstre yüklenecekse şimdilik yalnız Vakıfbank vadesiz TL var.
                </span>
            </div>

            <div class="bh-alan">
                <label>Kapalı eşleştirme katmanları</label>
                <div style="display:flex; gap:14px; align-items:center">
                    <span style="display:flex; gap:5px; align-items:center">
                        <RadzenCheckBox @bind-Value="_form.IbanKatmaniAktif" Name="ibanKatmani" />
                        <label for="ibanKatmani" style="font-size:12px; color:#4a5568; text-transform:none; letter-spacing:0">IBAN</label>
                    </span>
                    <span style="display:flex; gap:5px; align-items:center">
                        <RadzenCheckBox @bind-Value="_form.VknKatmaniAktif" Name="vknKatmani" />
                        <label for="vknKatmani" style="font-size:12px; color:#4a5568; text-transform:none; letter-spacing:0">VKN</label>
                    </span>
                </div>
                <span class="bh-ipucu">
                    İkisi de varsayılan kapalı. Vakıfbank'ta VKN kolonu karşı tarafın değil hesap
                    sahibinin VKN'si; IBAN verisi de düzenli tutulmuyor. Yalnız bu alanları
                    güvenilir veren bir bankada açın.
                </span>
            </div>

            <div class="bh-alan">
                <label>Durum</label>
                <div style="display:flex; gap:6px; align-items:center">
                    <RadzenCheckBox @bind-Value="_form.Aktif" Name="aktif" />
                    <label for="aktif" style="font-size:12px; color:#4a5568; text-transform:none; letter-spacing:0">Aktif</label>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:6px; margin-top:14px">
            <RadzenButton Text="Kaydet" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Disabled="@_kaydediyor" Click="@KaydetAsync" />
            <RadzenButton Text="Vazgeç" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => { _form = null; _duzenlenenId = null; })" />
        </div>
    </div>
}

@code {
    private List<BankaHesabiDto> _hesaplar = new();
    private List<ParserSecenekDto> _parserler = new();

    private BankaHesabiYazDto? _form;
    private int? _duzenlenenId;

    private bool _pasifDahil;
    private bool _yukleniyor = true;
    private bool _kaydediyor;

    private bool _iceAktarimAcik;
    private bool _iceAktariliyor;
    private BankaHesabiIceAktarimSonucDto? _iceAktarimSonucu;

    /// <summary>Sunucudaki sınırla aynı; büyük dosya isteği boşuna gitmesin.</summary>
    private const long EnFazlaBayt = 20 * 1024 * 1024;

    /// <summary>
    /// Aktar ekranındaki "Banka ekle" düğmesi buraya <c>?yeniHesap=1</c> ile gelir;
    /// sayfa açılır açılmaz boş form açılsın.
    /// </summary>
    [Parameter] public bool YeniHesapIstendi { get; set; }

    /// <summary>
    /// Kapsüldeki "Tam düzenleme" bağlantısı buraya <c>?hesap={id}</c> ile gelir;
    /// o hesabın düzenleme formu açılsın.
    /// </summary>
    [Parameter] public int? AcilacakHesapId { get; set; }

    /// <summary>
    /// En son uygulanan adres isteği. Aynı istek tekrar uygulanmaz (kullanıcı formu
    /// kapattıysa yeniden açılmasın) ama <b>farklı</b> bir hesaba geçilirse uygulanır.
    /// </summary>
    private string? _uygulananIstek;

    private List<BankaHesabiDto> Gorunen => _hesaplar;

    /// <summary>
    /// Otomatik tamamlamayı besleyen mevcut banka adları. Tanımlı hesaplardan türer;
    /// listede olmayan bir yazım girildiğinde <see cref="BankaAdiDenetimi.YeniBankaUyarisi"/>
    /// uyarı verir. Aynı bankanın iki yazımla girilmesi eşleştirmeyi bozduğu için burada
    /// büyük/küçük harf duyarsız tekilleştirme yapılır: liste zaten tutarsızsa iki yazım
    /// da görünür ve kullanıcı hangisini seçtiğini bilir.
    /// </summary>
    private List<string> MevcutBankaAdlari =>
        _hesaplar.Select(h => h.BankaAdi)
                 .Where(a => !string.IsNullOrWhiteSpace(a))
                 .Distinct(StringComparer.Ordinal)
                 .OrderBy(a => a, StringComparer.CurrentCulture)
                 .ToList();

    /// <summary>Onay ve bildirim metinlerinde geçen firma adı.</summary>
    private string FirmaAdi => Oturum.SeciliFirma?.Ad ?? "seçili firma";

    protected override async Task OnInitializedAsync()
    {
        _parserler = await Api.GetParserlerAsync();
        await YukleAsync();
        SorguIsteginiUygula();
    }

    protected override void OnParametersSet() => SorguIsteginiUygula();

    /// <summary>
    /// Adresle gelen form isteğini bir kez uygular. Hesaplar henüz yüklenmediyse
    /// beklenir: düzenleme formu kaydı listeden bulur.
    /// </summary>
    private void SorguIsteginiUygula()
    {
        if (_yukleniyor) return;
        if (!YeniHesapIstendi && AcilacakHesapId is null) return;

        var istek = AcilacakHesapId is int hedef ? $"hesap:{hedef}" : "yeni";
        if (istek == _uygulananIstek) return;

        _uygulananIstek = istek;

        if (AcilacakHesapId is int id)
        {
            var hesap = _hesaplar.FirstOrDefault(h => h.Id == id);
            if (hesap is not null)
            {
                FormAc(hesap);
                return;
            }

            // Pasif hesaplar varsayılan listede yok; bağlantı kırılmasın diye açılır.
            _pasifDahil = true;
            _ = YukleVeAcAsync(id);
            return;
        }

        FormAc(null);
    }

    private async Task YukleVeAcAsync(int id)
    {
        await YukleAsync();

        var hesap = _hesaplar.FirstOrDefault(h => h.Id == id);
        if (hesap is not null) FormAc(hesap);

        StateHasChanged();
    }

    /// <summary>Firma değişince üst sayfa bunu çağırır.</summary>
    public Task YenileAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        _yukleniyor = true;
        _hesaplar = await Api.GetHesaplarAsync(_pasifDahil);
        _yukleniyor = false;

        // Firma değişiminde üst sayfa YenileAsync'i çağırıyor; kendi StateHasChanged'i
        // bu bileşeni yeniden çizdirmiyor (parametresi değişmiyor). Kardeş bölümler de
        // aynı sebeple burada StateHasChanged çağırıyor.
        StateHasChanged();
    }

    private string ParserAdi(string tip)
        => _parserler.FirstOrDefault(p => p.Tip == tip)?.Ad ?? tip;

    /// <summary>
    /// Ayrıştırıcı listesi + başta "Yok". Hesapların çoğuna ekstre yüklenmiyor, bu yüzden
    /// yeni hesabın varsayılanı da "Yok": yanlış bankanın ayrıştırıcısı sessizce atanmasın.
    /// </summary>
    private List<ParserSecenekDto> ParserSecenekleri
    {
        get
        {
            var liste = new List<ParserSecenekDto> { new() { Tip = string.Empty, Ad = "Yok — ekstre yüklenmez" } };
            liste.AddRange(_parserler);
            return liste;
        }
    }

    private void FormAc(BankaHesabiDto? hesap)
    {
        _duzenlenenId = hesap?.Id;
        _form = hesap is null
            // Hesap sahibi unvanı ve takma adlar burada DÜZENLENMEZ (kendi bölümünde)
            // ama forma yüklenir: kaydederken alanlar boş gitseydi firma kimliği
            // silinir, banka açıklamalarındaki kendi unvanımız karşı taraf sanılırdı.
            ? new BankaHesabiYazDto
            {
                ParserTipi = string.Empty,
                HesapSahibiUnvani = FirmaUnvani(),
                HesapSahibiTakmaAdlari = FirmaTakmaAdlari()
            }
            : new BankaHesabiYazDto
            {
                BankaAdi = hesap.BankaAdi,
                HesapAdi = hesap.HesapAdi,
                EslestirmeAnahtarlari = hesap.EslestirmeAnahtarlari,
                HesapSahibiUnvani = hesap.HesapSahibiUnvani ?? FirmaUnvani(),
                HesapSahibiTakmaAdlari = hesap.HesapSahibiTakmaAdlari,
                HesapTipi = hesap.HesapTipi,
                ParaBirimi = hesap.ParaBirimi,
                Iban = hesap.Iban,
                OrkaHesapKodu = hesap.OrkaHesapKodu,
                ParserTipi = hesap.ParserTipi,
                Aktif = hesap.Aktif,
                IbanKatmaniAktif = hesap.IbanKatmaniAktif,
                VknKatmaniAktif = hesap.VknKatmaniAktif
            };
    }

    /// <summary>Mevcut hesaplarda girilmiş hesap sahibi unvanı (firma başına tek değer).</summary>
    private string? FirmaUnvani()
        => _hesaplar.Select(h => h.HesapSahibiUnvani)
                    .FirstOrDefault(u => !string.IsNullOrWhiteSpace(u));

    /// <summary>Aynı şekilde takma adlar: yeni hesap firmanın kimliğini devralır.</summary>
    private string? FirmaTakmaAdlari()
        => _hesaplar.Select(h => h.HesapSahibiTakmaAdlari)
                    .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));

    /// <summary>
    /// Hesap adı değişince anahtar önerisi doldurulur — yalnız alan boşsa: kullanıcının
    /// yazdığı anahtar ezilmemeli.
    /// </summary>
    private async Task HesapAdiDegistiAsync(string? yeniAd)
    {
        if (_form is null) return;

        _form.HesapAdi = yeniAd;
        if (!string.IsNullOrWhiteSpace(_form.EslestirmeAnahtarlari)) return;

        await AnahtarOnerAsync();
    }

    /// <summary>Hesap adından anahtar önerisi; "Öner" düğmesi mevcut değeri de tazeler.</summary>
    private async Task AnahtarOnerAsync()
    {
        if (_form is null || string.IsNullOrWhiteSpace(_form.HesapAdi)) return;

        _form.EslestirmeAnahtarlari = await Api.AnahtarOnerisiAsync(_form.HesapAdi, _form.BankaAdi);
    }

    private async Task KaydetAsync()
    {
        if (_form is null) return;

        // Banka adı biçimi engellemez, yalnız uyarır: kullanıcı bilerek uzun ad yazmış olabilir.
        var bankaAdiUyarisi = BankaAdiDenetimi.Uyari(_form.BankaAdi);

        _kaydediyor = true;
        var (veri, hata) = _duzenlenenId is int id
            ? await Api.UpdateHesapAsync(id, _form)
            : await Api.CreateHesapAsync(_form);
        _kaydediyor = false;

        if (hata is not null)
        {
            Notif.Notify(NotificationSeverity.Error, "Kaydedilemedi", hata, 6000);
            return;
        }

        Notif.Notify(NotificationSeverity.Success, "Kaydedildi", $"{FirmaAdi} · {veri?.BankaAdi}", 3000);

        if (bankaAdiUyarisi is not null)
            Notif.Notify(NotificationSeverity.Warning, "Banka adını gözden geçirin", bankaAdiUyarisi, 9000);

        _form = null;
        _duzenlenenId = null;
        await YukleAsync();
    }

    /// <summary>
    /// Toplu içe aktarım. Hatalı satır dosyanın tamamını düşürmez; sonuç raporu
    /// (eklenen/güncellenen/atlanan + satır bazlı sebepler) ekranda kalır.
    /// </summary>
    private async Task IceAktarAsync(InputFileChangeEventArgs args)
    {
        var dosya = args.File;
        if (dosya is null) return;

        // Firma adıyla onay: dosya tüm bankaları kapsıyor ve yanlış firmaya yazılırsa
        // hesap tanımlarının tamamı bozulur.
        var onay = await Dialog.Confirm(
            $"{FirmaAdi} firmasına \"{dosya.Name}\" dosyasındaki banka hesapları aktarılacak.",
            "Toplu içe aktarım onayı",
            new ConfirmOptions { OkButtonText = "İçe aktar", CancelButtonText = "Vazgeç", ShowClose = true });

        if (onay != true) return;

        _iceAktarimSonucu = null;
        _iceAktariliyor = true;

        try
        {
            using var bellek = new MemoryStream();
            await using (var kaynak = dosya.OpenReadStream(EnFazlaBayt))
                await kaynak.CopyToAsync(bellek);
            bellek.Position = 0;

            var (veri, hata) = await Api.HesaplariIceAktarAsync(bellek, dosya.Name);
            if (hata is not null)
            {
                Notif.Notify(NotificationSeverity.Error, "İçe aktarılamadı", hata, 8000);
                return;
            }

            _iceAktarimSonucu = veri;
            await YukleAsync();
    
            var ozet = $"{FirmaAdi} · {veri?.Okunan} satır okundu, {veri?.Eklenen} eklendi, {veri?.Guncellenen} güncellendi";
            if (veri is { Atlanan: > 0 })
                Notif.Notify(NotificationSeverity.Warning, "İçe aktarım tamamlandı",
                             $"{ozet}, {veri.Atlanan} satır atlandı. Sebepler aşağıda.", 8000);
            else
                Notif.Notify(NotificationSeverity.Success, "İçe aktarım tamamlandı", ozet, 4000);
        }
        finally
        {
            _iceAktariliyor = false;
        }
    }

    private async Task SablonIndirAsync()
    {
        var (dosyaAdi, icerik, hata) = await Api.HesapSablonuAsync();
        if (hata is not null || icerik is null)
        {
            Notif.Notify(NotificationSeverity.Warning, "Şablon indirilemedi", hata, 6000);
            return;
        }

        await JS.InvokeVoidAsync("downloadFileFromBytes", dosyaAdi, icerik);
    }

    private async Task SilAsync(BankaHesabiDto hesap)
    {
        var onay = await Dialog.Confirm(
            $"{FirmaAdi} firmasının \"{hesap.BankaAdi} · {hesap.OrkaHesapKodu}\" hesabı silinecek. " +
            "Ekstresi işlenmiş hesap silinmez, pasife çekilir.",
            "Hesap silme onayı",
            new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç", ShowClose = true });

        if (onay != true) return;

        var hata = await Api.DeleteHesapAsync(hesap.Id);
        if (hata is not null)
        {
            Notif.Notify(NotificationSeverity.Warning, "Silinemedi", hata, 6000);
            return;
        }

        Notif.Notify(NotificationSeverity.Success, "Silindi", $"{FirmaAdi} · {hesap.BankaAdi}", 3000);
        await YukleAsync();
    }
}
