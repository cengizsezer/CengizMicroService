@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.BankaEkstre

@inject IBankaEkstreApi Api
@inject IBankaOtomasyonOturumu Oturum
@inject NotificationService Notif
@inject DialogService Dialog
@inject IJSRuntime JS

@*
    Tanımlar ekranının "Öğrenilen eşleşmeler" bölümü. Yanlış onaylanan bir eşleşme bir
    daha sorulmadan tekrarlanır; bu yüzden liste görülebilir, düzeltilebilir ve
    silinebilir olmak zorunda.

    Anahtar ham açıklama değil, normalize unvan çekirdeği: banka her satıra farklı sorgu
    numarası yazdığı için ham metin asla ikinci kez eşleşmiyordu.
*@

<style>
    .oe-arac { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
    .oe-tablo { border: 1px solid #eee; border-radius: 6px; background: #fff; overflow: hidden; }
    .oe-satir { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid #f5f5f5; font-size: 13px; }
    .oe-head { background: #fafafa; border-bottom: 1px solid #eee; font-size: 11px; color: #718096;
               text-transform: uppercase; letter-spacing: .3px; }
    .oe-satir:not(.oe-head):hover { background: #f8fbff; }
    .oe-anahtar { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
                  font-family: ui-monospace, Consolas, monospace; }
    .oe-kod { flex: 0 0 110px; font-family: ui-monospace, Consolas, monospace; }
    .oe-ad { flex: 0 0 220px; color: #4a5568; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .oe-yon { flex: 0 0 70px; color: #4a5568; }
    .oe-sayi { flex: 0 0 70px; text-align: right; font-variant-numeric: tabular-nums; }
    .oe-tarih { flex: 0 0 95px; color: #718096; font-variant-numeric: tabular-nums; }
    .oe-aksiyon { flex: 0 0 80px; text-align: right; }
    .oe-bos { padding: 26px; text-align: center; color: #a0aec0; }
    .oe-ek { font-size: 11px; color: #2c5282; margin-left: 6px; }
    .oe-tip { flex: 0 0 95px; font-size: 11px; color: #718096; }
    .oe-rozet { display: inline-block; padding: 1px 6px; border-radius: 9px; font-size: 10px;
                background: #edf2f7; color: #4a5568; }
    .oe-rozet.belirsizlik { background: #fefcbf; color: #744210; }
    .oe-ice-aktar { margin-top: 14px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fbfdff; }
    .oe-ice-aktar-baslik { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .oe-ipucu { font-size: 11px; color: #a0aec0; }
    .oe-alan { display: flex; flex-direction: column; gap: 4px; }
    .oe-alan > label { font-size: 11px; color: #718096; }
    .oe-sorun { font-size: 12px; color: #4a5568; padding: 2px 0; }
    .oe-sorun-hata { color: #c53030; }
    .oe-sorun-no { display: inline-block; min-width: 62px; color: #718096; font-variant-numeric: tabular-nums; }
</style>

<div class="oe-arac">
    <h5 style="margin:0">Öğrenilen eşleşmeler</h5>
    <div style="display:flex; gap:6px; align-items:center">
        <RadzenTextBox @bind-Value="_arama" Placeholder="Unvan veya kod ara" Style="width:220px"
                       Change="@(async (string _) => await YenileAsync())" />
        <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@YenileAsync" />
    </div>
</div>

<div class="oe-tablo">
    <div class="oe-satir oe-head">
        <span class="oe-anahtar">Anahtar</span>
        <span class="oe-tip">Tür</span>
        <span class="oe-kod">Hesap kodu</span>
        <span class="oe-ad">Hesap adı</span>
        <span class="oe-yon">Yön</span>
        <span class="oe-sayi">Kullanım</span>
        <span class="oe-tarih">Son</span>
        <span class="oe-aksiyon"></span>
    </div>

    @if (_kayitlar.Count == 0)
    {
        <div class="oe-bos">Henüz öğrenilmiş eşleşme yok. Onay ekranında verilen her onay buraya düşer.</div>
    }

    @foreach (var kayit in _kayitlar)
    {
        <div class="oe-satir">
            <span class="oe-anahtar" title="@kayit.TamAnahtar">
                @kayit.AnahtarCekirdek
                @if (!string.IsNullOrWhiteSpace(kayit.AyirtEdiciEk))
                {
                    <span class="oe-ek">+ @kayit.AyirtEdiciEk</span>
                }
            </span>
            <span class="oe-tip">
                <span class="oe-rozet @(kayit.AnahtarTipi == AnahtarTipi.Belirsizlik ? "belirsizlik" : "")"
                      title="@AnahtarTipiIpucu(kayit)">
                    @AnahtarTipiAdi(kayit.AnahtarTipi)
                </span>
            </span>
            <span class="oe-kod">@kayit.HesapKodu</span>
            <span class="oe-ad" title="@kayit.HesapAdi">@(kayit.HesapAdi ?? "—")</span>
            <span class="oe-yon">@BankaEkstreEtiket.Yon(kayit.Yon)</span>
            <span class="oe-sayi">@kayit.KullanimSayisi</span>
            <span class="oe-tarih">@BankaEkstreEtiket.Tarih(kayit.SonKullanim)</span>
            <span class="oe-aksiyon">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              Click="@(() => FormAc(kayit))" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              Click="@(() => SilAsync(kayit))" />
            </span>
        </div>
    }
</div>

@*
    Toplu içe aktarım. Öğrenme tablosu şimdiye kadar yalnız onay ekranından tek tek
    doluyordu; ORKA yevmiyesinden çıkarılmış yüzlerce doğrulanmış eşleşme elle girilemez.

    Kullanıcının kararı önceliklidir: aynı anahtar için kayıt varsa satır ATLANIR,
    üzerine yazılmaz.
*@
<div class="oe-ice-aktar">
    <div class="oe-ice-aktar-baslik">
        <RadzenButton Text="Toplu İçe Aktar" Icon="upload_file" ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.Small" Disabled="@_iceAktariliyor"
                      Click="@(() => _iceAktarimAcik = !_iceAktarimAcik)" />
        <RadzenButton Text="Örnek şablon indir" Icon="download" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@SablonIndirAsync" />
        <span class="oe-ipucu">
            xlsx; kolonlar başlık adıyla bulunur, sıraları değişebilir. Anahtar unvan
            çekirdeğidir ve içe aktarılırken yeniden normalize edilir.
            <b>Mevcut kayıtlar korunur</b> — onaydan öğrenilmiş bir eşleşme ezilmez.
        </span>
    </div>

    @if (_iceAktarimAcik)
    {
        <div class="oe-alan" style="margin-top:10px; max-width:460px">
            <label>Dosya seç (.xlsx)</label>
            <InputFile OnChange="IceAktarAsync" accept=".xlsx,.xls" disabled="@_iceAktariliyor" />
            <span class="oe-ipucu">
                Zorunlu kolonlar: <code>Anahtar Çekirdek</code>, <code>Hesap Kodu</code>.
                İsteğe bağlı: <code>Hesap Adı</code>, <code>Yön</code>, <code>Kullanım Sayısı</code>,
                <code>Son Kullanım</code>. Yön boşsa <code>Farketmez</code> sayılır ve iki yön için
                de kayıt yazılır.
            </span>
        </div>
    }

    @if (_iceAktariliyor)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>İçe aktarılıyor...</span>
        </RadzenStack>
    }

    @if (_iceAktarimSonucu is not null)
    {
        <RadzenAlert AlertStyle="@(_iceAktarimSonucu.Hatalar.Count > 0 ? AlertStyle.Warning : AlertStyle.Success)"
                     ShowIcon="true" AllowClose="false" Style="margin-top:10px">
            @_iceAktarimSonucu.Okunan satır okundu · @_iceAktarimSonucu.Eklenen eklendi
            (@_iceAktarimSonucu.EklenenKayit kayıt)
            @if (_iceAktarimSonucu.Atlanan > 0)
            {
                <span> · @_iceAktarimSonucu.Atlanan atlandı (mevcut)</span>
            }
            @if (_iceAktarimSonucu.Hatali > 0)
            {
                <span> · @_iceAktarimSonucu.Hatali hatalı</span>
            }
        </RadzenAlert>

        @foreach (var hata in _iceAktarimSonucu.Hatalar)
        {
            <div class="oe-sorun oe-sorun-hata">
                <span class="oe-sorun-no">Satır @hata.SatirNo</span> @hata.Message
            </div>
        }

        @foreach (var uyari in _iceAktarimSonucu.Uyarilar)
        {
            <div class="oe-sorun">
                <span class="oe-sorun-no">Satır @uyari.SatirNo</span> @uyari.Message
            </div>
        }
    }
</div>

@if (_duzenlenen is not null && _form is not null)
{
    <div style="margin-top:14px; padding:14px; border:1px solid #e2e8f0; border-radius:6px; background:#fff">
        <h6 style="margin-top:0">
            Eşleşmeyi düzelt — <code>@_duzenlenen.AnahtarCekirdek</code>
        </h6>
        <div style="font-size:11px; color:#a0aec0; margin-bottom:10px">
            Anahtar değiştirilemez; o karşı tarafın kimliğidir. Yalnız gittiği hesap, yön ve
            ayırt edici kelime düzenlenir.
        </div>

        <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:12px">
            <div style="display:flex; flex-direction:column; gap:3px">
                <label style="font-size:11px; color:#718096">ORKA hesap kodu</label>
                <RadzenTextBox @bind-Value="_form.HesapKodu" Placeholder="120 D22" />
            </div>
            <div style="display:flex; flex-direction:column; gap:3px">
                <label style="font-size:11px; color:#718096">Yön</label>
                <RadzenDropDown TValue="Yon" @bind-Value="_form.Yon" Data="@(new[] { Yon.Giren, Yon.Cikan })"
                                Style="width:100%" />
            </div>
            <div style="display:flex; flex-direction:column; gap:3px">
                <label style="font-size:11px; color:#718096">Ayırt edici kelime (isteğe bağlı)</label>
                <RadzenTextBox @bind-Value="_form.AyirtEdiciEk" Placeholder="Aidat" />
            </div>
        </div>

        <div style="display:flex; gap:6px; margin-top:12px">
            <RadzenButton Text="Kaydet" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Disabled="@_kaydediyor" Click="@KaydetAsync" />
            <RadzenButton Text="Vazgeç" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => { _duzenlenen = null; _form = null; })" />
        </div>
    </div>
}

@code {
    private List<HesapEslesmesiDto> _kayitlar = new();
    private HesapEslesmesiDto? _duzenlenen;
    private HesapEslesmesiYazDto? _form;

    private string? _arama;
    private bool _kaydediyor;

    private bool _iceAktarimAcik;
    private bool _iceAktariliyor;
    private OgrenilenEslesmeIceAktarimSonucDto? _iceAktarimSonucu;

    /// <summary>Sunucudaki sınırla aynı; büyük dosya isteği boşuna gitmesin.</summary>
    private const long EnFazlaBayt = 20 * 1024 * 1024;

    private string FirmaAdi => Oturum.SeciliFirma is null ? "seçili firma" : Oturum.FirmaAdi;

    private static string AnahtarTipiAdi(AnahtarTipi tip) => tip switch
    {
        AnahtarTipi.Belirsizlik => "belirsizlik",
        AnahtarTipi.Iban => "IBAN",
        AnahtarTipi.Vkn => "VKN",
        _ => "unvan"
    };

    /// <summary>
    /// Belirsizlik kayıtlarında aday kümesi özeti de saklanır: küme değişirse (yeni bir
    /// cari açılırsa) karar uygulanmaz, satır tekrar onaya düşer. Kullanıcı bunu bilmeli.
    /// </summary>
    private static string AnahtarTipiIpucu(HesapEslesmesiDto kayit) => kayit.AnahtarTipi switch
    {
        AnahtarTipi.Belirsizlik =>
            "Çoklu adaydan yapılan seçim. Aynı belirsizlik bir daha sorulmaz — " +
            "aday kümesi değişmediği sürece (yeni cari açılırsa yeniden sorulur).",
        _ => "Onaydan öğrenilen unvan çekirdeği."
    };

    protected override async Task OnInitializedAsync() => await YenileAsync();

    /// <summary>Firma değişince üst sayfa bunu çağırır.</summary>
    public async Task YenileAsync()
    {
        _kayitlar = await Api.EslesmeleriAraAsync(_arama);
        StateHasChanged();
    }

    private void FormAc(HesapEslesmesiDto kayit)
    {
        _duzenlenen = kayit;
        _form = new HesapEslesmesiYazDto
        {
            HesapKodu = kayit.HesapKodu,
            Yon = kayit.Yon,
            AyirtEdiciEk = kayit.AyirtEdiciEk
        };
    }

    private async Task KaydetAsync()
    {
        if (_duzenlenen is null || _form is null) return;

        _kaydediyor = true;
        var (_, hata) = await Api.EslesmeGuncelleAsync(_duzenlenen.Id, _form);
        _kaydediyor = false;

        if (hata is not null)
        {
            Notif.Notify(NotificationSeverity.Error, "Kaydedilemedi", hata, 6000);
            return;
        }

        Notif.Notify(NotificationSeverity.Success, "Eşleşme güncellendi", null, 3000);
        _duzenlenen = null;
        _form = null;
        await YenileAsync();
    }

    private async Task SilAsync(HesapEslesmesiDto kayit)
    {
        var hata = await Api.EslesmeSilAsync(kayit.Id);
        if (hata is not null)
        {
            Notif.Notify(NotificationSeverity.Warning, "Silinemedi", hata, 6000);
            return;
        }

        if (_duzenlenen?.Id == kayit.Id)
        {
            _duzenlenen = null;
            _form = null;
        }

        Notif.Notify(NotificationSeverity.Success, "Silindi", kayit.TamAnahtar, 3000);
        await YenileAsync();
    }

    /// <summary>
    /// Toplu içe aktarım. Hatalı satır dosyanın tamamını düşürmez; sonuç raporu
    /// (eklenen / atlanan / hatalı + satır bazlı sebepler) ekranda kalır.
    /// </summary>
    private async Task IceAktarAsync(InputFileChangeEventArgs args)
    {
        var dosya = args.File;
        if (dosya is null) return;

        // Firma adıyla onay: eşleşmeler firma bazlı, yanlış firmaya yazılırsa o firmanın
        // öğrenme tablosu doğrulanmamış kararlarla dolar.
        var onay = await Dialog.Confirm(
            $"{FirmaAdi} için \"{dosya.Name}\" dosyasındaki öğrenilmiş eşleşmeler içe aktarılacak. " +
            "Aynı anahtar için kayıt varsa mevcut karar korunur.",
            "Toplu içe aktarım onayı",
            new ConfirmOptions { OkButtonText = "İçe aktar", CancelButtonText = "Vazgeç", ShowClose = true });

        if (onay != true) return;

        _iceAktarimSonucu = null;
        _iceAktariliyor = true;

        try
        {
            using var bellek = new MemoryStream();
            await using (var kaynak = dosya.OpenReadStream(EnFazlaBayt))
                await kaynak.CopyToAsync(bellek);
            bellek.Position = 0;

            var (veri, hata) = await Api.EslesmeleriIceAktarAsync(bellek, dosya.Name);
            if (hata is not null)
            {
                Notif.Notify(NotificationSeverity.Error, "İçe aktarılamadı", hata, 8000);
                return;
            }

            _iceAktarimSonucu = veri;
            await YenileAsync();

            var ozet = $"{FirmaAdi} · {veri?.Okunan} satır okundu, {veri?.Eklenen} eklendi";
            if (veri is not null && (veri.Atlanan > 0 || veri.Hatali > 0))
                Notif.Notify(NotificationSeverity.Warning, "İçe aktarım tamamlandı",
                             $"{ozet}, {veri.Atlanan} atlandı (mevcut), {veri.Hatali} hatalı. Sebepler aşağıda.", 8000);
            else
                Notif.Notify(NotificationSeverity.Success, "İçe aktarım tamamlandı", ozet, 4000);
        }
        finally
        {
            _iceAktariliyor = false;
        }
    }

    private async Task SablonIndirAsync()
    {
        var (dosyaAdi, icerik, hata) = await Api.EslesmeSablonuAsync();
        if (hata is not null || icerik is null)
        {
            Notif.Notify(NotificationSeverity.Warning, "Şablon indirilemedi", hata, 6000);
            return;
        }

        await JS.InvokeVoidAsync("downloadFileFromBytes", dosyaAdi, icerik);
    }
}
