@using Radzen
@using Radzen.Blazor

@*
    Banka Otomasyon'un sekme şeridi.

    ESKİDEN firma başlığıydı: hangi firmaya "girildiğini" yazar ve firma listesine dönüş
    bağlantısı taşırdı. Firma artık bir oturum bağlamı değil verinin bir boyutu
    (KARARLAR §99) — girilecek bir firma, dönülecek bir liste, dolayısıyla gösterilecek
    bir başlık da kalmadı. Geriye yalnız sekmeler kaldı.

    Firma bilgisi kaybolmadı, yer değiştirdi: listelerde satır başına firma kolonu,
    onay/yükleme mesajlarında firma adı. Yanlış firmaya veri girmeye karşı savunma
    ekranın tepesindeki tek bir etiket değil, işlemin yapıldığı yerdeki firma adı.
*@

<style>
    .bo-ust { display: flex; justify-content: flex-end; align-items: center; gap: 12px;
              flex-wrap: wrap; padding: 8px 12px; margin-bottom: 14px;
              border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fbff; }
    .bo-sekmeler { display: flex; gap: 6px; }
    .bo-sekme { border: 1px solid #e2e8f0; border-radius: 999px; padding: 5px 16px; font-size: 13px;
                color: #4a5568; background: #fff; text-decoration: none; }
    .bo-sekme:hover { background: #edf5ff; }
    .bo-sekme.aktif { background: #2b6cb0; border-color: #2b6cb0; color: #fff; font-weight: 600; }
</style>

<div class="bo-ust">
    <div class="bo-sekmeler">
        <a class="bo-sekme @(Sekme == BankaOtomasyonSekmesi.Aktar ? "aktif" : "")"
           href="/banka-otomasyon/aktar">Aktar</a>
        <a class="bo-sekme @(Sekme == BankaOtomasyonSekmesi.Tanimlar ? "aktif" : "")"
           href="/banka-otomasyon/tanimlar">Tanımlar</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BankaOtomasyonSekmesi Sekme { get; set; }
}
