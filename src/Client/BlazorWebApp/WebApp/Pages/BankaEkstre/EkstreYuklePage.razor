@page "/banka-isleme/yukle"

@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.BankaEkstre

@inject IBankaEkstreApi Api
@inject NotificationService Notif
@inject NavigationManager Nav

@*
    Ekstre yükleme ve hesap planı içe aktarımı. Yükleme anında satırlar işlenir:
    açıklama üretilir, karşı hesap katmanlı olarak çözülür. Belirsiz kalanlar onay
    ekranına düşer; sayaçlar bunu gösterir.
*@

<style>
    .ey-kart { border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; padding: 14px; margin-bottom: 14px; }
    .ey-alan { display: flex; flex-direction: column; gap: 3px; margin-bottom: 10px; max-width: 420px; }
    .ey-alan label { font-size: 11px; color: #718096; text-transform: uppercase; letter-spacing: .3px; }
    .ey-ipucu { font-size: 11px; color: #a0aec0; }

    .ey-sayaclar { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
    .ey-sayac { border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 14px; min-width: 110px; background: #fafbfc; }
    .ey-sayac .deger { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .ey-sayac .ad { font-size: 11px; color: #718096; text-transform: uppercase; letter-spacing: .3px; }
    .ey-sayac.iyi .deger { color: #276749; }
    .ey-sayac.dikkat .deger { color: #975a16; }
    .ey-sayac.kotu .deger { color: #9b2c2c; }

    .ey-tablo { border: 1px solid #eee; border-radius: 6px; background: #fff; overflow: hidden; }
    .ey-satir { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid #f5f5f5; font-size: 13px; }
    .ey-head { background: #fafafa; border-bottom: 1px solid #eee; font-size: 11px; color: #718096;
               text-transform: uppercase; letter-spacing: .3px; }
    .ey-satir:not(.ey-head):hover { background: #f8fbff; }
    .ey-dosya { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ey-banka { flex: 0 0 150px; }
    .ey-donem { flex: 0 0 190px; color: #4a5568; }
    .ey-adet { flex: 0 0 80px; text-align: right; font-variant-numeric: tabular-nums; }
    .ey-durum { flex: 0 0 160px; }
    .ey-aksiyon { flex: 0 0 130px; text-align: right; }
    .ey-bos { padding: 26px; text-align: center; color: #a0aec0; }
    .ey-rozet { font-size: 11px; padding: 1px 8px; border-radius: 10px; }
    .ey-rozet.tamam { background: #f0fff4; color: #276749; }
    .ey-rozet.eksik { background: #fffaf0; color: #975a16; }
</style>

<h4 style="margin:0 0 12px">Ekstre Yükleme</h4>

<div class="ey-kart">
    <h5 style="margin-top:0">Hesap planı</h5>

    @if (_planSayisi == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            Hesap planı henüz içe aktarılmadı. Cari eşleştirmesi (Katman 5) hesap planı olmadan çalışmaz.
        </RadzenAlert>
    }
    else
    {
        <div style="font-size:13px; color:#4a5568; margin-bottom:8px">
            Yüklü hesap sayısı: <strong>@_planSayisi</strong>
        </div>
    }

    <div class="ey-alan">
        <label>Hesap planı dosyası (.xlsx)</label>
        <InputFile OnChange="PlanSecildiAsync" accept=".xlsx,.xls" />
        <span class="ey-ipucu">Beklenen kolonlar: <code>Hesap Kodu</code>, <code>Hesap Adı</code>. Var olan kodlar güncellenir.</span>
    </div>

    @if (_planSonuc is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" AllowClose="false">
            @_planSonuc.Okunan satır okundu · @_planSonuc.Eklenen eklendi · @_planSonuc.Guncellenen güncellendi
            @if (_planSonuc.Atlanan > 0)
            {
                <span> · @_planSonuc.Atlanan atlandı</span>
            }
        </RadzenAlert>

        @foreach (var uyari in _planSonuc.Uyarilar)
        {
            <div class="ey-ipucu">@uyari</div>
        }
    }
</div>

<div class="ey-kart">
    <h5 style="margin-top:0">Ekstre</h5>

    <div class="ey-alan">
        <label>Banka hesabı</label>
        <RadzenDropDown TValue="int" @bind-Value="_seciliHesapId" Data="@_hesaplar"
                        TextProperty="BankaAdi" ValueProperty="Id" Style="width:100%"
                        Placeholder="Hesap seçin" />
        @if (_hesaplar.Count == 0)
        {
            <span class="ey-ipucu">Önce Banka Hesapları ekranından bir hesap tanımlayın.</span>
        }
    </div>

    <div class="ey-alan">
        <label>Ekstre dosyası (.xlsx)</label>
        <InputFile OnChange="EkstreSecildiAsync" accept=".xlsx,.xls" disabled="@(_seciliHesapId == 0)" />
    </div>

    @if (_isleniyor)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>İşleniyor...</span>
        </RadzenStack>
    }

    @if (_sonYukleme is not null)
    {
        <div class="ey-sayaclar">
            <div class="ey-sayac">
                <div class="deger">@_sonYukleme.Sayaclar.Toplam</div>
                <div class="ad">Toplam</div>
            </div>
            <div class="ey-sayac iyi">
                <div class="deger">@_sonYukleme.Sayaclar.Otomatik</div>
                <div class="ad">Otomatik</div>
            </div>
            <div class="ey-sayac dikkat">
                <div class="deger">@_sonYukleme.Sayaclar.OnayBekleyen</div>
                <div class="ad">Onay bekleyen</div>
            </div>
            <div class="ey-sayac kotu">
                <div class="deger">@_sonYukleme.Sayaclar.Cozulemeyen</div>
                <div class="ad">Çözülemeyen</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_sonYukleme.Uyarilar))
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" Style="margin-top:10px">
                @_sonYukleme.Uyarilar
            </RadzenAlert>
        }

        <div style="margin-top:10px">
            <RadzenButton Text="Onay ekranına git" Icon="fact_check" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo($"/banka-isleme/onay/{_sonYukleme.Id}"))" />
        </div>
    }
</div>

<h5>Yüklemeler</h5>

<div class="ey-tablo">
    <div class="ey-satir ey-head">
        <span class="ey-dosya">Dosya</span>
        <span class="ey-banka">Banka</span>
        <span class="ey-donem">Dönem</span>
        <span class="ey-adet">Satır</span>
        <span class="ey-durum">Durum</span>
        <span class="ey-aksiyon"></span>
    </div>

    @if (_yuklemeler.Count == 0)
    {
        <div class="ey-bos">Henüz ekstre yüklenmedi.</div>
    }

    @foreach (var y in _yuklemeler)
    {
        <div class="ey-satir">
            <span class="ey-dosya" title="@y.DosyaAdi">@y.DosyaAdi</span>
            <span class="ey-banka">@y.BankaAdi</span>
            <span class="ey-donem">@Donem(y)</span>
            <span class="ey-adet">@y.SatirSayisi</span>
            <span class="ey-durum">
                @if (y.Sayaclar.Eksik == 0)
                {
                    <span class="ey-rozet tamam">Tamamlandı</span>
                }
                else
                {
                    <span class="ey-rozet eksik">@y.Sayaclar.Eksik satır bekliyor</span>
                }
            </span>
            <span class="ey-aksiyon">
                <RadzenButton Text="Onay" Icon="fact_check" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              Click="@(() => Nav.NavigateTo($"/banka-isleme/onay/{y.Id}"))" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              Click="@(() => SilAsync(y))" />
            </span>
        </div>
    }
</div>

@code {
    private const long EnFazlaBayt = 20 * 1024 * 1024;

    private List<BankaHesabiDto> _hesaplar = new();
    private List<EkstreYuklemeDto> _yuklemeler = new();

    private EkstreYuklemeDto? _sonYukleme;
    private HesapPlaniIceAktarimSonucDto? _planSonuc;

    private int _seciliHesapId;
    private int _planSayisi;
    private bool _isleniyor;

    protected override async Task OnInitializedAsync() => await YukleAsync();

    private async Task YukleAsync()
    {
        _hesaplar = await Api.GetHesaplarAsync();
        _yuklemeler = await Api.GetYuklemelerAsync();
        _planSayisi = await Api.HesapPlaniSayisiAsync();

        if (_seciliHesapId == 0 && _hesaplar.Count > 0)
            _seciliHesapId = _hesaplar[0].Id;
    }

    private static string Donem(EkstreYuklemeDto y)
        => y.DonemBaslangic is null || y.DonemBitis is null
            ? "—"
            : $"{BankaEkstreEtiket.Tarih(y.DonemBaslangic.Value)} – {BankaEkstreEtiket.Tarih(y.DonemBitis.Value)}";

    private async Task PlanSecildiAsync(InputFileChangeEventArgs args)
    {
        var dosya = args.File;
        if (dosya is null) return;

        _planSonuc = null;
        _isleniyor = true;

        try
        {
            using var bellek = new MemoryStream();
            await using (var kaynak = dosya.OpenReadStream(EnFazlaBayt))
                await kaynak.CopyToAsync(bellek);
            bellek.Position = 0;

            var (veri, hata) = await Api.HesapPlaniIceAktarAsync(bellek, dosya.Name);
            if (hata is not null)
            {
                Notif.Notify(NotificationSeverity.Error, "İçe aktarılamadı", hata, 8000);
                return;
            }

            _planSonuc = veri;
            _planSayisi = await Api.HesapPlaniSayisiAsync();
            Notif.Notify(NotificationSeverity.Success, "Hesap planı güncellendi", null, 3000);
        }
        finally
        {
            _isleniyor = false;
        }
    }

    private async Task EkstreSecildiAsync(InputFileChangeEventArgs args)
    {
        var dosya = args.File;
        if (dosya is null || _seciliHesapId == 0) return;

        _sonYukleme = null;
        _isleniyor = true;

        try
        {
            using var bellek = new MemoryStream();
            await using (var kaynak = dosya.OpenReadStream(EnFazlaBayt))
                await kaynak.CopyToAsync(bellek);
            bellek.Position = 0;

            var (veri, hata) = await Api.YukleAsync(_seciliHesapId, bellek, dosya.Name);
            if (hata is not null)
            {
                Notif.Notify(NotificationSeverity.Error, "Yüklenemedi", hata, 8000);
                return;
            }

            _sonYukleme = veri;
            _yuklemeler = await Api.GetYuklemelerAsync();
            Notif.Notify(NotificationSeverity.Success, "Ekstre işlendi", $"{veri?.SatirSayisi} satır", 3000);
        }
        finally
        {
            _isleniyor = false;
        }
    }

    private async Task SilAsync(EkstreYuklemeDto y)
    {
        var hata = await Api.SilAsync(y.Id);
        if (hata is not null)
        {
            Notif.Notify(NotificationSeverity.Warning, "Silinemedi", hata, 6000);
            return;
        }

        if (_sonYukleme?.Id == y.Id) _sonYukleme = null;
        _yuklemeler = await Api.GetYuklemelerAsync();
    }
}
