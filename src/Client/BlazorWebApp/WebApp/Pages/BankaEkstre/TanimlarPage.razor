@page "/banka-isleme/tanimlar"

@using Radzen
@using Radzen.Blazor
@using WebApp.Domain.Models.User
@using WebApp.Manager
@using WebApp.Pages.BankaEkstre.Bolumler

@implements IDisposable

@inject IAppSessionManager SessionManager

@*
    Banka İşleme > Tanımlar — kurulum ekranı, nadiren açılır. Üç bölüm:
    hesap planı, banka hesapları, öğrenilen eşleşmeler.

    Günlük ekranda (İşleme) hesap planı yükleme yok: hesap planı yılda birkaç kez
    değişiyor, her gün açılan ekranda durmasının anlamı yok.

    Firma bağlamı sayfa içinde seçilmez; üstteki FİRMA DEĞİŞTİR bağlamı kullanılır.
*@

<style>
    .tn-kart { border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; padding: 16px; margin-bottom: 16px; }
</style>

<h4 style="margin:0 0 4px">Banka İşleme — Tanımlar</h4>
<div style="font-size:12px; color:#718096; margin-bottom:14px">
    Kurulum ayarları. Günlük çalışma için <a href="/banka-isleme">İşleme</a> ekranını kullanın.
</div>

<div class="tn-kart">
    <HesapPlaniBolumu @ref="_hesapPlani" />
</div>

<div class="tn-kart">
    <BankaHesaplariBolumu @ref="_bankaHesaplari" />
</div>

<div class="tn-kart">
    <OgrenilenEslesmelerBolumu @ref="_eslesmeler" />
</div>

@code {
    private HesapPlaniBolumu? _hesapPlani;
    private BankaHesaplariBolumu? _bankaHesaplari;
    private OgrenilenEslesmelerBolumu? _eslesmeler;

    protected override void OnInitialized() => SessionManager.FirmChanged += OnFirmaDegisti;

    /// <summary>
    /// Firma değişince tüm bölümler yenilenir: hesap planı, banka hesapları ve
    /// eşleşmeler firma bazlıdır, eski firmanın verisi ekranda kalmamalı.
    /// </summary>
    private async void OnFirmaDegisti(FirmaDto _)
        => await InvokeAsync(async () =>
        {
            if (_hesapPlani is not null) await _hesapPlani.YenileAsync();
            if (_bankaHesaplari is not null) await _bankaHesaplari.YenileAsync();
            if (_eslesmeler is not null) await _eslesmeler.YenileAsync();
            StateHasChanged();
        });

    public void Dispose() => SessionManager.FirmChanged -= OnFirmaDegisti;
}
