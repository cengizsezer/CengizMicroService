@page "/banka-otomasyon"
@page "/banka-isleme"
@page "/banka-isleme/firma-tanimlari"
@page "/banka-isleme/tanimlar"
@page "/banka-isleme/onay/{EkstreId:int}"

@inject NavigationManager Nav

@*
    Modül "Banka İşleme" iken kullanılan adresler. Kayıtlı bağlantılar ve tarayıcı yer
    imleri kırılmasın diye rotalar duruyor; içerik yok, yalnız yeni adrese yönlendiriyor.

    Kök adres (/banka-otomasyon) Aktar'a gider. Bir dönem firma seçim ekranına gidiyordu;
    o ekran kaldırıldı (KARARLAR §99): firma artık bir oturum bağlamı olmadığı için
    "hangi firmadayız" sorusu da yok. Aktar zaten tüm firmaların hesaplarını listeliyor.

    replace: true — geri düğmesi eski adrese dönüp sonsuz yönlendirme kurmasın.
*@

@code {
    /// <summary>Yalnız eski onay rotasında dolu; diğer rotalarda null.</summary>
    [Parameter] public int? EkstreId { get; set; }

    protected override void OnInitialized()
    {
        var yol = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

        var hedef = EkstreId is int id ? $"/banka-otomasyon/onay/{id}"
                  : yol.EndsWith("/tanimlar", StringComparison.OrdinalIgnoreCase)
                    || yol.EndsWith("/firma-tanimlari", StringComparison.OrdinalIgnoreCase)
                        ? "/banka-otomasyon/tanimlar"
                        : "/banka-otomasyon/aktar";

        Nav.NavigateTo(hedef, forceLoad: false, replace: true);
    }
}
