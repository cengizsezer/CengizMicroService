@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Application.Services.Interfaces
@inject NavigationManager NavigationManager
@inject IIdentityService IdentityService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<style>
    .login-container {
        display: flex;
        min-height: 100vh;
        width: 100vw;
    }

    .login-left {
        position: relative;
        width: 66.66vw;
        height: 100vh;
        background-color: #f5f7fa;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        text-align: center;
        overflow: hidden;
    }

    .login-image {
        width: 120%;
        height: 120%;
        object-fit: cover;
        display: block;
    }

    .login-right {
        width: 33.33vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(to bottom right, #f0f4ff, #ffffff);
    }

    .login-card {
        width: 100%;
        max-width: 600px;
        padding: 2rem;
        border-radius: 8px;
        background-color: transparent;
    }

    .login-logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 10rem;
        margin-top: -3rem;
    }

    .login-logo {
        max-height: 200px;
        width: auto;
    }

    .login-title {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .RadzenTextBox,
    .RadzenPassword,
    .RadzenButton {
        width: 130% !important;
    }
</style>

<div class="login-container">
    <div class="login-left">
        <img src="img/Login.jpeg" alt="Digital Accounting" class="login-image" />
    </div>

    <div class="login-right">
        <div class="login-card">
            <div class="login-logo-container">
                <img src="img/LogoWithText.png" alt="Dijital Masraf Logo" class="login-logo" />
            </div>

            <div class="login-title">
                <RadzenHeading Size="H4">Kayıt Ol</RadzenHeading>
            </div>

            <EditForm EditContext="@editContext" OnValidSubmit="@OnRegister" OnInvalidSubmit="@OnInvalidSubmit">
                <DataAnnotationsValidator />

                <RadzenTextBox @bind-Value="registerModel.UserName" Name="username" Placeholder="Kullanıcı Adı" Style="width: 100%; margin-bottom: 1rem;" />
                <ValidationMessage For="@(() => registerModel.UserName)" />

                <RadzenTextBox @bind-Value="registerModel.Email" Name="email" Placeholder="Email" Style="width: 100%; margin-bottom: 1rem;" />
                <ValidationMessage For="@(() => registerModel.Email)" />

                <RadzenPassword @bind-Value="registerModel.Password" Name="password" Placeholder="Şifre" Style="width: 100%; margin-bottom: 1rem;" />
                <ValidationMessage For="@(() => registerModel.Password)" />

                <RadzenButton ButtonType="ButtonType.Submit" Disabled="@isLoading"
                               Style="width: 100%; background-color: #3b82f6; color: white; font-weight: 600; border-radius: 25px; padding: 10px;">
                    @if (isLoading)
                    {
                        <div style="display: flex; align-items: center; justify-content: center;">
                            <RadzenProgressCircle ShowValue="false" Style="width: 20px; height: 20px; margin-right: 8px;" />
                            <span>Kayıt Yapılıyor...</span>
                        </div>
                    }
                    else
                    {
                        <span>Kayıt Ol</span>
                    }
                </RadzenButton>

                <RadzenAlert Visible="@hasError" Severity="AlertSeverity.Error" Style="margin-top: 1rem;">
                    Kayıt başarısız oldu.
                </RadzenAlert>
            </EditForm>

            <div class="alternative-login" style="margin-top: 2rem; text-align:center;">
                <RadzenText>
                    Zaten bir hesabınız var mı?
                    <RadzenLink Text="Giriş Yap" Path="/login" Style="color: #3b82f6; margin-left: 5px;" />
                </RadzenText>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private EditContext editContext;
    private bool hasError;
    private bool isLoading = false;

    public class RegisterModel
    {
        [Required(ErrorMessage = "Kullanıcı adı zorunludur")]
        public string UserName { get; set; }

        [Required(ErrorMessage = "Email zorunludur")]
        [EmailAddress(ErrorMessage = "Geçerli bir email girin")]
        public string Email { get; set; }

        [Required(ErrorMessage = "Şifre zorunludur")]
        public string Password { get; set; }
    }

    protected override void OnInitialized()
    {
        editContext = new EditContext(registerModel);
    }

    private string? errorMessage;

    private async Task OnRegister()
    {
        hasError = false;
        isLoading = true;
        StateHasChanged();

        try
        {
            var res = await IdentityService.Register(registerModel.UserName, registerModel.Email, registerModel.Password);

            if (res?.Success == true)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                hasError = true;
                errorMessage = res?.Message ?? "Kayıt başarısız.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Bir hata oluştu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnInvalidSubmit(EditContext context)
    {
        JSRuntime.InvokeVoidAsync("console.warn", "\u274C Form doğrulaması başarısız");
    }
}
