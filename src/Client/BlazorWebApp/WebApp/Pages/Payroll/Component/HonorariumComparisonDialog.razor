        display: flex;
        gap: 10px;
        align-items: center; /* 🔥 ortalandı */
        background: #f3faf4;
        border: 1px solid #d8ead9;
        border-radius: 8px;
        padding: 10px 14px; /* 🔥 küçültüldü */
