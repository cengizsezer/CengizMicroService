        margin-top: 2px; /* 🔥 aşağı kaymayı düzeltti */
    }

    .comparison-footer-left {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #374151;
    }

    .comparison-footer-right {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
</style>