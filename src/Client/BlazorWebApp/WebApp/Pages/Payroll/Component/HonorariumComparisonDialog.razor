        margin-bottom: 8px; /* 🔥 boşluk azaltıldı */
    }

    .comparison-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        background: white;
    }

        /* HEADER */
        .comparison-table thead th {
            background: #f8fafc;
            font-size: 15px;
            font-weight: 700;
            color: #1f2937;
