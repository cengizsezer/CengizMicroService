        margin: 0 0 6px 0;
        font-size: 22px;
        font-weight: 700;
        color: #1f2937;
    }

    .comparison-subtitle {
        font-size: 14px;
        color: #6b7280;
    }

    .comparison-toolbar-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* TABLE WRAP */
    .comparison-table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
