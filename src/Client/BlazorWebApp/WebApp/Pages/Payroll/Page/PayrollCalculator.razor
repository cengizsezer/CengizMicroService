@layout PublicPayrollLayout
@page "/payroll-calculator"
@using WebApp.Pages.Payroll.Layout
@using WebApp.Pages.Payroll.Model
@using WebApp.Pages.Payroll.Services
@inject IPayrollApiService PayrollApiService

<PageTitle>İşçi Ücret Hesaplama</PageTitle>

<div class="payroll-page">
    <div class="payroll-container">

        <h1 class="page-title">İşçi Bordrosu</h1>

        <div class="payroll-top-text">
            Yemek Bedeli (Günlük İstisna) GVK ve DV Açısından:
            <strong>300 TL</strong>
            SGK Açısından:
            <strong>158 TL</strong>,
            GVK Ulaşım İstisnası (Günlük):
            <strong>158 TL</strong>,
            GVK Aylık Huzur Hakkı İstisnası:
            <strong>33.030,00 TL</strong>
            <br />
            SGK Çocuk Zammı (Çocuk Başına Aylık):
            <strong>660,60 TL</strong>,
            SGK Aile Zammı (Aylık):
            <strong>3.303,00 TL</strong>
            <br />
            Vergiden Müstesna Gündelik:
            <strong>900 TL</strong>
            -
            KKTC:
            <strong>2.005 TL</strong>
        </div>

        <div class="payroll-filters">
            <div class="filter-item year-box">
                <label>Yıl</label>
                <RadzenDropDown TValue="int"
                                Data="@yearOptions"
                                @bind-Value="model.Year"
                                Style="width:90px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            <div class="filter-item">
                <label>Hesaplama Tipi</label>
                <RadzenDropDown TValue="int"
                                Data="@calculationTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.CalculationType"
                                Style="width:170px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            <div class="filter-item">
                <label>Çalışan Tipi</label>
                <RadzenDropDown TValue="int"
                                Data="@employeeTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.EmployeeType"
                                Style="width:170px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            <div class="filter-item switch-item">
                <label>&nbsp;</label>
                <div class="switch-wrap">
                    <RadzenCheckBox @bind-Value="model.IsJanitor"
                                    Change="@((bool value) => OnJanitorChanged(value))" />
                    <span>Kapıcı</span>
                </div>
            </div>

            <div class="filter-item switch-item">
                <label>&nbsp;</label>
                <div class="switch-wrap">
                    <RadzenCheckBox @bind-Value="model.HasMandatoryBes"
                                    Change="@((bool value) => TriggerRecalculateAsync())" />
                    <span>Zorunlu BES</span>
                </div>
            </div>

            <div class="filter-item">
                <label>Engel Durumu</label>
                <RadzenDropDown TValue="int"
                                Data="@disabilityTypes"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="model.DisabilityType"
                                Style="width:140px;"
                                Change="@(_ => TriggerRecalculateAsync())" />
            </div>

            <div class="filter-item action-link">
                <label>&nbsp;</label>
                <a href="javascript:void(0)">Asgari Ücrete Göre Hesapla</a>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="payroll-table">
                <thead>
                    <tr>
                        <th>Aylar</th>
                        <th>Tutar</th>
                        <th>Brüt Ücret</th>
                        <th>SGK İşçi</th>
                        <th>İSP İşçi</th>
                        <th>Gelir V. Matrahı</th>
                        <th>Kümülatif Matrah</th>
                        <th>Gelir Vergisi</th>
                        <th>İstisna Gelir V.</th>
                        <th>Ödenecek Gelir Ver.</th>
                        <th>Damga Vergisi</th>
                        <th>İstisna D.V.</th>
                        <th>Ödenecek Damga V.</th>
                        <th>Kesintiler Toplamı</th>
                        <th>Net Ücret</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < monthInputs.Count; i++)
                    {
                        var input = monthInputs[i];
                        var monthResult = GetMonthResult(input.Month);

                        <tr>
                            <td>@input.MonthName</td>

                            <td class="input-cell">
                                <div class="input-wrap">
                                    <RadzenNumeric TValue="decimal"
                                                   Value="input.Amount"
                                                   Style="width:100%;"
                                                   Format="N2"
                                                   Change="@(args => OnAmountChangedAsync(input, args))" />
                                </div>
                            </td>

                            <td>@FormatMoney(monthResult?.GrossSalary)</td>
                            <td>@FormatMoney(monthResult?.SgkEmployeeAmount)</td>
                            <td>@FormatMoney(monthResult?.UnemploymentEmployeeAmount)</td>
                            <td>@FormatMoney(monthResult?.IncomeTaxBase)</td>
                            <td>@FormatMoney(monthResult?.CumulativeIncomeTaxBase)</td>
                            <td>@FormatMoney(monthResult?.CalculatedIncomeTax)</td>
                            <td>@FormatMoney(monthResult?.IncomeTaxExemption)</td>
                            <td>@FormatMoney(monthResult?.PayableIncomeTax)</td>
                            <td>@FormatMoney(monthResult?.CalculatedStampTax)</td>
                            <td>@FormatMoney(monthResult?.StampTaxExemption)</td>
                            <td>@FormatMoney(monthResult?.PayableStampTax)</td>
                            <td>@FormatMoney(monthResult?.TotalDeductions)</td>
                            <td>@FormatMoney(monthResult?.NetSalary)</td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td colspan="2">Toplam...</td>
                        <td>@FormatMoney(result?.Totals.TotalGrossSalary)</td>
                        <td>@FormatMoney(result?.Totals.TotalSgkEmployeeAmount)</td>
                        <td>@FormatMoney(result?.Totals.TotalUnemploymentEmployeeAmount)</td>
                        <td>@FormatMoney(result?.Totals.TotalIncomeTaxBase)</td>
                        <td>@FormatMoney(result?.Totals.TotalIncomeTaxBase)</td>
                        <td>@FormatMoney(result?.Totals.TotalCalculatedIncomeTax)</td>
                        <td>@FormatMoney(result?.Totals.TotalIncomeTaxExemption)</td>
                        <td>@FormatMoney(result?.Totals.TotalPayableIncomeTax)</td>
                        <td>@FormatMoney(result?.Totals.TotalCalculatedStampTax)</td>
                        <td>@FormatMoney(result?.Totals.TotalStampTaxExemption)</td>
                        <td>@FormatMoney(result?.Totals.TotalPayableStampTax)</td>
                        <td>@FormatMoney(result?.Totals.TotalDeductions)</td>
                        <td>@FormatMoney(result?.Totals.TotalNetSalary)</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="payroll-info-text">
            <div>◎ Sadece temel parametrelere göre hesaplama yapmak üzere dizayn edilen bu hizmetin kullanımı ücretsizdir.</div>
            <div>◎ Burada yapılan hesaplamalar bilgilendirme amaçlı olup profesyonel danışmanlık hizmeti sunma taahhüdü taşımaz. Belirtilen bilgilerin doğruluğu garanti edilmez ve bu bilgilerin kullanımı nedeniyle oluşabilecek herhangi bir zarardan sorumluluk kabul edilmez.</div>
        </div>

        @if (isLoading)
        {
            <div class="status-text">Hesaplanıyor...</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="error-box">@errorMessage</div>
        }
    </div>
</div>

@code {
    private readonly PayrollPageModel model = new();
    private List<PayrollMonthInputModel> monthInputs = new();
    private CalculatePayrollResponse? result;
    private bool isLoading;
    private string? errorMessage;
    private CancellationTokenSource? debounceCts;

    private List<int> yearOptions = new() { 2025, 2026, 2027 };

    private List<LookupItem> calculationTypes = new()
    {
        new() { Value = 1, Text = "Brütten Nete" },
        new() { Value = 2, Text = "Netten Brüte" }
    };

    private List<LookupItem> employeeTypes = new()
    {
        new() { Value = 1, Text = "Normal Çalışan" },
        new() { Value = 2, Text = "Emekli Çalışan" }
    };

    private List<LookupItem> disabilityTypes = new()
    {
        new() { Value = 0, Text = "Normal" },
        new() { Value = 1, Text = "1. Derece" },
        new() { Value = 2, Text = "2. Derece" },
        new() { Value = 3, Text = "3. Derece" }
    };

    private List<PayrollMonthInputModel> BuildDefaultMonths()
    {
        return new()
        {
            new() { Month = 1, MonthName = "Ocak", Amount = 0, IsEdited = false },
            new() { Month = 2, MonthName = "Şubat", Amount = 0, IsEdited = false },
            new() { Month = 3, MonthName = "Mart", Amount = 0, IsEdited = false },
            new() { Month = 4, MonthName = "Nisan", Amount = 0, IsEdited = false },
            new() { Month = 5, MonthName = "Mayıs", Amount = 0, IsEdited = false },
            new() { Month = 6, MonthName = "Haziran", Amount = 0, IsEdited = false },
            new() { Month = 7, MonthName = "Temmuz", Amount = 0, IsEdited = false },
            new() { Month = 8, MonthName = "Ağustos", Amount = 0, IsEdited = false },
            new() { Month = 9, MonthName = "Eylül", Amount = 0, IsEdited = false },
            new() { Month = 10, MonthName = "Ekim", Amount = 0, IsEdited = false },
            new() { Month = 11, MonthName = "Kasım", Amount = 0, IsEdited = false },
            new() { Month = 12, MonthName = "Aralık", Amount = 0, IsEdited = false }
        };
    }

    protected override void OnInitialized()
    {
        monthInputs = BuildDefaultMonths();
    }

    private async Task OnAmountChangedAsync(PayrollMonthInputModel item, object? value)
    {
        var amount = value is decimal dec ? dec : 0m;

        item.Amount = amount;
        item.IsEdited = true;

        foreach (var next in monthInputs.Where(x => x.Month > item.Month && !x.IsEdited).OrderBy(x => x.Month))
        {
            next.Amount = amount;
        }

        await TriggerRecalculateAsync();
    }

    private async Task OnJanitorChanged(bool value)
    {
        model.IsJanitor = value;
        model.EmployeeType = value ? 2 : 1;
        await TriggerRecalculateAsync();
    }

    private async Task TriggerRecalculateAsync()
    {
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        try
        {
            await Task.Delay(250, token);
            await CalculateAsync(token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task CalculateAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var request = new CalculatePayrollRequest
            {
                Year = model.Year,
                CalculationType = model.CalculationType,
                EmployeeType = model.EmployeeType,
                HasMandatoryBes = model.HasMandatoryBes,
                DisabilityType = model.DisabilityType,
                StartMonth = 1,
                PreviousCumulativeTaxBase = model.PreviousCumulativeTaxBase,
                Months = monthInputs
                    .Where(x => x.IsEdited)
                    .Select(x => new PayrollMonthInputRequest
                    {
                        Month = x.Month,
                        Amount = x.Amount
                    })
                    .ToList()
            };

            if (!request.Months.Any())
            {
                result = null;
                return;
            }

            result = await PayrollApiService.CalculateAsync(request, cancellationToken);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private PayrollMonthResultDto? GetMonthResult(int month)
    {
        return result?.Months?.FirstOrDefault(x => x.Month == month);
    }

    private string FormatMoney(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("N2") : "0,00";
    }

    private class LookupItem
    {
        public int Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private class PayrollPageModel
    {
        public int Year { get; set; } = 2026;
        public int CalculationType { get; set; } = 1;
        public int EmployeeType { get; set; } = 1;
        public bool IsJanitor { get; set; }
        public bool HasMandatoryBes { get; set; }
        public int DisabilityType { get; set; } = 0;
        public decimal PreviousCumulativeTaxBase { get; set; }
    }
}