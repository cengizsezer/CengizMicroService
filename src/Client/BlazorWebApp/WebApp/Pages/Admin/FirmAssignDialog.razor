@using Radzen
@using Radzen.Blazor
@using WebApp.Shared.Dto.Admin
@using WebApp.Application.Services.Interfaces

@inject IUserAdminService Admin
@inject DialogService Dialog
@inject NotificationService Notif

<RadzenCard class="rz-p-3">
    <RadzenStack Gap="1rem">
        <RadzenLabel Text="Firmalar" />

        <RadzenCheckBoxList TValue="int"
                            Data="@firmOptions"
                            TextProperty="Text"
                            ValueProperty="Id"
                            @bind-Value="@selectedFirmIds"
                            Style="width:100%" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Vazgeç" Click="@(() => Dialog.Close(false))" />
            <RadzenButton Text="Kaydet" ButtonStyle="ButtonStyle.Primary" Click="@Save" Disabled="@loading" />
        </RadzenStack>
    </RadzenStack>

    @if (loading)
    {
        <div class="rz-mt-3">
            <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public int UserId { get; set; }

    // UI için seçenek listesi
    private List<FirmOption> firmOptions = new();
    // CheckBoxList için doğru tip: IEnumerable<int>
    private IEnumerable<int> selectedFirmIds = Array.Empty<int>();
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var firms = await Admin.GetFirmsAsync();

            // Ekranda "Ad (FirmaNo)" gösterelim; FirmaNo boşsa sadece Ad
            firmOptions = firms.Select(f => new FirmOption
            {
                Id = f.Id,
                Text = string.IsNullOrWhiteSpace(f.FirmaNo) ? f.Name : $"{f.Name} ({f.FirmaNo})"
            })
            .OrderBy(x => x.Text)
            .ToList();

            // Kullanıcının mevcut firmaları
            var userFirms = await Admin.GetUserFirmsAsync(UserId); // List<UserFirmDto>
            selectedFirmIds = userFirms.Select(x => x.TenantId).ToList();
        }
        finally { loading = false; }
    }

    private async Task Save()
    {
        if (loading) return;
        loading = true;
        try
        {
            var req = new SetUserFirmsRequest
            {
                Firms = selectedFirmIds.Select(tid => new UserFirmAssignDto
                {
                    TenantId = tid,
                    Roles = null // rollere dokunma
                }).ToList()
            };

            await Admin.SetUserFirmsAsync(UserId, req);

            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Kaydedildi",
                Detail = "Kullanıcının firma yetkileri güncellendi."
            });

            Dialog.Close(true);
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message
            });
        }
        finally { loading = false; }
    }

    // basit display view-model
    private class FirmOption
    {
        public int Id { get; set; }
        public string Text { get; set; } = "";
    }
}
