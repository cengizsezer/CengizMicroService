@inject IUserAdminService Admin
@inject NotificationService Notif
@inject DialogService Dialog
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.Admin

<EditForm EditContext="@editContext"
          OnValidSubmit="@Save"
          OnInvalidSubmit="@Invalid">
  <DataAnnotationsValidator />
  <ValidationSummary />

  <RadzenPassword @bind-Value="pwd.NewPassword"
                  Name="NewPassword"
                  Style="width:100%"
                  Placeholder="Yeni Şifre"
                  RevealText="true" />
  <ValidationMessage For="()=>pwd.NewPassword" />

  <RadzenStack Orientation="Orientation.Horizontal"
               JustifyContent="JustifyContent.End"
               Gap="0.5rem"
               class="rz-mt-3">
    <RadzenButton Text="İptal" Click="@(()=>Dialog.Close(false))" />
    <RadzenButton Text="Kaydet"
                  ButtonStyle="ButtonStyle.Primary"
                  Disabled="@saving"
                  ButtonType="ButtonType.Submit" />
  </RadzenStack>
</EditForm>

@code {
  [Parameter] public int UserId { get; set; }

  class Vm
  {
    [Required(ErrorMessage = "Şifre zorunludur.")]
    [MinLength(6, ErrorMessage = "Şifre en az 6 karakter olmalıdır.")]
    public string NewPassword { get; set; } = "";
  }

  Vm pwd = new();
  EditContext? editContext;
  bool saving;

  protected override void OnInitialized()
  {
    editContext = new EditContext(pwd);
  }

  private async Task Save()
  {
    if (saving) return;
    saving = true;
    try
    {
      await Admin.AdminChangePasswordAsync(
        UserId,
        new UserChangePasswordDto { NewPassword = pwd.NewPassword }
      );

      Notif.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Şifre güncellendi",
        Detail = "Kullanıcının şifresi başarıyla değiştirildi."
      });

      Dialog.Close(true);
    }
    catch (Exception ex)
    {
      Notif.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Hata",
        Detail = ex.Message
      });
    }
    finally { saving = false; }
  }

  private void Invalid(EditContext ctx)
  {
    // Geçersiz submit’te buraya düşer: ekranın üstündeki ValidationSummary’de detayları görürsün.
    Notif.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Warning,
      Summary = "Eksik / Hatalı alan",
      Detail = "Lütfen form hatalarını düzeltin."
    });
  }
}
