@using Radzen
@using Radzen.Blazor
@using WebApp.Shared.Dto.Sovos
@using WebApp.Application.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@inject DialogService Dialog
@inject NotificationService Notif
@inject ISovosAdminService Sovos

<EditForm EditContext="@editContext"
          OnValidSubmit="@OnValidSubmit"
          OnInvalidSubmit="@OnInvalidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(CompanyName))
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-muted rz-mb-2">
            @CompanyName için yeni şifre belirleyin.
        </RadzenText>
    }

    <RadzenStack Gap="0.75rem">

        <div>
            <RadzenPassword @bind-Value="vm.NewPassword"
                            Name="NewPassword"
                            Style="width:100%"
                            Placeholder="Yeni Şifre"
                            RevealText="true" />
            <ValidationMessage For="()=>vm.NewPassword" />
            <RadzenHint Text="Şifre en az 4 karakter olmalı." />
        </div>

        <div>
            <RadzenPassword @bind-Value="vm.ConfirmPassword"
                            Name="ConfirmPassword"
                            Style="width:100%"
                            Placeholder="Yeni Şifre (Tekrar)"
                            RevealText="true" />
            <ValidationMessage For="()=>vm.ConfirmPassword" />
        </div>

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem"
                     class="rz-mt-2">
            <RadzenButton Text="İptal" Click="@(()=>Dialog.Close(false))" />
            <RadzenButton Text="Kaydet"
                          ButtonStyle="ButtonStyle.Primary"
                          Disabled="@saving"
                          ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    [Parameter] public int CompanyId { get; set; }
    [Parameter] public string? CompanyName { get; set; }

    class Vm
    {
        [Required(ErrorMessage = "Şifre zorunludur.")]
        [MinLength(4, ErrorMessage = "Şifre en az 4 karakter olmalıdır.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Şifre tekrarı zorunludur.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Şifreler eşleşmiyor.")]
        public string ConfirmPassword { get; set; } = "";
    }

    Vm vm = new();
    EditContext? editContext;
    bool saving;

    protected override void OnInitialized()
    {
        editContext = new EditContext(vm);
    }

    private async Task OnValidSubmit()
    {
        if (saving) return;
        saving = true;
        try
        {
            var ok = await Sovos.ChangePasswordAsync(
                CompanyId,
                new SovosCompanyPasswordDto { NewPassword = vm.NewPassword }
            );

            if (ok)
            {
                Dialog.Close(true);
            }
            else
            {
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Hata",
                    Detail = "Şifre güncellenemedi."
                });
            }
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message
            });
        }
        finally { saving = false; }
    }

    private void OnInvalidSubmit(EditContext ctx)
    {
        Notif.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Eksik / Hatalı alan",
            Detail = "Lütfen form hatalarını düzeltin."
        });
    }
}
