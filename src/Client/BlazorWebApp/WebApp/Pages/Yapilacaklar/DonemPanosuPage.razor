@code {
    private const string OzetSekme = "ozet";
    private const string NasilSekme = "nasil";
    private const string KisilerSekme = "kisiler";

    [SupplyParameterFromQuery(Name = "donem")] public string? Donem { get; set; }
    [SupplyParameterFromQuery(Name = "sekme")] public string? Sekme { get; set; }
    [SupplyParameterFromQuery(Name = "firma")] public int? Firma { get; set; }

    /// <summary>Nasıl yapılır sekmesinde seçili iş (tarif grubu anahtarı).</summary>
    [SupplyParameterFromQuery(Name = "is")] public string? Is { get; set; }

    /// <summary>Kişiler sekmesinde tek kişi (iş dialogundaki "Kişiyi düzenle").</summary>
    [SupplyParameterFromQuery(Name = "kisi")] public int? KisiParam { get; set; }

    private DonemOzetiDto? ozet;

    /// <summary>Kabuktaki eylem grubu (MEVCUT dialoglar); sekmelerin boş-liste düğmeleri ve Ctrl+V buraya gelir.</summary>
    private IsTakipEylemleri? eylemler;

    /// <summary>Ekleme bitince artar; açık sekme parametre değişince kendini tazeler.</summary>
    private int surum;
    private string? ozetHata;
    private string? donemHata;

    /// <summary>Adresteki dönem; boşsa (ve özet de yüklenemediyse) matris sunucunun varsayılanını açar.</summary>
    private (int Yil, int Ay, string Anahtar)? secili;

    private bool OzetSekmesi => string.Equals(Sekme, OzetSekme, StringComparison.OrdinalIgnoreCase);
    private bool NasilSekmesi => string.Equals(Sekme, NasilSekme, StringComparison.OrdinalIgnoreCase);

    /// <summary>Dönem dışı sekme (Özet, Nasıl yapılır): adres boş dönemle varsayılana yönlenmez.</summary>
    private bool KisilerSekmesi => string.Equals(Sekme, KisilerSekme, StringComparison.OrdinalIgnoreCase);
    private bool SabitSekme => OzetSekmesi || NasilSekmesi || KisilerSekmesi;

    private List<DonemFirmaSecenegi> FirmaSecenekleri
        => ozet?.Satirlar.Select(s => new DonemFirmaSecenegi(s.FirmaId, s.FirmaAdi)).ToList() ?? new();

    private IEnumerable<DonemSekmesiDto> SekmeDonemleri => ozet?.Donemler ?? Enumerable.Empty<DonemSekmesiDto>();

    protected override async Task OnParametersSetAsync()
    {
        donemHata = null;
        secili = null;
        if (!SabitSekme && !string.IsNullOrWhiteSpace(Donem))
        {
            secili = Coz(Donem);
            if (secili is null) donemHata = $"\"{Donem}\" geçerli bir dönem değil (beklenen: 2026-09).";
        }

        if (ozet is null && ozetHata is null) await OzetYukle();

        // Adres boş: varsayılan sekmeye (bir önceki ay). replace — geri tuşu boş adrese dönüp
        // tekrar yönlendirme döngüsü kurmasın (Hesaplamalar'la aynı gerekçe).
        if (!SabitSekme && string.IsNullOrWhiteSpace(Donem) && ozet is not null)
            Nav.NavigateTo(Adres(null, ozet.VarsayilanAnahtar), forceLoad: false, replace: true);
    }

    private async Task OzetYukle()
    {
        var (sonuc, mesaj) = await Api.DonemOzetiAsync();
        if (sonuc is null)
        {
            ozetHata = mesaj ?? "bağlantı hatası";
            return;
        }
        ozet = sonuc;
        ozetHata = null;
    }

    /// <summary>Matristen işaret/not/kanıt değişti: sekme rozetleri ve "açık dönem" kutusu tazelensin.</summary>
    private async Task OzetTazele()
    {
        var (sonuc, _) = await Api.DonemOzetiAsync();
        if (sonuc is not null) ozet = sonuc;
    }

    private void DonemeGit(string anahtar, int? firmaId) => Nav.NavigateTo(Kur(null, anahtar, firmaId));

    /// <summary>
    /// Firma seçici: açık sekmede kalınır, yalnız firma değişir (adres → geri tuşu çalışır, bağlantı paylaşılır).
    /// Nasıl yapılır'da seçili iş korunur; Kişiler'deki tek kişi filtresi bırakılır.
    /// </summary>
    private void FirmaSec(int? firmaId)
    {
        if (firmaId == Firma) return;
        var adres = SabitSekme ? Kur(Sekme!.ToLowerInvariant(), null, firmaId)
                  : secili is { } s ? Kur(null, s.Anahtar, firmaId)
                  : ozet is not null ? Kur(null, ozet.VarsayilanAnahtar, firmaId)
                  : Kur(OzetSekme, null, firmaId);
        if (NasilSekmesi && !string.IsNullOrEmpty(Is)) adres += "&is=" + Uri.EscapeDataString(Is);
        Nav.NavigateTo(adres);
    }

    /// <summary>Panodan ekleme bitti: rozetler/özet ve açık sekme tazelenir — sayfa yenilemeye gerek yok.</summary>
    private async Task Eklendi()
    {
        surum++;
        await OzetTazele();
        StateHasChanged();
    }

    private Task EylemIsEkle() => eylemler?.IsEkle() ?? Task.CompletedTask;
    private Task EylemYapistir() => eylemler?.YapistirDugmesi() ?? Task.CompletedTask;
    private Task EylemCtrlV(string metin) => eylemler?.TopluAc(metin) ?? Task.CompletedTask;

    private void AyKaydir(int fark)
    {
        if (secili is not { } s) return;
        var t = new DateTime(s.Yil, s.Ay, 1).AddMonths(fark);
        DonemeGit($"{t.Year:0000}-{t.Month:00}", Firma);
    }

    /// <summary>Sekme/dönem adresi — sayfanın firma seçimi (?firma=) HER SEKMEDE taşınır (Prompt 15).</summary>
    private string Adres(string? sekme, string? donem = null) => Kur(sekme, donem, Firma);

    private static string Kur(string? sekme, string? donem, int? firmaId)
    {
        var adres = sekme is not null ? $"{IsTakipPanosuAdres.Yol}?sekme={sekme}" : $"{IsTakipPanosuAdres.Yol}?donem={donem}";
        return firmaId is { } f ? adres + $"&firma={f}" : adres;
    }

    /// <summary>"2026-09" → (2026, 9). Biçim sunucudaki aylık dönem anahtarıyla aynı.</summary>
    private static (int Yil, int Ay, string Anahtar)? Coz(string anahtar)
    {
        var p = anahtar.Trim().Split('-');
        if (p.Length != 2 || !int.TryParse(p[0], out var y) || !int.TryParse(p[1], out var a)
            || y is < 2000 or > 2100 || a is < 1 or > 12)
            return null;
        return (y, a, $"{y:0000}-{a:00}");
    }

    private static string Etiket(int y, int a)
        => $"{new System.Globalization.CultureInfo("tr-TR").DateTimeFormat.GetMonthName(a)} {y}";

    private static string SekmeBasligi(DonemSekmesiDto d)
        => (d.IcindeBulunulan ? "İçinde bulunulan ay · " : "")
           + (d.Toplam == 0 ? "bu ayda kapanan iş yok" : d.Eksik == 0 ? $"{d.Yapilan}/{d.Toplam} · tamam" : $"{d.Yapilan}/{d.Toplam} · {d.Eksik} eksik");
}