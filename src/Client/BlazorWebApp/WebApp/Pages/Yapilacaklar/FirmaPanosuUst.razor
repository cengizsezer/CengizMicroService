@*
    Firma Panosu'nun ortak başlığı ve üst sekme şeridi (Aşama 1): İş Takip | Yapılacaklar. İki AYRI sayfa (adresleri
    değişmedi); sekmeler <a href> — geri tuşu çalışır. İş Takip Panosu'nun kendi alt sekme şeridi (dp-sekmeler)
    sayfanın altında olduğu gibi durur. Sağ taraf (ChildContent) sayfanın eylemleri için.
*@

<div class="ck-kok">
    <div class="ck-iz"><span>Firma Panosu</span><span>›</span><b>@(Aktif == FirmaPanosuSekmesi.IsTakip ? "İş Takip" : "Yapılacaklar")</b></div>
    <div class="ck-baslik-satir">
        <div class="ck-baslik-ikon" aria-hidden="true">☑</div>
        <div>
            <h1 class="ck-baslik">Firma Panosu</h1>
        </div>
        @if (!string.IsNullOrEmpty(Rozet))
        {
            <span class="ck-rozet">@Rozet</span>
        }
        <nav class="ck-sekmeler" aria-label="Firma Panosu">
            <a class="ck-sekme" href="@IsTakipPanosuAdres.Yol" aria-current="@(Aktif == FirmaPanosuSekmesi.IsTakip ? "page" : null)">İş Takip</a>
            <a class="ck-sekme" href="/yapilacaklar" aria-current="@(Aktif == FirmaPanosuSekmesi.Yapilacaklar ? "page" : null)">Yapılacaklar</a>
        </nav>
        <span class="ck-bosluk"></span>
        @ChildContent
    </div>
    @if (!string.IsNullOrEmpty(Aciklama))
    {
        <div class="ck-aciklama">@Aciklama</div>
    }
</div>

@code {
    [Parameter] public FirmaPanosuSekmesi Aktif { get; set; }

    /// <summary>Başlığın yanındaki küçük sayı ("4 firma").</summary>
    [Parameter] public string? Rozet { get; set; }

    [Parameter] public string? Aciklama { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
