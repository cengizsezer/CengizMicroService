@page "/vehicles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using System.Text.Json
@using WebApp.Application.Services
@using WebApp.Shared.Dto
@using Microsoft.JSInterop
@using System.Linq
@using WebApp.Utils
@using WebApp.Application.Services.Interfaces
@inject IVehicleService VehicleService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject HttpClient Http
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>ARACLAR</PageTitle>

<div class="rz-p-3">
    <div class="rz-flex rz-ai-center rz-jc-between rz-mb-3">
        <div class="rz-flex rz-ai-center rz-g-2">
            <RadzenButton Text="Add Vehicle"
                          Icon="add_circle"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@InsertRow" />

            <!-- IMPORT: Excel -> backend 'api/vehicles/import-excel' -->
            <RadzenUpload @ref="excelUpload"
                          Auto="false"
                          Multiple="false"
                          Accept=".xlsx"
                          Change="@OnExcelSelected" />

            <RadzenButton Text="Import Excel"
                          Click="@OnExcelUpload"
                          Disabled="@(selectedExcel is null)" />

            <RadzenButton Text="Export Excel"
                          Icon="download"
                          ButtonStyle="ButtonStyle.Info"
                          Disabled="@exporting"
                          Click="@ExportExcel" />

            <RadzenButton Text="Delete All"
                          Icon="delete_forever"
                          ButtonStyle="ButtonStyle.Danger"
                          Disabled="@(view.Count == 0)"
                          Click="@DeleteAll" />
        </div>

        <div class="rz-flex rz-ai-center rz-g-2">
            <RadzenTextBox @bind-Value="search"
                           Placeholder="Search (Plate, Driver, Unit, Department)"
                           Style="width: 360px"
                           Change="@(args => ApplySearch())" />
        </div>
    </div>
    <div class="grid-wrap">
    <RadzenDataGrid @ref="grid"
                    Data="@view"
                    TItem="VehicleDto"
                    EditMode="DataGridEditMode.Single"
                    RowCreate="@OnCreateRow"
                    RowUpdate="@OnUpdateRow"
                    AllowFiltering="false"
                    AllowSorting="true"
                    AllowPaging="true"
                    AllowColumnResize="true"
                        ColumnWidth="150px"
                        IsLoading=@isLoading
                    PageSize="20"
                    RowDoubleClick="@OnRowDoubleClick">
        <Columns>
            <RadzenDataGridColumn TItem="VehicleDto" Property="Id" Title="ID" Width="90px" />
            <RadzenDataGridColumn TItem="VehicleDto" Property="Plate" Title="Plate">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Plate" Name="Plate" Style="width:100%" />
                    <RadzenRequiredValidator Component="Plate" Text="Plate is required" Popup="true" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Driver" Title="Driver">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Driver" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Unit" Title="Unit">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Unit" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Department" Title="Department">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Department" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VehicleDto" Property="Description1" Title="Description1" Width="220px">
                <EditTemplate Context="row">
                    <RadzenTextArea @bind-Value="row.Description1" Rows="2" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Region" Title="Region">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Region" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Description2" Title="Description2" Width="220px">
                <EditTemplate Context="row">
                    <RadzenTextArea @bind-Value="row.Description2" Rows="2" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Type" Title="Type">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Type" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Brand" Title="Brand">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Brand" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Model" Title="Model">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Model" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Gear" Title="Gear">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Gear" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Fuel" Title="Fuel">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Fuel" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VehicleDto" Property="Fleet" Title="Fleet">
                <EditTemplate Context="row">
                    <RadzenTextBox @bind-Value="row.Fleet" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="VehicleDto"
                    Title="Actions"
                    Width="210px"
                    TextAlign="TextAlign.Center"
                    Filterable="false"
                    Sortable="false"
                    Frozen="true"
                    FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="row">
                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Warning"
                                  Size="ButtonSize.Small"
                                  class="rz-mr-2"
                                  Click="@(()=> EditRow(row))" />
                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Click="@(()=> DeleteRow(row))" />
                </Template>
                <EditTemplate Context="row">
                    <RadzenButton Icon="check"
                                  ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small"
                                  class="rz-mr-2"
                                  Click="@((args)=> SaveRow(row))" />
                    <RadzenButton Icon="close"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@((args)=> CancelEdit(row))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </div>
</div>

@code {
    RadzenDataGrid<VehicleDto> grid;
    List<VehicleDto> items = new();
    List<VehicleDto> view = new(); // filtrelenmiş görünüm
    string search;
    bool exporting = false;
    IBrowserFile? selectedExcel;
    RadzenUpload? excelUpload;
    bool isLoading = false;
    void OnExcelSelected(UploadChangeEventArgs args)
    {
        selectedExcel = args.Files?.FirstOrDefault();
        // _ = OnExcelUpload(); // seçer seçmez otomatik başlat
    }

    async Task OnExcelUpload()
    {
        if (selectedExcel is null) return;

        using var stream = selectedExcel.OpenReadStream(100_000_000);
        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType =
            new System.Net.Http.Headers.MediaTypeHeaderValue(
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        content.Add(fileContent, "file", selectedExcel.Name);

        // HttpClient BaseAddress: http://localhost:5000/
        var resp = await Http.PostAsync("/catalog/vehicles/parse-excel", content);
        if (!resp.IsSuccessStatusCode)
        {
            var err = await resp.Content.ReadAsStringAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Parse hatası", err);
            return;
        }

        var list = await resp.Content.ReadFromJsonAsync<List<VehicleDto>>() ?? new();

        var ok = await DialogService.OpenAsync<ImportVehiclesDialog>(
            "Import Vehicles",
            new Dictionary<string, object> { { "Items", list } },
            new DialogOptions { Width = "960px", CloseDialogOnOverlayClick = true });

        if (ok is true) await ReloadAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        var canView = await PermissionService.HasPermissionAsync("Vehicle.View");

        if (!canView)
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        isLoading = true;
        items = await VehicleService.GetAllAsync();
        ApplySearch();
        StateHasChanged();
        isLoading = false;
    }
    async Task OnRowDoubleClick(DataGridRowMouseEventArgs<VehicleDto> args)
    {
        // args.Data = çift tıklanan satırın verisi
        await EditVehicle(args.Data); // mevcut Edit akışını çağır
    }
    void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            view = items.ToList();
        }
        else
        {
            var s = search.Trim();
            view = items.Where(x =>
                    (!string.IsNullOrEmpty(x.Plate) && x.Plate.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(x.Driver) && x.Driver.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(x.Unit) && x.Unit.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(x.Department) && x.Department.Contains(s, StringComparison.OrdinalIgnoreCase))
                ).ToList();
        }
        grid?.Reload();
    }
   
    async Task CreateVehicle()
    {
        var result = await DialogService.OpenAsync<CreateorUpdateVehicle>(
            "Add Vehicle",
            new Dictionary<string, object>
            {
                { "Action", UIActionEnum.Insert },
                { "model", new VehicleDto() }
            },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true });

        if (result is true) await ReloadAsync();
    }

    async Task EditVehicle(VehicleDto row)
    {
        var result = await DialogService.OpenAsync<ImportVehiclesDialog>(
            "Edit Vehicle",
            new Dictionary<string, object>
            {
                { "Action", UIActionEnum.Update },
                { "model", row }
            },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true });

        if (result is true) await ReloadAsync();
    }

    async Task DeleteVehicle(VehicleDto row)
    {
        var confirm = await DialogService.Confirm(
            $"Delete vehicle '{row.Plate}'?", "Confirm",
            new ConfirmOptions() { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            var ok = await VehicleService.DeleteAsync(row.Id);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = ok ? NotificationSeverity.Success : NotificationSeverity.Error,
                Summary = ok ? "Deleted" : "Delete failed",
                Duration = 2500
            });

            if (ok) await ReloadAsync();
        }
    }

    async Task DeleteAll()
    {
        var confirm = await DialogService.Confirm(
            "Tüm araçlar silinecek ve ID sayaçları sıfırlanacak. Emin misiniz?",
            "Onay",
            new ConfirmOptions { OkButtonText = "Evet, Sil", CancelButtonText = "Vazgeç", ShowClose = false });

        if (confirm == true)
        {
            var ok = await VehicleService.DeleteAllAsync();
            NotificationService.Notify(new NotificationMessage
            {
                Severity = ok ? NotificationSeverity.Success : NotificationSeverity.Error,
                Summary = ok ? "Silindi" : "Silme başarısız",
                Detail = ok ? "Tüm araçlar silindi." : "Sunucu silme sırasında hata döndü.",
                Duration = 2500
            });

            if (ok) await ReloadAsync();
        }
    }


    async Task ExportExcel()
    {
        exporting = true;
        try
        {
            var bytes = await VehicleService.ExportExcelAsync();
            await JS.InvokeVoidAsync("downloadFileFromBytes",
                $"vehicles_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", bytes);
        }
        finally
        {
            exporting = false;
        }
    }

    void OnUploadProgress(UploadProgressArgs args)
    {
        // İstersen progress bar göster
        // args.Progress: 0..100
    }

    async Task OnUploadComplete(UploadCompleteEventArgs args)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(args.RawResponse))
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Import failed", Detail = "Sunucudan yanıt gelmedi." });
                return;
            }

            var list = JsonSerializer.Deserialize<List<VehicleDto>>(args.RawResponse,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (list == null || list.Count == 0)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Boş", Detail = "Excel'den veri okunamadı." });
                return;
            }

            // Ön izleme dialogunu aç
            var result = await DialogService.OpenAsync<ImportVehiclesDialog>(
                "Import Vehicles",
                new Dictionary<string, object>
                {
                { "Items", list }   // ImportVehiclesDialog'ta [Parameter] Items ile karşıla
                },
                new DialogOptions { Width = "960px", CloseDialogOnOverlayClick = true });

            if (result is true)
                await ReloadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Hata", Detail = ex.Message });
        }
    }


    async Task InsertRow()
    {
        var newItem = new VehicleDto();
        await grid.InsertRow(newItem);
    }

    async Task EditRow(VehicleDto row)
    {
        await grid.EditRow(row);
    }

    async Task SaveRow(VehicleDto row)
    {
        await grid.UpdateRow(row); // → OnUpdateRow tetiklenir
    }

    void CancelEdit(VehicleDto row)
    {
        grid.CancelEditRow(row);
    }

    async Task OnCreateRow(VehicleDto row)
    {
        // Plate normalize DB tarafında da var ama UI'da da güvene alabiliriz
        row.Plate = row.Plate?.Trim();

        var ok = await VehicleService.CreateAsync(row);
        if (!ok)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Create failed", "Kayıt eklenemedi.");
            grid.CancelEditRow(row);
            return;
        }
        await ReloadAsync(); // Id’nin güncellenmesi için taze liste
    }

    async Task OnUpdateRow(VehicleDto row)
    {
        row.Plate = row.Plate?.Trim();

        var ok = await VehicleService.UpdateAsync(row);
        if (!ok)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Update failed", "Kayıt güncellenemedi.");
            grid.CancelEditRow(row);
            return;
        }
        // İstersen sadece satırı bırakabilir veya tüm listeyi tazeleyebilirsin
        // await ReloadAsync();
    }

    async Task DeleteRow(VehicleDto row)
    {
        await DeleteVehicle(row); // mevcut confirm akışını kullanıyoruz
    }
}
