@page "/ticaret-sicil"
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.TicaretSicil
@inject ITicaretSicilApi Api
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem" AlignItems="AlignItems.Stretch">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenIcon Icon="account_balance" Style="font-size:2rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Ticaret Sicil İşlemleri</RadzenText>
        </RadzenStack>
        <RadzenButton Text="Yeni işlem ekle" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Navigation.NavigateTo("/ticaret-sicil/duzenle"))" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
        Yapmak istediğiniz işlemi seçin. İşlemin adımlarını sırayla görür, her adımdaki örnek
        dilekçe/belgeye tıklayarak yan panelde görüntüleyebilirsiniz.
    </RadzenText>

    @if (islemler is null)
    {
        <RadzenCard class="rz-p-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <span>Yükleniyor...</span>
            </RadzenStack>
        </RadzenCard>
    }
    else if (islemler.Count == 0)
    {
        <RadzenCard class="rz-p-4"><em>Henüz tanımlı işlem bulunmuyor.</em></RadzenCard>
    }
    else
    {
        <div class="grid">
            @foreach (var islem in islemler)
            {
                <div class="col-12 sm:col-6 lg:col-4">
                    <RadzenCard class="ts-islem-card rz-p-4"
                                Style="cursor:pointer; height:100%;"
                                @onclick="@(() => Navigation.NavigateTo($"/ticaret-sicil/{islem.Slug}"))">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenIcon Icon="@IconFor(islem.Kategori)" Style="font-size:1.75rem; color: var(--rz-primary);" />
                            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@islem.Ad</RadzenText>
                        </RadzenStack>
                        @if (!string.IsNullOrWhiteSpace(islem.Kategori))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@islem.Kategori" class="rz-mt-2" />
                        }
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mt-2 rz-mb-0">
                            @islem.Aciklama
                        </RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     Gap="0.25rem" class="rz-mt-3">
                            <RadzenIcon Icon="list_alt" Style="font-size:1rem;" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@islem.AdimSayisi adım</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</RadzenStack>

<style>
    .ts-islem-card {
        transition: box-shadow .15s ease, transform .15s ease;
    }

    .ts-islem-card:hover {
        box-shadow: var(--rz-shadow-3);
        transform: translateY(-2px);
    }
</style>

@code {
    private List<TicaretSicilIslemListDto>? islemler;

    protected override async Task OnInitializedAsync()
    {
        islemler = await Api.GetAllAsync();
    }

    private static string IconFor(string? kategori) => kategori switch
    {
        "Kuruluş" => "store",
        "Değişiklik" => "trending_up",
        "Yapısal İşlem" => "merge",
        _ => "description"
    };
}
