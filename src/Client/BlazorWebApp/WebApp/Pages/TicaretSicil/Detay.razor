@page "/ticaret-sicil/{Slug}"
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.TicaretSicil
@inject ITicaretSicilApi Api
@inject IFileApiService FileApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (loading)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        <span>Yükleniyor...</span>
    </RadzenStack>
}
else if (islem is null)
{
    <RadzenStack Gap="1rem">
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="true">
            Aradığınız işlem bulunamadı.
        </RadzenAlert>
        <RadzenButton Text="Ticaret Sicil İşlemleri" Icon="arrow_back"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Navigation.NavigateTo("/ticaret-sicil"))" />
    </RadzenStack>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => Navigation.NavigateTo("/ticaret-sicil"))" />
                <RadzenIcon Icon="account_balance" Style="font-size:1.75rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@islem.Ad</RadzenText>
            </RadzenStack>
            <RadzenButton Text="Düzenle" Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => Navigation.NavigateTo($"/ticaret-sicil/duzenle/{islem.Id}"))" />
        </RadzenStack>

        @if (!string.IsNullOrWhiteSpace(islem.Aciklama))
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-m-0">@islem.Aciklama</RadzenText>
        }

        <div class="ts-detay-grid">
            @* ---- Sol: adımlar ---- *@
            <div class="ts-adimlar">
                <RadzenStack Gap="0.75rem">
                    @foreach (var adim in islem.Adimlar)
                    {
                        <RadzenCard class="rz-p-3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                                <div class="ts-adim-no">@adim.Sira</div>
                                <RadzenStack Gap="0.35rem" Style="flex:1; min-width:0;">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@adim.Baslik</RadzenText>
                                    @if (!string.IsNullOrWhiteSpace(adim.Aciklama))
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-m-0">@adim.Aciklama</RadzenText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(adim.Not))
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
                                                     ShowIcon="true" AllowClose="false" class="rz-my-1 rz-p-2">
                                            @adim.Not
                                        </RadzenAlert>
                                    }

                                    @if (adim.Ekler.Count > 0)
                                    {
                                        <RadzenStack Gap="0.35rem" class="rz-mt-1">
                                            @foreach (var ek in adim.Ekler)
                                            {
                                                var isSelected = secili?.Id == ek.Id;
                                                <RadzenButton Click="@(() => SelectEk(ek))"
                                                              ButtonStyle="@(isSelected ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                              Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                                              Size="ButtonSize.Small"
                                                              Icon="@(ek.Tur == EkTur.Resim ? "image" : "picture_as_pdf")"
                                                              Text="@ek.Ad"
                                                              class="ts-belge-btn" />
                                            }
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            </div>

            @* ---- Sağ: belge görüntüleyici ---- *@
            <div class="ts-viewer">
                <RadzenCard class="rz-p-0 ts-viewer-card">
                    @if (secili is null)
                    {
                        <div class="ts-viewer-empty">
                            <RadzenIcon Icon="touch_app" Style="font-size:2.5rem; color: var(--rz-text-disabled-color);" />
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary rz-mt-2">
                                Görüntülemek için bir belgeye tıklayın.
                            </RadzenText>
                        </div>
                    }
                    else
                    {
                        <div class="ts-viewer-head">
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@secili.Ad</RadzenText>
                            @if (!string.IsNullOrWhiteSpace(seciliUrl))
                            {
                                <RadzenButton Icon="open_in_new" Text="Yeni sekmede aç"
                                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => OpenInNewTab(seciliUrl!))" />
                            }
                        </div>

                        <div class="ts-viewer-body">
                            @if (viewerYukleniyor)
                            {
                                <div class="ts-viewer-empty">
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                                               Size="ProgressBarCircularSize.Small" />
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mt-2">Yükleniyor...</RadzenText>
                                </div>
                            }
                            else if (string.IsNullOrWhiteSpace(seciliUrl))
                            {
                                <div class="ts-viewer-empty">
                                    <RadzenIcon Icon="broken_image" Style="font-size:2.5rem; color: var(--rz-warning);" />
                                    <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2 rz-mb-1">Belge görüntülenemiyor</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary" Style="text-align:center;">
                                        Belgeye şu an erişilemiyor. Lütfen daha sonra tekrar deneyin.
                                    </RadzenText>
                                </div>
                            }
                            else if (secili.Tur == EkTur.Resim)
                            {
                                <img src="@seciliUrl" alt="@secili.Ad" class="ts-viewer-img" />
                            }
                            else
                            {
                                <object data="@seciliUrl" type="application/pdf" class="ts-viewer-frame">
                                    <div class="ts-viewer-empty">
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mb-2">
                                            Belge tarayıcıda gösterilemiyor.
                                        </RadzenText>
                                        <RadzenButton Icon="open_in_new" Text="Bağlantıyı aç"
                                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                      Click="@(() => OpenInNewTab(seciliUrl!))" />
                                    </div>
                                </object>
                            }
                        </div>
                    }
                </RadzenCard>
            </div>
        </div>
    </RadzenStack>
}

<style>
    .ts-detay-grid {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) minmax(0, 1.4fr);
        gap: 1rem;
        align-items: start;
    }

    .ts-viewer {
        position: sticky;
        top: 1rem;
    }

    .ts-viewer-card {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 220px);
        min-height: 420px;
        overflow: hidden;
    }

    .ts-viewer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        padding: .65rem .85rem;
        border-bottom: 1px solid var(--rz-border-color, #e0e0e0);
    }

    .ts-viewer-body {
        flex: 1;
        min-height: 0;
        position: relative;
    }

    .ts-viewer-frame {
        width: 100%;
        height: 100%;
        border: none;
    }

    .ts-viewer-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: var(--rz-base-200, #fafafa);
    }

    .ts-viewer-empty {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        text-align: center;
    }

    .ts-adim-no {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--rz-primary);
        color: var(--rz-primary-contrast-text, #fff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: .85rem;
    }

    .ts-belge-btn {
        justify-content: flex-start;
        text-align: left;
        max-width: 100%;
    }

    @@media (max-width: 900px) {
        .ts-detay-grid {
            grid-template-columns: 1fr;
        }

        .ts-viewer {
            position: static;
        }

        .ts-viewer-card {
            height: 70vh;
        }
    }
</style>

@code {
    [Parameter] public string? Slug { get; set; }

    private TicaretSicilIslemDetayDto? islem;
    private bool loading = true;

    private TicaretSicilEkDto? secili;
    private string? seciliUrl;
    private bool viewerYukleniyor;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        secili = null;
        seciliUrl = null;
        islem = string.IsNullOrWhiteSpace(Slug) ? null : await Api.GetBySlugAsync(Slug);
        loading = false;
    }

    private async Task SelectEk(TicaretSicilEkDto ek)
    {
        secili = ek;
        seciliUrl = null;
        viewerYukleniyor = true;
        StateHasChanged();

        try
        {
            var dto = await FileApi.GetDownloadAsync(ek.FileId);
            seciliUrl = dto?.PresignedUrl;
        }
        catch
        {
            seciliUrl = null;
        }

        viewerYukleniyor = false;
        StateHasChanged();
    }

    private async Task OpenInNewTab(string url)
        => await JS.InvokeVoidAsync("open", url, "_blank");
}
