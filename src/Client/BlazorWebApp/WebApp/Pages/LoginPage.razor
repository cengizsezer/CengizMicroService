@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Application.Services.Interfaces
@inject NavigationManager NavigationManager
@inject IIdentityService IdentityService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<style>
    .login-container {
        display: flex;
        min-height: 100vh;
        width: 100vw;
    }

    .login-left {
        position: relative;
        width: 66.66vw;
        height: 100vh;
        background-color: #f5f7fa;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        text-align: center;
        overflow: hidden;
    }

    .login-image {
        width: 120%;
        height: 120%;
        object-fit: cover;
        display: block;
    }

    .login-title-on-image {
        position: absolute;
        bottom: 5%;
        left: 50%;
        transform: translateX(-50%);
        font-weight: 800;
        font-size: 2rem;
        color: white;
        text-shadow: 0 0 10px rgba(0, 123, 255, 0.8);
        z-index: 2;
        text-align: center;
    }

    .login-right {
        width: 33.33vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(to bottom right, #f0f4ff, #ffffff);
    }

    .login-card {
        width: 100%;
        max-width: 600px;
        padding: 2rem;
        border-radius: 8px;
        /* box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); */
        background-color: transparent;
    }

    .login-logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 10rem;
        margin-top: -3rem;
    }

    .login-logo {
        max-height: 200px;
        width: auto;
    }

    .login-title {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .alternative-login {
        text-align: center;
        margin: 1rem 0;
    }

    .login-options {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }

    .RadzenTextBox,
    .RadzenPassword,
    .RadzenButton {
        width: 130% !important;}
</style>

<div class="login-container">
    <div class="login-left">
        <img src="img/Login.jpeg" alt="Digital Accounting" class="login-image" />
        @* <h2 class="login-title-on-image">DİJİTAL<br />MASRAF</h2> *@
    </div>

    <div class="login-right">
        <div class="login-card">
            <!-- 🟦 BURASI: Logo alanı eklendi -->
            <div class="login-logo-container">
                <img src="img/LogoWithText.png" alt="Dijital Masraf Logo" class="login-logo" />
            </div>

            <div class="login-title">
                <RadzenHeading Size="H4">Giriş Yap</RadzenHeading>
            </div>

            <div class="alternative-login">
                <RadzenText>
                    Firma Kodu veya Kullanıcı Kodu ile mi giriş yapıyorsunuz?
                    <RadzenLink Text="Buraya tıklayınız" Path="#" Style="color: #3b82f6; margin-left: 5px;" />
                </RadzenText>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <RadzenLabel Text="@errorMessage" Style="color: #d32f2f; margin-bottom: 12px; text-align: center;" />
            }

            <EditForm EditContext="@loginEditContext" OnValidSubmit="@OnLogin">
                <DataAnnotationsValidator />

                <RadzenTextBox @bind-Value="loginModel.Username" Placeholder="Kullanıcı Adı (veya E-posta)" Style="width: 100%; margin-bottom: 1rem;" Name="Username" />
                <ValidationMessage For="@(() => loginModel.Username)" />

                <RadzenPassword @bind-Value="loginModel.Password" Placeholder="Şifre" Style="width: 100%; margin-bottom: 1rem;" Name="Password" />
                <ValidationMessage For="@(() => loginModel.Password)" />

                <div class="login-options">
                    <RadzenCheckBox @bind-Value="rememberMe" Style="margin-right: 5px;" />
                    <RadzenLabel Text="Beni Hatırla" />
                </div>

                <RadzenLink Text="Şifremi Unuttum" Path="#" Style="color: #3b82f6; display: block; text-align: right; margin-bottom: 1rem;" />

                <RadzenButton ButtonType="ButtonType.Submit" Disabled="@isLoading"
                               Style="width: 100%; background-color: #3b82f6; color: white; font-weight: 600; border-radius: 25px; padding: 10px;">
                    @if (isLoading)
                    {
                        <div style="display: flex; align-items: center; justify-content: center;">
                            <RadzenProgressCircle ShowValue="false" Style="width: 20px; height: 20px; margin-right: 8px;" />
                            <span>Giriş Yapılıyor...</span>
                        </div>
                    }
                    else
                    {
                        <span>Giriş Yap</span>
                    }
                </RadzenButton>
            </EditForm>

            <div class="alternative-login" style="margin-top: 2rem;">
                <RadzenText>
                    Hesabınız yok mu?
                    <RadzenLink Text="Kayıt Ol" Path="/register" Style="color: #3b82f6; margin-left: 5px;" />
                </RadzenText>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private EditContext loginEditContext;
    private bool isLoading = false;
    private string errorMessage;
    private bool rememberMe = true;

    public class LoginModel
    {
        [Required(ErrorMessage = "Kullanıcı adı zorunludur")]
        public string Username { get; set; }

        [Required(ErrorMessage = "Şifre zorunludur")]
        public string Password { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        loginEditContext = new EditContext(loginModel);

        var (savedUsername, savedPassword) = await IdentityService.GetRememberedCredentials();
        loginModel.Username = savedUsername;
        loginModel.Password = savedPassword;
    }

    private async Task OnLogin()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var success = await IdentityService.Login(loginModel.Username, loginModel.Password, rememberMe);

            if (success)
            {
                NavigationManager.NavigateTo("/home");
            }
            else
            {
                errorMessage = "Geçersiz kullanıcı adı veya şifre.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Bir hata oluştu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
