@page "/smmm-takip"
@using System.Text
@using System.Text.RegularExpressions
@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.SmmmTakip
@using Microsoft.AspNetCore.Components.Web
@inject ISmmmTakipApi Api
@inject DialogService Dialog
@inject NotificationService Notif

<style>
    .st-left { height: calc(100vh - 140px); display: flex; flex-direction: column; }
    .st-viewer { min-height: 220px; padding: 12px 16px; border-radius: 6px; border: 1px solid #eee; background: #fff; }
    .st-md { font-size: 15px; line-height: 1.7; }
    /* Okuma genişliği (74ch) yalnızca metin akışına; şema/tablo panelin tamamına yayılsın. */
    .st-md h2, .st-md h3, .st-md h4, .st-md p, .st-md ul { max-width: 74ch; }
    .st-md h2 { font-size: 19px; margin: 1rem 0 .4rem; }
    .st-md h3 { font-size: 17px; margin: 1rem 0 .4rem; }
    .st-md h4 { font-size: 15px; margin: 1rem 0 .4rem; }
    .st-md p { margin: 0 0 .8rem; }
    .st-md ul { margin: 0 0 .8rem 1.2rem; }
    .st-md code { font-family: ui-monospace, Consolas, monospace; background: #f3f3f3; padding: 1px 4px; border-radius: 3px; font-size: 13px; }
    .st-panel { border: 1px solid #eee; border-radius: 6px; padding: 12px 16px; margin-top: 12px; background: #fff; }
    .st-form-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 8px; }
    .st-form-row > div { display: flex; flex-direction: column; gap: 2px; }
    .st-form-row label { font-size: 11px; color: #888; }
    .st-year-chips { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
</style>

<div class="row">
    <!-- SOL: Konu ağacı -->
    <div class="col-4">
        <div class="st-left">
            <RadzenTextBox placeholder="Ara (başlık)" type="search"
                           @oninput="Filter" style="width:100%; margin-bottom:8px" />

            <div style="flex:0 0 auto">
                <RadzenTree Style="width:100%" Change="@OnSelect">
                    @foreach (var root in _viewRoots)
                    {
                        @RenderNode(root)
                    }
                </RadzenTree>
            </div>

            <div class="rz-mt-3">
                <RadzenButton Text="Yeni Konu" Icon="add" ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Small" Click="@(() => _yeniKonuAcik = !_yeniKonuAcik)" />
            </div>

            @if (_yeniKonuAcik)
            {
                <div class="st-panel">
                    <div class="st-form-row">
                        <div style="flex:1 1 100%">
                            <label>Başlık</label>
                            <RadzenTextBox @bind-Value="_yeniKonu.Baslik" Style="width:100%" />
                        </div>
                        <div style="flex:1 1 100%">
                            <label>Üst Konu</label>
                            <RadzenDropDown TValue="int?" @bind-Value="_yeniKonu.UstKonuId" Data="_konuSecenekleri"
                                            TextProperty="Ad" ValueProperty="Id" AllowClear="true"
                                            Placeholder="(Kök)" Style="width:100%" />
                        </div>
                        <div>
                            <label>Sıra</label>
                            <RadzenNumeric TValue="int" @bind-Value="_yeniKonu.Sira" Style="width:90px" />
                        </div>
                    </div>
                    <RadzenButton Text="Kaydet" Icon="save" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary" Click="@CreateKonuAsync" />
                    <RadzenButton Text="Vazgeç" Size="ButtonSize.Small" Click="@(() => _yeniKonuAcik = false)" />
                </div>
            }
        </div>
    </div>

    <!-- SAĞ: Detay -->
    <div class="col-8">
        @if (_detay is null)
        {
            <div class="text-muted">Soldan bir konu seçin.</div>
        }
        else
        {
            <div style="display:flex; justify-content:space-between; align-items:center">
                <h4 style="margin:0">@_detay.Baslik</h4>
                <div>
                    @if (!_editIcerik)
                    {
                        <RadzenButton Text="Düzenle" Icon="edit" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary" Click="@StartEditIcerik" class="rz-mr-1" />
                        <RadzenButton Text="Konuyu Sil" Icon="delete" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@DeleteKonuAsync" />
                    }
                </div>
            </div>

            <!-- Şema yazı boyutu (tüm dal şemalarını birlikte büyütür/küçültür) -->
            @if (!_editIcerik)
            {
                <div style="display:flex; align-items:center; gap:6px; margin:8px 0" title="Dal şemalarının yazı boyutu">
                    <span style="font-size:12px; color:var(--text-secondary,#718096)">Şema boyutu</span>
                    <RadzenButton Text="A−" Size="ButtonSize.Small" Variant="Variant.Outlined"
                                  Disabled="@(_semaOlcekIdx == 0)" Click="@SemaKucult" />
                    <span style="min-width:76px; text-align:center; font-size:13px; font-weight:600">@_semaOlcekAd[_semaOlcekIdx]</span>
                    <RadzenButton Text="A+" Size="ButtonSize.Small" Variant="Variant.Outlined"
                                  Disabled="@(_semaOlcekIdx == _semaOlcekler.Length - 1)" Click="@SemaBuyut" />
                </div>
            }

            <!-- İçerik (markdown) -->
            <div class="st-viewer rz-mt-2">
                @if (!_editIcerik)
                {
                    <div class="st-md" style="@SemaScaleStyle">@RenderMarkdown(_detay.IcerikMd)</div>
                }
                else
                {
                    <RadzenTextArea @bind-Value="_icerikDraft" Style="width:100%; min-height:260px; font-family:ui-monospace,Consolas,monospace" />
                    <div class="rz-mt-2">
                        <RadzenButton Text="Kaydet" Icon="save" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary" Click="@SaveIcerikAsync" class="rz-mr-1" />
                        <RadzenButton Text="Vazgeç" Size="ButtonSize.Small" Click="@(() => _editIcerik = false)" />
                    </div>
                }
            </div>

            <!-- Hadler -->
            <div class="st-panel">
                <div class="st-year-chips">
                    <strong>Hadler</strong>
                    <span class="rz-ml-2" style="font-size:12px;color:#888">Yıl:</span>
                    <RadzenNumeric TValue="int" Value="_seciliYil" Change="@OnYilChanged" Min="2000" Max="2100" Style="width:100px" />
                    @foreach (var y in _yillar)
                    {
                        <RadzenButton Text="@y.ToString()" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="@(y == _seciliYil ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Click="@(() => SetYil(y))" />
                    }
                    <RadzenButton Text="Yeni Had" Icon="add" Size="ButtonSize.ExtraSmall"
                                  ButtonStyle="ButtonStyle.Secondary" Click="@(() => _yeniHadAcik = !_yeniHadAcik)" class="rz-ml-2" />
                </div>

                @if (_yeniHadAcik)
                {
                    <div class="st-panel">
                        <div class="st-form-row">
                            <div><label>Kod</label><RadzenTextBox @bind-Value="_yeniHad.Kod" Style="width:180px" /></div>
                            <div style="flex:1 1 220px"><label>Ad</label><RadzenTextBox @bind-Value="_yeniHad.Ad" Style="width:100%" /></div>
                            <div>
                                <label>Birim</label>
                                <RadzenDropDown TValue="string" @bind-Value="_yeniHad.Birim" Data="_birimler" Style="width:90px" />
                            </div>
                            <div><label>Dayanak</label><RadzenTextBox @bind-Value="_yeniHad.Dayanak" Style="width:140px" /></div>
                            <div><label>Sıra</label><RadzenNumeric TValue="int" @bind-Value="_yeniHad.Sira" Style="width:80px" /></div>
                        </div>
                        <RadzenButton Text="Kaydet" Icon="save" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary" Click="@CreateHadAsync" />
                        <RadzenButton Text="Vazgeç" Size="ButtonSize.Small" Click="@(() => _yeniHadAcik = false)" />
                    </div>
                }

                @if (_detay.Hadler.Count == 0)
                {
                    <div class="text-muted rz-mt-2">Bu konu için tanımlı had yok.</div>
                }
                else
                {
                    <table class="rz-mt-2" style="width:100%; border-collapse:collapse; font-size:14px">
                        <thead>
                            <tr style="text-align:left; border-bottom:1px solid #eee; color:#666">
                                <th style="padding:6px">Kalem</th>
                                <th style="padding:6px">Kod</th>
                                <th style="padding:6px">Dayanak</th>
                                <th style="padding:6px; width:200px">@_seciliYil Değeri</th>
                                <th style="padding:6px; width:150px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _detay.Hadler)
                            {
                                <tr style="border-bottom:1px solid #f5f5f5">
                                    <td style="padding:6px">@h.Ad</td>
                                    <td style="padding:6px"><code>@h.Kod</code></td>
                                    <td style="padding:6px">@h.Dayanak</td>
                                    <td style="padding:6px">
                                        <div style="display:flex; align-items:center; gap:6px">
                                            <RadzenNumeric TValue="decimal?" Value="@GetDeger(h.Id)"
                                                           Change="@(v => _degerInput[h.Id] = v)" Style="width:120px" />
                                            <span style="font-size:12px;color:#888">@h.Birim</span>
                                        </div>
                                    </td>
                                    <td style="padding:6px">
                                        <RadzenButton Icon="save" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary"
                                                      Click="@(() => SaveDegerAsync(h))" title="Değeri kaydet" />
                                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined" Click="@(() => DeleteHadAsync(h))" title="Haddi sil" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Tr = new("tr-TR");
    private readonly string[] _birimler = { "TL", "%", "adet" };

    // Ağaç
    List<SmmmKonuAgacDto> _agac = new();
    List<SmmmKonuAgacDto> _viewRoots = new();
    string _term = string.Empty;
    List<KonuSecenek> _konuSecenekleri = new();

    // Seçili konu
    SmmmKonuDetayDto? _detay;
    int _seciliYil = DateTime.Now.Year;
    List<int> _yillar = new();

    // İçerik düzenleme
    bool _editIcerik;
    string? _icerikDraft;

    // Şema yazı ölçeği (A− / A+): tüm dal şemalarının font/ikon/çizgi boyutları bununla çarpılır (CSS --sema-scale).
    // Sadece sayfa açıkken geçerli (localStorage yok — WASM'da sorunsuz kalsın).
    static readonly double[] _semaOlcekler = { 0.9, 1.0, 1.15, 1.3 };
    static readonly string[] _semaOlcekAd = { "Küçük", "Orta", "Büyük", "Çok Büyük" };
    int _semaOlcekIdx = 1;
    double SemaOlcek => _semaOlcekler[_semaOlcekIdx];
    string SemaScaleStyle => $"--sema-scale:{SemaOlcek.ToString(CultureInfo.InvariantCulture)}";
    void SemaKucult() { if (_semaOlcekIdx > 0) _semaOlcekIdx--; }
    void SemaBuyut() { if (_semaOlcekIdx < _semaOlcekler.Length - 1) _semaOlcekIdx++; }

    // Değer girişi (hadId -> değer)
    readonly Dictionary<int, decimal?> _degerInput = new();

    // Yeni kayıt formları
    bool _yeniKonuAcik;
    bool _yeniHadAcik;
    SmmmKonuSaveDto _yeniKonu = new();
    SmmmHadSaveDto _yeniHad = new() { Birim = "TL" };

    protected override async Task OnInitializedAsync() => await LoadAgacAsync();

    async Task LoadAgacAsync()
    {
        _agac = await Api.GetAgacAsync();
        _viewRoots = _agac;
        _konuSecenekleri = FlattenSecenekler(_agac);
        StateHasChanged();
    }

    // ---- Ağaç render ----
    RenderFragment RenderNode(SmmmKonuAgacDto n) => __builder =>
    {
        __builder.OpenComponent<RadzenTreeItem>(0);
        __builder.AddAttribute(1, "Text", n.Baslik);
        __builder.AddAttribute(2, "Value", n);
        __builder.AddAttribute(3, "Expanded", !string.IsNullOrWhiteSpace(_term));
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)((b) =>
        {
            foreach (var c in n.AltKonular)
                b.AddContent(5, RenderNode(c));
        }));
        __builder.CloseComponent();
    };

    async Task OnSelect(TreeEventArgs args)
    {
        if (args.Value is not SmmmKonuAgacDto node) return;
        await LoadKonuAsync(node.Id);
    }

    async Task LoadKonuAsync(int id)
    {
        _editIcerik = false;
        _yeniHadAcik = false;
        _detay = await Api.GetKonuByIdAsync(id);
        if (_detay is null) return;

        _yillar = _detay.Hadler
            .SelectMany(h => h.Degerler.Select(d => d.Yil))
            .Distinct().OrderByDescending(y => y).ToList();

        if (_yillar.Count > 0 && !_yillar.Contains(_seciliYil))
            _seciliYil = _yillar.First();

        RefreshDegerInput();
        StateHasChanged();
    }

    // ---- Yıl ----
    void OnYilChanged(int y) => SetYil(y);

    void SetYil(int y)
    {
        _seciliYil = y;
        RefreshDegerInput();
    }

    void RefreshDegerInput()
    {
        _degerInput.Clear();
        if (_detay is null) return;
        foreach (var h in _detay.Hadler)
            _degerInput[h.Id] = h.Degerler.FirstOrDefault(d => d.Yil == _seciliYil)?.Deger;
    }

    decimal? GetDeger(int hadId) => _degerInput.TryGetValue(hadId, out var v) ? v : null;

    // ---- İçerik ----
    void StartEditIcerik()
    {
        _icerikDraft = _detay?.IcerikMd;
        _editIcerik = true;
    }

    async Task SaveIcerikAsync()
    {
        if (_detay is null) return;
        var dto = new SmmmKonuSaveDto
        {
            UstKonuId = _detay.UstKonuId,
            Baslik = _detay.Baslik,
            Slug = _detay.Slug,
            IcerikMd = _icerikDraft,
            Sira = _detay.Sira,
            Aktif = _detay.Aktif
        };
        var updated = await Api.UpdateKonuAsync(_detay.Id, dto);
        if (updated is not null)
        {
            _detay = updated;
            _editIcerik = false;
            Toast("Kaydedildi", $"{_detay.Baslik} içeriği güncellendi.");
        }
        else Toast("Hata", "İçerik kaydedilemedi.", NotificationSeverity.Error);
    }

    // ---- Konu ----
    async Task CreateKonuAsync()
    {
        if (string.IsNullOrWhiteSpace(_yeniKonu.Baslik)) { Toast("Eksik", "Başlık zorunlu.", NotificationSeverity.Warning); return; }
        var created = await Api.CreateKonuAsync(_yeniKonu);
        if (created is not null)
        {
            _yeniKonu = new();
            _yeniKonuAcik = false;
            await LoadAgacAsync();
            await LoadKonuAsync(created.Id);
            Toast("Eklendi", "Yeni konu oluşturuldu.");
        }
        else Toast("Hata", "Konu eklenemedi.", NotificationSeverity.Error);
    }

    async Task DeleteKonuAsync()
    {
        if (_detay is null) return;
        var onay = await Dialog.Confirm($"'{_detay.Baslik}' silinsin mi? (Hadleri de silinir)", "Konuyu Sil",
            new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç" });
        if (onay != true) return;

        var ok = await Api.DeleteKonuAsync(_detay.Id);
        if (ok)
        {
            _detay = null;
            await LoadAgacAsync();
            Toast("Silindi", "Konu silindi.");
        }
        else Toast("Silinemedi", "Alt konusu olan bir konu silinemez. Önce alt konuları silin veya taşıyın.", NotificationSeverity.Warning);
    }

    // ---- Had ----
    async Task CreateHadAsync()
    {
        if (_detay is null) return;
        if (string.IsNullOrWhiteSpace(_yeniHad.Kod) || string.IsNullOrWhiteSpace(_yeniHad.Ad))
        { Toast("Eksik", "Kod ve Ad zorunlu.", NotificationSeverity.Warning); return; }

        _yeniHad.KonuId = _detay.Id;
        var created = await Api.CreateHadAsync(_yeniHad);
        if (created is not null)
        {
            _yeniHad = new() { Birim = "TL" };
            _yeniHadAcik = false;
            await LoadKonuAsync(_detay.Id);
            Toast("Eklendi", "Yeni had oluşturuldu.");
        }
        else Toast("Hata", "Had eklenemedi (kod benzersiz olmalı).", NotificationSeverity.Error);
    }

    async Task DeleteHadAsync(SmmmHadDto h)
    {
        if (_detay is null) return;
        var onay = await Dialog.Confirm($"'{h.Ad}' haddi silinsin mi?", "Haddi Sil",
            new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç" });
        if (onay != true) return;

        if (await Api.DeleteHadAsync(h.Id))
        {
            await LoadKonuAsync(_detay.Id);
            Toast("Silindi", "Had silindi.");
        }
        else Toast("Hata", "Had silinemedi.", NotificationSeverity.Error);
    }

    // ---- Had değeri (yıl bazlı upsert) ----
    async Task SaveDegerAsync(SmmmHadDto h)
    {
        if (_detay is null) return;
        var deger = GetDeger(h.Id);
        if (deger is null) { Toast("Eksik", "Değer girin.", NotificationSeverity.Warning); return; }

        var dto = new SmmmHadDegeriSaveDto { HadId = h.Id, Yil = _seciliYil, Deger = deger.Value };
        var sonuc = await Api.UpsertHadDegeriAsync(dto);
        if (sonuc is not null)
        {
            await LoadKonuAsync(_detay.Id);
            Toast("Kaydedildi", $"{h.Ad} — {_seciliYil}: {deger.Value.ToString("N0", Tr)} {h.Birim}");
        }
        else Toast("Hata", "Değer kaydedilemedi.", NotificationSeverity.Error);
    }

    // ---- Arama ----
    void Filter(ChangeEventArgs e)
    {
        _term = (e.Value?.ToString() ?? string.Empty).Trim();
        _viewRoots = string.IsNullOrWhiteSpace(_term) ? _agac : FilterTree(_agac, _term);
        StateHasChanged();
    }

    static List<SmmmKonuAgacDto> FilterTree(List<SmmmKonuAgacDto> roots, string term)
    {
        var list = new List<SmmmKonuAgacDto>();
        foreach (var r in roots)
        {
            var match = r.Baslik.Contains(term, StringComparison.OrdinalIgnoreCase);
            var kids = FilterTree(r.AltKonular, term);
            if (match || kids.Count > 0)
                list.Add(new SmmmKonuAgacDto
                {
                    Id = r.Id, UstKonuId = r.UstKonuId, Baslik = r.Baslik, Slug = r.Slug,
                    Sira = r.Sira, Aktif = r.Aktif, AltKonular = kids
                });
        }
        return list;
    }

    static List<KonuSecenek> FlattenSecenekler(List<SmmmKonuAgacDto> roots, int depth = 0)
    {
        var list = new List<KonuSecenek>();
        foreach (var r in roots)
        {
            list.Add(new KonuSecenek { Id = r.Id, Ad = new string('—', depth) + (depth > 0 ? " " : "") + r.Baslik });
            list.AddRange(FlattenSecenekler(r.AltKonular, depth + 1));
        }
        return list;
    }

    void Toast(string ozet, string detay, NotificationSeverity sev = NotificationSeverity.Success) =>
        Notif.Notify(new NotificationMessage { Severity = sev, Summary = ozet, Detail = detay, Duration = 3500 });

    public class KonuSecenek { public int? Id { get; set; } public string Ad { get; set; } = ""; }

    // ---- Markdown -> HTML (bağımlılıksız; MevzuatNotu ile aynı) ----
    private static MarkupString RenderMarkdown(string? md)
    {
        if (string.IsNullOrWhiteSpace(md)) return (MarkupString)"<p style=\"color:#999\"><em>İçerik yok.</em></p>";

        var lines = md.Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
        var sb = new StringBuilder();
        bool inList = false;

        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i].TrimEnd();

            // [[dal]] / [[dal-dikey]] node-şeması bloğu: kök başlığı + ardışık "- " dalları.
            // "> " satırları = o dalın çok satırlı not paneli. Blok, boş satırda veya
            // "- "/">" olmayan satırda biter. Opsiyonel genişlik: [[dal-dikey w=760]]
            var trigM = Regex.Match(line, @"^\[\[dal(-dikey)?(?:\s+w=(\d+))?\]\]\s*(.*)$");
            if (trigM.Success)
            {
                CloseList(sb, ref inList);
                var dikey = trigM.Groups[1].Success;               // "-dikey" varsa dikey şema
                int? genislik = trigM.Groups[2].Success ? int.Parse(trigM.Groups[2].Value) : null;
                var kok = trigM.Groups[3].Value.Trim();
                var dallar = new List<DalItem>();
                DalItem? cur = null;
                int j = i + 1;
                while (j < lines.Length)
                {
                    var next = lines[j].TrimEnd();
                    if (string.IsNullOrWhiteSpace(next)) break; // boş satır bloğu bitirir
                    var t = next.TrimStart();
                    if (t.StartsWith("- "))
                    {
                        cur = ParseDalItem(t[2..]);
                        dallar.Add(cur);
                    }
                    else if (t.StartsWith(">") && cur is not null)
                    {
                        cur.Panel.Add(t[1..].TrimStart()); // dalın not paneli satırı
                    }
                    else break; // "- "/">" olmayan satır bloğu bitirir
                    j++;
                }
                sb.Append(dikey ? RenderDalDikey(kok, dallar, genislik) : RenderDalYatay(kok, dallar, genislik));
                i = j - 1; // tüketilen satırları atla
                continue;
            }

            if (string.IsNullOrWhiteSpace(line)) { CloseList(sb, ref inList); continue; }

            if (line.StartsWith("### ")) { CloseList(sb, ref inList); sb.Append($"<h4>{Inline(line[4..])}</h4>"); continue; }
            if (line.StartsWith("## "))  { CloseList(sb, ref inList); sb.Append($"<h3>{Inline(line[3..])}</h3>"); continue; }
            if (line.StartsWith("# "))   { CloseList(sb, ref inList); sb.Append($"<h2>{Inline(line[2..])}</h2>"); continue; }

            if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                if (!inList) { sb.Append("<ul>"); inList = true; }
                sb.Append($"<li>{Inline(line[2..])}</li>");
                continue;
            }

            CloseList(sb, ref inList);
            sb.Append($"<p>{Inline(line)}</p>");
        }

        CloseList(sb, ref inList);
        return (MarkupString)sb.ToString();
    }

    // Bir dal satırının ayrıştırılmış hâli: kutu metni + işaret + tek-satır not + çok-satır panel
    private sealed class DalItem
    {
        public string Text = "";
        public char? Marker;            // '*' (uyarı) | '!' (tehlike) | null
        public string? InlineNote;      // "//" sonrası tek satır not
        public List<string> Panel = new();  // "> " satırlarından çok satırlı not paneli
    }

    // "- <metin> [*|!] [// tek-satır-not]" gramerini ayrıştırır. İşaret ve "//" kutu metnine dahil EDİLMEZ.
    private static DalItem ParseDalItem(string s)
    {
        var item = new DalItem();

        // "//" tek-satır not ( "https://" gibi şema içindeki // hariç )
        var note = Regex.Match(s, @"(?<!:)//");
        if (note.Success)
        {
            var n = s[(note.Index + 2)..].Trim();
            item.InlineNote = string.IsNullOrEmpty(n) ? null : n;
            s = s[..note.Index];
        }

        s = s.TrimEnd();

        // sondaki işaret: tek başına '*' veya '!' (boşlukla ayrılmış ya da tüm metin)
        var mk = Regex.Match(s, @"(?:^|\s)([*!])$");
        if (mk.Success)
        {
            item.Marker = mk.Groups[1].Value[0];
            s = s[..mk.Index].TrimEnd();
        }

        item.Text = s.Trim();
        return item;
    }

    // Şema boyutu: sabit px'i sayfa ölçek faktörüyle (CSS --sema-scale, A−/A+ ile değişir) çarpar.
    // Tek yerden büyüt/küçült: tüm font/ikon/çizgi boyutları bu değere bağlı.
    private static string Sc(double px) =>
        $"calc({px.ToString(CultureInfo.InvariantCulture)}px * var(--sema-scale, 1))";

    // İşaret ikonu: dolu yıldız (uyarı) / dolu üçgen (tehlike). Renk teması yoksa fallback kullanır.
    private static string MarkerIcon(char? marker) => marker switch
    {
        '*' => "<span title=\"Önemli\" style=\"color:var(--text-warning,#d98a00); font-size:" + Sc(17) + "; line-height:1\">&#9733;</span>",
        '!' => "<span title=\"Dikkat\" style=\"color:var(--text-danger,#c0392b); font-size:" + Sc(16) + "; line-height:1\">&#9650;</span>",
        _ => ""
    };

    private static string DalBorder(char? marker) => marker switch
    {
        '*' => "var(--text-warning,#d98a00)",
        '!' => "var(--text-danger,#c0392b)",
        _ => "#cbd5e0"
    };

    // Kutunun ALTINDAKI notlar: tek-satır not (küçük, soluk, tek satır) + çok-satır not paneli
    private static string DalNotlar(DalItem d)
    {
        var sb = new StringBuilder();
        if (d.InlineNote is not null)
            sb.Append("<div style=\"font-size:" + Sc(14) + "; color:var(--text-primary,#1a202c); margin-top:4px; line-height:1.8\">"
                      + Inline(d.InlineNote) + "</div>");
        if (d.Panel.Count > 0)
        {
            sb.Append("<div style=\"margin-top:6px; padding:6px 9px; border:1px solid #e2e8f0; border-radius:6px; "
                      + "background:#fbfcfd; text-align:left\">");
            foreach (var p in d.Panel)
                sb.Append("<div style=\"font-size:" + Sc(14) + "; color:var(--text-primary,#1a202c); line-height:1.8\">"
                          + Inline(p) + "</div>");
            sb.Append("</div>");
        }
        return sb.ToString();
    }

    // Yatay şema kutusu (inline)
    private static string DalBoxInline(DalItem d)
    {
        var icon = MarkerIcon(d.Marker);
        return "<div style=\"display:inline-flex; align-items:center; gap:5px; padding:7px 12px; border:1px solid "
               + DalBorder(d.Marker) + "; border-radius:6px; background:#fff; color:var(--text-primary,#1a202c); "
               + "font-weight:600; font-size:" + Sc(16) + "; max-width:260px\">"
               + Inline(d.Text) + (icon.Length > 0 ? " " + icon : "") + "</div>";
    }

    // Dikey şema kutusu (blok, kolon genişliğinde, ortalı)
    private static string DalBoxBlock(DalItem d)
    {
        var icon = MarkerIcon(d.Marker);
        return "<div style=\"box-sizing:border-box; width:100%; padding:8px 10px; border:1px solid "
               + DalBorder(d.Marker) + "; border-radius:6px; background:#fff; color:var(--text-primary,#1a202c); "
               + "font-weight:600; text-align:center; font-size:" + Sc(16) + "\">"
               + Inline(d.Text) + (icon.Length > 0 ? " " + icon : "") + "</div>";
    }

    // [[dal]] — YATAY: kök solda, dallar sağda alt alta, her dala chevron-right (→). Opsiyonel w=N genişlik.
    private static string RenderDalYatay(string kok, List<DalItem> dallar, int? genislik = null)
    {
        if (dallar.Count == 0) return $"<p>{Inline(kok)}</p>";

        var wrapStyle = genislik is int w
            ? $"max-width:{w}px; margin:.9rem auto;"
            : "margin:.9rem 0;";

        var kokBox =
            "<div style=\"flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center; "
            + "padding:10px 16px; border:2px solid #4a5568; border-radius:8px; background:#f7fafc; "
            + "font-weight:600; font-size:" + Sc(18) + "; text-align:center; max-width:220px; color:var(--text-primary,#1a202c)\">"
            + Inline(kok) + "</div>";

        var rows = new StringBuilder();
        foreach (var d in dallar)
        {
            rows.Append(
                "<div style=\"display:flex; align-items:flex-start; gap:6px\">"
                + "<span style=\"color:#a0aec0; font-size:" + Sc(20) + "; line-height:1.6\">&#8594;</span>"
                + "<div style=\"display:flex; flex-direction:column\">" + DalBoxInline(d) + DalNotlar(d) + "</div>"
                + "</div>");
        }

        return
            "<div style=\"display:flex; align-items:flex-start; gap:14px; " + wrapStyle
            + " padding:6px 2px; overflow-x:auto\">" + kokBox
            + "<div style=\"display:flex; flex-direction:column; gap:12px\">" + rows + "</div></div>";
    }

    // [[dal-dikey]] — DİKEY: kök ortada üstte, aşağı stem + yatay dağıtıcı, dallar altta yan yana,
    // her dala chevron-down (↓); her dalın altında içeriğe göre uzunlukta not paneli.
    // w=N verilmezse kapsayıcının TAM genişliğine yayılır; w=N verilirse N px, ortalı, dar ekranda küçülür.
    private static string RenderDalDikey(string kok, List<DalItem> dallar, int? genislik = null)
    {
        if (dallar.Count == 0) return $"<p>{Inline(kok)}</p>";

        var wrapStyle = genislik is int gw
            ? $"max-width:{gw}px; margin:1rem auto;"   // ortalı; max-width dar ekranda küçültür
            : "width:100%; margin:1rem 0;";            // tam genişlik

        var kokBox =
            "<div style=\"display:inline-flex; align-items:center; justify-content:center; padding:10px 18px; "
            + "border:2px solid #4a5568; border-radius:8px; background:#f7fafc; font-weight:600; color:var(--text-primary,#1a202c); "
            + "font-size:" + Sc(18) + "; text-align:center; max-width:280px\">" + Inline(kok) + "</div>";

        // yatay dağıtıcı çizgiyi kolon merkezlerine yaklaştırmak için kenardan ~yarım kolon içeri al
        var inset = (100.0 / (2 * dallar.Count)).ToString("0.###", CultureInfo.InvariantCulture);

        var cols = new StringBuilder();
        foreach (var d in dallar)
        {
            cols.Append(
                "<div style=\"flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:center\">"
                + "<div style=\"width:2px; height:" + Sc(14) + "; background:#cbd5e0\"></div>"                // dağıtıcıdan aşağı bağlantı
                + "<span style=\"color:#a0aec0; font-size:" + Sc(20) + "; line-height:1\">&#8595;</span>"    // chevron-down
                + "<div style=\"width:100%; margin-top:4px\">" + DalBoxBlock(d) + "</div>"
                + "<div style=\"width:100%\">" + DalNotlar(d) + "</div>"
                + "</div>");
        }

        return
            "<div style=\"" + wrapStyle + " padding:6px 4px\">"
            + "<div style=\"display:flex; justify-content:center\">" + kokBox + "</div>"
            + "<div style=\"display:flex; justify-content:center\"><div style=\"width:2px; height:" + Sc(18) + "; background:#cbd5e0\"></div></div>"
            + "<div style=\"padding:0 " + inset + "%\"><div style=\"height:2px; background:#cbd5e0\"></div></div>"
            + "<div style=\"display:flex; gap:12px; align-items:flex-start\">" + cols + "</div>"
            + "</div>";
    }

    private static void CloseList(StringBuilder sb, ref bool inList)
    {
        if (inList) { sb.Append("</ul>"); inList = false; }
    }

    private static string Inline(string s)
    {
        var e = System.Net.WebUtility.HtmlEncode(s);
        e = Regex.Replace(e, @"\[([^\]]+)\]\((https?:[^)\s]+)\)",
            m => $"<a href=\"{m.Groups[2].Value}\" target=\"_blank\" rel=\"noopener noreferrer\">{m.Groups[1].Value}</a>");
        e = Regex.Replace(e, @"\*\*([^*]+)\*\*", "<strong>$1</strong>");
        e = Regex.Replace(e, @"\*([^*]+)\*", "<em>$1</em>");
        e = Regex.Replace(e, @"`([^`]+)`", "<code>$1</code>");
        return e;
    }
}
