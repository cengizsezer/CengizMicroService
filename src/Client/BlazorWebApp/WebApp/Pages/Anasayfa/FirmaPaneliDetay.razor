    private static string BasHarfler(string? ad)
    {
        var parcalar = (ad ?? string.Empty).Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        var harfler = string.Concat(parcalar.Take(2).Select(p => char.ToUpper(p[0], Tr)));
        return harfler.Length == 0 ? "?" : harfler;
    }

