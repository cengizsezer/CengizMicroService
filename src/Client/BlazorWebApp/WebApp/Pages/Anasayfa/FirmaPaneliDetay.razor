@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Components
@using WebApp.Shared.Dto.Anasayfa
@using WebApp.Shared.Dto.FirmaBilgileri
@using WebApp.Shared.Dto.Sistemler

@inject NavigationManager Nav
@inject IFileApiService FileApi
@inject DialogService DialogService
@inject WebApp.Application.Services.IAnasayfaApiClient Api
@inject NotificationService Notif
@inject IJSRuntime JS

@*
    Seçili firmanın künyesi: mükellefiyet, sınıflandırma, kullanılan sistemler, sicil,
    ortaklık, imza yetkilileri, belgeler.

    Ekran OKUMA odaklı. Her bölümün "Düzenle" bağlantısı mevcut Firma Bilgileri
    ekranına götürüyor; buraya ikinci bir düzenleme yüzeyi konmadı — aynı alanı iki
    formdan yazmak, birini doğrulayıp diğerini unutmanın kapısıdır.

    Boş alan gizlenmiyor, "—" yazılıyor: eksik olduğunun görünmesi bu ekranın işi.
*@

<RadzenStack Gap="0.75rem">

    @* Eksik bilgi şeridi: raydaki sayı rozetiyle aynı liste (sunucuda FirmaEksikBilgi). *@
    @* Uyarılar (imza yetkisi, pay oranı, geçerli yetkili yok) aynı şeritte ayrı cümlede;
       eskiden ayrı kutudaydı ve raydan düşmüştü. *@
    @* Prompt 12: şerit KART BAŞLIĞINA göre gruplu; her grup kendi kartına kaydırır. Gruplar künyenin tek
       ucundan gelen Eksikler listesinden türetilir (ikinci uç yok). Yalnız GEREKLİ alanlar ve durum (mizan)
       şeritte; ikincil boşluklar kartta "—" olarak durur, burada ve rozette sayılmaz. Başlık raydaki rozetle
       aynı karar: yeni firmada gri "Künye tamamlanıyor". Metinlerdeki boşluklar C# dizesinin İÇİNDE —
       Blazor etiketle ifade arasındaki boşluğu atıyordu ("Eksik bilgi:Sınıflandırma" hatası). *@
    @if (SeritGruplari.Count > 0 || RaydakiUyarilar.Count > 0)
    {
        <div class="@(Detay.YeniFirma && Detay.GerekliEksikSayisi > 0 ? "an-eksik-serit an-eksik-serit-yeni" : "an-eksik-serit")">
            <RadzenIcon Icon="edit_note" Style="font-size:17px;flex-shrink:0" />
            <span class="an-eksik-metin">
                @if (Detay.GerekliEksikSayisi > 0)
                {
                    <b>@(Detay.YeniFirma
                             ? $"Künye tamamlanıyor · {Detay.GerekliEksikSayisi} gerekli alan"
                             : $"Eksik bilgi: {Detay.GerekliEksikSayisi} gerekli alan eksik")</b>
                }
                @foreach (var g in SeritGruplari)
                {
                    <span class="an-eksik-grup">
                        <span class="an-baglanti" role="button" title="@($"{g.Kart} kartına git")"
                              @onclick="@(() => KartaGit(g.Kart))">@g.Kart</span>@($": {string.Join(", ", g.Alanlar)}")
                    </span>
                }
                @if (RaydakiUyarilar.Count > 0)
                {
                    <span class="an-uyari-cumle">
                        <b>@("Uyarı: ")</b>@string.Join(" · ", RaydakiUyarilar.Select(u => u.Mesaj.TrimEnd('.')))
                    </span>
                }
            </span>
            <RadzenButton Text="Tamamla" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning"
                          Variant="Variant.Flat" Click="@Tamamla" />
        </div>
    }


    @* ---- Mükellefiyet ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-mukellefiyet">
        @Baslik("badge", "Mükellefiyet")

        <div class="fp-alanlar">
            @Alan("Vergi dairesi", Detay.Mukellefiyet.VergiDairesi)
            @Alan("Vergi kimlik no", Detay.Mukellefiyet.VergiKimlikNo)
            <div class="fp-alan">
                <div class="fp-etiket">Mükellefiyet türleri</div>
                @if (Detay.Mukellefiyet.Kodlar.Count == 0 && Bos(Detay.Mukellefiyet.KalanMetin))
                {
                    <div class="fp-deger">—</div>
                }
                else
                {
                    <div class="an-kod-cipler">
                        @foreach (var kod in Detay.Mukellefiyet.Kodlar)
                        {
                            <span class="@(kod.SiniflandirmaKaynagi ? "an-kod-cip an-kod-kaynak" : "an-kod-cip")"
                                  title="@(kod.SiniflandirmaKaynagi ? $"{kod.Ad} — sınıflandırmanın kaynağı" : kod.Ad)">
                                @(kod.KisaAd is null ? kod.Kod : $"{kod.Kod} · {kod.KisaAd}")
                            </span>
                        }
                    </div>
                    @* Kod sayılamayan kalan metin sessizce yutulmaz. *@
                    @if (!Bos(Detay.Mukellefiyet.KalanMetin))
                    {
                        <div class="an-kalan" title="Kod olarak ayıklanamayan metin">@Detay.Mukellefiyet.KalanMetin</div>
                    }
                }
            </div>
            @Alan("İşe başlama", Tarih(Detay.Mukellefiyet.IseBaslamaTarihi))
            @Alan("NACE kodu", Detay.Mukellefiyet.NaceKodu)
            <div class="fp-alan">
                <div class="fp-etiket">e-Fatura / e-Defter</div>
                <div class="fp-deger">
                    @Rozet("e-Fatura", Detay.Mukellefiyet.EFatura)
                    @Rozet("e-Defter", Detay.Mukellefiyet.EDefter)
                </div>
            </div>
        </div>
    </RadzenCard>

    @* ---- Sınıflandırma (vergi ve mevzuat) ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-siniflandirma">
        <div class="fp-bolum-basi">
            <span class="fp-bolum-ad">
                <RadzenIcon Icon="category" Style="font-size:17px" />
                Sınıflandırma
            </span>
            <span class="fp-duzenle" role="button" @onclick="@(() => SiniflandirmaDuzenle(null))">Düzenle</span>
        </div>

        <div class="fp-alanlar">
            @Alan("Firma tipi", FirmaTipiAdi(Sinif.FirmaTipi))
            <div class="fp-alan">
                <div class="fp-etiket">Defter usulü</div>
                <div class="fp-deger">@DefterUsuluAdi(Sinif.DefterUsulu)</div>
                @if (Sinif.DefterUsuluOtomatikKod is { } dk)
                {
                    <div class="an-oto">@OtomatikNotu(dk)</div>
                }
            </div>
            <div class="fp-alan">
                <div class="fp-etiket">Vergi türü</div>
                <div class="fp-deger">@VergiTuruAdi(Sinif.VergiTuru)</div>
                @if (Sinif.VergiTuruOtomatikKod is { } vk)
                {
                    <div class="an-oto">@OtomatikNotu(vk)</div>
                }
            </div>
            @Alan("Hesap dönemi", HesapDonemiMetni())
            <div class="fp-alan">
                <div class="fp-etiket">SGK teşvik kademesi</div>
                <div class="fp-deger">
                    @(SgkKademeAdi() ?? "—")
                    @if (Sinif.SgkIsverenOrani is { } oran)
                    {
                        <span class="an-sgk-oran">işveren %@oran.ToString("0.00", Tr)</span>
                    }
                </div>
            </div>
            @Alan("Muhtasar dönemi", MuhtasarDonemiAdi(Sinif.MuhtasarDonemi))
        </div>
    </RadzenCard>

    @* ---- Kullanılan sistemler (hangi iş nerede yapılıyor) ----
       ORKA firma kodu ve mizan formatı Firma kaydının kendi alanları; kart gösterir ve
       aynı alanlara yazar. Mizan satırı eski karttan aynen taşındı. *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-sistemler">
        <div class="fp-bolum-basi">
            <span class="fp-bolum-ad">
                <RadzenIcon Icon="apps" Style="font-size:17px" />
                Kullanılan sistemler
            </span>
            <span class="fp-duzenle" role="button" @onclick="@(() => SistemlerDuzenle(null))">Düzenle</span>
        </div>

        <div class="fp-alanlar">
            @SistemAlani("Muhasebe programı", SistemTuru.Muhasebe)
            @SistemAlani("e-Fatura entegratörü", SistemTuru.EFatura)
            @SistemAlani("Bordro", SistemTuru.Bordro)
            @SistemAlani("Beyanname", SistemTuru.Beyanname)
            @SistemAlani("Banka portalları", SistemTuru.Banka)
            @if (Sistemler.Atamalar.Any(a => a.Tur == SistemTuru.Diger))
            {
                @SistemAlani("Diğer sistemler", SistemTuru.Diger)
            }
        </div>

        <div class="fp-alanlar an-sistem-satir">
            @Alan("ORKA firma kodu", Sinif.OrkaFirmaKodu)
            <div class="fp-alan">
                <div class="fp-etiket">Diğer sistemlerdeki firma kodları</div>
                @if (Sistemler.Atamalar.Any(a => !Bos(a.FirmaKodu)))
                {
                    <div class="an-sistemler">
                        @foreach (var a in Sistemler.Atamalar.Where(a => !Bos(a.FirmaKodu)))
                        {
                            <span class="an-sistem">@a.Ad<span class="an-sistem-kod">@a.FirmaKodu</span></span>
                        }
                    </div>
                }
                else
                {
                    <div class="fp-deger">—</div>
                }
            </div>
            <div class="fp-alan">
                <div class="fp-etiket">Sistem notu</div>
                <div class="@(Bos(Sistemler.SistemNotu) ? "fp-deger" : "an-sistem-not")">@(Bos(Sistemler.SistemNotu) ? "—" : Sistemler.SistemNotu)</div>
            </div>
        </div>

        <div class="an-mizan">
            <div class="fp-alan">
                <div class="fp-etiket">Mizan formatı</div>
                <div class="fp-deger">@(MizanFormatlari.Secili(Sinif.MizanFormati) ? Sinif.MizanFormati : "—")</div>
                @if (MizanFormatlari.SablonVar(Sinif.MizanFormati))
                {
                    @* Firma işleri şablonuyla AYNI bileşen (Prompt 13): "Hazırlanıyor…", çift tık koruması, tek satır hata. *@
                    <SablonIndirBaglantisi Getir="@(() => Api.MizanSablonuAsync(Sinif.MizanFormati!))"
                                           DosyaAdi="mizan-sablonu.xlsx" Sinif="an-baglanti" />
                }
                else if (MizanFormatlari.Secili(Sinif.MizanFormati))
                {
                    @* Gerçek çıktısı görülmemiş program: uydurma şablon gönderilmez. *@
                    <span class="an-baglanti an-pasif">Boş şablon indir</span>
                    <div class="an-oto">bu programın gerçek mizan çıktısı henüz görülmedi</div>
                }
                else
                {
                    <span class="an-baglanti an-pasif" title="Önce mizan formatını seçin">Boş şablon indir</span>
                }
            </div>
            @Alan("Son yüklenen mizan", SonMizanMetni())
            @Alan("Yükleme zamanı", Sinif.SonMizan?.YuklenmeZamani?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
            <div class="fp-alan">
                <div class="fp-etiket">Denge</div>
                <div class="fp-deger">
                    @if (Sinif.SonMizan?.Dengeli is true)
                    {
                        <span class="an-denge an-denge-tamam">Borç = Alacak</span>
                    }
                    else if (Sinif.SonMizan?.Dengeli is false)
                    {
                        <span class="an-denge an-denge-fark">Fark @Para(Sinif.SonMizan.Fark ?? 0)</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
            @Alan("Alt kırılım", AltKirilimMetni())
            <span class="an-baglanti an-mizan-ac" role="button" @onclick="FirmaKontroluneGit">Firma kontrolünde aç</span>
        </div>
    </RadzenCard>

    @* ---- Sicil ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-sicil">
        @Baslik("apartment", "Sicil")

        <div class="fp-alanlar">
            @Alan("Ticaret sicil no", Detay.Sicil.TicaretSicilNo)
            @Alan("MERSİS no", Detay.Sicil.MersisNo)
            @Alan("Sermaye", Sermaye())
            @Alan("Kuruluş tarihi", Tarih(Detay.Sicil.KurulusTarihi))
        </div>

        <div class="fp-alan fp-genis">
            <div class="fp-etiket">Adres</div>
            <div class="fp-deger">@(Bos(Detay.Sicil.Adres) ? "—" : Detay.Sicil.Adres)</div>
        </div>
    </RadzenCard>

    @* ---- Ortaklık ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-ortaklik">
        @Baslik("groups", "Ortaklık")

        @if (Detay.Ortaklik.Ortaklar.Count == 0)
        {
            <div class="fp-bos-satir">Ortak kaydı yok.</div>
        }
        else
        {
            <div class="fp-tablo-kutu">
                <table class="fp-tablo">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th style="width:150px">TCKN / VKN</th>
                            <th style="width:150px" class="fp-sag">Pay tutarı</th>
                            <th style="width:110px" class="fp-sag">Pay oranı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ortak in Detay.Ortaklik.Ortaklar)
                        {
                            <tr>
                                <td>@ortak.Ad</td>
                                <td class="fp-mono"><MaskeliKimlik Deger="@ortak.TcknVkn" /></td>
                                <td class="fp-sag fp-mono">@Para(ortak.PayTutari)</td>
                                <td class="fp-sag fp-mono">@Yuzde(ortak.PayOrani)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="@(Detay.Ortaklik.PayOraniUyarisi ? "fp-toplam fp-hatali" : "fp-toplam")">
                            <td colspan="2">Toplam</td>
                            <td class="fp-sag fp-mono">@Para(Detay.Ortaklik.ToplamPayTutari)</td>
                            <td class="fp-sag fp-mono">@Yuzde(Detay.Ortaklik.ToplamPayOrani)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </RadzenCard>

    @* ---- İmza yetkilileri ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-imza">
        @Baslik("draw", "İmza yetkilileri", YetkiRozeti())

        @if (Detay.Yetkililer.Count == 0)
        {
            <div class="fp-bos-satir">İmza yetkilisi kaydı yok.</div>
        }
        else
        {
            <div class="fp-tablo-kutu">
                <table class="fp-tablo">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th style="width:190px">Görev / unvan</th>
                            <th style="width:110px">Temsil</th>
                            <th style="width:210px">Yetki bitişi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var yetkili in Detay.Yetkililer)
                        {
                            <tr class="@YetkiliSinifi(yetkili)">
                                <td>@yetkili.Ad</td>
                                <td>@(Bos(yetkili.Gorev) ? "—" : yetkili.Gorev)</td>
                                <td>@(yetkili.TemsilSekli == TemsilSekli.Musterek ? "Müşterek" : "Münferit")</td>
                                <td>
                                    @if (yetkili.YetkiBitis is null)
                                    {
                                        <span class="fp-bos">Süresiz</span>
                                    }
                                    else
                                    {
                                        <span class="fp-mono">@yetkili.YetkiBitis.Value.ToString("dd.MM.yyyy")</span>
                                        <span class="fp-kalan"> · @KalanMetni(yetkili)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </RadzenCard>

    @* ---- Belgeler ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum">
        @Baslik("folder", "Belgeler")

        <div class="fp-belgeler">
            @foreach (var tur in BelgeTurleri)
            {
                var mevcut = Detay.Belgeler.Where(b => b.Tur == tur.Deger).ToList();

                @if (mevcut.Count == 0)
                {
                    <span class="fp-belge fp-belge-yok" role="button" @onclick="Duzenle"
                          title="@(tur.Ad + " eklemek için Firma Bilgileri ekranına gidin")">
                        <RadzenIcon Icon="add" Style="font-size:15px" />
                        @tur.Ad
                    </span>
                }
                else
                {
                    @foreach (var belge in mevcut)
                    {
                        <span class="fp-belge" role="button" @onclick="@(() => Goruntule(belge, tur.Ad))"
                              title="@belge.FileName">
                            <RadzenIcon Icon="picture_as_pdf" Style="font-size:15px;color:#c53030" />
                            @tur.Ad
                            @if (!Bos(belge.Aciklama))
                            {
                                <span class="fp-belge-not">@belge.Aciklama</span>
                            }
                        </span>
                    }
                }
            }
        </div>
    </RadzenCard>

    @* ---- Takip ---- *@
    <RadzenCard Variant="Variant.Outlined" class="fp-bolum" id="an-kart-takip">
        <div class="fp-bolum-basi">
            <span class="fp-bolum-ad">
                <RadzenIcon Icon="assignment_ind" Style="font-size:17px" />
                Takip
            </span>
        </div>

        <div class="an-takip">
            <div class="fp-alan">
                <div class="fp-etiket">Sorumlu</div>
                <div class="an-sorumlu">
                    @if (Takip.SorumluKullaniciId is null)
                    {
                        <span class="an-avatar an-avatar-bos"></span>
                        <span class="fp-bos">Atanmamış</span>
                        <span class="an-baglanti" role="button" @onclick="SorumluAta">Ata</span>
                    }
                    else
                    {
                        <span class="an-avatar">@BasHarfler(Takip.SorumluKullaniciAdi)</span>
                        <span class="fp-deger">@Takip.SorumluKullaniciAdi</span>
                        <span class="an-baglanti" role="button" @onclick="SorumluAta">Değiştir</span>
                    }
                </div>
            </div>

            <div class="fp-alan">
                <div class="fp-etiket">Dönemler</div>
                <div class="an-donemler">
                    @foreach (var donem in Takip.Donemler)
                    {
                        <span class="@(donem.Yuklu ? "an-donem an-donem-yuklu" : "an-donem an-donem-yok")"
                              title="@(donem.Yuklu ? $"{donem.Yil} mizanı yüklü" : $"{donem.Yil} mizanı yüklenmemiş")">@donem.Yil</span>
                    }
                </div>
            </div>
        </div>

        @* Prompt 7B: "Not" bölümü kaldırıldı — aynı FirmaNotu kayıtları "Kalıcı talimatlar" kartında da
           görünüyordu (aynı not iki yerde). Tek yer Kalıcı talimatlar; veri silinmedi. *@

        <div class="an-takip-bolum">
            <div class="an-takip-basi">
                <span class="fp-etiket">Son işlemler</span>
                @if (Takip.SonOlaylar.Count > 0)
                {
                    <span class="an-baglanti" role="button" @onclick="HareketleriAc">Tüm hareketler</span>
                }
            </div>
            @if (Takip.SonOlaylar.Count == 0)
            {
                <div class="fp-bos-satir">Henüz işlem yok</div>
            }
            else
            {
                <FirmaOlayListesi Olaylar="@Takip.SonOlaylar" />
            }
        </div>
    </RadzenCard>

    @* ---- Firma işleri + Kalıcı talimatlar (Prompt 7) ----
       Firma işleri: yasal (mükellefiyetten, kilitli) + firmaya özel. Kalıcı talimatlar:
       FirmaNotu kayıtlarının TEK gösterildiği yer (Prompt 7B); tarihi ve durumu yok. *@
    @* Prompt 12 izolasyon: kendi verisini yükleyen kartlar ErrorBoundary içinde (Dönem panosundaki desen) —
       kartın render hatası yalnız o kartı düşürür; "Yeniden dene" yalnız onu yeniden kurar. *@
    <ErrorBoundary @ref="islerSiniri">
        <ChildContent>
            <FirmaIsleriKarti FirmaId="@Detay.FirmaId" FirmaAdi="@Detay.Ad" Degisti="@Degisti" />
        </ChildContent>
        <ErrorContent>
            <RadzenCard Variant="Variant.Outlined" class="fp-bolum">
                <div class="fp-bolum-basi"><span class="fp-bolum-ad">Firma işleri</span></div>
                <AnKartHatasi YenidenDene="@(() => islerSiniri?.Recover())" />
            </RadzenCard>
        </ErrorContent>
    </ErrorBoundary>
    <ErrorBoundary @ref="talimatSiniri">
        <ChildContent>
            <KaliciTalimatlarKarti FirmaId="@Detay.FirmaId" NotSayisi="@Takip.NotSayisi" Degisti="@Degisti" />
        </ChildContent>
        <ErrorContent>
            <RadzenCard Variant="Variant.Outlined" class="fp-bolum">
                <div class="fp-bolum-basi"><span class="fp-bolum-ad">Kalıcı talimatlar</span></div>
                <AnKartHatasi YenidenDene="@(() => talimatSiniri?.Recover())" />
            </RadzenCard>
        </ErrorContent>
    </ErrorBoundary>

</RadzenStack>

@code {
    [Parameter, EditorRequired] public FirmaPaneliDetayDto Detay { get; set; } = new();

    private ErrorBoundary? islerSiniri, talimatSiniri;

    protected override void OnParametersSet()
    {
        // Firma değişince hata durumundaki kart sıfırlanır: yeni firmanın kartı yeniden denensin.
        if (Detay.FirmaId != sinirFirmasi)
        {
            sinirFirmasi = Detay.FirmaId;
            islerSiniri?.Recover();
            talimatSiniri?.Recover();
        }
    }

    private int sinirFirmasi;

    /// <summary>Kart üzerinden bir şey kaydedildi; üst bileşen paneli tazeler.</summary>
    [Parameter] public EventCallback Degisti { get; set; }

    private FirmaPaneliSiniflandirmaDto Sinif => Detay.Siniflandirma;

    /// <summary>Şeritteki "Uyarı" cümlesi: eksik sicil uyarısı hariç (o eksik listesinde).</summary>
    private List<FirmaUyariDto> RaydakiUyarilar
        => Detay.Uyarilar.Where(u => u.Tur != FirmaUyariTuru.EksikSicilAlani).ToList();

    /// <summary>
    /// İlk eksik alanın kartını açar ve o alana odaklanır: sınıflandırma alanları bu
    /// ekrandaki formda, sorumlu Takip kartında, geri kalanı (mükellefiyet, sicil, ortak,
    /// yetkili) tek düzenleme yeri olan Firma Bilgileri ekranında.
    /// </summary>
    private sealed record SeritGrubu(string Kart, List<string> Alanlar);

    /// <summary>Şeridin grupları: gerekli eksikler ve durum maddeleri, kart sırasıyla (sunucunun listesi).</summary>
    private List<SeritGrubu> SeritGruplari
        => Detay.Eksikler.Where(e => e.Gerekli || e.Durum)
                         .GroupBy(e => e.Kart)
                         .Select(g => new SeritGrubu(g.Key, g.Select(e => e.Alan).ToList()))
                         .ToList();

    /// <summary>Kart başlığı → kartın id'si (kaydırma hedefi). Mizan bölümü Kullanılan sistemler kartında.</summary>
    private static string KartId(string kart) => kart switch
    {
        "Mükellefiyet" => "an-kart-mukellefiyet",
        "Sınıflandırma" => "an-kart-siniflandirma",
        "Kullanılan sistemler" or "Mizan" => "an-kart-sistemler",
        "Sicil" => "an-kart-sicil",
        "Ortaklık" => "an-kart-ortaklik",
        "İmza yetkilileri" => "an-kart-imza",
        "Takip" => "an-kart-takip",
        _ => "an-kart-mukellefiyet"
    };

    /// <summary>Şerit grubuna tıklanınca o karta kayar ve kısa süre vurgular (mevcut anOdakla).</summary>
    private async Task KartaGit(string kart)
    {
        try
        {
            await JS.InvokeVoidAsync("anOdakla", KartId(kart));
        }
        catch
        {
            // JS yoksa kaydırma olmaz; sayfa etkilenmez.
        }
    }

    private async Task Tamamla()
    {
        // Prompt 12: önce GEREKLİ eksik; yoksa durum (mizan); ikincil boşluk "Tamamla"yı tetiklemez.
        var ilk = Detay.Eksikler.FirstOrDefault(e => e.Gerekli) ?? Detay.Eksikler.FirstOrDefault(e => e.Durum);
        if (ilk is null)
        {
            // Eksik yok, yalnız uyarı var: pay oranı ortaklığa, imza uyarıları yetkililere.
            var uyari = RaydakiUyarilar.FirstOrDefault();
            if (uyari is null) return;

            if (uyari.Tur == FirmaUyariTuru.SiniflandirmaUyusmuyor)
            {
                // Düzelt ya da onayla: ikisi de sınıflandırma formunda.
                await SiniflandirmaDuzenle("vergiTuru");
                return;
            }

            var odak = uyari.Tur == FirmaUyariTuru.PayOraniTutmuyor ? "ortak" : "imzaYetkilisi";
            Nav.NavigateTo($"/yonetim/firmalar/{Detay.FirmaId}/bilgiler?odak={odak}");
            return;
        }

        switch (ilk.Kart)
        {
            case "Sınıflandırma":
                await SiniflandirmaDuzenle(ilk.Odak);
                break;
            case "Kullanılan sistemler":
                await SistemlerDuzenle(ilk.Odak);
                break;
            case "Takip":
                await SorumluAta();
                break;
            case "Mizan":
                // Mizan yükleme Firma Kontrol ekranında; anasayfa yüklemez.
                FirmaKontroluneGit();
                break;
            default:
                Nav.NavigateTo($"/yonetim/firmalar/{Detay.FirmaId}/bilgiler?odak={Uri.EscapeDataString(ilk.Odak)}");
                break;
        }
    }

