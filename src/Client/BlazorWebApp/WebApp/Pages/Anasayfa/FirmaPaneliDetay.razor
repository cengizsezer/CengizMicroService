    /// <summary>
    /// İmza yetkilileri başlık rozeti (sunucu hesaplar): 90 günden az kalan varsa kırmızı,
    /// yoksa amber. Yetkili yoksa ya da hepsi bir yıldan uzunsa rozet çıkmaz.
    /// </summary>
    private RenderFragment? YetkiRozeti()
    {
        if (Detay.YetkiRozeti is { GecerliYok: true })
        {
            return __builder =>
            {
                <span class="an-yetki-rozet an-yetki-kritik" title="Kayıtlı yetkililerin hepsinin süresi dolmuş">Geçerli yetkili yok</span>
            };
        }

        if (Detay.YetkiRozeti is not { Sayi: > 0 } r) return null;

        return __builder =>
        {
            <span class="@(r.Kritik ? "an-yetki-rozet an-yetki-kritik" : "an-yetki-rozet")"
                  title="@(r.Kritik ? "En az bir yetkinin bitişine 90 günden az kaldı" : "Bitişine 1 yıldan az kalan yetki var")">
                @r.Sayi yetki 1 yıldan kısa
            </span>
        };
    }

    private static readonly CultureInfo Tr = new("tr-TR");

