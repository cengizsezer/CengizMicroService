    /// <summary>Türün atamaları; pasife alınmış sistem kesikli çerçeveyle (atama bozulmaz). Boşsa "—".</summary>
    private RenderFragment SistemAlani(string etiket, SistemTuru tur) => __builder =>
    {
        var atamalar = Sistemler.Atamalar.Where(a => a.Tur == tur).ToList();
        <div class="fp-alan">
            <div class="fp-etiket">@etiket</div>
            @if (atamalar.Count == 0)
            {
                <div class="fp-deger">—</div>
            }
            else
            {
                <div class="an-sistemler">
                    @foreach (var a in atamalar)
                    {
                        <span class="@(a.Aktif ? "an-sistem" : "an-sistem an-sistem-pasif")"
                              title="@(a.Aktif ? null : "Pasife alınmış sistem; yeni seçimde çıkmaz")">@a.Ad</span>
                    }
                </div>
            }
        </div>
    };

