@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services
@using WebApp.Shared.Dto.Sistemler

@inject ISistemApiClient Api

@*
    Tek türden sistem seçimi + listenin altında "+ Yeni ekle".

    Yeni kayıt Yönetim ekranına gitmeden eklenir (17 firmayı girerken o kesinti işi
    bıraktırır) ve hemen bu alana seçilir. Benzer ad SORULMADAN geçilmez: sunucu 409 ile
    benzer kaydı döner, kullanıcı ya onu seçer ya da ısrar edip yenisini ekler.

    Liste üst bileşenle paylaşılır: eklenen kayıt aynı formdaki diğer seçicilerde de görünür.
    Pasif kayıt yalnız bu alanda zaten seçiliyse görünür (mevcut atama bozulmaz).
*@

<div class="an-secici">
    <RadzenDropDown TValue="int?" Data="@Secenekler" TextProperty="Ad" ValueProperty="Id"
                    Value="@Value" ValueChanged="@Sec" AllowClear="true" AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    Placeholder="—" Style="width:100%" />

    @if (!ekleniyor)
    {
        <span class="an-secici-yeni" role="button" @onclick="@(() => ekleniyor = true)">+ Yeni ekle</span>
    }
    else
    {
        <div class="an-secici-form">
            <RadzenTextBox @bind-Value="yeniAd" MaxLength="100" Placeholder="@($"Yeni {SistemMetin.Tur(Tur).ToLower()} adı")"
                           Style="flex:1;min-width:0" />
            <RadzenButton Text="Ekle" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary" IsBusy="@isleniyor"
                          Disabled="@string.IsNullOrWhiteSpace(yeniAd)" Click="@(() => Ekle(israr: false))" />
            <RadzenButton Text="Vazgeç" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@Kapat" />
        </div>
    }

    @if (benzer is not null)
    {
        <div class="an-secici-benzer">
            <div><b>@benzer.Ad</b> zaten listede@(benzer.Aktif ? "" : " (pasif)"), onu mu demek istediniz?</div>
            <div class="an-secici-dugmeler">
                @if (benzer.Aktif)
                {
                    <RadzenButton Text="@($"Evet, {benzer.Ad}")" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary"
                                  Click="@BenzeriSec" />
                }
                <RadzenButton Text="@($"Hayır, \"{yeniAd?.Trim()}\" ayrı bir sistem")" Size="ButtonSize.ExtraSmall"
                              ButtonStyle="ButtonStyle.Light" IsBusy="@isleniyor" Click="@(() => Ekle(israr: true))" />
            </div>
        </div>
    }

    @if (hata is not null)
    {
        <div class="an-secici-hata">@hata</div>
    }
</div>

<style>
    .an-secici { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .an-secici-yeni { font-size:11.5px; color:#3182ce; cursor:pointer; align-self:flex-start; }
    .an-secici-yeni:hover { text-decoration:underline; }
    .an-secici-form { display:flex; gap:4px; align-items:center; }
    .an-secici-benzer { border:1px solid #f6e05e; background:#fffff0; border-radius:6px; padding:.35rem .5rem;
                        font-size:12px; color:#744210; }
    .an-secici-dugmeler { display:flex; gap:4px; flex-wrap:wrap; margin-top:4px; }
    .an-secici-hata { font-size:11.5px; color:#c53030; }
</style>

@code {
    [Parameter, EditorRequired] public SistemTuru Tur { get; set; }

    /// <summary>Formun ortak listesi (bütün türler, pasifler dahil); eklenen kayıt buraya da girer.</summary>
    [Parameter, EditorRequired] public List<SistemDto> Liste { get; set; } = new();

    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    private bool ekleniyor;
    private bool isleniyor;
    private string? yeniAd;
    private SistemDto? benzer;
    private string? hata;

    private sealed record Secenek(int Id, string Ad);

    private List<Secenek> Secenekler => Liste
        .Where(s => s.Tur == Tur && (s.Aktif || s.Id == Value))
        .OrderBy(s => s.Ad, StringComparer.Create(new System.Globalization.CultureInfo("tr-TR"), true))
        .Select(s => new Secenek(s.Id, s.Aktif ? s.Ad : s.Ad + " (pasif)"))
        .ToList();

    private Task Sec(int? id) => ValueChanged.InvokeAsync(id);

    private void Kapat()
    {
        ekleniyor = false;
        yeniAd = null;
        benzer = null;
        hata = null;
    }

    private async Task Ekle(bool israr)
    {
        hata = null;
        isleniyor = true;
        try
        {
            var sonuc = await Api.EkleAsync(new SistemEkleDto { Ad = yeniAd ?? string.Empty, Tur = Tur, Israr = israr });

            if (sonuc.Benzer is not null)
            {
                benzer = sonuc.Benzer;
                return;
            }

            if (sonuc.Kayit is null)
            {
                hata = sonuc.Hata;
                return;
            }

            Liste.Add(sonuc.Kayit);
            var id = sonuc.Kayit.Id;
            Kapat();
            await Sec(id);
        }
        finally
        {
            isleniyor = false;
        }
    }

    private async Task BenzeriSec()
    {
        var b = benzer!;
        if (Liste.All(s => s.Id != b.Id)) Liste.Add(b);
        Kapat();
        await Sec(b.Id);
    }
}
