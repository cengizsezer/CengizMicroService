@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services
@using WebApp.Shared.Dto.Anasayfa
@using WebApp.Shared.Dto.Sistemler

@inject ISistemApiClient Api
@inject DialogService DialogService

@*
    "Kullanılan sistemler" kartının formu: hangi iş nerede yapılıyor.

    Sistemler ORTAK listeden seçilir (DijitalPlanet bir kez tanımlı, her firmada aynı kayıt);
    listede yoksa alanın altındaki "+ Yeni ekle" ile buradan eklenir.

    ORKA firma kodu ve mizan formatı Firma kaydının KENDİ alanlarına yazılır — ORKA'ya aktarım
    yükü kodu oradan okur, mizan formatı da mizan profili olarak orada kalır. Muhasebe programı
    seçilince mizan formatı için öneri çıkar; zorlanmaz.
*@

<div class="an-form">
    @if (liste is null)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
    }
    else
    {
        <div class="an-form-ikili">
            @TekliAlan("Muhasebe programı", SistemTuru.Muhasebe, muhasebe)
            @TekliAlan("e-Fatura entegratörü", SistemTuru.EFatura, efatura)
            @TekliAlan("Bordro", SistemTuru.Bordro, bordro)
            @TekliAlan("Beyanname", SistemTuru.Beyanname, beyanname)
        </div>

        @CokluAlan("Banka portalları", SistemTuru.Banka, bankalar, "+ Banka portalı ekle")
        @CokluAlan("Diğer sistemler", SistemTuru.Diger, digerleri, "+ Diğer sistem ekle")

        <div class="an-form-ikili">
            <div class="@AlanSinifi("orkaFirmaKodu")" id="an-alan-orkaFirmaKodu">
                <div class="an-form-etiket">ORKA firma kodu</div>
                <RadzenTextBox @bind-Value="orkaKodu" MaxLength="20" Placeholder="ör. 0001" Style="width:100%" />
                <div class="an-not">ORKA girişinde F7'den sonra yazılan kod; ORKA'ya aktarım bu alanı okur.</div>
            </div>

            <div class="@AlanSinifi("mizanFormati")" id="an-alan-mizanFormati">
                <div class="an-form-etiket">Mizan formatı</div>
                <RadzenDropDown TValue="string" Data="@MizanFormatlari.Liste" @bind-Value="mizanFormati"
                                Placeholder="Seçin" AllowClear="true" Style="width:100%" />
                @if (MizanOnerileri.Count > 0)
                {
                    <div class="an-not">
                        @MuhasebeAdi için öneri:
                        @foreach (var oneri in MizanOnerileri)
                        {
                            <span class="an-oneri" role="button" @onclick="@(() => mizanFormati = oneri)">@oneri</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="an-form-etiket">Sistem notu</div>
            <RadzenTextArea @bind-Value="sistemNotu" MaxLength="500" Rows="2" Style="width:100%"
                            Placeholder="ör. DijitalPlanet şifresi firma yetkilisinde" />
        </div>
    }

    @if (hata is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Small">@hata</RadzenAlert>
    }

    <div class="an-form-dugmeler">
        <RadzenButton Text="Vazgeç" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="Kaydet" ButtonStyle="ButtonStyle.Primary" IsBusy="@kaydediliyor" Disabled="@(liste is null)"
                      Click="@Kaydet" />
    </div>
</div>

<style>
    .an-form { display:flex; flex-direction:column; gap:.9rem; }
    .an-form-ikili { display:grid; grid-template-columns:1fr 1fr; gap:.75rem 1rem; }
    .an-form-alan { padding:.35rem .5rem; border-radius:6px; }
    .an-form-odak { background:#fffff0; box-shadow:0 0 0 2px #f6e05e; }
    .an-form-etiket { font-size:11px; color:#718096; text-transform:uppercase; letter-spacing:.02em; margin-bottom:.25rem; }
    .an-form-dugmeler { display:flex; justify-content:flex-end; gap:.5rem; }
    .an-not { font-size:11.5px; color:#a0aec0; margin-top:.2rem; }
    .an-kod-giris { margin-top:4px; }
    .an-coklu-satir { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) 28px; gap:6px; align-items:start;
                      margin-bottom:6px; }
    .an-oneri { display:inline-block; font-size:11px; border:1px solid #bee3f8; color:#2b6cb0; border-radius:999px;
                padding:0 7px; margin-left:4px; cursor:pointer; }
    .an-oneri:hover { background:#ebf8ff; }
    .an-coklu-ekle { font-size:12px; color:#3182ce; cursor:pointer; }
    .an-coklu-ekle:hover { text-decoration:underline; }
</style>

@code {
    [Parameter, EditorRequired] public int FirmaId { get; set; }
    [Parameter, EditorRequired] public FirmaPaneliSistemlerDto Mevcut { get; set; } = new();

    /// <summary>Firma kaydındaki ORKA kodu ve mizan formatı (Sınıflandırma DTO'sundan).</summary>
    [Parameter] public string? OrkaFirmaKodu { get; set; }
    [Parameter] public string? MizanFormati { get; set; }

    /// <summary>"Tamamla"dan gelindiyse vurgulanacak alan (mizanFormati, orkaFirmaKodu).</summary>
    [Parameter] public string? Odak { get; set; }

    private sealed class Satir
    {
        public int? SistemId { get; set; }
        public string? FirmaKodu { get; set; }
    }

    private List<SistemDto>? liste;
    private Satir muhasebe = new(), efatura = new(), bordro = new(), beyanname = new();
    private List<Satir> bankalar = new(), digerleri = new();

    /// <summary>Tekli türde ikinci atama (başka yoldan gelmiş): formda görünmez ama kayıtta korunur.</summary>
    private List<Satir> korunanlar = new();

    private string? orkaKodu, mizanFormati, sistemNotu;
    private bool kaydediliyor;
    private string? hata;

    protected override async Task OnInitializedAsync()
    {
        orkaKodu = OrkaFirmaKodu;
        mizanFormati = MizanFormatlari.Secili(MizanFormati) ? MizanFormati : null;
        sistemNotu = Mevcut.SistemNotu;

        Satir Ilk(SistemTuru tur)
        {
            var atamalar = Mevcut.Atamalar.Where(a => a.Tur == tur).ToList();
            korunanlar.AddRange(atamalar.Skip(1).Select(a => new Satir { SistemId = a.SistemId, FirmaKodu = a.FirmaKodu }));
            return atamalar.Select(a => new Satir { SistemId = a.SistemId, FirmaKodu = a.FirmaKodu }).FirstOrDefault() ?? new Satir();
        }

        muhasebe = Ilk(SistemTuru.Muhasebe);
        efatura = Ilk(SistemTuru.EFatura);
        bordro = Ilk(SistemTuru.Bordro);
        beyanname = Ilk(SistemTuru.Beyanname);
        bankalar = Mevcut.Atamalar.Where(a => a.Tur == SistemTuru.Banka)
            .Select(a => new Satir { SistemId = a.SistemId, FirmaKodu = a.FirmaKodu }).ToList();
        digerleri = Mevcut.Atamalar.Where(a => a.Tur == SistemTuru.Diger)
            .Select(a => new Satir { SistemId = a.SistemId, FirmaKodu = a.FirmaKodu }).ToList();

        // Pasifler de gelir: mevcut atama pasif kayıtsa seçicide görünmeye devam etsin.
        liste = await Api.ListeAsync(null, pasiflerDahil: true);
        if (liste is null) hata = "Sistem listesi alınamadı.";
    }

    private string AlanSinifi(string alan) => alan == Odak ? "an-form-alan an-form-odak" : "an-form-alan";

    private string? MuhasebeAdi => liste?.FirstOrDefault(s => s.Id == muhasebe.SistemId)?.Ad;

    /// <summary>Muhasebe programına uyan formatlar; seçili format zaten uyuyorsa öneri yok.</summary>
    private List<string> MizanOnerileri
    {
        get
        {
            var oneriler = MizanFormatlari.ProgramIcin(MuhasebeAdi);
            return oneriler.Contains(mizanFormati ?? string.Empty) ? new() : oneriler;
        }
    }

    private RenderFragment TekliAlan(string etiket, SistemTuru tur, Satir satir) => __builder =>
    {
        <div class="an-form-alan">
            <div class="an-form-etiket">@etiket</div>
            <SistemSecici Tur="@tur" Liste="@(liste!)" @bind-Value="satir.SistemId" />
            @if (satir.SistemId is not null)
            {
                <RadzenTextBox @bind-Value="satir.FirmaKodu" MaxLength="50" Placeholder="Bu sistemdeki firma kodu (isteğe bağlı)"
                               class="an-kod-giris" Style="width:100%" />
            }
        </div>
    };

    private RenderFragment CokluAlan(string etiket, SistemTuru tur, List<Satir> satirlar, string ekleMetni) => __builder =>
    {
        <div class="an-form-alan">
            <div class="an-form-etiket">@etiket</div>
            @foreach (var s in satirlar)
            {
                <div class="an-coklu-satir">
                    <SistemSecici Tur="@tur" Liste="@(liste!)" @bind-Value="s.SistemId" />
                    <RadzenTextBox @bind-Value="s.FirmaKodu" MaxLength="50" Placeholder="Firma / müşteri kodu" />
                    <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  title="Çıkar" Click="@(() => satirlar.Remove(s))" />
                </div>
            }
            <span class="an-coklu-ekle" role="button" @onclick="@(() => satirlar.Add(new Satir()))">@ekleMetni</span>
        </div>
    };

    private async Task Kaydet()
    {
        hata = null;

        var atamalar = new[] { muhasebe, efatura, bordro, beyanname }
            .Concat(bankalar).Concat(digerleri).Concat(korunanlar)
            .Where(s => s.SistemId is not null)
            .GroupBy(s => s.SistemId!.Value)
            .Select(g => new FirmaSistemAtamaKaydetDto { SistemId = g.Key, FirmaKodu = g.First().FirmaKodu })
            .ToList();

        kaydediliyor = true;
        try
        {
            hata = await Api.FirmaSistemleriKaydetAsync(FirmaId, new FirmaSistemleriKaydetDto
            {
                Atamalar = atamalar,
                OrkaFirmaKodu = orkaKodu,
                MizanFormati = mizanFormati,
                SistemNotu = sistemNotu
            });
        }
        finally
        {
            kaydediliyor = false;
        }

        if (hata is null) DialogService.Close(true);
    }
}
