    .fp-tablo td { padding:4px 6px; border-bottom:1px solid #f2f5f9; color:#2d3748; }
    .fp-tablo tbody tr:last-child td { border-bottom:none; }
    .fp-sag { text-align:right; }
    .fp-mono { font-family:Consolas,"Courier New",monospace; }
    .fp-kimlik { font-family:Consolas,"Courier New",monospace; cursor:pointer;
                 border-bottom:1px dotted #cbd5e0; }
    .fp-toplam td { border-top:1px solid #e2e8f0; font-weight:700; }
    .fp-hatali td { color:#c53030; }
    .fp-yetki-doldu td { background:#fffaf0; }
    .fp-yetki-yakin td { background:#fffff0; }
    .fp-kalan { color:#718096; font-size:11.5px; }

    .fp-uyari-kutu { border:1px solid #f6e05e; background:#fffff0; border-radius:6px; padding:.5rem .7rem; }
    .fp-uyari-satir { display:flex; align-items:center; gap:6px; font-size:12.5px; color:#744210; }

    .fp-belgeler { display:flex; flex-wrap:wrap; gap:6px; }
    .fp-belge { display:inline-flex; align-items:center; gap:5px; font-size:12.5px;
                border:1px solid #e2e8f0; border-radius:4px; padding:4px 10px;
                background:#fff; cursor:pointer; color:#2d3748; }
    .fp-belge:hover { background:#f7fafc; }
    .fp-belge-not { color:#a0aec0; font-size:11.5px; }
    .fp-belge-yok { border:1px dashed #cbd5e0; color:#a0aec0; background:transparent; }
    .fp-belge-yok:hover { border-color:#3182ce; color:#3182ce; }

    /* ---- anasayfa künyesi eklemeleri (an-) ---- */
    .an-cipler { display:flex; flex-wrap:wrap; gap:5px; padding:7px 10px; border-bottom:1px solid #edf2f7; }
    .an-cip { font-size:11.5px; border:1px solid #e2e8f0; border-radius:999px; padding:1px 9px;
              color:#4a5568; cursor:pointer; background:#fff; white-space:nowrap; }
    .an-cip:hover { border-color:#3182ce; }
    .an-cip-secili { background:#3182ce; border-color:#3182ce; color:#fff; }
    .an-rozet { display:inline-flex; align-items:center; justify-content:center; min-width:19px; height:19px;
                padding:0 5px; border-radius:999px; font-size:11px; font-weight:700; flex-shrink:0; }
    .an-rozet-eksik { background:#fefcbf; color:#744210; }
    .an-rozet-mizan { background:#e53e3e; color:#fff; }
    .an-ray-aciklama { padding:7px 10px; font-size:11px; color:#a0aec0; border-top:1px solid #edf2f7;
                       display:flex; align-items:center; gap:4px; flex-wrap:wrap; }
    .an-ray-aciklama .an-rozet { min-width:15px; height:15px; font-size:10px; padding:0 3px; }
    .an-oto { font-size:11px; color:#a0aec0; }
    .an-eksik-serit { display:flex; align-items:center; gap:8px; border:1px solid #f6e05e; background:#fffff0;
                      border-radius:6px; padding:.45rem .7rem; color:#744210; font-size:12.5px; }
    .an-eksik-metin { flex:1; min-width:0; }
    .an-eksik-fazla { color:#975a16; white-space:nowrap; }
    .an-uyari-cumle { display:block; margin-top:2px; }

    /* Prompt 12: künye rozeti (yalnız gerekli alanlar) ve gruplu şerit */
    .an-kunye-rozet { display:inline-block; margin-top:3px; font-size:10.5px; font-weight:600; border-radius:999px;
                      padding:0 7px; line-height:16px; white-space:nowrap; }
    .an-kunye-gerekli { background:#fed7d7; color:#9b2c2c; }
    .an-kunye-uyari { background:#fefcbf; color:#975a16; }
    .an-kunye-tamamlaniyor { background:#edf2f7; color:#4a5568; }
    .an-eksik-grup { display:block; }
    .an-eksik-serit-yeni { border-color:#cbd5e0; background:#f7fafc; color:#4a5568; }
    .an-kod-cipler { display:flex; flex-wrap:wrap; gap:4px; }
    .an-kod-cip { font-size:11.5px; border-radius:999px; padding:1px 8px; background:#edf2f7; color:#4a5568;
                  white-space:nowrap; }
    .an-kod-kaynak { background:#ebf4ff; color:#2c5282; font-weight:700; box-shadow:inset 0 0 0 1px #90cdf4; }
    .an-kalan { font-size:11px; color:#a0aec0; margin-top:3px; word-break:break-word; }
    .an-odak-vurgu { outline:2px solid #f6e05e; outline-offset:3px; border-radius:6px; }

    /* Takip kartı */
    .an-takip { display:grid; gap:.4rem 1.2rem; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); }
    .an-sorumlu { display:flex; align-items:center; gap:8px; font-size:13px; }
    .an-avatar { width:26px; height:26px; border-radius:50%; background:#ebf4ff; color:#2c5282;
                 display:inline-flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; }
    .an-avatar-bos { background:transparent; border:1.5px dashed #cbd5e0; }
    .an-donemler { display:flex; flex-wrap:wrap; gap:5px; }
    .an-donem { font-size:11.5px; border-radius:999px; padding:1px 9px; }
    .an-donem-yuklu { background:#e6fffa; color:#276749; }
    .an-donem-yok { background:#edf2f7; color:#a0aec0; }
    .an-takip-bolum { border-top:1px solid #edf2f7; margin-top:.6rem; padding-top:.5rem; }
    .an-takip-basi { display:flex; justify-content:space-between; align-items:center; margin-bottom:.25rem; }
    .an-not { font-size:13px; color:#2d3748; white-space:pre-wrap; word-break:break-word; }
    .an-yetki-rozet { font-size:11px; font-weight:600; border-radius:999px; padding:1px 8px; margin-left:4px;
                      background:#fefcbf; color:#744210; }
    .an-yetki-kritik { background:#fed7d7; color:#9b2c2c; }
    .an-baglanti { font-size:12px; color:#3182ce; cursor:pointer; }
    .an-baglanti:hover { text-decoration:underline; }
    .an-pasif { color:#cbd5e0; cursor:not-allowed; }
    .an-pasif:hover { text-decoration:none; }
    .an-mizan { display:grid; gap:.4rem 1.2rem; align-items:end;
                grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
                border-top:1px solid #edf2f7; margin-top:.6rem; padding-top:.55rem; }
    .an-mizan-ac { justify-self:end; white-space:nowrap; }
    .an-denge { display:inline-block; font-size:11.5px; border-radius:999px; padding:1px 8px; }
    .an-denge-tamam { background:#e6fffa; color:#276749; }
    .an-denge-fark { background:#fffaf0; color:#975a16; }

    /* Kullanılan sistemler kartı (Prompt 9) */
    .an-sistemler { display:flex; flex-wrap:wrap; gap:4px; }
    .an-sistem { font-size:12px; border-radius:4px; padding:1px 8px; background:#f7fafc; color:#2d3748;
                 border:1px solid #e2e8f0; white-space:nowrap; }
    .an-sistem-pasif { color:#a0aec0; border-style:dashed; }
    .an-sistem-kod { font-family:Consolas,"Courier New",monospace; color:#718096; margin-left:4px; }
    .an-sistem-satir { border-top:1px solid #edf2f7; margin-top:.6rem; padding-top:.55rem; }
    .an-sistem-not { font-size:12.5px; color:#4a5568; white-space:pre-wrap; word-break:break-word; }
    .an-sgk-oran { font-size:11px; color:#718096; margin-left:4px; }
</style>

@code {
    private FirmaPaneliDto panel = new();
    private string? arama;
    private bool yukleniyor = true;
    private bool detayYukleniyor;
    private string? hata;

    private int SeciliId => panel.Secili?.FirmaId ?? 0;

    private enum RayFiltresi { Tumu, Eksik, MizanYok }

    private RayFiltresi filtre = RayFiltresi.Tumu;

    /// <summary>Arama ile filtre birlikte uygulanır; çipteki sayılar filtre öncesi (aramasız) toplamdır.</summary>
    private List<FirmaPaneliOzetDto> Suzulmus => FirmaPaneliArama.Suz(panel.Firmalar, arama)
        .Where(f => filtre switch
        {
            RayFiltresi.Eksik => Sayi(f) > 0,
            RayFiltresi.MizanYok => f.MizanYok,
            _ => true
        })
        .ToList();

    private RenderFragment Cip(RayFiltresi deger, string ad, int sayi) => __builder =>
    {
        <span class="@(filtre == deger ? "an-cip an-cip-secili" : "an-cip")" role="button"
              @onclick="@(() => filtre = deger)">@ad @sayi</span>
    };

    /// <summary>"Eksik" filtresi: rozeti olan firma (gerekli eksik ya da uyarı). İkincil boşluk saymaz.</summary>
    private static int Sayi(FirmaPaneliOzetDto f) => f.Rozet == KunyeRozeti.Yok ? 0 : 1;

    /// <summary>Rozet metni (Prompt 12). Karar (tür) sunucudan; istemci yalnız yazar ve boyar.</summary>
    private static string RozetMetni(FirmaPaneliOzetDto f) => f.Rozet switch
    {
        KunyeRozeti.GerekliEksik => $"{f.GerekliEksikSayisi} gerekli alan eksik",
        KunyeRozeti.Tamamlaniyor => $"Künye tamamlanıyor · {f.GerekliEksikSayisi} gerekli alan",
        KunyeRozeti.Uyari => $"{f.UyariSayisi} uyarı",
        _ => string.Empty
    };

    private static string RozetSinifi(KunyeRozeti r) => r switch
    {
        KunyeRozeti.GerekliEksik => "an-kunye-rozet an-kunye-gerekli",
        KunyeRozeti.Tamamlaniyor => "an-kunye-rozet an-kunye-tamamlaniyor",
        _ => "an-kunye-rozet an-kunye-uyari"
    };

    /// <summary>Renk tek başına anlam taşımasın: title eksik alanların ADLARINI sayar.</summary>
    private static string RozetBasligi(FirmaPaneliOzetDto f)
    {
        if (f.GerekliEksikler.Count > 0) return "Eksik: " + string.Join(", ", f.GerekliEksikler);
        return f.Uyarilar.Count > 0 ? "Uyarı: " + string.Join(" · ", f.Uyarilar.Select(u => u.Mesaj.TrimEnd('.'))) : string.Empty;
    }

    /// <summary>Adresten gelen firma (Prompt 13); yoksa sunucu ilk firmayı seçer.</summary>
    [Parameter] public int? BaslangicFirmaId { get; set; }

    /// <summary>"isler": açılışta firma işleri kartına kaydırılır (mevcut anOdakla, vurgulu).</summary>
    [Parameter] public string? OdakKart { get; set; }

    /// <summary>Adresteki firma bulunamadı (pasif/silinmiş): sunucu başka firmaya düştü — söylenir, kaydırılmaz.</summary>
    private string? baslangicUyarisi;

    protected override async Task OnInitializedAsync()
    {
        await Yukle(BaslangicFirmaId, ilk: true);
        if (BaslangicFirmaId is not { } istenen || hata is not null) return;

        if (SeciliId != istenen)
        {
            // Sessizce yanlış firmanın kartına GÖTÜRÜLMEZ.
            baslangicUyarisi = "İstenen firma bulunamadı (pasif ya da silinmiş olabilir); listeden firmayı seçin.";
            return;
        }

        if (string.Equals(OdakKart, "isler", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                await JS.InvokeVoidAsync("anOdakla", "ys-kart-isler");   // kart DOM'a gelene kadar bekler
            }
            catch
            {
                // Kaydırma olmazsa sayfa etkilenmez.
            }
        }
    }

    /// <summary>
    /// Dışarıdan (anasayfanın "Yenile" düğmesi) tazeleme. Olay üst bileşende
    /// gerçekleştiği için yeniden çizimi burada elle istemek gerekiyor.
    /// </summary>
    public async Task Tazele()
    {
        await Yukle(SeciliId > 0 ? SeciliId : null, ilk: true);
        StateHasChanged();
    }

    /// <summary>Kart üzerinden kayıt yapıldı: aynı firma, liste ve ayrıntı birlikte tazelenir.</summary>
    private Task DetayTazele() => Yukle(SeciliId > 0 ? SeciliId : null, ilk: false);

    private async Task Sec(int firmaId)
    {
        if (firmaId == SeciliId) return;
        await Yukle(firmaId, ilk: false);
    }

    private async Task Yukle(int? firmaId, bool ilk)
    {
        if (ilk) yukleniyor = true; else detayYukleniyor = true;
        hata = null;

        try
        {
            var sonuc = await Api.FirmaPaneliAsync(firmaId);

            if (sonuc is null)
            {
                Log.LogWarning("Firma paneli ucu veri döndürmedi (firma {FirmaId}).", firmaId);
                hata = "Firma bilgileri alınamadı. Sunucuya ulaşılamıyor olabilir.";
                return;
            }

            panel = sonuc;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Firma paneli yüklenemedi (firma {FirmaId}).", firmaId);
            hata = "Firma bilgileri alınamadı. Sunucuya ulaşılamıyor olabilir.";
        }
        finally
        {
            yukleniyor = false;
            detayYukleniyor = false;
        }
    }

    /// <summary>"Yeniden dene": yalnız künye çağrısı; seçili firma korunur.</summary>
    private Task YenidenDene() => Yukle(SeciliId > 0 ? SeciliId : null, ilk: panel.Firmalar.Count == 0);

    private void AramaDegisti(ChangeEventArgs e) => arama = e.Value?.ToString();

    private void AramayiTemizle() => arama = null;
}
