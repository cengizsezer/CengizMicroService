    // Karta tıklayınca detay paneli (view-only). Kanban'dan düzenleme Parça 5/sonraki tur.
    async Task OpenDetail(TaskCardVm card)
    {
        await DialogService.OpenAsync<JobDetailPage>(
            card.Title,
            new Dictionary<string, object>
            {
                ["JobId"] = card.JobId,
                ["Title"] = card.Title,
                ["Description"] = card.Description,
                ["Start"] = card.Start,
                ["End"] = card.End,
                ["AssigneeNames"] = card.AssigneeNames,
                ["Status"] = card.Status,
                ["Attachments"] = card.Attachments,
                ["CanEdit"] = false
            },
            new DialogOptions { Width = "1000px", Height = "720px", Resizable = true, Draggable = true });
    }

    public class TaskCardVm
    {
        public long JobId { get; set; }
        public long AssignmentId { get; set; }
        public JobStatus Status { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public JobAssignmentDto? Me { get; set; }
        public List<JobAttachmentDto> Attachments { get; set; } = new();
        public List<string> AssigneeNames { get; set; } = new();
    }
