    // Zone filtreleri
    Func<TaskCardVm, RadzenDropZone<TaskCardVm>, bool> ItemSelector =
        (item, zone) => item.Status == (JobStatus)zone.Value && item.Status != JobStatus.Deleted;

    Func<RadzenDropZoneItemEventArgs<TaskCardVm>, bool> CanDrop = request =>
        request.FromZone == request.ToZone ||
        (JobStatus)request.ToZone.Value == JobStatus.Deleted ||
        Math.Abs((int)request.Item.Status - (int)request.ToZone.Value) == 1;

    void OnItemRender(RadzenDropZoneItemRenderEventArgs<TaskCardVm> args)
    {
        args.Visible = args.Item.Status != JobStatus.Deleted;
    }

    async void OnDrop(RadzenDropZoneItemEventArgs<TaskCardVm> args)
    {
        if (args.FromZone == args.ToZone && args.ToItem == args.Item) return;

        var toStatus = (JobStatus)args.ToZone.Value;

        // Tam silme: "Deleted" sütunu
        if (toStatus == JobStatus.Deleted)
        {
            // (İsteğe bağlı) emin misin?
            // if (!await ConfirmAsync("Bu iş herkesten silinecek, emin misiniz?")) return;

            // FileId'leri Job silmeden ÖNCE al (kartın belleğindeki eklerden).
            var fileIds = args.Item.Attachments?
                .Select(a => a.FileId)
                .Where(id => id > 0)
                .Distinct()
                .ToList() ?? new List<int>();

            try
            {
                await JobsApi.DeleteAsync(args.Item.JobId); // 👈 job’u sil

                // Yetim dosya önleme: Job'a ait eklerin MinIO dosyalarını da temizle.
                foreach (var fid in fileIds)
                {
                    try { await FileApi.DeleteAsync(fid); } catch { }
                }

                // aynı job’a ait tüm kartları listeden çıkar
                var toRemove = data.Where(d => d.JobId == args.Item.JobId).ToList();
                foreach (var x in toRemove) data.Remove(x);
                StateHasChanged();
            }
            catch
            {
                // (İsteğe bağlı) toast / error göster
            }
            return;
        }

        // Eski davranış: kolonlar arası normal geçiş → assignment status güncelle
        var old = args.Item.Status;
        args.Item.Status = toStatus;

        try
        {
            await JobsApi.UpdateAssignmentStatusAsync(args.Item.AssignmentId, args.Item.Status);
        }
        catch
        {
            args.Item.Status = old;
            StateHasChanged();
            return;
        }

        if (args.ToItem != null && args.ToItem != args.Item)
        {
            data.Remove(args.Item);
            data.Insert(data.IndexOf(args.ToItem), args.Item);
        }

        StateHasChanged();
    }

