@page "/AssignedTaskPage"
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.Scheduling
@inject IJobsApi JobsApi
@inject AuthenticationStateProvider Auth // me.Id lazım olabilir
@inject DialogService DialogService
@inject IFileApiService FileApi
@using Radzen
@using System.Security.Claims;
<h3>ATANMIŞ GÖREVLER</h3>

<RadzenDropZoneContainer TItem="TaskCardVm" Data="data"
                         ItemSelector="@ItemSelector"
                         ItemRender="@OnItemRender"
                         CanDrop="@CanDrop"
                         Drop="@OnDrop">
    <ChildContent>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-p-12">
            <div class="rz-border-radius-2 rz-p-4" style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .75rem; max-height: calc(100vh - 220px); background: #f4f5f7; border: 1px solid #e5e7eb;">
                <div style="display: flex; align-items: center; gap: .4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #EF9F27; flex: none;"></span>
                    <RadzenText Text="Başlanmadı" TextStyle="TextStyle.Subtitle2" Style="color: #3f3f46;" />
                </div>
                <RadzenDropZone Value="JobStatus.NotStarted" class="rz-display-flex rz-flex-column" Style="flex: 1; min-height: 0; overflow-y: auto; gap: 1rem;">
                </RadzenDropZone>
            </div>
            <div class="rz-border-radius-2 rz-p-4" style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .75rem; max-height: calc(100vh - 220px); background: #f4f5f7; border: 1px solid #e5e7eb;">
                <div style="display: flex; align-items: center; gap: .4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #378ADD; flex: none;"></span>
                    <RadzenText Text="Başlandı" TextStyle="TextStyle.Subtitle2" Style="color: #3f3f46;" />
                </div>
                <RadzenDropZone Value="JobStatus.Started" class="rz-display-flex rz-flex-column" Style="flex: 1; min-height: 0; overflow-y: auto; gap: 1rem;">
                </RadzenDropZone>
            </div>
            <div class="rz-border-radius-2 rz-p-4" style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .75rem; max-height: calc(100vh - 220px); background: #f4f5f7; border: 1px solid #e5e7eb;">
                <div style="display: flex; align-items: center; gap: .4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #1D9E75; flex: none;"></span>
                    <RadzenText Text="Tamamlandı" TextStyle="TextStyle.Subtitle2" Style="color: #3f3f46;" />
                </div>
                <RadzenDropZone Value="JobStatus.Completed" class="rz-display-flex rz-flex-column" Style="flex: 1; min-height: 0; overflow-y: auto; gap: 1rem;">
                </RadzenDropZone>
            </div>
            <div class="rz-border-radius-2 rz-p-4" style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .75rem; max-height: calc(100vh - 220px); background: #f4f5f7; border: 1px solid #f0c9c7;">
                <div style="display: flex; align-items: center; gap: .4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #E24B4A; flex: none;"></span>
                    <RadzenText Text="Silmek için buraya bırak" TextStyle="TextStyle.Subtitle2" Style="color: #3f3f46;" />
                </div>
                <RadzenDropZone Value="JobStatus.Deleted" class="rz-display-flex rz-flex-column" Style="flex: 1; min-height: 0; overflow-y: auto; gap: 1rem;">
                </RadzenDropZone>
            </div>
        </RadzenStack>
    </ChildContent>
    <Template>
        <div class="rz-card" @onclick="@(() => OpenDetail(context))"
             style="cursor:pointer;background:#ffffff;border:1px solid #ececf1;border-left:3px solid #7F77DD;border-radius:12px;padding:.65rem .8rem;display:flex;flex-direction:column;gap:.3rem;">
            <div style="color:#2b2b36;font-weight:500;font-size:14px;line-height:1.25;">@context.Title</div>
            @if (!string.IsNullOrWhiteSpace(context.Description))
            {
                <div style="color:#9a9aa8;font-size:12px;line-height:1.3;">@context.Description</div>
            }
            <div style="display:flex;align-items:center;gap:.3rem;color:#8a8a97;font-size:12px;">
                <RadzenIcon Icon="calendar_today" Style="font-size:14px;" />
                <span>@(context.Start.ToString("d MMM")) – @(context.End.ToString("d MMM"))</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f1f5;padding-top:.35rem;margin-top:.1rem;">
                <div style="display:flex;align-items:center;gap:.25rem;color:#b6b6c2;font-size:11px;">
                    <RadzenIcon Icon="schedule" Style="font-size:13px;" />
                    <span>@(context.CreatedAt.ToString("dd.MM.yyyy")) eklendi</span>
                </div>
                @if (context.Attachments is { Count: > 0 })
                {
                    <div style="display:flex;align-items:center;gap:.2rem;color:#8a8a97;font-size:11px;"
                         title="@(context.Attachments.Count) ek">
                        <RadzenIcon Icon="attach_file" Style="font-size:14px;" />
                        <span>@context.Attachments.Count</span>
                    </div>
                }
            </div>
        </div>
    </Template>
</RadzenDropZoneContainer>

@code {
    // Data
    IList<TaskCardVm> data = new List<TaskCardVm>();
    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;

        // Birden fazla olası claim key’i dene
        var meId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
            user.FindFirst("sub")?.Value ??
            user.FindFirst("uid")?.Value ??
            user.FindFirst("nameid")?.Value; // bazı provider’lar böyle yazar

        // meId yoksa, geçici olarak assigneeId parametresi göndermeden çekelim (UI boş kalmasın)
        var jobs = await JobsApi.GetRangeAsync(DateTime.Today.AddDays(-7),
                                               DateTime.Today.AddDays(30),
                                               assigneeId: string.IsNullOrWhiteSpace(meId) ? null : meId);

        // Eğer API tarafında assignee filtresi henüz net değilse, client’ta da süzelim:
        var filtered = string.IsNullOrWhiteSpace(meId)
            ? jobs // meId yoksa hepsini göster
            : jobs.Where(j => j.Assignments.Any(a => a.UserId == meId && a.Status != JobStatus.Deleted));

        data = filtered.SelectMany(j => j.Assignments
                    .Where(a => (string.IsNullOrWhiteSpace(meId) || a.UserId == meId) && a.Status != JobStatus.Deleted)
                    .Select(a => new TaskCardVm
                    {
                        JobId = j.Id,
                        AssignmentId = a.Id,
                        Status = a.Status,
                        Title = j.Title,
                        Description = j.Description,
                        Start = j.Start,
                        End = j.End,
                        CreatedAt = j.CreatedAt,
                        Me = a,
                        Attachments = j.Attachments ?? new(),
                        AssigneeNames = j.Assignments
                                         .Where(x => x.Status != JobStatus.Deleted)
                                         .Select(x => x.UserName).ToList()
                    }))
                .ToList();
    }
