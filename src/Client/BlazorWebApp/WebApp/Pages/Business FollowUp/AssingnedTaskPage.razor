@page "/AssignedTaskPage"
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.Scheduling
@inject IJobsApi JobsApi
@inject AuthenticationStateProvider Auth // me.Id lazım olabilir
@using System.Security.Claims;
<h3>ATANMIŞ GÖREVLER</h3>

<RadzenDropZoneContainer TItem="TaskCardVm" Data="data"
                         ItemSelector="@ItemSelector"
                         ItemRender="@OnItemRender"
                         CanDrop="@CanDrop"
                         Drop="@OnDrop">
    <ChildContent>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-p-12">
            <RadzenDropZone Value="JobStatus.NotStarted" class="rz-display-flex rz-flex-column rz-background-color-warning-lighter rz-border-warning-light rz-border-radius-2 rz-p-4" Style="flex: 1; gap: 1rem;">
                <RadzenText Text="Not started" TextStyle="TextStyle.Subtitle2" />
            </RadzenDropZone>
            <RadzenDropZone Value="JobStatus.Started" class="rz-display-flex rz-flex-column rz-background-color-info-lighter rz-border-info-light rz-border-radius-2 rz-p-4" Style="flex: 1; gap: 1rem;">
                <RadzenText Text="Started" TextStyle="TextStyle.Subtitle2" />
            </RadzenDropZone>
            <RadzenDropZone Value="JobStatus.Completed" class="rz-display-flex rz-flex-column rz-background-color-success-lighter rz-border-success-light rz-border-radius-2 rz-p-4" Style="flex: 1; gap: 1rem;">
                <RadzenText Text="Completed" TextStyle="TextStyle.Subtitle2" />
            </RadzenDropZone>
            <RadzenDropZone Value="JobStatus.Deleted" class="rz-display-flex rz-flex-column rz-background-color-danger-lighter rz-border-danger-light rz-border-radius-2 rz-p-4" Style="flex: 1; gap: 1rem;">
                <RadzenText Text="Drop here to delete" TextStyle="TextStyle.Subtitle2" />
            </RadzenDropZone>
        </RadzenStack>
    </ChildContent>
    <Template>
        <div class="rz-card rz-variant-filled rz-background-color-primary-light rz-color-on-primary-light rz-p-3">
            <strong>@context.Title</strong><br />
            <small>@(context.Start.ToString("g")) - @(context.End.ToString("g"))</small><br />
            <span>@context.Description</span>
        </div>
    </Template>
</RadzenDropZoneContainer>

@code {
    // Data
    IList<TaskCardVm> data = new List<TaskCardVm>();
    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;

        // Birden fazla olası claim key’i dene
        var meId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
            user.FindFirst("sub")?.Value ??
            user.FindFirst("uid")?.Value ??
            user.FindFirst("nameid")?.Value; // bazı provider’lar böyle yazar

        // meId yoksa, geçici olarak assigneeId parametresi göndermeden çekelim (UI boş kalmasın)
        var jobs = await JobsApi.GetRangeAsync(DateTime.Today.AddDays(-7),
                                               DateTime.Today.AddDays(30),
                                               assigneeId: string.IsNullOrWhiteSpace(meId) ? null : meId);

        // Eğer API tarafında assignee filtresi henüz net değilse, client’ta da süzelim:
        var filtered = string.IsNullOrWhiteSpace(meId)
            ? jobs // meId yoksa hepsini göster
            : jobs.Where(j => j.Assignments.Any(a => a.UserId == meId && a.Status != JobStatus.Deleted));

        data = filtered.SelectMany(j => j.Assignments
                    .Where(a => (string.IsNullOrWhiteSpace(meId) || a.UserId == meId) && a.Status != JobStatus.Deleted)
                    .Select(a => new TaskCardVm
                    {
                        JobId = j.Id,
                        AssignmentId = a.Id,
                        Status = a.Status,
                        Title = j.Title,
                        Description = j.Description,
                        Start = j.Start,
                        End = j.End,
                        Me = a
                    }))
                .ToList();
    }
