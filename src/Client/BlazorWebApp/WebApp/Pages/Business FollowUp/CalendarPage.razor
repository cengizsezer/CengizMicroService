@page "/calendarpage"
@using WebApp.Application.Services.Interfaces
@using WebApp.Shared.Dto.Scheduling
@inject DialogService DialogService
@inject IJobsApi JobsApi
@inject IFileApiService FileApi
@inject NotificationService Notif
@inject AuthenticationStateProvider Auth
@using System.Security.Claims;
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<RadzenScheduler @ref="scheduler"
                 TItem="AppointmentVm"
                 Data="@appointments"
                 StartProperty="Start" EndProperty="End" TextProperty="Text"
                 SelectedIndex="0"
                 SlotRender="@OnSlotRender"
                 SlotSelect="@OnSlotSelect"
                 AppointmentSelect="@OnAppointmentSelect"
                 AppointmentRender="@OnAppointmentRender"
                 LoadData="@OnLoadData"
                 MonthSelect="@OnMonthSelect"
                 TodayText="Bugün"
                 style="height: 768px;">
    <RadzenMonthView Text="Ay" />
    <RadzenYearView Text="Yıl" StartMonth="@startMonth" />
</RadzenScheduler>

@code {
    RadzenScheduler<AppointmentVm> scheduler;

    Month startMonth = Month.January;
    List<AppointmentVm> appointments = new();

    bool canView;

    // Ekranda hangi aralik yuklu. Ayni aralik icin tekrar istek atmamak ve
    // kayit sonrasi mevcut gorunumu tazelemek icin tutuluyor.
    DateTime? loadedFrom;
    DateTime? loadedTo;

    // Oklara hizli basildiginda gec donen cevabin yeni araligi ezmemesi icin.
    int loadSeq;

    protected override async Task OnInitializedAsync()
    {
        canView = await PermissionService.HasPermissionAsync("Calendarpage.View");

        if (!canView)
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }
        await LoadMonth(DateTime.Today);
    }

    // Scheduler goruntulenen donem her degistiginde (ileri/geri ok, Bugun, gorunum
    // degisimi) burayi cagirir. MonthSelect yalnizca Yil gorunumunde ay basligina
    // tiklaninca tetiklendigi icin ay navigasyonu tek basina ona birakilamaz.
    async Task OnLoadData(Radzen.SchedulerLoadDataEventArgs args)
    {
        if (!canView) return;
        await LoadRange(args.Start, args.End);
    }
