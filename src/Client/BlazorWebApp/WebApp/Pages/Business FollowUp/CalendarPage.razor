    async Task LoadMonth(DateTime anyDayInMonth)
    {
        var from = new DateTime(anyDayInMonth.Year, anyDayInMonth.Month, 1, 0, 0, 0, DateTimeKind.Local);
        var to = from.AddMonths(1).AddTicks(-1);

        var auth = await Auth.GetAuthenticationStateAsync();
        var meId =
            auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? auth.User.FindFirst("nameid")?.Value
            ?? auth.User.FindFirst("sub")?.Value
            ?? auth.User.FindFirst("uid")?.Value;

        // DEBUG: bir kere bakıp doğrula
        Console.WriteLine($"[Calendar] meId = {meId ?? "<null>"}");

        // meId yoksa assignee filtresi göndermeyelim
        var jobs = string.IsNullOrWhiteSpace(meId)
            ? await JobsApi.GetRangeAsync(from, to)
            : await JobsApi.GetRangeAsync(from, to, assigneeId: meId);

        // meId varsa hem user hem Deleted filtresi; yoksa sadece Deleted filtresi
        appointments = jobs
            .Where(j => j.Assignments.Any(a =>
                (string.IsNullOrWhiteSpace(meId) || a.UserId == meId) &&
                a.Status != JobStatus.Deleted))
            .Select(j => new AppointmentVm
            {
                JobId = j.Id,
                Start = j.Start,
                End = j.End,
                Text = j.Title,
                Title = j.Title,
                Description = j.Description ?? "",
                AssigneeIds = j.Assignments
                               .Where(a => a.Status != JobStatus.Deleted)
                               .Select(a => a.UserId).ToList(),
                AssigneeNames = j.Assignments
                                 .Where(a => a.Status != JobStatus.Deleted)
                                 .Select(a => a.UserName).ToList(),
                Attachments = j.Attachments ?? new()
            })
            .ToList();

        await scheduler?.Reload();
        StateHasChanged();
    }



