    void OnSlotRender(SchedulerSlotRenderEventArgs args)
    {
        if (args.View.Text == "Ay" && args.Start.Date == DateTime.Today)
            args.Attributes["style"] = "background: var(--rz-scheduler-highlight-background-color, rgba(255,220,40,.2));";

        if ((args.View.Text == "Planner" || args.View.Text == "Timeline") && args.Start.Month == 12 && startMonth != Month.January)
            args.Attributes["style"] = "border-bottom: thick double var(--rz-base-600);";

        if (args.Appointments.Count() > 4) args.Attributes["style"] = "background: #ffabab;";
        else if (args.Appointments.Count() > 2) args.Attributes["style"] = "background: #ffc988;";
        else if (args.Appointments.Count() > 0) args.Attributes["style"] = "background: #c3ffc3;";
    }

    async Task OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        if (args.View.Text == "Yıl") return;

        // Add dialog: CreateJobRequest döndüreceğiz
        var createReq = await DialogService.OpenAsync<AddAppointmentPage>("Randevu ekle",
            new Dictionary<string, object> { { "Start", args.Start }, { "End", args.End } },
            new DialogOptions { Width = "460px" });

        if (createReq is CreateJobRequest req)
        {
            try
            {
                await JobsApi.CreateAsync(req);                        // backend’e kaydet
            }
            catch (Exception ex)
            {
                // Telafi: Job kaydı başarısızsa modalda yüklenmiş ekleri (MinIO) geri al.
                if (req.Attachments is { Count: > 0 })
                    foreach (var a in req.Attachments)
                    {
                        try { await FileApi.DeleteAsync(a.FileId); } catch { }
                    }

                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Randevu kaydedilemedi",
                    Detail = ex.Message,
                    Duration = 4000
                });
                return;
            }

            await LoadMonth(args.Start);                               // ayı tazele
        }
    }

    async Task OnMonthSelect(Radzen.SchedulerMonthSelectEventArgs args)
    {
        var start = args.MonthStart;                  // örn: 2025-10-01 00:00
        var end = start.AddMonths(1).AddTicks(-1);  // ayın son anı

        await LoadMonth(start); // veya: await LoadRange(start, end);
    }

    async Task OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<AppointmentVm> args)
    {
        var current = args.Data;

        // Önce detay paneli (solda bilgi + ekler, sağda büyük görsel/PDF). Düzenle'ye basılırsa edit modalı açılır.
        var detailResult = await DialogService.OpenAsync<JobDetailPage>(
            current.Title,
            new Dictionary<string, object>
            {
                ["JobId"] = current.JobId,
                ["Title"] = current.Title,
                ["Description"] = current.Description,
                ["Start"] = current.Start,
                ["End"] = current.End,
                ["AssigneeNames"] = current.AssigneeNames,
                ["Attachments"] = current.Attachments,
                ["CanEdit"] = true
            },
            new DialogOptions { Width = "1000px", Height = "720px", Resizable = true, Draggable = true }
        );

        if (detailResult as string != "edit")
            return;

        // Düzenle → mevcut edit modalı; mevcut ekleri InitialAttachments ile yükle (eski ekler düşmesin).
        var result = await DialogService.OpenAsync<AddAppointmentPage>(
            $"{current.Title} – Düzenle",
            new Dictionary<string, object>
            {
                ["Start"] = current.Start,
                ["End"] = current.End,
                ["InitialTitle"] = current.Title,
                ["InitialDescription"] = current.Description,
                ["InitialAssigneeIds"] = current.AssigneeIds, // List<string>
                ["InitialAttachments"] = current.Attachments  // List<JobAttachmentDto>
            },
            new DialogOptions { Width = "460px" }
        );

        // Dialog iptal edildiyse null döner
        if (result is not CreateJobRequest req)
            return;

        // CreateJobRequest’te Id yok; güncellenecek kaydın Id’si mevcut randevudan gelir
        await JobsApi.UpdateAsync(current.JobId, req);

        await LoadMonth(current.Start); // ekranda tazele
    }



    void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<AppointmentVm> args)
    {
        if (args.Data.Text?.Equals("Beyanname", StringComparison.OrdinalIgnoreCase) == true)
            args.Attributes["style"] = "background: red";
    }

    public class AppointmentVm
    {
        public long JobId { get; set; }
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public string Text { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public List<string> AssigneeIds { get; set; } = new();   // IDs
        public List<string> AssigneeNames { get; set; } = new(); // UI gösterimi
        public List<JobAttachmentDto> Attachments { get; set; } = new(); // detay paneli için ekler
    }
