    Task LoadMonth(DateTime anyDayInMonth)
    {
        var from = new DateTime(anyDayInMonth.Year, anyDayInMonth.Month, 1, 0, 0, 0, DateTimeKind.Local);
        var to = from.AddMonths(1).AddTicks(-1);
        return LoadRange(from, to, force: true);
    }

    // Kayit/guncelleme sonrasi: ekranda hangi aralik yukluyse onu tazele.
    // (LoadMonth ile sabit ay yuklersek Yil gorunumundeki liste bozulur.)
    Task ReloadCurrentAsync(DateTime fallbackDay)
        => loadedFrom is DateTime f && loadedTo is DateTime t
            ? LoadRange(f, t, force: true)
            : LoadMonth(fallbackDay);

    async Task LoadRange(DateTime from, DateTime to, bool force = false)
    {
        if (!force && loadedFrom == from && loadedTo == to)
            return;

        var seq = ++loadSeq;

        try
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            var meId =
                auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? auth.User.FindFirst("nameid")?.Value
                ?? auth.User.FindFirst("sub")?.Value
                ?? auth.User.FindFirst("uid")?.Value;

            // meId yoksa assignee filtresi göndermeyelim
            var jobs = string.IsNullOrWhiteSpace(meId)
                ? await JobsApi.GetRangeAsync(from, to)
                : await JobsApi.GetRangeAsync(from, to, assigneeId: meId);

            // Bu istek uçuştayken kullanıcı başka aya geçtiyse sonucu yazma.
            if (seq != loadSeq) return;

            // meId varsa hem user hem Deleted filtresi; yoksa sadece Deleted filtresi
            appointments = jobs
                .Where(j => j.Assignments.Any(a =>
                    (string.IsNullOrWhiteSpace(meId) || a.UserId == meId) &&
                    a.Status != JobStatus.Deleted))
                .Select(j => new AppointmentVm
                {
                    JobId = j.Id,
                    Start = j.Start,
                    End = j.End,
                    Text = j.Title,
                    Title = j.Title,
                    Description = j.Description ?? "",
                    AssigneeIds = j.Assignments
                                   .Where(a => a.Status != JobStatus.Deleted)
                                   .Select(a => a.UserId).ToList(),
                    AssigneeNames = j.Assignments
                                     .Where(a => a.Status != JobStatus.Deleted)
                                     .Select(a => a.UserName).ToList(),
                    Attachments = j.Attachments ?? new()
                })
                .ToList();

            loadedFrom = from;
            loadedTo = to;
        }
        catch (Exception ex)
        {
            if (seq != loadSeq) return;

            // Token yenilenemedi / servis hata verdi: sessizce boş takvim gösterme.
            appointments = new();
            loadedFrom = null;
            loadedTo = null;

            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Görevler yüklenemedi",
                Detail = ex.Message,
                Duration = 4000
            });
        }

        // OnInitializedAsync icinde @ref henuz atanmamis olabilir.
        if (scheduler is not null)
            await scheduler.Reload();

        StateHasChanged();
    }



