@attribute [Authorize(Roles = "pkf")]
@page "/yonetim/mukellefler"
@using System.Net
@using System.Timers
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.Yonetim
@using WebApp.Shared.Dto.Yonetim

@implements IDisposable

@inject IMukellefApiClient Api
@inject DialogService Dialog
@inject NotificationService Notif

<RadzenCard class="rz-p-3">

    <div class="rz-display-flex rz-align-items-center rz-mb-3" style="justify-content:space-between;">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">
            Mükellefler <span class="rz-text-muted" style="font-size:0.85rem;">(@_totalCount)</span>
        </RadzenText>
        <div style="display:flex; gap:0.5rem;">
            <RadzenButton Text="Excel Yükle"
                          Icon="upload_file"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@ImportExcelAsync" />
            <RadzenButton Text="Yeni Mükellef"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@CreateAsync" />
        </div>
    </div>

    <div class="rz-display-flex rz-align-items-center rz-mb-3" style="gap:1rem; flex-wrap:wrap;">
        <RadzenTextBox Placeholder="Arama: Sözleşme No, VKN, unvan"
                       Value="@_searchInput"
                       Change="@OnSearchChanged"
                       Style="min-width:320px; flex:1;" />
        <RadzenDropDown TValue="MukellefDurumu?"
                        @bind-Value="_durumFilter"
                        Data="@_durumOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        AllowClear="true"
                        Placeholder="Durum: Tümü"
                        Change="@OnDurumChanged"
                        Style="min-width:200px;" />
    </div>

    <RadzenDataGrid @ref="_grid"
                    TItem="MukellefDto"
                    Data="@_items"
                    Count="@_totalCount"
                    LoadData="@LoadData"
                    IsLoading="@_loading"
                    AllowPaging="true"
                    AllowSorting="true"
                    PageSize="50"
                    PageSizeOptions="@(new int[] { 25, 50, 100 })"
                    EmptyText="@(_hasFilters ? "Filtreye uygun kayıt bulunamadı." : "Henüz mükellef yok.")">
        <Columns>
            <RadzenDataGridColumn TItem="MukellefDto" Property="SozlesmeNo" Title="Sözleşme No" Width="160px" />
            <RadzenDataGridColumn TItem="MukellefDto" Property="SozlesmeTarihi" Title="Sözleşme Tarihi" Width="140px" FormatString="{0:dd.MM.yyyy}" />
            <RadzenDataGridColumn TItem="MukellefDto" Property="Unvan" Title="Unvan" />
            <RadzenDataGridColumn TItem="MukellefDto" Property="VergiKimlikNo" Title="VKN" Width="130px" />
            <RadzenDataGridColumn TItem="MukellefDto" Property="Hizmet" Title="Hizmet" Width="220px" />

            <RadzenDataGridColumn TItem="MukellefDto" Property="Durum" Title="Durum" Width="140px" Sortable="true">
                <Template Context="m">
                    <RadzenBadge BadgeStyle="@DurumBadgeStyle(m.Durum)" Text="@DurumText(m.Durum)" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="MukellefDto" Title="İşlemler" Width="100px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="m">
                    <span @onclick:stopPropagation @onkeydown:stopPropagation>
                        <RadzenButton Icon="edit"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      class="rz-mr-1"
                                      Click="@(() => EditAsync(m))" />
                        <RadzenButton Icon="delete"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Disabled="@(m.Durum == MukellefDurumu.IptalEdildi)"
                                      Click="@(() => DeleteAsync(m))" />
                    </span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</RadzenCard>

@code {
    private RadzenDataGrid<MukellefDto>? _grid;
    private List<MukellefDto> _items = new();
    private int _totalCount;
    private bool _loading;

    private string _searchInput = "";
    private string _search = "";
    private MukellefDurumu? _durumFilter;

    private Timer? _debounceTimer;

    private bool _hasFilters => !string.IsNullOrWhiteSpace(_search) || _durumFilter.HasValue;

    protected override async Task OnInitializedAsync()
    {
        // Radzen 7.x'te RadzenDataGrid ilk render'da LoadData'yı otomatik tetiklemiyor
        // (Personel.razor pattern'i ile aynı: elle ilk yüklemeyi tetikliyoruz)
        await LoadData(new LoadDataArgs { Skip = 0, Top = 50 });
    }

    private record DurumOption(string Text, MukellefDurumu Value);

    private readonly List<DurumOption> _durumOptions = new()
    {
        new("Devam Ediyor", MukellefDurumu.DevamEdiyor),
        new("Fesh Oldu",   MukellefDurumu.FeshOldu),
        new("İptal Edildi", MukellefDurumu.IptalEdildi)
    };

    private async Task LoadData(LoadDataArgs args)
    {
        _loading = true;
        try
        {
            var top = args.Top ?? 50;
            var skip = args.Skip ?? 0;
            var page = (skip / top) + 1;

            var result = await Api.GetPaginatedAsync(
                page: page,
                pageSize: top,
                search: string.IsNullOrWhiteSpace(_search) ? null : _search,
                durum: _durumFilter);

            _items = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (ApiClientException ex)
        {
            ShowApiError(ex);
            _items = new();
            _totalCount = 0;
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message,
                Duration = 5000
            });
            _items = new();
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged(string val)
    {
        _searchInput = val ?? "";
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(500) { AutoReset = false };
        _debounceTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                if (_search == _searchInput) return;
                _search = _searchInput;
                if (_grid is not null) await _grid.Reload();
            });
        };
        _debounceTimer.Start();
    }

    private async Task OnDurumChanged(object? _)
    {
        if (_grid is not null) await _grid.Reload();
    }

    private async Task ImportExcelAsync()
    {
        var result = await Dialog.OpenAsync<MukellefImportDialog>("Mükellef Excel Aktarımı",
            new Dictionary<string, object>(),
            new DialogOptions { Width = "720px" });

        if (result is bool ok && ok)
        {
            if (_grid is not null) await _grid.Reload();
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "İçe Aktarım",
                Detail = "Liste güncellendi.",
                Duration = 3000
            });
        }
    }

    private async Task CreateAsync()
    {
        var result = await Dialog.OpenAsync<MukellefDialog>("Yeni Mükellef",
            new Dictionary<string, object>(),
            new DialogOptions { Width = "720px" });

        if (result is bool ok && ok)
        {
            if (_grid is not null) await _grid.Reload();
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Başarılı",
                Detail = "Mükellef oluşturuldu.",
                Duration = 3000
            });
        }
    }

    private async Task EditAsync(MukellefDto m)
    {
        var result = await Dialog.OpenAsync<MukellefDialog>($"Mükellefi Düzenle: {m.Unvan}",
            new Dictionary<string, object> { ["Existing"] = m },
            new DialogOptions { Width = "720px" });

        if (result is bool ok && ok)
        {
            if (_grid is not null) await _grid.Reload();
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Güncellendi",
                Detail = "Mükellef güncellendi.",
                Duration = 3000
            });
        }
    }

    private async Task DeleteAsync(MukellefDto m)
    {
        var confirm = await Dialog.Confirm(
            $"\"{m.Unvan}\" iptal edildi olarak işaretlenecek. Devam edilsin mi?",
            "Soft Delete Onayı",
            new ConfirmOptions { OkButtonText = "İptal Et", CancelButtonText = "Vazgeç" });

        if (confirm != true) return;

        try
        {
            await Api.DeleteAsync(m.Id);
            if (_grid is not null) await _grid.Reload();
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Silindi",
                Detail = $"{m.Unvan} iptal edildi.",
                Duration = 3000
            });
        }
        catch (ApiClientException ex)
        {
            ShowApiError(ex);
            if (_grid is not null) await _grid.Reload();
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private static string DurumText(MukellefDurumu d) => d switch
    {
        MukellefDurumu.DevamEdiyor => "Devam Ediyor",
        MukellefDurumu.FeshOldu    => "Fesh Oldu",
        MukellefDurumu.IptalEdildi => "İptal Edildi",
        _ => d.ToString()
    };

    private static BadgeStyle DurumBadgeStyle(MukellefDurumu d) => d switch
    {
        MukellefDurumu.DevamEdiyor => BadgeStyle.Success,
        MukellefDurumu.FeshOldu    => BadgeStyle.Warning,
        MukellefDurumu.IptalEdildi => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private void ShowApiError(ApiClientException ex)
    {
        var (sev, summary, detail) = ex.StatusCode switch
        {
            HttpStatusCode.NotFound => (NotificationSeverity.Warning, "Bulunamadı", "Kayıt bulunamadı, sayfa yenileniyor."),
            HttpStatusCode.Conflict => (NotificationSeverity.Warning, ex.Field is null ? "Çakışma" : $"{ex.Field} çakışması", ex.Message),
            HttpStatusCode.BadRequest => (NotificationSeverity.Warning, "Geçersiz veri", "Lütfen tüm alanları doğru doldurun."),
            _ => (NotificationSeverity.Error, "Sunucu hatası", "Sunucu hatası, tekrar deneyin.")
        };
        Notif.Notify(new NotificationMessage { Severity = sev, Summary = summary, Detail = detail, Duration = 5000 });
    }

    public void Dispose()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
    }
}
