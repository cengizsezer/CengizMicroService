@using System.Net
@using Radzen
@using Radzen.Blazor
@using WebApp.Application.Services.KdvBeyanname
@using WebApp.Application.Services.Yonetim
@using WebApp.Domain.Models.KdvBeyanname
@using WebApp.Shared.Dto.Yonetim

@inject DialogService Dialog
@inject NotificationService Notif
@inject IFirmaApiClient Api
@inject IKdvBeyannameApiService KdvApi

<RadzenTemplateForm TItem="FirmaCreateDto" Data="@Model" Submit="@OnSubmit">
    <RadzenCard class="rz-p-3">
        <RadzenStack Gap="0.75rem">

            <RadzenFormField Text="Vergi Kimlik No (10 hane)" Variant="Variant.Outlined">
                <RadzenTextBox Name="VergiKimlikNo"
                               @bind-Value="Model.VergiKimlikNo"
                               Style="width:100%"
                               MaxLength="10"
                               Disabled="@IsEdit" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="VergiKimlikNo" Text="VKN zorunlu" />
            <RadzenLengthValidator Component="VergiKimlikNo" Min="10" Max="10" Text="VKN 10 hane olmalı" />

            <RadzenFormField Text="Unvan" Variant="Variant.Outlined">
                <RadzenTextBox Name="Unvan" @bind-Value="Model.Unvan" Style="width:100%" MaxLength="250" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="Unvan" Text="Unvan zorunlu" />

            <RadzenFormField Text="Kısa Ad" Variant="Variant.Outlined">
                <RadzenTextBox Name="KisaAd" @bind-Value="Model.KisaAd" Style="width:100%" MaxLength="100" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="KisaAd" Text="Kısa ad zorunlu" />

            <RadzenFormField Text="Email" Variant="Variant.Outlined">
                <RadzenTextBox Name="Email" @bind-Value="Model.Email" Style="width:100%" MaxLength="150" />
            </RadzenFormField>
            <RadzenEmailValidator Component="Email" Text="Geçerli bir email girin" />

            <RadzenFormField Text="Telefon" Variant="Variant.Outlined">
                <RadzenTextBox Name="Telefon" @bind-Value="Model.Telefon" Style="width:100%" MaxLength="30" />
            </RadzenFormField>

            <RadzenFormField Text="Ticaret Sicil No" Variant="Variant.Outlined">
                <RadzenTextBox Name="TicaretSicilNo" @bind-Value="Model.TicaretSicilNo" Style="width:100%" MaxLength="50" />
            </RadzenFormField>

            <RadzenFormField Text="Vergi Dairesi" Variant="Variant.Outlined">
                <RadzenTextBox Name="VergiDairesi" @bind-Value="Model.VergiDairesi" Style="width:100%" MaxLength="100" />
            </RadzenFormField>

            @* ORKA firma kodu görünür alanlarda: "ORKA'ya Aktar" bunsuz çalışmıyor ve
               hata mesajı kullanıcıyı buraya yolluyor. Katlanan BDP kutusunun içindeyken
               kimse bulamıyordu; alanın KDV beyannamesiyle de ilgisi yok. *@
            <RadzenFormField Text="ORKA Firma Kodu" Variant="Variant.Outlined">
                <RadzenTextBox Name="OrkaFirmaKodu"
                               @bind-Value="Model.OrkaFirmaKodu"
                               Style="width:100%"
                               MaxLength="20"
                               Placeholder="Örn: 0001" />
            </RadzenFormField>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-0">
                ORKA girişinde F7'den sonra girilen firma kodu. Boşsa bu firmada
                "ORKA'ya Aktar" işi oluşturulamaz.
            </RadzenText>

            @* ── KDV Beyannamesi (BDP) için ek alanlar — opsiyonel ─── *@
            <RadzenFieldset AllowCollapse="true" Collapsed="@_bdpCollapsed">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="request_quote" />
                        <strong>BDP Beyanname Bilgileri</strong>
                        <span class="rz-color-secondary" style="font-size: 0.85rem;">
                            — KDV beyannamesi XML üretimi için (opsiyonel)
                        </span>
                    </RadzenStack>
                </HeaderTemplate>
                <ChildContent>
                    <RadzenStack Gap="0.75rem">

                        <RadzenFormField Text="Vergi Dairesi Kodu" Variant="Variant.Outlined">
                            <RadzenTextBox Name="VergiDairesiKodu"
                                           @bind-Value="Model.VergiDairesiKodu"
                                           Style="width:100%"
                                           MaxLength="10"
                                           Placeholder="Örn: 034247 (Maslak)" />
                        </RadzenFormField>

                        <RadzenFormField Text="Soyadı (Unvanı)" Variant="Variant.Outlined">
                            <RadzenTextBox Name="YetkiliSoyadi"
                                           @bind-Value="Model.YetkiliSoyadi"
                                           Style="width:100%"
                                           MaxLength="100"
                                           Placeholder="Örn: PKF PROGROUP KURUMSAL YÖNETIM" />
                        </RadzenFormField>

                        <RadzenFormField Text="Adı (Unvanın Devamı)" Variant="Variant.Outlined">
                            <RadzenTextBox Name="YetkiliAdi"
                                           @bind-Value="Model.YetkiliAdi"
                                           Style="width:100%"
                                           MaxLength="100"
                                           Placeholder="Örn: DANISMANLIGI A.S." />
                        </RadzenFormField>

                        <RadzenFormField Text="Telefon Alan Kodu (örn. 212)" Variant="Variant.Outlined">
                            <RadzenTextBox Name="TelefonAlanKodu"
                                           @bind-Value="Model.TelefonAlanKodu"
                                           Style="width:100%"
                                           MaxLength="10" />
                        </RadzenFormField>

                        @* ── Düzenleyen dropdown ─── *@
                        <div>
                            <RadzenFormField Text="Düzenleyen" Variant="Variant.Outlined">
                                <RadzenDropDown TValue="int?"
                                                Name="DuzenleyenId"
                                                Data="@duzenleyenler"
                                                TextProperty="@nameof(KdvDuzenleyen.Kisaltma)"
                                                ValueProperty="@nameof(KdvDuzenleyen.Id)"
                                                @bind-Value="Model.DuzenleyenId"
                                                AllowClear="true"
                                                Placeholder="Düzenleyen seçin..."
                                                Style="width:100%"
                                                Disabled="@duzenleyenlerLoading" />
                            </RadzenFormField>
                            <div class="rz-color-secondary" style="font-size: 0.8rem; margin-top: 0.25rem;">
                                Bu firmanın beyannamesini hangi SMMM/YMM düzenliyor?
                                Yönetim → Düzenleyen Bilgileri'nde tanımlanır.
                            </div>
                        </div>

                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>

            <div>
                <RadzenCheckBox @bind-Value="Model.Aktif" Name="Aktif" />
                <RadzenLabel Text="Aktif" Component="Aktif" class="rz-ml-2" />
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Vazgeç" Click="@(() => Dialog.Close(false))" Disabled="@_busy" />
                <RadzenButton Text="@(_busy ? "Kaydediliyor..." : "Kaydet")"
                              Icon="@(_busy ? "" : "save")"
                              IsBusy="@_busy"
                              BusyText="Kaydediliyor..."
                              ButtonStyle="ButtonStyle.Primary"
                              ButtonType="ButtonType.Submit"
                              Disabled="@_busy" />
            </RadzenStack>

        </RadzenStack>
    </RadzenCard>
</RadzenTemplateForm>

@code {
    [Parameter] public FirmaDto? Existing { get; set; }

    private FirmaCreateDto Model { get; set; } = new();
    private List<KdvDuzenleyen> duzenleyenler = new();
    private bool duzenleyenlerLoading = true;
    private bool _busy;

    // BDP fieldset düzenlemede açık (varolan değer var olabilir), oluşturmada kapalı.
    private bool _bdpCollapsed => Existing is null;

    private bool IsEdit => Existing is not null;

    protected override async Task OnInitializedAsync()
    {
        if (Existing is not null)
        {
            Model = new FirmaCreateDto
            {
                VergiKimlikNo = Existing.VergiKimlikNo,
                Unvan = Existing.Unvan,
                KisaAd = Existing.KisaAd,
                Email = Existing.Email,
                Telefon = Existing.Telefon,
                TicaretSicilNo = Existing.TicaretSicilNo,
                VergiDairesi = Existing.VergiDairesi,
                VergiDairesiKodu = Existing.VergiDairesiKodu,
                OrkaFirmaKodu = Existing.OrkaFirmaKodu,
                YetkiliAdi = Existing.YetkiliAdi,
                YetkiliSoyadi = Existing.YetkiliSoyadi,
                TelefonAlanKodu = Existing.TelefonAlanKodu,
                DuzenleyenId = Existing.DuzenleyenId,
                Aktif = Existing.Aktif
            };
        }

        try
        {
            duzenleyenler = await KdvApi.ListDuzenleyenlerAsync(includeInactive: false);
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary  = "Düzenleyen listesi yüklenemedi",
                Detail   = ex.Message,
                Duration = 4000
            });
        }
        finally
        {
            duzenleyenlerLoading = false;
        }
    }

    private async Task OnSubmit(FirmaCreateDto _)
    {
        _busy = true;
        try
        {
            if (IsEdit)
            {
                var updateDto = new FirmaUpdateDto
                {
                    VergiKimlikNo = Model.VergiKimlikNo.Trim(),
                    Unvan = Model.Unvan.Trim(),
                    KisaAd = Model.KisaAd.Trim(),
                    Email = Model.Email.Trim(),
                    Telefon = Model.Telefon.Trim(),
                    TicaretSicilNo = Model.TicaretSicilNo.Trim(),
                    VergiDairesi = Model.VergiDairesi.Trim(),
                    VergiDairesiKodu = Model.VergiDairesiKodu?.Trim(),
                    OrkaFirmaKodu = Model.OrkaFirmaKodu?.Trim(),
                    YetkiliAdi = Model.YetkiliAdi?.Trim(),
                    YetkiliSoyadi = Model.YetkiliSoyadi?.Trim(),
                    TelefonAlanKodu = Model.TelefonAlanKodu?.Trim(),
                    DuzenleyenId = Model.DuzenleyenId,
                    Aktif = Model.Aktif
                };
                await Api.UpdateAsync(Existing!.Id, updateDto);
            }
            else
            {
                Model.VergiKimlikNo = Model.VergiKimlikNo.Trim();
                Model.Unvan = Model.Unvan.Trim();
                Model.KisaAd = Model.KisaAd.Trim();
                Model.Email = Model.Email.Trim();
                await Api.CreateAsync(Model);
            }

            Dialog.Close(true);
        }
        catch (ApiClientException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message,
                Duration = 5000
            });
        }
        finally
        {
            _busy = false;
        }
    }

    private void HandleApiError(ApiClientException ex)
    {
        switch (ex.StatusCode)
        {
            case HttpStatusCode.Conflict:
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = ex.Field is null ? "Çakışma" : $"{ex.Field} çakışması",
                    Detail = ex.Message,
                    Duration = 6000
                });
                break;
            case HttpStatusCode.BadRequest:
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Geçersiz veri",
                    Detail = "Lütfen tüm alanları doğru doldurun.",
                    Duration = 5000
                });
                break;
            case HttpStatusCode.NotFound:
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Bulunamadı",
                    Detail = "Kayıt bulunamadı, sayfa yenileniyor.",
                    Duration = 4000
                });
                Dialog.Close(true);
                break;
            default:
                Notif.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Sunucu hatası",
                    Detail = ex.Message,
                    Duration = 5000
                });
                break;
        }
    }
}
