                    Item = "Tek Ürün", Amount = 100, VatRate = 20, ProductDetails = new List<ProductDetail>() }
            }
        },
        new Expense
        {
            Company = "BİZ KLİNİK",
            AccountingCode = "770.01.01.00002",
