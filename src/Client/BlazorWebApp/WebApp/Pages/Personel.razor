                    }
                }
            }
        }
    };

    void RowRender(RowRenderEventArgs<Expense> args)
    {
        args.Expandable = args.Data.ReceiptDetails != null && args.Data.ReceiptDetails.Any();
    }

    void ShowDocuments(Expense expense)
    {
        var parameters = new Dictionary<string, object>
    {
        { "Receipts", expense.ReceiptDetails }
    };

        DialogService.Open<ViewDocuments>("Evraklar", parameters, new DialogOptions { Width = "600px", Height = "400px" });
    }





    public class Expense
    {
        public string Company { get; set; }
        public string AccountingCode { get; set; }
        public string PersonnelCode { get; set; }
        public string FullName { get; set; }
        public string Note { get; set; }
        public decimal AmountExclVat { get; set; }
        public decimal VatRate { get; set; }
        public List<ReceiptItem> ReceiptDetails { get; set; } = new();
    }

    public class ReceiptItem
    {
        public string Company { get; set; }
        public string AccountingCode { get; set; }
        public string PersonnelCode { get; set; }
        public string FullName { get; set; }
        public string Item { get; set; }
        public decimal Amount { get; set; }
        public decimal VatRate { get; set; }
        public List<ProductDetail> ProductDetails { get; set; } = new();
    }

    public class ProductDetail
    {
        public string Company { get; set; }
        public string AccountingCode { get; set; }
        public string PersonnelCode { get; set; }
        public string FullName { get; set; }
        public string Name { get; set; }
        public decimal Amount { get; set; }
        public decimal VatRate { get; set; }
    }
}
