@page "/personel"
@using WebApp.Application.Services.Interfaces
@using WebApp.Domain.Models.Catalog
@using WebApp.Domain.Models
@using WebApp.Shared
@inject IExpenseService ExpenseService
@inject DialogService DialogService
@using Radzen.Blazor
@inject NavigationManager NavManager
@using WebApp.Shared.Dto

<style>
    .rz-grid-table {
        width: unset;
    }
</style>

<h3>Masraf Listesi</h3>

<RadzenCard Variant="Variant.Outlined" class="rz-my-4">
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Center"
                 Gap="1rem">

        <!-- Sol taraf -->
        <div>Edit Mode:</div>

        <!-- Sağ taraf butonlar -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">

           @if (!isEditMode)
            {
                <RadzenButton Icon="edit" Text="Düzenle" ButtonStyle="ButtonStyle.Primary" Click="@(() => isEditMode = true)" />
                <RadzenButton Icon="delete" Text="Sil" ButtonStyle="ButtonStyle.Danger" />
            }
            else
            {
                <RadzenButton Icon="check" Text="Kaydet" ButtonStyle="ButtonStyle.Success" Click="@(() => isEditMode = false)" />
                <RadzenButton Icon="close" Text="İptal" ButtonStyle="ButtonStyle.Secondary" Click="@(() => isEditMode = false)" />
            }
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@if (isLoading)
{
  <div style="width: 100%; margin-top: 3rem; text-align: center;">
    <div style="margin: 0 auto; width: 100%; max-width: 1200px;">
        <RadzenProgressBar Value="100"
                           ShowValue="false"
                           Mode="ProgressBarMode.Indeterminate"
                           Style="height: 14px; width: 100%;" />
        <p style="margin-top: 1rem; font-size: 16px;">Yükleniyor...</p>
    </div>
</div>


}
else
{

<RadzenCard Style="overflow-x: auto;">
    <RadzenDataGrid TItem="ExpenseDto"
                    Data="@expenses"
                    @ref="grid"
                    Count="@totalCount"
                    LoadData="@LoadData"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowColumnPicking="true"
                    PickedColumnsChanged="@PickedColumnsChanged"
                    ColumnsPickerAllowFiltering="true"
                    ExpandMode="DataGridExpandMode.Single"
                    RowRender="@RowRender"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    Value="@selectedExpenses"
                    ValueChanged="@OnSelectedExpensesChanged"
                    style="min-width: 1600px; height: 800px">

        <HeaderTemplate>
            <div style="display: flex; justify-content: flex-end;">
                <RadzenButton ButtonStyle="ButtonStyle.Success"
                              Icon="add_circle"
                              Text="YENİ MASRAF EKLE"
                              Click="@(args => OnClickAddExpense())" />
            </div>
        </HeaderTemplate>

        <Columns>
            <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false" Frozen="true">
                <HeaderTemplate>
                    <RadzenCheckBox TabIndex="-1"
                                    TriState="false"
                                    TValue="bool?"
                                    Value="@(selectedExpenses != null && selectedExpenses.Count == expenses.Count)"
                                    Change="@ToggleSelectAll"
                                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select all items" } })" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool"
                                    Value="@(selectedExpenses?.Contains(data) == true)"
                                    Change="@(args => {
                                        if (args == true)
                                            selectedExpenses.Add(data);
                                        else
                                            selectedExpenses.Remove(data);
                                    })" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PersonnelFullName" Title="Personel Adı Soyadı" Width="180px" Frozen="true" />
            <RadzenDataGridColumn Property="PersonnelAccountingCode" Title="Muhasebe Kodu" Width="150px" />
            <RadzenDataGridColumn Property="ExpenseCode" Title="Masraf Kodu" Width="150px" />
            <RadzenDataGridColumn Property="ProjectCode" Title="Proje Kodu" Width="150px" />
            <RadzenDataGridColumn Property="Description" Title="Masraf Açıklaması" Width="200px" />
            <RadzenDataGridColumn Property="TotalAmount" Title="KDV Hariç Tutar" Width="150px">
                <FooterTemplate>
                    Toplam: <b>@expenses.Sum(e => e.TotalAmount).ToString("C")</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="TotalVat" Title="KDV Tutarı" Width="150px">
                <FooterTemplate>
                    Toplam: <b>@expenses.Sum(e => e.TotalVat).ToString("C")</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ExpenseDate" Title="Masraf Tarihi" Width="140px" />
            <RadzenDataGridColumn Property="ApprovedBy" Title="Onaylayan" Width="160px" />
            <RadzenDataGridColumn Property="ApprovedAt" Title="Onay Tarihi" Width="140px" />
            <RadzenDataGridColumn Property="CreatedDate" Title="Kayıt Tarihi" Width="140px" />
            <RadzenDataGridColumn Property="CreatedTime" Title="Kayıt Saati" Width="140px" />

            <RadzenDataGridColumn Title="İşlem" Width="180px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="expense">
                    <RadzenSplitButton Text="İŞLEM YAP"
                                       ButtonStyle="ButtonStyle.Primary"
                                       Size="ButtonSize.Small"
                                       Click="@(args => OnSplitButtonClick(args, expense))">
                        <ChildContent>
                            <RadzenSplitButtonItem Text="Hareketler" Value="zarf" />
                            <RadzenSplitButtonItem Text="Excel" Value="hareket" />
                        </ChildContent>
                    </RadzenSplitButton>
                </Template>
            </RadzenDataGridColumn>
        </Columns>

       <Template Context="expense">
    <RadzenDataGrid Data="@expense.ReceiptItems"
                    TItem="ReceiptItemDto"
                    ShowPagination="false"
                    AllowFiltering="false"
                    AllowSorting="false"
                    ExpandMode="DataGridExpandMode.Single"
                    style="width: 100%; margin-left: 20px;"
                    RowRender="@((RowRenderEventArgs<ReceiptItemDto> args) => args.Expandable = args.Data.ProductDetails?.Any() == true)">
        <Columns>
            <RadzenDataGridColumn Property="Type" Title="Fiş Türü" Width="140px" />
            <RadzenDataGridColumn Property="AccountingCode" Title="Muhasebe Kodu" Width="150px" />
            <RadzenDataGridColumn Property="Description" Title="Açıklama" Width="200px" />
            <RadzenDataGridColumn Property="TotalAmount" Title="Tutar" Width="120px" />
            <RadzenDataGridColumn Property="TotalVat" Title="KDV" Width="120px" />
            <RadzenDataGridColumn Property="ReceiptNumber" Title="Fiş No" Width="130px" />
            <RadzenDataGridColumn Property="ReceiptDate" Title="Fiş Tarihi" Width="130px" FormatString="{0:dd.MM.yyyy}" />
        </Columns>

        <Template Context="receipt">
            <RadzenDataGrid Data="@receipt.ProductDetails"
                            TItem="ProductDetailDto"
                            ShowPagination="false"
                            AllowFiltering="false"
                            AllowSorting="false"
                            style="margin-left: 40px; width: 800px;">
                <Columns>
                    <RadzenDataGridColumn Property="Rank" Title="#" Width="60px" />
                    <RadzenDataGridColumn Property="TaxBase" Title="Matrah" Width="120px" />
                    <RadzenDataGridColumn Property="VatRate" Title="KDV Oranı (%)" Width="120px" />
                    <RadzenDataGridColumn Property="VatAmount" Title="KDV Tutarı" Width="120px" />
                    <RadzenDataGridColumn Property="TotalAmount" Title="Toplam" Width="120px" />
                </Columns>
            </RadzenDataGrid>
        </Template>
    </RadzenDataGrid>
</Template>
    </RadzenDataGrid>
</RadzenCard>
}

<RadzenDialog />

