    //     var pageIndex = args.Skip.HasValue && args.Top.HasValue ? args.Skip.Value / args.Top.Value : 0;
    //     var pageSize = args.Top ?? 10;
    //     var result = await ExpenseService.GetExpensesAsync(pageIndex, pageSize);
    //     expenses = result.Data.ToList();
    //     totalCount = (int)result.Count;
    // }

    async Task LoadData(LoadDataArgs args)
    {
        try
        {
            var pageIndex = args.Skip.HasValue && args.Top.HasValue ? args.Skip.Value / args.Top.Value : 0;
            var pageSize = args.Top ?? 10;

            var result = await ExpenseService.GetExpensesAsync(pageIndex, pageSize);

            expenses = result.Data.ToList();
            totalCount = (int)result.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hata: " + ex.Message);
        }
    }


    void RowRender(RowRenderEventArgs<ExpenseDto> args)
    {
        args.Expandable = args.Data.ReceiptItems != null && args.Data.ReceiptItems.Any();
    }

    void ShowDocuments(ExpenseDto expense)
    {
        var parameters = new Dictionary<string, object>
        {
            { "Receipts", expense.ReceiptItems }
        };

        DialogService.Open<ViewDocuments>("Evraklar", parameters, new DialogOptions { Width = "600px", Height = "400px" });
    }

    void PickedColumnsChanged(DataGridPickedColumnsChangedEventArgs<ExpenseDto> args)
    {
        Console.WriteLine($"Picked columns: {string.Join(", ", args.Columns.Select(c => c.Title))}");
    }

    void ToggleSelectAll(bool? isChecked)
    {
        if (isChecked == true)
        {
            selectedExpenses = expenses.ToList();
        }
        else
        {
            selectedExpenses.Clear();
        }
    }

    private Task OnSelectedExpensesChanged(IEnumerable<ExpenseDto> selected)
    {
        selectedExpenses = selected.ToList();
        return Task.CompletedTask;
    }
}
