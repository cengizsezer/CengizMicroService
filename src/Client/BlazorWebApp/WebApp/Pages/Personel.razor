@page "/personel"
@using WebApp.Application.Services.Interfaces
@using WebApp.Domain.Models.Catalog
@using WebApp.Domain.Models
@using WebApp.Shared
@inject IExpenseService ExpenseService
@inject DialogService DialogService

<h3>Masraf Listesi</h3>

<RadzenCard>
    <RadzenDataGrid TItem="Expense"
                    Data="@expenses"
                    @ref="grid"
                    Count="@totalCount"
                    LoadData="@LoadData"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowColumnPicking="true"
                    PickedColumnsChanged="@PickedColumnsChanged"
                    ColumnsPickerAllowFiltering="true"
                    ExpandMode="DataGridExpandMode.Single"
                    RowRender="@RowRender"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    Value="@selectedExpenses"
                    ValueChanged="@OnSelectedExpensesChanged">


        <Columns>
            <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                <HeaderTemplate>
                    <RadzenCheckBox TabIndex="-1"
                                    TriState="false"
                                    TValue="bool?"
                                    Value="@(selectedExpenses != null && selectedExpenses.Count == expenses.Count)"
                                    Change="@ToggleSelectAll"
                                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select all items" } })" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool"
                                    Value="@(selectedExpenses?.Contains(data) == true)"
                                    Change="@(args => {
                                        if (args == true)
                                            selectedExpenses.Add(data);
                                        else
                                            selectedExpenses.Remove(data);
                                    })" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="Tür">
                <Template>MASRAF</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Company" Title="Firma" />
            <RadzenDataGridColumn Property="AccountingCode" Title="Muhasebe Kodu" />
            <RadzenDataGridColumn Property="PersonnelCode" Title="Personel Kodu" />
            <RadzenDataGridColumn Property="FullName" Title="Personel Adı Soyadı" />
            <RadzenDataGridColumn Property="Note" Title="Masraf Açıklaması" />
            <RadzenDataGridColumn Property="AmountExclVat" Title="KDV Hariç Tutar">
                <FooterTemplate>
                    Toplam: <b>@expenses.Sum(e => e.AmountExclVat).ToString("C")</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="VatRate" Title="KDV Oranı (%)" />
            <RadzenDataGridColumn Title="KDV Tutarı">
                <Template Context="expense">
                    @(expense.AmountExclVat * (expense.VatRate / 100)).ToString("C")
                </Template>
                <FooterTemplate>
                    Toplam: <b>@expenses.Sum(e => e.AmountExclVat * (e.VatRate / 100)).ToString("C")</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="">
                <Template Context="expense">
                    <RadzenButton Text="Evrak Görüntüle"
                                  Size="ButtonSize.Small"
                                  Click="@(() => ShowDocuments(expense))"
                                  Icon="description"
                                  Style="margin-top:4px" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

        <Template Context="expense">
            <RadzenDataGrid Data="@expense.ReceiptDetails"
                            TItem="ReceiptItem"
                            ShowPagingSummary="false"
                            ShowPagination="false"
                            AllowFiltering="false"
                            AllowSorting="false"
                            ExpandMode="DataGridExpandMode.Single"
                            RowRender="@((RowRenderEventArgs<ReceiptItem> args) => args.Expandable = args.Data.ProductDetails != null && args.Data.ProductDetails.Any())">
                <Columns>
                    <RadzenDataGridColumn Title="Tür">
                        <Template>FİŞ</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="AccountingCode" Title="Muhasebe Kodu" />
                    <RadzenDataGridColumn Property="PersonnelCode" Title="Personel Kodu" />
                    <RadzenDataGridColumn Property="FullName" Title="Personel Adı Soyadı" />
                    <RadzenDataGridColumn Property="Item" Title="Masraf Açıklaması" />
                    <RadzenDataGridColumn Property="Amount" Title="KDV Hariç Tutar" />
                    <RadzenDataGridColumn Property="VatRate" Title="KDV Oranı (%)" />
                    <RadzenDataGridColumn Title="KDV Tutarı">
                        <Template Context="receipt">
                            @(receipt.Amount * (receipt.VatRate / 100)).ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>

                <Template Context="receipt">
                    <RadzenDataGrid Data="@receipt.ProductDetails"
                                    TItem="ProductDetail"
                                    ShowPagination="false"
                                    AllowFiltering="false"
                                    AllowSorting="false">
                        <Columns>
                            <RadzenDataGridColumn Title="Tür">
                                <Template>DETAY</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="AccountingCode" Title="Muhasebe Kodu" />
                            <RadzenDataGridColumn Property="PersonnelCode" Title="Personel Kodu" />
                            <RadzenDataGridColumn Property="FullName" Title="Personel Adı Soyadı" />
                            <RadzenDataGridColumn Property="Name" Title="Masraf Açıklaması" />
                            <RadzenDataGridColumn Property="Amount" Title="KDV Hariç Tutar" />
                            <RadzenDataGridColumn Property="VatRate" Title="KDV Oranı (%)" />
                            <RadzenDataGridColumn Title="KDV Tutarı">
                                <Template Context="product">
                                    @(product.Amount * (product.VatRate / 100)).ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </Template>
            </RadzenDataGrid>
        </Template>
    </RadzenDataGrid>
</RadzenCard>

<RadzenDialog />

@code {
    RadzenDataGrid<Expense> grid;
    List<Expense> expenses = new();
    List<Expense> selectedExpenses = new();
    int totalCount = 0;
    bool initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            await grid.FirstPage(true); // LoadData() fonksiyonunu tetikler
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        var pageIndex = args.Skip.HasValue && args.Top.HasValue ? args.Skip.Value / args.Top.Value : 0;
        var pageSize = args.Top ?? 10;
        var result = await ExpenseService.GetExpensesAsync(pageIndex, pageSize);
        expenses = result.Data.ToList();
        totalCount = (int)result.Count;
    }

    void RowRender(RowRenderEventArgs<Expense> args)
    {
        args.Expandable = args.Data.ReceiptDetails != null && args.Data.ReceiptDetails.Any();
    }

    void ShowDocuments(Expense expense)
    {
        var parameters = new Dictionary<string, object>
        {
            { "Receipts", expense.ReceiptDetails }
        };

        DialogService.Open<ViewDocuments>("Evraklar", parameters, new DialogOptions { Width = "600px", Height = "400px" });
    }

    void PickedColumnsChanged(DataGridPickedColumnsChangedEventArgs<Expense> args)
    {
        Console.WriteLine($"Picked columns: {string.Join(", ", args.Columns.Select(c => c.Title))}");
    }

    void ToggleSelectAll(bool? isChecked)
    {
        if (isChecked == true)
        {
            selectedExpenses = expenses.ToList();
        }
        else
        {
            selectedExpenses.Clear();
        }
    }


    private Task OnSelectedExpensesChanged(IEnumerable<Expense> selected)
    {
        selectedExpenses = selected.ToList();
        return Task.CompletedTask;
    }
}
