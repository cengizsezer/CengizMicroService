            ReceiptDetails = new List<ReceiptItem>
            {
                new ReceiptItem {
                    Company = "BİZ KLİNİK", AccountingCode="770.01.01.00002", PersonnelCode="195.01.01.00002", FullName="Ali Veli",
                    Item = "Fiş 1", Amount = 100, VatRate = 10, ProductDetails = new List<ProductDetail> {
                        new ProductDetail { Company = "BİZ KLİNİK", AccountingCode="770.01.01.00002", PersonnelCode="195.01.01.00002", FullName="Ali Veli", Name = "Yemek 1", Amount = 60, VatRate = 10 },
                        new ProductDetail { Company = "BİZ KLİNİK", AccountingCode="770.01.01.00002", PersonnelCode="195.01.01.00002", FullName="Ali Veli", Name = "Yemek 2", Amount = 40, VatRate = 10 }
                    }
