@using System.Globalization
@using WebApp.Application.Services
@using WebApp.Domain.Models.FirmaKontrol
@inject TooltipService TooltipService
@inject IJSRuntime JS

@* Finansal Oranlar — solda sade rakam listesi, sağda seçili alanın grafiği.

   Bu dosya SUNUM katmanıdır: oran formülleri, referans eşikleri ve durum kararları
   değişmedi. Grafikler mevcut OranKart değerlerinden türetilir, yeniden hesaplama yoktur;
   bant grafiğinin ekseni de kartın taşıdığı referans değerinden okunur.

   Tek kaynak: yüklenen mizan. Aktif/Pasif için MizanHesaplayici.Compute (Bilanço, Bilanço
   Özet ve Dikey Yüzdeler ile aynı), gelir tablosu için GelirTablosuCalculator.Compute.
   Özkaynak ve pasif toplamına eklenen dönem kârı düzeltmesi Detay.razor'dan TEK değer
   olarak gelir (DonemKariDuzeltmesi) — Bilanço paneliyle aynı değer, kural burada
   tekrarlanmaz.

   ÖNEMLİ: Tutarlar MaliTabloIsareti ile bölümün sunum yönüne normalize edilir (Pasif ve
   gelir tablosu ters çevrilir). Bu sayfadaki oranlar büyüklük/yapı oranıdır, işaret
   anlamsız → her kalem Math.Abs ile alınır. *@

<div class="or-ekran">

    @* ── Üst şerit ── *@
    <div class="or-serit">
        <span class="or-serit-sayi">@ToplamOran oran · @alanlar.Count alan</span>

        <span class="or-sayac or-s-olumlu"><i class="or-nokta or-n-olumlu"></i>OLUMLU @OlumluSayisi</span>
        <span class="or-sayac or-s-olumsuz"><i class="or-nokta or-n-olumsuz"></i>OLUMSUZ @OlumsuzSayisi</span>
        <span class="or-sayac or-s-refsiz"><i class="or-nokta or-n-refsiz"></i>REFERANSSIZ @ReferanssizSayisi</span>
        <span class="or-sayac or-s-refsiz"><i class="or-nokta or-n-refsiz"></i>HESAPLANAMADI @HesaplanamadiSayisi</span>

        <span class="or-serit-bosluk"></span>

        <button type="button" class="or-ref-dugme" disabled
                title="Referans eşikleri şimdilik kodda sabit; düzenleme ekranı henüz yok.">
            Referansları düzenle
        </button>
    </div>

    @* ── Bilanço denklik uyarısı — fark 0,01'den büyükse ── *@
    @if (Denksiz)
    {
        <div class="or-denklik">
            <RadzenIcon Icon="warning" Style="font-size:18px" />
            <span>
                Bilanço denk değil (fark @Imzali(DenklikFarki)) — mali yapı oranları güvenilir değil.
            </span>
            @if (OnBilancoyaGit.HasDelegate)
            {
                <button type="button" class="or-bag" @onclick="OnBilancoyaGit">Bilançoya git</button>
            }
        </div>
    }

    <div class="or-govde">

        @* ── Sol sütun: sade rakam listesi ── *@
        <div class="or-sol">
            <div class="or-kolon-basligi">
                <span class="or-k-ad">Oran</span>
                <span class="or-k-deger">Değer</span>
                <span class="or-k-ref">Referans</span>
                <span class="or-k-durum">Durum</span>
            </div>

            @foreach (var alan in alanlar)
            {
                var secili = alan.No == _secili;

                <div class="or-alan-basligi" id="@($"or-alan-{alan.No}")"
                     @onclick="@(() => AlanSecAsync(alan.No))">
                    <span>@alan.No · @alan.Ad</span>
                    <span class="or-alan-adet">@alan.Oranlar.Count oran</span>
                </div>

                @if (!alan.Hesaplanabilir)
                {
                    @* Faaliyet: iki dönem yoksa 9 oran tek tek listelenmez, tek satır bilgi çıkar. *@
                    <div class="or-alan-not">
                        <span>@(alan.Uyari ?? "Bu alan için yeterli veri yok.")</span>
                        @if (alan.OncekiDonemGerekir && OnOncekiDonemYukle.HasDelegate)
                        {
                            <button type="button" class="or-bag" @onclick="OnOncekiDonemYukle">Önceki dönemi yükle</button>
                        }
                    </div>
                }
                else
                {
                    @foreach (var k in alan.Oranlar)
                    {
                        <div class="or-satir @(secili ? "or-satir-secili" : null) @(k.Deger is null ? "or-satir-bos" : null)">
                            <span class="or-k-ad" @ref="k.AdEl" style="cursor:help"
                                  @onmouseenter="@(() => TooltipService.Open(k.AdEl, k.Tooltip, TooltipAyar))">@k.Ad</span>
                            <span class="or-k-deger">@FormatDeger(k)</span>
                            @* Referansı olmayan oranda hücre boş kalır ("—"); yön bilgisi
                               DURUM sütununda ve oran adının tooltip'inde zaten var. *@
                            <span class="or-k-ref">@(k.Referans is null ? "—" : k.RefMetni)</span>
                            <span class="or-k-durum">
                                @if (k.Deger is null)
                                {
                                    <span class="or-sebep">@(k.Sebep ?? "—")</span>
                                }
                                else
                                {
                                    <span class="or-durum @DurumSinif(k)">
                                        <i class="or-nokta @NoktaSinif(k)"></i>@DurumMetni(k)
                                    </span>
                                }
                            </span>
                        </div>
                    }
                }
            }
        </div>

        @* ── Sağ sütun: seçili alanın grafikleri ── *@
        <div class="or-sag">
            <div class="or-sekmeler">
                @foreach (var alan in alanlar)
                {
                    <button type="button"
                            class="or-sekme @(alan.No == _secili ? "or-sekme-secili" : null) @(alan.Hesaplanabilir ? null : "or-sekme-soluk")"
                            @onclick="@(() => AlanSecAsync(alan.No))">
                        @alan.No · @alan.Ad
                    </button>
                }
            </div>

            @if (SeciliAlan is not { } sa)
            {
                <div class="or-kart"><div class="or-kart-bos">Gösterilecek alan yok.</div></div>
            }
            else if (!sa.Hesaplanabilir)
            {
                <div class="or-kart">
                    <div class="or-kart-bos">@(sa.Uyari ?? "Bu alan için yeterli veri yok.")</div>
                </div>
            }
            else
            {
                var bantlar = sa.Oranlar.Where(k => k.Deger.HasValue && k.Referans is not null).ToList();
                var yuzdeler = sa.Oranlar.Where(k => k.Deger.HasValue && k.Referans is null && k.Yuzde).ToList();
                var digerler = sa.Oranlar.Where(k => k.Deger.HasValue && k.Referans is null && !k.Yuzde).ToList();

                @* Referanslı oranlar: ortak eksen "referansın katı" (değer / referans). *@
                @if (bantlar.Count > 0)
                {
                    <div class="or-kart">
                        <div class="or-kart-baslik">Referanslı oranlar</div>
                        <div class="or-kart-alt">1,00x = referans değeri</div>

                        @foreach (var k in bantlar)
                        {
                            var kat = k.Deger!.Value / k.Referans!.Value;
                            var kirpik = kat > 2m;

                            <div class="or-bant">
                                <span class="or-bant-ad">@k.Ad</span>
                                <span class="or-bant-ray">
                                    <span class="or-bant-cubuk @NoktaSinif(k)" style="@Genislik(BantOran(kat))"></span>
                                    <span class="or-bant-ref"></span>
                                    @if (kirpik)
                                    {
                                        <span class="or-bant-kirpik">»</span>
                                    }
                                </span>
                                <span class="or-bant-deger">@KatMetni(kat)</span>
                            </div>
                        }
                    </div>
                }

                @* Referanssız oranlar: düz yüzde çubuğu, referans çizgisi yok. *@
                @if (yuzdeler.Count > 0 || digerler.Count > 0)
                {
                    <div class="or-kart">
                        <div class="or-kart-baslik">Referanssız oranlar</div>

                        @foreach (var k in yuzdeler)
                        {
                            var y = k.Deger!.Value * 100m;
                            var eksenDisi = y > 100m || y < 0m;

                            <div class="or-bant">
                                <span class="or-bant-ad">@k.Ad</span>
                                @if (eksenDisi)
                                {
                                    @* %100'ü aşan oran ekseni bozmasın: çubuk yerine sebebi yazılır. *@
                                    <span class="or-bant-ray or-bant-ray-bos">
                                        <span class="or-olcek-disi">ölçek dışı</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="or-bant-ray">
                                        <span class="or-bant-cubuk or-cubuk-duz" style="@Genislik((double)y)"></span>
                                    </span>
                                }
                                <span class="or-bant-deger">@FormatDeger(k)</span>
                            </div>
                        }

                        @* Defa / gün birimli oranların yüzde ekseninde karşılığı yok: yalnız rakam. *@
                        @foreach (var k in digerler)
                        {
                            <div class="or-bant">
                                <span class="or-bant-ad">@k.Ad</span>
                                <span class="or-bant-ray or-bant-ray-bos">
                                    <span class="or-olcek-disi">ölçek dışı</span>
                                </span>
                                <span class="or-bant-deger">@FormatDeger(k)</span>
                            </div>
                        }
                    </div>
                }

                @* Finansal Yapı: kaynak yapısı yığın çubuğu. *@
                @if (sa.No == FinYapiNo && _pasifToplam is > 0m)
                {
                    <div class="or-kart">
                        <div class="or-kart-baslik">Kaynak Yapısı</div>
                        <div class="or-kart-alt">Pasif toplamının dağılımı</div>

                        <div class="or-yigin">
                            <span class="or-yigin-p or-p-kvyk" style="@Genislik(Pay(_kvyk, _pasifToplam))"></span>
                            <span class="or-yigin-p or-p-uvyk" style="@Genislik(Pay(_uvyk, _pasifToplam))"></span>
                            <span class="or-yigin-p or-p-ozk" style="@Genislik(Pay(_ozkaynak, _pasifToplam))"></span>
                        </div>

                        <div class="or-lejant">
                            <span class="or-lejant-oge"><i class="or-kare or-p-kvyk"></i>KVYK @YuzdeMetni(_kvyk, _pasifToplam) · @TutarMetni(_kvyk)</span>
                            <span class="or-lejant-oge"><i class="or-kare or-p-uvyk"></i>UVYK @YuzdeMetni(_uvyk, _pasifToplam) · @TutarMetni(_uvyk)</span>
                            <span class="or-lejant-oge"><i class="or-kare or-p-ozk"></i>Özkaynaklar @YuzdeMetni(_ozkaynak, _pasifToplam) · @TutarMetni(_ozkaynak)</span>
                        </div>
                    </div>
                }

                @* Sermaye / Varlık Karlılığı: bu alanın yedi oranı da aynı payı (dönem net kârı)
                   farklı paydalara bölüyor. Paydaları aynı ölçekte yan yana koymak, oranların
                   neden farklı çıktığını gösterir. Değerler yukarıdaki hesabın çıktısıdır. *@
                @if (sa.No == SermayeKarlilikNo && PaydaOlcegi is > 0m)
                {
                    <div class="or-kart">
                        <div class="or-kart-baslik">Dönem net kârı neye göre ölçülüyor</div>
                        <div class="or-kart-alt">Payda büyüdükçe oran küçülür</div>

                        <div class="or-kart-dipnot" style="margin-top:0; padding-top:0; border-top:none">
                            Dönem Net Karı (sabit pay): <strong>@TutarMetni(_donemNetKari)</strong>
                        </div>

                        @foreach (var (ad, deger) in Paydalar)
                        {
                            <div class="or-bant">
                                <span class="or-bant-ad">@ad</span>
                                <span class="or-bant-ray">
                                    <span class="or-bant-cubuk or-cubuk-duz" style="@Genislik(Pay(deger, PaydaOlcegi))"></span>
                                </span>
                                <span class="or-bant-deger">@TutarMetni(deger)</span>
                            </div>
                        }
                    </div>
                }

                @* Likidite: Dönen Varlık / KVYK karşılaştırması, aynı ölçekte. *@
                @if (sa.No == LikiditeNo && OlcekDonenKvyk is > 0m)
                {
                    <div class="or-kart">
                        <div class="or-kart-baslik">Dönen Varlıklar / KVYK</div>
                        <div class="or-kart-alt">İki çubuk aynı ölçekte</div>

                        <div class="or-bant">
                            <span class="or-bant-ad">Dönen Varlıklar</span>
                            <span class="or-bant-ray">
                                <span class="or-bant-cubuk or-cubuk-duz" style="@Genislik(Pay(_donen, OlcekDonenKvyk))"></span>
                            </span>
                            <span class="or-bant-deger">@TutarMetni(_donen)</span>
                        </div>
                        <div class="or-bant">
                            <span class="or-bant-ad">KVYK</span>
                            <span class="or-bant-ray">
                                <span class="or-bant-cubuk or-cubuk-kvyk" style="@Genislik(Pay(_kvyk, OlcekDonenKvyk))"></span>
                            </span>
                            <span class="or-bant-deger">@TutarMetni(_kvyk)</span>
                        </div>

                        <div class="or-kart-dipnot">
                            Net İşletme Sermayesi (Dönen Varlıklar − KVYK): <strong>@Imzali(NetIsletmeSermayesi)</strong>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<MizanSatir> Aktif { get; set; } = new();
    [Parameter, EditorRequired] public List<MizanSatir> Pasif { get; set; } = new();
    [Parameter] public List<MizanSatir> GelirTablosu { get; set; } = new();

    [Parameter] public IReadOnlyDictionary<string, decimal?> CariRawValues { get; set; } =
        new Dictionary<string, decimal?>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, decimal?> OncekiRawValues { get; set; } =
        new Dictionary<string, decimal?>(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Dönem net kârının özkaynağa eklenecek tutarı. Kuralın TEK sahibi
    /// <c>Detay.OzkaynakDonemKariDuzeltmesi</c>'dir (590/591 doluysa 0, boşsa 690);
    /// aynı değer Bilanço paneline de geçer. Burada yalnızca özkaynak ve pasif toplamına
    /// eklenir — hiçbir oran formülü değişmez, sadece girdileri doğru olur.
    /// </summary>
    [Parameter] public decimal DonemKariDuzeltmesi { get; set; }

    /// <summary>Denklik uyarısındaki "Bilançoya git" — sekme seçimini sayfa yapar.</summary>
    [Parameter] public EventCallback OnBilancoyaGit { get; set; }

    /// <summary>Faaliyet alanındaki "Önceki dönemi yükle" — mizan yükleme diyaloğunu sayfa açar.</summary>
    [Parameter] public EventCallback OnOncekiDonemYukle { get; set; }

    // Standart likidite referansları. (Cari 1,5 — 2,00 değil. Faiz Karşılama 8.)
    private const decimal CariReferans = 1.50m;
    private const decimal AsitTestReferans = 1.00m;
    private const decimal NakitReferans = 0.20m;
    private const decimal FaizKarsilamaReferans = 8.00m;

    // Finansal yapı referansları (oranlar % — 0,50 = %50; finansman = kat, ≥ 1).
    private const decimal KaldiracReferans = 0.50m;       // ≤ %50 olumlu (düşük borçluluk)
    private const decimal OzkaynakReferans = 0.50m;       // ≥ %50 olumlu
    private const decimal FinansmanReferans = 1.00m;      // ≥ 1 (özkaynak ≥ yabancı kaynak)

    private static readonly TooltipOptions TooltipAyar = new() { Position = TooltipPosition.Top };

    private const string LikiditeTooltip =
        "İşletmenin kısa vadeli borç ödeyebilme gücünü ölçmek için geliştirilmiş oranlardır.";
    private const string FaaliyetTooltip =
        "Varlıkların ve alacakların ne kadar verimli kullanıldığını ölçen devir oranlarıdır. "
        + "Devir oranları önceki ve cari dönem ortalaması ile hesaplandığından iki dönem mizan gerektirir.";
    private const string FinYapiTooltip =
        "İşletmenin kaynaklarının (borç/özkaynak) yapısını ve finansal bağımsızlığını ölçen oranlardır.";
    private const string KarlilikTooltip =
        "İşletmenin kâr üretme performansını; satışlara ve yatırılan sermayeye/varlıklara göre ölçen oranlardır.";

    private enum Ton { Iyi, Uyari, Notr }

    // Sağ oran tablosunun bir satırı.
    private class OranKart
    {
        public string Ad { get; init; } = "";
        public string Formul { get; init; } = "";
        public decimal? Deger { get; init; }
        public string RefMetni { get; init; } = "";
        public Ton Ton { get; init; }
        public string Tooltip { get; init; } = "";
        public bool Yuzde { get; init; }            // değer % olarak gösterilsin (×100, son ek "%")
        public string Birim { get; init; } = "";    // % değilse değer son eki (örn. " defa", " gün")
        public int Ondalik { get; init; } = 2;      // % değilse ondalık basamak (süre = 0)
        public ElementReference AdEl { get; set; }

        /// <summary>
        /// Referansın SAYISAL değeri — yalnızca bant grafiğinin ekseni ("referansın katı")
        /// için taşınır. Durum kararını <see cref="Oran"/> verir; bu alan hiçbir karara
        /// girmez. Referanssız oranlarda null.
        /// </summary>
        public decimal? Referans { get; init; }

        /// <summary>
        /// Değer hesaplanamadığında durum yerine yazılacak kısa sebep ("STOK YOK").
        /// Eksik girdi tek ve belli değilse null bırakılır → ekranda "—" kalır.
        /// </summary>
        public string? Sebep { get; init; }
    }

    // Sol özet tablonun bir satırı. Tutar/Payda zaten Math.Abs ile pozitif tutulur.
    private class OranTabloSatir
    {
        public string Ad { get; init; } = "";
        public decimal? Tutar { get; init; }
        public decimal? Payda { get; init; }   // dikey % paydası (ilgili toplam)
        public bool Toplam { get; init; }       // ilgili toplam satırı (%100) → total stili
    }

    // Bir bölüm: solda özet tablo, sağda oran listesi. Karlılık'ta iki bölüm (Satış / Sermaye).
    private class OranBolum
    {
        public string? AltBaslik { get; init; }
        public string TabloBaslik { get; init; } = "";
        public List<OranTabloSatir> SolTablo { get; init; } = new();
        public List<OranKart> Oranlar { get; init; } = new();
    }

    // Ekrandaki "alan": bir OranBolum + başlık/ikon/uyarı bilgisi. Beş alan, düz liste.
    private class Alan
    {
        public int No { get; init; }
        public string Ad { get; init; } = "";
        public string Ikon { get; init; } = "";
        public string Tooltip { get; init; } = "";
        public bool Hesaplanabilir { get; init; }
        public string? Uyari { get; init; }
        public bool OncekiDonemGerekir { get; init; }
        public OranBolum Bolum { get; init; } = new();

        public List<OranKart> Oranlar => Bolum.Oranlar;
    }

    private const int LikiditeNo = 1;
    private const int FinYapiNo = 3;
    private const int SermayeKarlilikNo = 5;

    private List<Alan> alanlar = new();
    private int _secili = LikiditeNo;

    // Grafikler için ham kalemler — hepsi yukarıdaki hesabın ÇIKTISI, yeniden hesaplanmaz.
    private decimal? _aktifToplam, _pasifToplam, _donen, _duran, _kvyk, _uvyk, _ozkaynak, _donemNetKari;

    protected override void OnParametersSet()
    {
        // Aktif/Pasif Bilanço ve Bilanço Özet ile AYNI hesaplayıcıdan gelir → "I -DÖNEN
        // VARLIKLAR" gibi grup toplamları tüm sekmelerde aynı çıkar.
        var aktif = MizanHesaplayici.Compute(Aktif, MaliTabloBolumu.Aktif);
        var pasif = MizanHesaplayici.Compute(Pasif, MaliTabloBolumu.Pasif);
        var gelir = GelirTablosuCalculator.Compute(GelirTablosu, CariRawValues, OncekiRawValues);

        decimal? Akt(string ad) => aktif
            .FirstOrDefault(r => string.Equals(r.Source.Ad?.Trim(), ad, StringComparison.OrdinalIgnoreCase))?.Cari;
        decimal? Pas(string ad) => pasif
            .FirstOrDefault(r => string.Equals(r.Source.Ad?.Trim(), ad, StringComparison.OrdinalIgnoreCase))?.Cari;
        decimal? Gt(string ad) => gelir
            .FirstOrDefault(r => string.Equals(r.Source.Ad?.Trim(), ad, StringComparison.OrdinalIgnoreCase))?.Cari;

        // Kod bazlı erişim (Compute önce, yoksa raw). 690/692 gibi tekil kodlar için.
        // Raw fallback ham borç-pozitif değerdir → gelir tablosu işaretine çevrilir.
        decimal? GtKod(string kod) => gelir.FirstOrDefault(r => r.Source.Kod == kod)?.Cari
            ?? MaliTabloIsareti.Uygula(
                CariRawValues.TryGetValue(kod, out var v) ? v : null, MaliTabloBolumu.GelirTablosu);

        // Grup bazlı (kod-prefix) toplam: bir hesap grubunun (örn. 12 Ticari Alacaklar,
        // 32 Ticari Borçlar) TÜM Account satırlarının İŞARETLİ bakiyesini toplar. Kontra
        // hesaplar (122/124/129, 322 ... "(-)") kendi negatif işaretiyle dahil olur →
        // grubun net büyüklüğü çıkar. Math.Abs grup toplamına (oran hesabında) uygulanır,
        // tek tek hesaplara DEĞİL; aksi halde kontra kalemler işaret kaybedip toplamı şişirir.
        // SubGroup başlıkları hesap planında kodsuz olduğundan (kod="") ad yerine kod-prefix
        // yöntemi seçilmiştir. Tek kaynak: parse zaten raw'ı Account satırlarına yazar.
        decimal? GrupCari(List<MizanHesaplayici.ComputedRow> list, string prefix)
        {
            decimal? sum = null;
            foreach (var r in list)
                if (r.Source.Tip == SatirTipi.Account && (r.Source.Kod?.StartsWith(prefix) ?? false) && r.Cari.HasValue)
                    sum = (sum ?? 0m) + r.Cari.Value;
            return sum;
        }
        decimal? GrupOnceki(List<MizanHesaplayici.ComputedRow> list, string prefix)
        {
            decimal? sum = null;
            foreach (var r in list)
                if (r.Source.Tip == SatirTipi.Account && (r.Source.Kod?.StartsWith(prefix) ?? false) && r.Onceki.HasValue)
                    sum = (sum ?? 0m) + r.Onceki.Value;
            return sum;
        }

        // Bölüm Total satırı (Aktif/Pasif'te tek Total → genel toplam).
        decimal? GenelToplam(List<MizanHesaplayici.ComputedRow> list) => list
            .Where(r => r.Source.Tip == SatirTipi.Total)
            .Select(r => r.Cari)
            .LastOrDefault(v => v.HasValue);

        // --- Bilanço kalemleri ---
        var donen = Akt("I -DÖNEN VARLIKLAR");
        var duran = Akt("II -DURAN VARLIKLAR");
        var stok = Akt("E-Stoklar");
        var hazir = Akt("A-Hazır Değerler");
        var menkul = Akt("B-Menkul Kıymetler");
        var aktifToplam = GenelToplam(aktif);

        var kvyk = Pas("III-KISA VADELİ YABANCI KAYNAKLAR");
        var uvyk = Pas("IV -UZUN VADELİ YABANCI KAYNAKLAR");
        var ozkaynak = Pas("V-ÖZ KAYNAKLAR");
        var pasifToplam = GenelToplam(pasif);

        // Kapanış atılmamışsa dönem kârı 590/591'de görünmez, hâlâ 6/7 gruplarındadır; bu
        // durumda özkaynak ve pasif toplamı EKSİK gelir. Düzeltme tutarı Detay.razor'da bir
        // kez hesaplanır (OzkaynakDonemKariDuzeltmesi) ve Bilanço paneline de aynı değer gider
        // — kural burada tekrar yazılmaz. Formüller değişmiyor, yalnızca girdiler doğruluyor.
        if (DonemKariDuzeltmesi != 0m)
        {
            ozkaynak = (ozkaynak ?? 0m) + DonemKariDuzeltmesi;
            pasifToplam = (pasifToplam ?? 0m) + DonemKariDuzeltmesi;
        }

        // Ticari Alacaklar = 12 grubu (120-129), Ticari Borçlar = 32 grubu (320-329) — grup bazlı.
        var ticariAlacak = GrupCari(aktif, "12");   // 12 Ticari Alacaklar (işaretli grup toplamı)
        var ticariBorc = GrupCari(pasif, "32");     // 32 Ticari Borçlar (işaretli grup toplamı)

        // --- Gelir tablosu kalemleri ---
        var brutSatis = Gt("A-BRÜT SATIŞLAR");
        var satisIndirim = Gt("B-SATIŞ İNDİRİMLERİ (-)");
        var netSatisSigned = (brutSatis.HasValue || satisIndirim.HasValue)
            ? (brutSatis ?? 0m) + (satisIndirim ?? 0m) : (decimal?)null;
        var netSatislar = netSatisSigned.HasValue ? Math.Abs(netSatisSigned.Value) : (decimal?)null;
        var smm = Abs(Gt("D-SATIŞLARIN MALİYETİ (-)"));
        var faaliyetKar = Gt("FAALİYET KARI VEYA ZARARI");
        var finansman = Gt("H-FİNANSMAN GİDERLERİ (-)");     // 660 + 661 alt-toplamı
        var brutKar = Gt("BRÜT SATIŞ KARI VEYA ZARARI");
        var olaganKar = Gt("OLAĞAN KAR VEYA ZARAR");
        var ticariKar = GtKod("690");        // Ticari Kâr / Dönem Kârı
        var donemNetKar = GtKod("692");      // Dönem Net Kârı

        var veriVar = donen.HasValue || kvyk.HasValue || netSatislar.HasValue;

        // ================= LİKİDİTE =================
        var cariOran = Bol(Abs(donen), Abs(kvyk));
        var asitPay = donen.HasValue ? Math.Abs(donen.Value) - Abs0(stok) : (decimal?)null;
        var asitTestOran = Bol(asitPay, Abs(kvyk));
        var stokBagPay = kvyk.HasValue ? Math.Abs(kvyk.Value) - (Abs0(hazir) + Abs0(menkul)) : (decimal?)null;
        var stokBagimlilik = Bol(stokBagPay, Abs(stok));
        var nakitPay = (hazir.HasValue || menkul.HasValue) ? Abs0(hazir) + Abs0(menkul) : (decimal?)null;
        var nakitOran = Bol(nakitPay, Abs(kvyk));
        var cabukOran = Bol(Abs(ticariAlacak), Abs(ticariBorc));
        var faizKarsilama = Bol(Abs(faaliyetKar), Abs(finansman));

        var likiditeBolum = new OranBolum
        {
            TabloBaslik = "Likidite Kalemleri",
            SolTablo = new List<OranTabloSatir>
            {
                Row("Dönen Varlıklar", donen, aktifToplam),
                Row("KVYK", kvyk, pasifToplam),
                Row("Stok", stok, aktifToplam),
                Row("Hazır Değerler", hazir, aktifToplam),
                Row("Menkul Kıymetler", menkul, aktifToplam),
            },
            Oranlar = new List<OranKart>
            {
                Oran("Cari Oran", "Dönen Varlıklar / KVYK", cariOran, CariReferans, false,
                    Ref("≥", CariReferans), "Kısa vadeli borç ödeme gücü. Dönen Varlıklar / KVYK.",
                    sebep: Yok("KVYK", kvyk)),
                Oran("Asit-Test Oranı", "(Dönen Varlıklar − Stok) / KVYK", asitTestOran, AsitTestReferans, false,
                    Ref("≥", AsitTestReferans), "Stok hariç kısa vadeli ödeme gücü. (Dönen Varlıklar − Stok) / KVYK.",
                    sebep: Yok("KVYK", kvyk)),
                Oran("Stok Bağımlılık Oranı", "(KVYK − (Hazır Değer + Menkul Kıymet)) / Stok", stokBagimlilik, null, false,
                    NotrRef, "KVYK'yi karşılamada stoklara bağımlılığı ölçer; referans yok (nötr/bilgi).",
                    sebep: Yok("STOK", stok)),
                Oran("Nakit Oran", "(Hazır Değer + Menkul Kıymet) / KVYK", nakitOran, NakitReferans, false,
                    Ref("≥", NakitReferans), "Stoklar/alacaklar olmadan KVYK karşılama oranı. Referans 0,20.",
                    sebep: Yok("KVYK", kvyk)),
                Oran("Çabuk Oran", "Ticari Alacaklar (12) / Ticari Borçlar (32)", cabukOran, AsitTestReferans, false,
                    Ref("≥", AsitTestReferans), "Ticari Alacaklar (12 grubu: 120-129) / Ticari Borçlar (32 grubu: 320-329). Kontra hesaplar işaretiyle dahil.",
                    sebep: Yok("TİCARİ BORÇ", ticariBorc)),
                Oran("Faiz Karşılama Oranı", "Faaliyet Karı / Finansman Gideri", faizKarsilama, FaizKarsilamaReferans, false,
                    Ref("≥", FaizKarsilamaReferans), "Faaliyet Karı / Finansman Gideri (66). Finansman gideri yoksa hesaplanmaz.",
                    sebep: Yok("GİDER", finansman)),
            },
        };

        // ================= FAALİYET =================
        // Devir oranları varlık/borç ORTALAMASI ile → iki dönem (önceki + cari) gerekir.
        bool ikiDonem = aktif.Any(r => r.Onceki.HasValue) || pasif.Any(r => r.Onceki.HasValue);
        bool cariVar = aktif.Any(r => r.Cari.HasValue) || pasif.Any(r => r.Cari.HasValue);

        decimal? OrtAkt(string ad)
        {
            var r = aktif.FirstOrDefault(x => string.Equals(x.Source.Ad?.Trim(), ad, StringComparison.OrdinalIgnoreCase));
            return Ort(r?.Cari, r?.Onceki);
        }
        var ortStok = OrtAkt("E-Stoklar");
        // Ticari Alacak/Borç ortalaması da grup bazlı: önce işaretli grup toplamı (cari/önceki),
        // sonra ortalama = (|önceki toplam| + |cari toplam|) / 2.
        var ortAlacak = Ort(GrupCari(aktif, "12"), GrupOnceki(aktif, "12"));
        var ortBorc = Ort(GrupCari(pasif, "32"), GrupOnceki(pasif, "32"));
        var ortDonen = OrtAkt("I -DÖNEN VARLIKLAR");
        var ortDuran = OrtAkt("II -DURAN VARLIKLAR");
        var ortAktif = (ortDonen.HasValue || ortDuran.HasValue) ? (ortDonen ?? 0m) + (ortDuran ?? 0m) : (decimal?)null;

        // İki dönem yoksa devir oranları + ortalama tablo değerleri hesaplanmaz ("—").
        decimal? G(decimal? v) => ikiDonem ? v : null;
        var stokDevir = G(Bol(smm, ortStok));
        var stokSure = Sure(stokDevir);
        var alacakDevir = G(Bol(netSatislar, ortAlacak));
        var alacakSure = Sure(alacakDevir);
        var borcDevir = G(Bol(smm, ortBorc));
        var borcSure = Sure(borcDevir);
        var donenDevir = G(Bol(netSatislar, ortDonen));
        var duranDevir = G(Bol(netSatislar, ortDuran));
        var aktifDevir = G(Bol(netSatislar, ortAktif));

        // Sol tablo ortalama kalemleri de iki dönem yoksa "—" (ortalama iki dönem gerektirir).
        var dOrtAktif = G(ortAktif);

        const string DefaBirim = " defa";
        const string GunBirim = " gün";

        var faaliyetBolum = new OranBolum
        {
            TabloBaslik = "Faaliyet Kalemleri (Cari & Ortalama)",
            SolTablo = new List<OranTabloSatir>
            {
                Row("Net Satışlar", netSatislar, netSatislar, toplam: true),
                Row("Satışların Maliyeti", smm, netSatislar),
                Row("Ortalama Aktif", dOrtAktif, dOrtAktif, toplam: true),
                Row("Ortalama Dönen Varlıklar", G(ortDonen), dOrtAktif),
                Row("Ortalama Duran Varlıklar", G(ortDuran), dOrtAktif),
                Row("Ortalama Ticari Alacak (12)", G(ortAlacak), dOrtAktif),
                Row("Ortalama Ticari Borç (32)", G(ortBorc), dOrtAktif),
                Row("Ortalama Stok", G(ortStok), dOrtAktif),
            },
            Oranlar = new List<OranKart>
            {
                FaalOran("Stok Devir Hızı", "Satışların Maliyeti / Ortalama Stok", stokDevir, DefaBirim, 2,
                    "Stokun yılda kaç kez döndüğü. SMM / Ortalama Stok. Ortalama = (önceki + cari) / 2."),
                FaalOran("Stok Devir Süresi", "365 / Stok Devir Hızı", stokSure, GunBirim, 0,
                    "Stokun ortalama kaç günde eridiği. 365 / Stok Devir Hızı."),
                FaalOran("Alacak Devir Hızı", "Net Satışlar / Ortalama Ticari Alacak (12)", alacakDevir, DefaBirim, 2,
                    "Ticari alacakların yılda kaç kez tahsil edildiği. Net Satışlar / Ortalama 12 grubu (120-129)."),
                FaalOran("Alacak Tahsil Süresi", "365 / Alacak Devir Hızı", alacakSure, GunBirim, 0,
                    "Alacakların ortalama kaç günde tahsil edildiği. 365 / Alacak Devir Hızı."),
                FaalOran("Borç Devir Hızı", "Satışların Maliyeti / Ortalama Ticari Borç (32)", borcDevir, DefaBirim, 2,
                    "Ticari borçların yılda kaç kez ödendiği. SMM / Ortalama 32 grubu (320-329)."),
                FaalOran("Borç Ödeme Süresi", "365 / Borç Devir Hızı", borcSure, GunBirim, 0,
                    "Borçların ortalama kaç günde ödendiği. 365 / Borç Devir Hızı."),
                FaalOran("Dönen Varlık Devir Hızı", "Net Satışlar / Ortalama Dönen Varlıklar", donenDevir, DefaBirim, 2,
                    "Dönen varlıkların satışa dönüşme verimi. Net Satışlar / Ortalama Dönen Varlıklar."),
                FaalOran("Duran Varlık Devir Hızı", "Net Satışlar / Ortalama Duran Varlıklar", duranDevir, DefaBirim, 2,
                    "Duran varlıkların satışa dönüşme verimi. Net Satışlar / Ortalama Duran Varlıklar."),
                FaalOran("Aktif Devir Hızı", "Net Satışlar / Ortalama Aktif Toplamı", aktifDevir, DefaBirim, 2,
                    "Toplam varlıkların satış üretme verimi. Net Satışlar / Ortalama Aktif (Dönen + Duran)."),
            },
        };

        // ================= FİNANSAL YAPI =================
        var yabanciKaynak = (kvyk.HasValue || uvyk.HasValue) ? Abs0(kvyk) + Abs0(uvyk) : (decimal?)null;
        var kaldirac = Bol(yabanciKaynak, Abs(pasifToplam));
        var ozkaynakOran = Bol(Abs(ozkaynak), Abs(pasifToplam));
        var devamliPay = (uvyk.HasValue || ozkaynak.HasValue) ? Abs0(uvyk) + Abs0(ozkaynak) : (decimal?)null;
        var devamliSermaye = Bol(devamliPay, Abs(pasifToplam));
        var finansmanOran = Bol(Abs(ozkaynak), yabanciKaynak);

        var finYapiBolum = new OranBolum
        {
            TabloBaslik = "Pasif (Kaynak Yapısı)",
            SolTablo = new List<OranTabloSatir>
            {
                Row("KVYK", kvyk, pasifToplam),
                Row("UVYK", uvyk, pasifToplam),
                Row("Özkaynaklar", ozkaynak, pasifToplam),
                Row("Pasif Toplam", pasifToplam, pasifToplam, toplam: true),
            },
            Oranlar = new List<OranKart>
            {
                Oran("Finansal Kaldıraç (Borç) Oranı", "Yabancı Kaynak / Pasif", kaldirac, KaldiracReferans, true,
                    Ref("≤", KaldiracReferans, yuzde: true),
                    "(KVYK + UVYK) / Pasif. Düşük olması olumlu (düşük borçluluk). Referans ≤ %50.",
                    yuzde: true,
                    sebep: Yok("PASİF", pasifToplam)),
                Oran("Özkaynak Oranı", "Özkaynaklar / Pasif", ozkaynakOran, OzkaynakReferans, false,
                    Ref("≥", OzkaynakReferans, yuzde: true),
                    "Varlıkların ne kadarının özkaynakla finanse edildiği. Yüksek olması olumlu. Referans ≥ %50.",
                    yuzde: true,
                    sebep: Yok("PASİF", pasifToplam)),
                Oran("Devamlı Sermaye Oranı", "(UVYK + Özkaynak) / Pasif", devamliSermaye, null, false,
                    NotrRef, "Uzun vadeli kaynakların pasif içindeki payı. Referans yok (bilgi/nötr).",
                    yuzde: true,
                    sebep: Yok("PASİF", pasifToplam)),
                Oran("Finansman Oranı", "Özkaynak / Yabancı Kaynak", finansmanOran, FinansmanReferans, false,
                    Ref("≥", FinansmanReferans),
                    "Özkaynağın yabancı kaynağa oranı. ≥ 1 ise özkaynak ≥ yabancı kaynak (olumlu).",
                    sebep: Yok("YABANCI KAYNAK", yabanciKaynak)),
            },
        };

        // ================= KARLILIK =================
        // A) Satış Karlılığı — hepsi / Net Satışlar (referans yok, yüksek=iyi → durum bilgi).
        decimal? Marj(decimal? kar) => Bol(Abs(kar), netSatislar);
        var satisKarlilikBolum = new OranBolum
        {
            AltBaslik = "Satış Karlılığı",
            TabloBaslik = "Gelir Tablosu — Kâr Kalemleri",
            SolTablo = new List<OranTabloSatir>
            {
                Row("Net Satışlar", netSatislar, netSatislar, toplam: true),
                Row("Brüt Satış Karı", brutKar, netSatislar),
                Row("Faaliyet Karı", faaliyetKar, netSatislar),
                Row("Olağan Kar", olaganKar, netSatislar),
                Row("Ticari Kar (690)", ticariKar, netSatislar),
                Row("Dönem Net Karı (692)", donemNetKar, netSatislar),
            },
            Oranlar = new List<OranKart>
            {
                KarOran("Brüt Satış Karlılığı", "Brüt Satış Karı / Net Satışlar", Marj(brutKar),
                    "Brüt kârın satışlara oranı. Yüksek olması olumlu.",
                    sebep: Yok("SATIŞ", netSatislar)),
                KarOran("Faaliyet Karlılığı", "Faaliyet Karı / Net Satışlar", Marj(faaliyetKar),
                    "Esas faaliyet kârının satışlara oranı. Yüksek olması olumlu.",
                    sebep: Yok("SATIŞ", netSatislar)),
                KarOran("Olağan Karlılık", "Olağan Kar / Net Satışlar", Marj(olaganKar),
                    "Olağan kârın satışlara oranı. Yüksek olması olumlu.",
                    sebep: Yok("SATIŞ", netSatislar)),
                KarOran("Ticari Karlılık", "Ticari Kar (690) / Net Satışlar", Marj(ticariKar),
                    "Dönem ticari kârının (690) satışlara oranı. Yüksek olması olumlu.",
                    sebep: Yok("SATIŞ", netSatislar)),
                KarOran("Net Kar Marjı", "Dönem Net Karı / Net Satışlar", Marj(donemNetKar),
                    "Dönem net kârının (692) satışlara oranı. Yüksek olması olumlu.",
                    sebep: Yok("SATIŞ", netSatislar)),
            },
        };

        // B) Sermaye/Varlık Karlılığı — hepsi Dönem Net Karı / kalem (referans yok, yüksek=iyi).
        var dnk = Abs(donemNetKar);
        decimal? Getiri(decimal? payda) => Bol(dnk, Abs(payda));
        var sermayeKarlilikBolum = new OranBolum
        {
            AltBaslik = "Sermaye / Varlık Karlılığı",
            TabloBaslik = "Bilanço — Varlık & Kaynak",
            SolTablo = new List<OranTabloSatir>
            {
                Row("Dönen Varlıklar", donen, aktifToplam),
                Row("Duran Varlıklar", duran, aktifToplam),
                Row("Aktif Toplam", aktifToplam, aktifToplam, toplam: true),
                Row("KVYK", kvyk, pasifToplam),
                Row("UVYK", uvyk, pasifToplam),
                Row("Özkaynaklar", ozkaynak, pasifToplam),
                Row("Pasif Toplam", pasifToplam, pasifToplam, toplam: true),
            },
            Oranlar = new List<OranKart>
            {
                KarOran("Dönem Net Karı / Dönen Varlıklar", "Dönem Net Karı / Dönen Varlıklar", Getiri(donen),
                    "Net kârın dönen varlıklara getirisi. Yüksek olması olumlu.",
                    sebep: Yok("DÖNEN VARLIK", donen)),
                KarOran("Dönem Net Karı / Duran Varlıklar", "Dönem Net Karı / Duran Varlıklar", Getiri(duran),
                    "Net kârın duran varlıklara getirisi. Yüksek olması olumlu.",
                    sebep: Yok("DURAN VARLIK", duran)),
                KarOran("Aktif Karlılığı (ROA)", "Dönem Net Karı / Aktif Toplam", Getiri(aktifToplam),
                    "Aktif Kârlılığı (ROA). Net kârın toplam varlıklara getirisi. Yüksek olması olumlu.",
                    sebep: Yok("AKTİF", aktifToplam)),
                KarOran("Dönem Net Karı / KVYK", "Dönem Net Karı / KVYK", Getiri(kvyk),
                    "Net kârın kısa vadeli yabancı kaynağa oranı. Yüksek olması olumlu.",
                    sebep: Yok("KVYK", kvyk)),
                KarOran("Dönem Net Karı / UVYK", "Dönem Net Karı / UVYK", Getiri(uvyk),
                    "Net kârın uzun vadeli yabancı kaynağa oranı. Yüksek olması olumlu.",
                    sebep: Yok("UVYK", uvyk)),
                KarOran("Özkaynak Karlılığı (ROE)", "Dönem Net Karı / Özkaynak", Getiri(ozkaynak),
                    "Özkaynak Kârlılığı (ROE). Net kârın özkaynağa getirisi. Yüksek olması olumlu.",
                    sebep: Yok("ÖZKAYNAK", ozkaynak)),
                KarOran("Dönem Net Karı / Pasif Toplam", "Dönem Net Karı / Pasif Toplam", Getiri(pasifToplam),
                    "Net kârın toplam kaynaklara getirisi. Yüksek olması olumlu.",
                    sebep: Yok("PASİF", pasifToplam)),
            },
        };

        // Beş alan: Karlılık grubunun iki bölümü ayrı alan olarak listelenir.
        alanlar = new List<Alan>
        {
            new()
            {
                No = 1, Ad = "LİKİDİTE", Ikon = "water_drop", Tooltip = LikiditeTooltip,
                Hesaplanabilir = veriVar, Bolum = likiditeBolum,
                Uyari = veriVar ? null : "Cari dönem mizanı yüklendiğinde oranlar otomatik hesaplanır.",
            },
            new()
            {
                No = 2, Ad = "FAALİYET", Ikon = "autorenew", Tooltip = FaaliyetTooltip,
                Hesaplanabilir = cariVar && ikiDonem,
                OncekiDonemGerekir = cariVar && !ikiDonem,
                Bolum = faaliyetBolum,
                Uyari = !cariVar
                    ? "Cari dönem mizanı yüklendiğinde oranlar otomatik hesaplanır."
                    : (!ikiDonem
                        ? "İki dönem mizan gerekir — devir oranları önceki ve cari dönem ortalaması ile hesaplanır."
                        : null),
            },
            new()
            {
                No = 3, Ad = "FİNANSAL YAPI", Ikon = "account_balance", Tooltip = FinYapiTooltip,
                Hesaplanabilir = veriVar, Bolum = finYapiBolum,
                Uyari = veriVar ? null : "Cari dönem mizanı yüklendiğinde oranlar otomatik hesaplanır.",
            },
            new()
            {
                No = 4, Ad = "SATIŞ KARLILIĞI", Ikon = "trending_up", Tooltip = KarlilikTooltip,
                Hesaplanabilir = veriVar, Bolum = satisKarlilikBolum,
                Uyari = veriVar ? null : "Cari dönem mizanı yüklendiğinde oranlar otomatik hesaplanır.",
            },
            new()
            {
                No = 5, Ad = "SERMAYE / VARLIK KARLILIĞI", Ikon = "savings", Tooltip = KarlilikTooltip,
                Hesaplanabilir = veriVar, Bolum = sermayeKarlilikBolum,
                Uyari = veriVar ? null : "Cari dönem mizanı yüklendiğinde oranlar otomatik hesaplanır.",
            },
        };

        // Grafiklerin kullandığı kalemler — yukarıdaki değerlerin aynısı (Math.Abs'li sunum hâli).
        _aktifToplam = Abs(aktifToplam);
        _pasifToplam = Abs(pasifToplam);
        _donen = Abs(donen);
        _duran = Abs(duran);
        _kvyk = Abs(kvyk);
        _uvyk = Abs(uvyk);
        _ozkaynak = Abs(ozkaynak);
        _donemNetKari = dnk;   // Getiri(...) oranlarının payı; yeniden hesaplanmaz

        // Seçili alan hesaplanamaz hâle geldiyse hesaplanabilen ilk alana geç.
        if (SeciliAlan is null || SeciliAlan is { Hesaplanabilir: false })
            _secili = alanlar.FirstOrDefault(a => a.Hesaplanabilir)?.No ?? LikiditeNo;
    }

    // ── Seçim ve sayaçlar ──

    private Alan? SeciliAlan => alanlar.FirstOrDefault(a => a.No == _secili);

    /// <summary>Alanı seçer ve sol listede o alanın başlığına kaydırır.</summary>
    private async Task AlanSecAsync(int no)
    {
        _secili = no;
        StateHasChanged();

        // Mizan sekmesindeki mevcut yardımcı; yeni JS yazılmadı.
        await JS.InvokeVoidAsync("fkMizanTab.scrollToRow", $"or-alan-{no}");
    }

    private IEnumerable<OranKart> TumOranlar => alanlar.SelectMany(a => a.Oranlar);

    private int ToplamOran => TumOranlar.Count();

    // Durum sayaçları. Kaynak Ton'dur (Iyi / Uyari / Notr) — yeni bir durum kararı ÜRETİLMEZ.
    //
    // Dört kova her oranı TAM BİR KEZ kapsar, toplamları ToplamOran'a eşittir:
    //   değeri yok                      → HESAPLANAMADI
    //   değeri var, referansı yok       → REFERANSSIZ
    //   değeri ve referansı var, Iyi    → OLUMLU
    //   değeri ve referansı var, Uyari  → OLUMSUZ
    // (Oran(...) kurucusu, değer ve referans varken Ton'u yalnızca Iyi ya da Uyari yapar.)
    private int OlumluSayisi => TumOranlar.Count(k => k.Deger.HasValue && k.Referans is not null && k.Ton == Ton.Iyi);
    private int OlumsuzSayisi => TumOranlar.Count(k => k.Deger.HasValue && k.Referans is not null && k.Ton == Ton.Uyari);
    private int ReferanssizSayisi => TumOranlar.Count(k => k.Deger.HasValue && k.Referans is null);
    private int HesaplanamadiSayisi => TumOranlar.Count(k => !k.Deger.HasValue);

    // ── Bilanço denkliği ──

    private decimal? DenklikFarki =>
        (_aktifToplam.HasValue && _pasifToplam.HasValue) ? _aktifToplam - _pasifToplam : null;

    private bool Denksiz => DenklikFarki.HasValue && Math.Abs(DenklikFarki.Value) > 0.01m;

    // ── Grafik yardımcıları (hepsi mevcut değerlerden türetilir) ──

    private decimal? OlcekDonenKvyk =>
        (_donen.HasValue || _kvyk.HasValue) ? Math.Max(_donen ?? 0m, _kvyk ?? 0m) : (decimal?)null;

    /// <summary>
    /// Sermaye / Varlık Karlılığı alanındaki yedi oranın paydaları — hepsi aynı payı
    /// (dönem net kârı) böler. Değerler yukarıdaki hesaptan gelir, yeniden hesaplanmaz.
    /// </summary>
    private IEnumerable<(string Ad, decimal? Deger)> Paydalar => new (string, decimal?)[]
    {
        ("Dönen Varlıklar", _donen),
        ("Duran Varlıklar", _duran),
        ("Aktif Toplam", _aktifToplam),
        ("KVYK", _kvyk),
        ("Özkaynaklar", _ozkaynak),
        ("Pasif Toplam", _pasifToplam),
    };

    /// <summary>Payda çubuklarının ortak ölçeği: en büyük payda tam genişlik olur.</summary>
    private decimal? PaydaOlcegi
    {
        get
        {
            var dolu = Paydalar.Where(p => p.Deger.HasValue).Select(p => p.Deger!.Value).ToList();
            return dolu.Count > 0 ? dolu.Max() : (decimal?)null;
        }
    }

    private decimal? NetIsletmeSermayesi =>
        (_donen.HasValue || _kvyk.HasValue) ? (_donen ?? 0m) - (_kvyk ?? 0m) : (decimal?)null;

    /// <summary>Bant grafiğinde çubuk genişliği: 0-2,0x ekseninde yüzde karşılığı.</summary>
    private static double BantOran(decimal kat)
    {
        var k = kat < 0m ? 0m : (kat > 2m ? 2m : kat);
        return (double)(k / 2m) * 100d;
    }

    private static double Pay(decimal? deger, decimal? payda) =>
        (deger.HasValue && payda is > 0m) ? (double)(deger.Value / payda.Value) * 100d : 0d;

    private static string Genislik(double yuzde) =>
        $"width:{Math.Round(Math.Clamp(yuzde, 0d, 100d), 2).ToString(CultureInfo.InvariantCulture)}%";

    private static string KatMetni(decimal kat) => kat.ToString("N2", Tr) + "x";

    private static string TutarMetni(decimal? deger) =>
        deger.HasValue ? deger.Value.ToString("N2", Tr) : "—";

    private static string YuzdeMetni(decimal? deger, decimal? payda) =>
        (deger.HasValue && payda is > 0m)
            ? "%" + (deger.Value / payda.Value * 100m).ToString("N2", Tr)
            : "—";

    /// <summary>İşaretli tutar: denklik farkı ve net işletme sermayesi için.</summary>
    private static string Imzali(decimal? deger)
    {
        if (!deger.HasValue) return "—";
        var metin = Math.Abs(deger.Value).ToString("N2", Tr);
        return deger.Value < 0m ? "−" + metin : metin;
    }

    // ── Durum sunumu ──

    private static string NoktaSinif(OranKart k) =>
        k.Referans is null ? "or-n-refsiz"
        : k.Ton == Ton.Iyi ? "or-n-olumlu"
        : k.Ton == Ton.Uyari ? "or-n-olumsuz"
        : "or-n-refsiz";

    private static string DurumSinif(OranKart k) =>
        k.Referans is null ? "or-s-refsiz"
        : k.Ton == Ton.Iyi ? "or-s-olumlu"
        : k.Ton == Ton.Uyari ? "or-s-olumsuz"
        : "or-s-refsiz";

    private static string DurumMetni(OranKart k) =>
        k.Referans is null ? "REFERANSSIZ"
        : k.Ton == Ton.Iyi ? "OLUMLU"
        : k.Ton == Ton.Uyari ? "OLUMSUZ"
        : "REFERANSSIZ";
    // --- Sol tablo satırı: tutar/payda Math.Abs ile pozitif tutulur. ---
    private static OranTabloSatir Row(string ad, decimal? tutar, decimal? payda, bool toplam = false) =>
        new() { Ad = ad, Tutar = Abs(tutar), Payda = Abs(payda), Toplam = toplam };

    // --- Referanslı / nötr oran kartı kurucusu. ---
    private static OranKart Oran(string ad, string formul, decimal? deger, decimal? referans, bool dusukIyi,
        string refMetni, string tooltip, bool yuzde = false, string birim = "", int ondalik = 2,
        string? sebep = null)
    {
        Ton ton;
        if (!deger.HasValue || referans is null)
            ton = Ton.Notr;
        else
            ton = (dusukIyi ? deger.Value <= referans.Value : deger.Value >= referans.Value) ? Ton.Iyi : Ton.Uyari;

        return new OranKart
        {
            Ad = ad, Formul = formul, Deger = deger, RefMetni = refMetni,
            Ton = ton, Tooltip = tooltip, Yuzde = yuzde, Birim = birim, Ondalik = ondalik,
            Referans = referans, Sebep = sebep,
        };
    }

    // Faaliyet kartı — referansı yok (nötr/bilgi); değer birimi (defa/gün) ve ondalık taşır.
    private static OranKart FaalOran(string ad, string formul, decimal? deger, string birim, int ondalik, string tooltip) =>
        new()
        {
            Ad = ad, Formul = formul, Deger = deger, RefMetni = NotrRef,
            Ton = Ton.Notr, Tooltip = tooltip, Birim = birim, Ondalik = ondalik,
        };

    // Karlılık kartı — referans yok ama yön belli (yüksek=iyi); durum nötr/bilgi, değer %.
    private static OranKart KarOran(string ad, string formul, decimal? deger, string tooltip,
        string? sebep = null) =>
        new()
        {
            Ad = ad, Formul = formul, Deger = deger, RefMetni = "Yüksek olması olumlu",
            Ton = Ton.Notr, Tooltip = tooltip, Yuzde = true, Ondalik = 2, Sebep = sebep,
        };

    /// <summary>
    /// Hesaplanamayan oranın kısa sebebi — yalnızca eksik/sıfır girdi TEK ve belliyse
    /// üretilir. Değer hesaplanabildiyse bu metin ekranda kullanılmaz.
    /// </summary>
    private static string? Yok(string etiket, decimal? girdi) =>
        (!girdi.HasValue || girdi.Value == 0m) ? etiket + " YOK" : null;

    private const string NotrRef = "Referans yok (nötr)";

    // Referans metni: yön + değer (oran ya da %).
    private static string Ref(string yon, decimal referans, bool yuzde = false) =>
        yuzde
            ? $"Ref {yon} {(referans * 100m).ToString("N0", Tr)}%"
            : $"Ref {yon} {referans.ToString("N2", Tr)}";

    // Ortalama = (|Önceki| + |Cari|) / 2. İkisi de yoksa null. (Yalnızca sunum/oran için Math.Abs.)
    private static decimal? Ort(decimal? cari, decimal? onceki)
    {
        if (!cari.HasValue && !onceki.HasValue) return null;
        return (Abs0(cari) + Abs0(onceki)) / 2m;
    }

    private static decimal? Sure(decimal? hiz) =>
        (hiz.HasValue && hiz.Value != 0m) ? 365m / hiz.Value : (decimal?)null;

    private static decimal? Abs(decimal? v) => v.HasValue ? Math.Abs(v.Value) : (decimal?)null;
    private static decimal Abs0(decimal? v) => v.HasValue ? Math.Abs(v.Value) : 0m;

    private static decimal? Bol(decimal? pay, decimal? payda)
    {
        if (!pay.HasValue || !payda.HasValue || payda.Value == 0m) return null;
        return pay.Value / payda.Value;
    }

    private static readonly CultureInfo Tr = new("tr-TR");

    // Sol tablo tutarı: N2 (zaten pozitif). Yoksa "—".
    private static string FormatNumber(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", Tr) : "—";

    // Dikey %: tutar / payda (her ikisi de pozitif). Payda 0/yok → "—".
    private static string FormatYuzde(decimal? value, decimal? payda)
    {
        if (!value.HasValue || !payda.HasValue || payda.Value == 0m) return "—";
        return (value.Value / payda.Value * 100m).ToString("N2", Tr) + "%";
    }

    // Oran değeri: % ise ×100 + "%", değilse N(ondalik) + birim. Yoksa "—".
    private static string FormatDeger(OranKart k)
    {
        if (!k.Deger.HasValue) return "—";
        return k.Yuzde
            ? (k.Deger.Value * 100m).ToString("N2", Tr) + "%"
            : k.Deger.Value.ToString("N" + k.Ondalik, Tr) + k.Birim;
    }

    private static string DurumLabel(Ton ton) => ton switch
    {
        Ton.Iyi => "Olumlu",
        Ton.Uyari => "Olumsuz",
        _ => "bilgi"
    };

    private static string TonRenk(Ton ton) => ton switch
    {
        Ton.Iyi => "var(--rz-success)",
        Ton.Uyari => "var(--rz-danger)",
        _ => "var(--rz-text-secondary-color)"
    };

    private static string TonIcon(Ton ton) => ton switch
    {
        Ton.Iyi => "arrow_upward",
        Ton.Uyari => "arrow_downward",
        _ => "info"
    };
}
