@using System.Globalization
@using WebApp.Domain.Models.FirmaKontrol

<table class="fk-mizan-table">
    <thead>
        <tr>
            <th class="fk-mizan-col-kod">Kod</th>
            <th class="fk-mizan-col-ad">Hesap Adı</th>
            <th class="fk-mizan-col-num">Önceki Dönem</th>
            <th class="fk-mizan-col-num">Cari Dönem</th>
            @if (ShowYuzde)
            {
                <th class="fk-mizan-col-num">Dikey %</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Rows.Count == 0)
        {
            <tr>
                <td colspan="@ColSpan" class="fk-mizan-empty"><em>Bu bölüm için satır bulunmuyor.</em></td>
            </tr>
        }
        else
        {
            @foreach (var row in computed)
            {
                <tr class="@RowCssClass(row.Source.Tip)">
                    <td class="fk-mizan-col-kod">@row.Source.Kod</td>
                    <td class="fk-mizan-col-ad">@row.Source.Ad</td>
                    <td class="fk-mizan-col-num">@FormatNumber(row.Onceki)</td>
                    <td class="fk-mizan-col-num">@FormatNumber(row.Cari)</td>
                    @if (ShowYuzde)
                    {
                        <td class="fk-mizan-col-num">@FormatYuzde(row.Cari)</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public List<MizanSatir> Rows { get; set; } = new();

    // true ise en sağa "Dikey %" kolonu eklenir (Dikey Yüzdeler Analizi sheet'i için).
    // Parametre verilmediğinde mevcut Aktif/Pasif sekmeleri eskisi gibi 4 kolon kalır.
    [Parameter] public bool ShowYuzde { get; set; } = false;

    private record ComputedRow(MizanSatir Source, decimal? Onceki, decimal? Cari);

    private List<ComputedRow> computed = new();

    // Dikey % paydası: bölümün Genel Toplam (Total) satırının cari değeri.
    private decimal? cariGenelToplam;

    private int ColSpan => ShowYuzde ? 5 : 4;

    protected override void OnParametersSet()
    {
        computed = Compute(Rows);

        // Payda = Total satırının cari değeri (Aktif/Pasif'te tek Total bulunur = Genel Toplam).
        cariGenelToplam = computed
            .Where(r => r.Source.Tip == SatirTipi.Total)
            .Select(r => r.Cari)
            .LastOrDefault(v => v.HasValue);
    }

    private static List<ComputedRow> Compute(List<MizanSatir> rows)
    {
        // 1) İlk geçiş: Account satırlarının değerleri olduğu gibi
        // 2) İkinci geçiş: SubGroup -> sonraki SubGroup/MainGroup'a kadarki Account toplamı
        //    MainGroup -> sonraki ÜST DÜZEY MainGroup/Total'a kadarki Account toplamı.
        //      (Hesap planında alt gruplar — H-Diğer Dönen Varlıklar, C-Mali Duran Varlıklar
        //       gibi — yanlışlıkla MainGroup etiketli; bunlarda kesilmeyip üst grubun
        //       toplamına dahil edilir, yoksa 190-199 gibi hesaplar Dönen toplamından düşer.)
        //    Total -> önceki Total'dan sonraki MainGroup toplamlarının toplamı
        //    Other -> hesaplanmaz

        var oncekiVals = new decimal?[rows.Count];
        var cariVals = new decimal?[rows.Count];

        // Account değerleri
        for (int i = 0; i < rows.Count; i++)
        {
            if (rows[i].Tip == SatirTipi.Account)
            {
                oncekiVals[i] = rows[i].OncekiDonem;
                cariVals[i] = rows[i].CariDonem;
            }
        }

        // SubGroup ve MainGroup toplamları
        for (int i = 0; i < rows.Count; i++)
        {
            var t = rows[i].Tip;
            if (t != SatirTipi.SubGroup && t != SatirTipi.MainGroup) continue;

            decimal? sumOnceki = null;
            decimal? sumCari = null;

            for (int j = i + 1; j < rows.Count; j++)
            {
                var jt = rows[j].Tip;

                if (t == SatirTipi.SubGroup)
                {
                    if (jt == SatirTipi.SubGroup || jt == SatirTipi.MainGroup || jt == SatirTipi.Total)
                        break;
                }
                else // MainGroup
                {
                    // Bir MainGroup toplamı, kendisinden sonraki TÜM SubGroup ve Account
                    // satırlarını, bir sonraki GERÇEK üst düzey MainGroup (veya Total)
                    // başlayana kadar kapsar. Hesap planında bazı alt bölüm başlıkları
                    // (H-Diğer Dönen Varlıklar=190-199, C-Mali Duran Varlıklar,
                    // Pasif'te I-Diğer Kısa Vadeli Yabancı Kaynaklar ...) yanlışlıkla
                    // MainGroup etiketli; bunlarda kesilmez, accountları emilir.
                    // Sadece Total'da veya gerçek üst düzey (tamamı büyük harf) MainGroup'ta kes.
                    if (jt == SatirTipi.Total ||
                        (jt == SatirTipi.MainGroup && UstDuzeyMainGroupMu(rows[j].Ad)))
                        break;
                }

                if (jt == SatirTipi.Account)
                {
                    if (rows[j].OncekiDonem.HasValue)
                        sumOnceki = (sumOnceki ?? 0m) + rows[j].OncekiDonem!.Value;
                    if (rows[j].CariDonem.HasValue)
                        sumCari = (sumCari ?? 0m) + rows[j].CariDonem!.Value;
                }
            }

            oncekiVals[i] = sumOnceki;
            cariVals[i] = sumCari;
        }

        // Total satırları: önceki Total'dan sonraki tüm Account'ların toplamı
        for (int i = 0; i < rows.Count; i++)
        {
            if (rows[i].Tip != SatirTipi.Total) continue;

            int start = 0;
            for (int k = i - 1; k >= 0; k--)
            {
                if (rows[k].Tip == SatirTipi.Total)
                {
                    start = k + 1;
                    break;
                }
            }

            decimal? sumOnceki = null;
            decimal? sumCari = null;

            for (int j = start; j < i; j++)
            {
                if (rows[j].Tip != SatirTipi.Account) continue;

                if (rows[j].OncekiDonem.HasValue)
                    sumOnceki = (sumOnceki ?? 0m) + rows[j].OncekiDonem!.Value;
                if (rows[j].CariDonem.HasValue)
                    sumCari = (sumCari ?? 0m) + rows[j].CariDonem!.Value;
            }

            oncekiVals[i] = sumOnceki;
            cariVals[i] = sumCari;
        }

        var result = new List<ComputedRow>(rows.Count);
        for (int i = 0; i < rows.Count; i++)
        {
            result.Add(new ComputedRow(rows[i], oncekiVals[i], cariVals[i]));
        }
        return result;
    }

    // Gerçek üst düzey bilanço başlıkları TAMAMEN BÜYÜK HARF (örn "I -DÖNEN VARLIKLAR",
    // "III-KISA VADELİ YABANCI KAYNAKLAR", "V-ÖZ KAYNAKLAR").
    // Yanlışlıkla MainGroup etiketli alt bölümler başlık-düzeni olup en az bir küçük harf
    // içerir (örn "H-Diğer Dönen Varlıklar", "I-Diğer Kısa Vadeli Yabancı Kaynaklar").
    // NOT: Roma rakamı önekine göre ayırmak hatalı olurdu — "I-Diğer Kısa Vadeli..." da
    // "I" ile başlar ama bir alt gruptur; bu yüzden büyük/küçük harf ölçütü kullanılır.
    // En az bir HARF olmalı ve hiç küçük harf bulunmamalı.
    private static bool UstDuzeyMainGroupMu(string? ad) =>
        !string.IsNullOrEmpty(ad) && ad.Any(char.IsLetter) && !ad.Any(char.IsLower);

    private static string RowCssClass(SatirTipi tip) => tip switch
    {
        SatirTipi.MainGroup => "fk-mizan-row main-group",
        SatirTipi.SubGroup => "fk-mizan-row sub-group",
        SatirTipi.Account => "fk-mizan-row account",
        SatirTipi.Total => "fk-mizan-row total",
        SatirTipi.Other => "fk-mizan-row other",
        _ => "fk-mizan-row"
    };

    private static string FormatNumber(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", new CultureInfo("tr-TR")) : "—";

    // Satırın cari değerinin Genel Toplam'a oranı. Tutar yoksa veya payda 0/boşsa "—".
    private string FormatYuzde(decimal? value)
    {
        if (!value.HasValue || !cariGenelToplam.HasValue || cariGenelToplam.Value == 0m)
            return "—";

        var oran = value.Value / cariGenelToplam.Value * 100m;
        return oran.ToString("N2", new CultureInfo("tr-TR")) + "%";
    }
}
