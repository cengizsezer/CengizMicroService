@using System.Globalization
@using WebApp.Application.Services
@using WebApp.Domain.Models.FirmaKontrol

<table class="fk-mizan-table fk-gt-table fk-mizan-kompakt">
    <thead>
        <tr>
            <th class="fk-mizan-col-kod">Hesap Kodu</th>
            <th class="fk-mizan-col-ad">Hesap Adı</th>
            <th class="fk-mizan-col-num">Önceki Dönem</th>
            <th class="fk-mizan-col-num">Cari Dönem</th>
            <th class="fk-gt-col-kaynak">Kaynak Hesap</th>
            <th class="fk-gt-col-yansitma">Yansıtma</th>
        </tr>
    </thead>
    <tbody>
        @if (Rows.Count == 0)
        {
            <tr>
                <td colspan="6" class="fk-mizan-empty"><em>Bu bölüm için satır bulunmuyor.</em></td>
            </tr>
        }
        else
        {
            @foreach (var row in renderedRows)
            {
                var kirilim = KirilimAl(row);
                var acik = kirilim is not null && acikKirilimlar.Contains(row.Source.Kod);

                <tr class="@RowCssClass(row.Source.Tip)">
                    <td class="fk-mizan-col-kod">
                        @if (kirilim is not null)
                        {
                            @* Etiket kırılımı BİLGİ AMAÇLIDIR — hiçbir toplamı değiştirmez. *@
                            <button type="button" class="gg-kirilim-dugme"
                                    aria-expanded="@(acik ? "true" : "false")"
                                    title="Etiket kırılımını @(acik ? "kapat" : "aç")"
                                    @onclick="@(() => KirilimDegistir(row.Source.Kod))">@(acik ? "▾" : "▸")</button>
                        }
                        @row.Source.Kod
                    </td>
                    <td class="fk-mizan-col-ad">@row.Source.Ad</td>
                    <td class="fk-mizan-col-num">@FormatNumber(row.OncekiCari)</td>
                    <td class="fk-mizan-col-num">@FormatNumber(row.Cari)</td>
                    <td class="fk-gt-col-kaynak">@(row.KaynakKod ?? string.Empty)</td>
                    <td class="fk-gt-col-yansitma">
                        @if (!string.IsNullOrEmpty(row.YansitmaKod))
                        {
                            <span class="fk-gt-yansitma-badge"
                                  title="@($"{row.YansitmaKod} kodlu yansıtma hesabı 6'lı seriye aktarıldı")">@row.YansitmaKod</span>
                        }
                    </td>
                </tr>

                @if (acik)
                {
                    @foreach (var k in kirilim!)
                    {
                        <tr class="gg-kirilim-satir @(k.Atanmamis ? "gg-kirilim-atanmamis" : null)">
                            <td></td>
                            <td class="gg-kirilim-ad">
                                <span class="gg-kare" style="@($"background:{(string.IsNullOrWhiteSpace(k.Renk) ? "#CBD5E1" : k.Renk)}")"></span>
                                @k.Ad
                            </td>
                            <td></td>
                            <td class="fk-mizan-col-num gg-kirilim-tutar">@FormatNumber(k.Tutar)</td>
                            <td colspan="2" class="gg-kirilim-not">bilgi amaçlı · toplama girmez</td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public List<MizanSatir> Rows { get; set; } = new();

    [Parameter] public IReadOnlyDictionary<string, decimal?> CariRawValues { get; set; } =
        new Dictionary<string, decimal?>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyDictionary<string, decimal?> OncekiRawValues { get; set; } =
        new Dictionary<string, decimal?>(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Vergi panelinden gelen 691 değeri. Cari sütununa -1 ile yansıtılır.
    /// </summary>
    [Parameter] public decimal? HesaplananVergi691Cari { get; set; }

    /// <summary>
    /// true ise 690 (Ticari Kar) satırından sonrası gizlenir.
    /// </summary>
    [Parameter] public bool HideTaxRows { get; set; } = true;

    /// <summary>
    /// İsteğe bağlı etiket kırılımı (ana hesap kodu → etiket satırları). Yalnızca Gelir
    /// Tablosu sekmesinin YASAL görünümü verir; verilmezse (Dikey Yüzdeler vb.) tablo
    /// eskisiyle birebir aynıdır. Kırılım ayrı satır olarak çizilir, <see cref="renderedRows"/>
    /// ve hiçbir toplam değişmez.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, List<GrupGorunumu.KirilimSatiri>>? EtiketKirilimi { get; set; }

    private List<GelirTablosuCalculator.ComputedRow> renderedRows = new();

    private readonly HashSet<string> acikKirilimlar = new(StringComparer.OrdinalIgnoreCase);

    private List<GrupGorunumu.KirilimSatiri>? KirilimAl(GelirTablosuCalculator.ComputedRow row) =>
        EtiketKirilimi is not null
        && row.Source.Tip == SatirTipi.Account
        && !string.IsNullOrEmpty(row.Source.Kod)
        && EtiketKirilimi.TryGetValue(row.Source.Kod, out var liste)
        && liste.Count > 0
            ? liste
            : null;

    private void KirilimDegistir(string kod)
    {
        if (!acikKirilimlar.Remove(kod)) acikKirilimlar.Add(kod);
    }

    protected override void OnParametersSet()
    {
        var computed = GelirTablosuCalculator.Compute(Rows, CariRawValues, OncekiRawValues, HesaplananVergi691Cari);

        if (HideTaxRows)
        {
            int donemKariIdx = -1;
            for (int i = 0; i < computed.Count; i++)
            {
                if (computed[i].Source.Kod == "690")
                {
                    donemKariIdx = i;
                    break;
                }
            }

            renderedRows = donemKariIdx >= 0
                ? computed.Take(donemKariIdx + 1).ToList()
                : computed;
        }
        else
        {
            renderedRows = computed;
        }
    }

    private static string RowCssClass(SatirTipi tip) => tip switch
    {
        SatirTipi.MainGroup => "fk-mizan-row main-group",
        SatirTipi.SubGroup => "fk-mizan-row sub-group",
        SatirTipi.Account => "fk-mizan-row account",
        SatirTipi.Total => "fk-mizan-row total",
        SatirTipi.Other => "fk-mizan-row other",
        _ => "fk-mizan-row"
    };

    private static string FormatNumber(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", new CultureInfo("tr-TR")) : "—";
}
