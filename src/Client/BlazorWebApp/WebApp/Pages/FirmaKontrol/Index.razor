@page "/firmakontrol"
@using WebApp.Application.Services.Interfaces
@using WebApp.Domain.Models.FirmaKontrol
@using WebApp.Pages.FirmaKontrol.Components
@inject IFirmaKontrolService FirmaKontrolService
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem" AlignItems="AlignItems.Stretch">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenIcon Icon="fact_check" Style="font-size:2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Raporlar</RadzenText>
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
        Kurumlar vergisi hazırlık çalışması yapacağınız firmayı seçin.
    </RadzenText>

    @if (firmlar is null)
    {
        <RadzenCard class="rz-p-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <span>Yükleniyor...</span>
            </RadzenStack>
        </RadzenCard>
    }
    else if (firmlar.Count == 0)
    {
        <RadzenCard class="rz-p-4">
            <em>Tanımlı firma bulunamadı.</em>
        </RadzenCard>
    }
    else
    {
        <RadzenDataGrid TItem="Firma"
                        Data="@firmlar"
                        AllowPaging="true" PageSize="20"
                        AllowSorting="true"
                        AllowFiltering="false"
                        RowSelect="@GoToDetay"
                        Style="cursor:pointer;">
            <Columns>
                <RadzenDataGridColumn TItem="Firma" Property="Ad" Title="Firma" />
                <RadzenDataGridColumn TItem="Firma" Property="VergiNo" Title="VKN" Width="150px" />
                <RadzenDataGridColumn TItem="Firma" Property="Donem" Title="Dönem" Width="170px" />

                <RadzenDataGridColumn TItem="Firma" Title="Toplam Kontrol" Width="150px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="f">
                        @GetStats(f.Id).Total
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Firma" Title="Tamamlanan" Width="130px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="f">
                        @GetStats(f.Id).Checked
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Firma" Title="Sorun" Width="110px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="f">
                        @{ var issue = GetStats(f.Id).Issue; }
                        @if (issue > 0)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@issue.ToString()" IsPill="true" />
                        }
                        else
                        {
                            <span class="rz-text-muted">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Firma" Title="" Width="120px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="f">
                        <span @onclick:stopPropagation @onkeydown:stopPropagation>
                            <RadzenButton Text="GİRİŞ"
                                          Icon="login"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small"
                                          Click="@(() => GoToDetay(f))" />
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private List<Firma>? firmlar;
    private readonly Dictionary<int, (int Total, int Checked, int Issue)> _statsCache = new();

    protected override async Task OnInitializedAsync()
    {
        var list = await FirmaKontrolService.GetFirmsAsync();
        firmlar = list.ToList();

        foreach (var f in firmlar)
        {
            var items = await FirmaKontrolService.GetControlItemsAsync(f.Id);
            _statsCache[f.Id] = (
                items.Count,
                items.Count(x => x.IsChecked),
                items.Count(x => x.Status == ControlStatus.HasIssue)
            );
        }
    }

    private (int Total, int Checked, int Issue) GetStats(int firmaId)
        => _statsCache.TryGetValue(firmaId, out var s) ? s : (0, 0, 0);

    private void GoToDetay(Firma firma)
    {
        Navigation.NavigateTo($"/firmakontrol/{firma.Id}");
    }
}
