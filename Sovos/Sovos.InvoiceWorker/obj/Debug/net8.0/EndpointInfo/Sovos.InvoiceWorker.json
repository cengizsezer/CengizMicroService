{
  "openapi": "3.0.1",
  "info": {
    "title": "Sovos.InvoiceWorker",
    "version": "1.0"
  },
  "paths": {
    "/api/worker/health": {
      "get": {
        "tags": [
          "Worker"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/worker/run-now/{companyId}": {
      "post": {
        "tags": [
          "Worker"
        ],
        "parameters": [
          {
            "name": "companyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/worker/run-batch": {
      "post": {
        "tags": [
          "Worker"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerBatchRunRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerBatchRunRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerBatchRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BatchRunResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchRunResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchRunResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchRunItem": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "integer",
            "format": "int32"
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BatchRunResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchRunItem"
            },
            "nullable": true
          },
          "failed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchRunItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WorkerBatchRunRequest": {
        "type": "object",
        "properties": {
          "companyIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}