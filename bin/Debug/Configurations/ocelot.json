{
  "Routes": [
    {
      "ServiceName": "IdentityService",
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "ServiceName": "IdentityService",
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/auth/register",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/auth/register",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "ServiceName": "IdentityService",
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/auth/refresh-token",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/auth/refresh-token",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "ServiceName": "IdentityService",
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/auth/admin-test",
      "DownstreamScheme": "http",
      "UpstreamPathTemplate": "/auth/admin-test",
      "UpstreamHttpMethod": [ "GET" ]
    },
    //{
    //  "UseServiceDiscovery": true,
    //  "ServiceName": "CatalogService",
    //  "DownstreamPathTemplate": "/api/catalog/{everything}",
    //  "DownstreamScheme": "http",

    //  "UpstreamPathTemplate": "/catalog/{everything}",
    //  "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ],
    //  "UpstreamScheme": "http"
    //},
    {
      "DownstreamPathTemplate": "/api/catalog/expenses/paged",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5004
        }
      ],
      "UpstreamPathTemplate": "/catalog/expenses/paged",
      "UpstreamHttpMethod": [ "GET" ]
    }

  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "ServiceDiscoveryProvider": {
      "Host": "localhost",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}
